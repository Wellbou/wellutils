#!/usr/bin/env bash
# wellpci v2 -- Beautiful PCI device listing with IDS database lookup
# Part of wellutils by wellbou_
set -euo pipefail

# ─── Shared libs ────────────────────────────────────────────────
_WU_TOOLNAME="wellpci" _WU_NAME="WellPCI" _WU_VERSION="2.1" _WU_MANUAL=1
_WU_TAGLINE="PCI device listing with IDS database lookup"
_WU_BOOT_DIR="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="/usr/share/wellutils"
source "$_WU_BOOT_DIR/bootstrap.sh" lang cli
_PCI_ALL=0

wpci_extra_parse() {
    case "$1" in
        --all)  _PCI_ALL=1; _WU_EXTRA_CONSUMED=1; return 0 ;;
    esac
    return 1
}
_WU_EXTRA_PARSE=wpci_extra_parse
_WU_EXTRA_HELP="      --all                   show all devices (default: expansion cards only)"


# ─── Colors ──────────────────────────────────────────────────────
R=$'\033[1;31m'  G=$'\033[1;32m'  Y=$'\033[1;33m'  B=$'\033[1;34m'
M=$'\033[1;35m'  C=$'\033[1;36m'  W=$'\033[1;37m'  DIM=$'\033[2m'
BOLD=$'\033[1m'  RESET=$'\033[0m'

PCI_IDS=""
for _p in /usr/local/share/hwdata/pci.ids /usr/share/hwdata/pci.ids /usr/share/misc/pci.ids /usr/share/pci.ids; do
    [[ -f "$_p" ]] && { PCI_IDS="$_p"; break; }
done

# ─── PCI Class Lookup ────────────────────────────────────────────
pci_class_name() {
    local major=${1:0:2}
    case "$major" in
        00) t pci_class_legacy ;;    01) t pci_class_storage ;;
        02) t pci_class_network ;;   03) t pci_class_display ;;
        04) t pci_class_multimedia ;; 05) t pci_class_memory ;;
        06) t pci_class_bridge ;;    07) t pci_class_comm ;;
        08) t pci_class_system ;;    09) t pci_class_input ;;
        0a) t pci_class_dock ;;      0b) t pci_class_processor ;;
        0c) t pci_class_serial ;;    0d) t pci_class_wireless ;;
        ff) t pci_class_vendor ;;    *)  t pci_class_unknown ;;
    esac
}

pci_class_color() {
    local major=${1:0:2}
    case "$major" in
        03) printf '%s' "$G" ;; 02) printf '%s' "$C" ;; 01) printf '%s' "$Y" ;;
        04) printf '%s' "$M" ;; 0c) printf '%s' "$B" ;; 06) printf '%s' "$DIM" ;;
        *)  printf '%s' "$W" ;;
    esac
}

pci_class_icon() {
    local major=${1:0:2}
    case "$major" in
        03) printf ''"$(_emu "🎮")"'' ;; 02) printf ''"$(_emu "🌐")"'' ;; 01) printf ''"$(_emu "💾")"'' ;;
        04) printf ''"$(_emu "🔊")"'' ;; 0c) printf ''"$(_emu "🔌")"'' ;; 06) printf ''"$(_emu "🌉")"'' ;;
        08) printf ''"$(_ic "⌨️")"'' ;; 0d) printf ''"$(_emu "📡")"'' ;; *)  printf ''"$(_emu "🔧")"'' ;;
    esac
}

# ─── PCI IDS Lookup (lazy, bash 3.2) ─────────────────────────────
_wlc() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

# Byte-length helpers (wellpci does not source box.sh)
vislen() { printf '%s' "${#1}"; }
wucap() {
    local s="$1" maxw="$2"
    if (( ${#s} > maxw )); then
        printf '%s…' "${s:0:maxw-1}"
    else
        printf '%s' "$s"
    fi
}

# ─── PCI slot device filter (duplicated from box.sh) ────────────
# Populates: _PCI_BUS[], _PCI_CLASS[], _PCI_DESC[]
pci_slot_devices() {
    _PCI_BUS=() _PCI_CLASS=() _PCI_DESC=()
    local d addr bus major class_hex
    for d in /sys/bus/pci/devices/*/; do
        [[ -d "$d" ]] || continue
        addr=$(basename "$d")
        bus=$(echo "$addr" | cut -d: -f2 | cut -d. -f1)
        class_hex=$(cat "$d/class" 2>/dev/null) || continue
        class_hex="${class_hex#0x}"
        major="${class_hex:0:2}"
        local sub="${class_hex:2:2}"

        [[ "$major" == "06" ]] && continue
        [[ "$major" == "05" || "$major" == "0b" ]] && continue
        [[ "$major" == "0c" && "$sub" == "05" ]] && continue
        [[ "$major" == "0c" && "$sub" == "00" ]] && continue

        if [[ "$major" == "03" || "$major" == "0d" ]]; then
            local desc
            desc=$(lspci -s "$addr" 2>/dev/null | sed 's/^[0-9a-f:.]* //' || true)
            _PCI_BUS+=("$addr") _PCI_CLASS+=("$class_hex") _PCI_DESC+=("$desc")
            continue
        fi

        if [[ "$major" == "01" && ( "$sub" == "04" || "$sub" == "08" ) ]]; then
            local desc
            desc=$(lspci -s "$addr" 2>/dev/null | sed 's/^[0-9a-f:.]* //' || true)
            _PCI_BUS+=("$addr") _PCI_CLASS+=("$class_hex") _PCI_DESC+=("$desc")
            continue
        fi

        [[ "$bus" == "00" ]] && continue

        case "$major" in
            01|02|07) continue ;;
        esac
        [[ "$major" == "0c" ]] && continue

        local desc
        desc=$(lspci -s "$addr" 2>/dev/null | sed 's/^[0-9a-f:.]* //' || true)
        _PCI_BUS+=("$addr") _PCI_CLASS+=("$class_hex") _PCI_DESC+=("$desc")
    done
}

pci_vendor_name() {
    [[ "$1" =~ ^[0-9a-f]{4}$ ]] || { printf '%s' "$(t hw_unknown)"; return 0; }
    [[ -f "$PCI_IDS" ]] || { printf '%s' "$(t hw_unknown)"; return 0; }
    awk -v v="$(_wlc "$1")" '
        /^[0-9a-f]{4}[[:space:]]/ { if (tolower($1)==v) { sub(/^[0-9a-f]{4}[[:space:]]+/, ""); print; exit } }
    ' "$PCI_IDS"
}

pci_device_name() {
    [[ "$1" =~ ^[0-9a-f]{4}$ && "$2" =~ ^[0-9a-f]{4}$ ]] || return 0
    [[ -f "$PCI_IDS" ]] || return 0
    awk -v v="$(_wlc "$1")" -v p="$(_wlc "$2")" '
        /^[0-9a-f]{4}[[:space:]]/ { insec = ($1 == v); next }
        insec && $0 ~ "^" "\t" p "[[:space:]]" { sub(/^[^ ]+ +/, ""); print; exit }
    ' "$PCI_IDS"
}

# ─── Scan (fills global arrays + count) ─────────────────────────
pci_scan() {
    ADDRS=() CLASSES=() DRIVERS=() VENDORS=() DEVICES=() DESCS=() VENDOR_NAMES=() DEVICE_NAMES=()
    count=0

    if [[ "$_PCI_ALL" == "1" ]]; then
        pci_scan_all
    else
        pci_scan_slot_filter
    fi
}

pci_scan_slot_filter() {
    pci_slot_devices
    local i devdir addr class vendor device vid did driver_name lspci_desc vname dname full_desc
    for (( i=0; i<${#_PCI_BUS[@]}; i++ )); do
        devdir="/sys/bus/pci/devices/${_PCI_BUS[$i]}/"
        [[ -d "$devdir" ]] || continue
        addr="${_PCI_BUS[$i]}"

        class=$(cat "$devdir/class" 2>/dev/null || echo "000000")
        class="${class#0x}"
        vendor=$(cat "$devdir/vendor" 2>/dev/null || echo "0x0000")
        device=$(cat "$devdir/device" 2>/dev/null || echo "0x0000")
        vid="${vendor#0x}" did="${device#0x}"

        driver_name="none"
        if [[ -L "$devdir/driver" ]]; then
            driver_name=$(basename "$(readlink "$devdir/driver")")
        fi

        lspci_desc=$(lspci -s "$addr" -n 2>/dev/null | sed 's/^[0-9a-f:.]* //' || true)

        vname=$(pci_vendor_name "$vid")
        dname=$(pci_device_name "$vid" "$did")
        if [[ -z "$dname" ]]; then
            dname=$(echo "$lspci_desc" | sed 's/^[0-9a-f:.]* //')
        fi

        full_desc=$(lspci -s "$addr" 2>/dev/null | sed 's/^[0-9a-f:.]* //' || true)

        ADDRS+=("$addr")
        CLASSES+=("$class")
        DRIVERS+=("$driver_name")
        VENDORS+=("$vid")
        DEVICES+=("$did")
        DESCS+=("$full_desc")
        VENDOR_NAMES+=("$vname")
        DEVICE_NAMES+=("$dname")
        count=$(( count + 1 ))
    done
}

pci_scan_all() {
    local devdir addr class vendor device vid did driver_name lspci_desc vname dname full_desc
    for devdir in /sys/bus/pci/devices/*/; do
        [[ -d "$devdir" ]] || continue
        addr=$(basename "$devdir")

        class=$(cat "$devdir/class" 2>/dev/null || echo "000000")
        class="${class#0x}"
        vendor=$(cat "$devdir/vendor" 2>/dev/null || echo "0x0000")
        device=$(cat "$devdir/device" 2>/dev/null || echo "0x0000")
        vid="${vendor#0x}" did="${device#0x}"

        driver_name="none"
        if [[ -L "$devdir/driver" ]]; then
            driver_name=$(basename "$(readlink "$devdir/driver")")
        fi

        lspci_desc=$(lspci -s "$addr" -n 2>/dev/null | sed 's/^[0-9a-f:.]* //' || true)

        vname=$(pci_vendor_name "$vid")
        dname=$(pci_device_name "$vid" "$did")
        if [[ -z "$dname" ]]; then
            dname=$(echo "$lspci_desc" | sed 's/^[0-9a-f:.]* //')
        fi

        full_desc=$(lspci -s "$addr" 2>/dev/null | sed 's/^[0-9a-f:.]* //' || true)

        ADDRS+=("$addr")
        CLASSES+=("$class")
        DRIVERS+=("$driver_name")
        VENDORS+=("$vid")
        DEVICES+=("$did")
        DESCS+=("$full_desc")
        VENDOR_NAMES+=("$vname")
        DEVICE_NAMES+=("$dname")
        count=$(( count + 1 ))
    done
}

# ─── JSON output ────────────────────────────────────────────────
json_out() {
    pci_scan

    wu_json_head "$_WU_TOOLNAME" "$_WU_VERSION"
    printf ',\n  "summary": { "devices": %d },\n' "$count"
    printf '  "ids_db_loaded": %s,\n' "$([[ -f $PCI_IDS ]] && printf 'true' || printf 'false')"
    printf '  "devices": [\n'
    local first=1
    for (( i=0; i<count; i++ )); do
        local addr="${ADDRS[$i]}" cls="${CLASSES[$i]}" drv="${DRIVERS[$i]}" vid="${VENDORS[$i]}" did="${DEVICES[$i]}" desc="${DESCS[$i]}" vname="${VENDOR_NAMES[$i]}" dname="${DEVICE_NAMES[$i]}"
        local major="${cls:0:2}"
        local cname
        cname=$(pci_class_name "${major}0000")

        (( first )) && first=0 || printf ',\n'
        printf '    { "addr": "%s", "class": "%s", "major": "%s", "class_name": "%s", "vendor_id": "%s", "device_id": "%s", "vendor": "%s", "device": "%s", "description": "%s", "driver": "%s" }' \
            "$(json_esc "$addr")" "$(json_esc "$cls")" "$(json_esc "$major")" "$(json_esc "$cname")" \
            "$(json_esc "$vid")" "$(json_esc "$did")" "$(json_esc "$vname")" "$(json_esc "$dname")" \
            "$(json_esc "$desc")" "$(json_esc "$drv")"
    done
    printf '\n  ]\n'
    wu_json_end
}

# ─── Main ────────────────────────────────────────────────────────
main() {
    if [[ "$_WU_JSON" == "1" ]]; then json_out; return 0; fi

    local line
    line=$(printf '═%.0s' {1..78})
    printf '\n  %s╔═%s═╗%s\n' "$C" "$line" "$RESET"
    printf '  %s║%s%s  '"$(_ic "🌉")"'wellpci -- %s                          %s%s║%s\n' "$C" "$RESET" "${BOLD}${W}" "$(t pci_title)" "$RESET" "$C" "$RESET"
    printf '  %s╚═%s═╝%s\n' "$C" "$line" "$RESET"

    pci_scan

    local ids_status
    if [[ -f $PCI_IDS ]]; then
        ids_status="${G}$(t loaded)${RESET}"
    else
        ids_status="${R}$(t not_found)${RESET}"
    fi

    printf '  %s│%s  '"$(_ic "📊")"'%s%s:%s %d  |  %s%s:%s %s\n\n' \
        "$C" "$RESET" "$BOLD" "$(t pci_total)" "$W" "$count" \
        "$BOLD" "$(t usb_ids_db)" "$W" "$ids_status"

    local prev_major=""
    for (( i=0; i<count; i++ )); do
        local addr="${ADDRS[$i]}"
        local cls="${CLASSES[$i]}"
        local drv="${DRIVERS[$i]}"
        local vid="${VENDORS[$i]}"
        local did="${DEVICES[$i]}"
        local desc="${DESCS[$i]}"
        local vname="${VENDOR_NAMES[$i]}"
        local dname="${DEVICE_NAMES[$i]}"
        local major="${cls:0:2}"

        if [[ "$major" != "$prev_major" ]]; then
            local cname
            cname=$(pci_class_name "${major}0000")
            local ccolor
            ccolor=$(pci_class_color "${major}0000")
            local cicon
            cicon=$(pci_class_icon "${major}0000")

            [[ -n "$prev_major" ]] && printf '  %s│%s\n' "$C" "$RESET"
            printf '  %s┌───%s %s %s%s%s%s\n' "$C" "$RESET" "$cicon" "$BOLD" "$ccolor" "$cname" "$RESET"
        fi
        prev_major="$major"

        local ccolor
        ccolor=$(pci_class_color "$cls")
        local cicon
        cicon=$(pci_class_icon "$cls")

        local lbl fixed drv_max desc_max desc_txt drv_txt
        lbl="$(t pci_drv):"
        fixed=$(( 4 + $(vislen "$cicon") + 1 + $(vislen "$addr") + 2 + $(vislen "$lbl") ))
        drv_max=12
        desc_max=$(( 82 - fixed - drv_max ))
        (( desc_max < 12 )) && desc_max=12
        desc_txt=$(wucap "$desc" "$desc_max")
        drv_txt=$(wucap "$drv" "$drv_max")

        local drv_badge
        if [[ "$drv" == "none" ]]; then
            drv_badge="${DIM}${drv_txt}${RESET}"
        else
            drv_badge="${G}${drv_txt}${RESET}"
        fi

        # PCIe link speed/width badge from sysfs
        local link_badge="" sysfs_addr="/sys/bus/pci/devices/${addr}/"
        if [[ -r "${sysfs_addr}current_link_speed" ]]; then
            local lnk_spd lnk_wid
            lnk_spd=$(cat "${sysfs_addr}current_link_speed" 2>/dev/null || true)
            lnk_wid=$(cat "${sysfs_addr}current_link_width" 2>/dev/null || true)
            [[ -n "$lnk_spd" ]] && link_badge=" ${DIM}${lnk_spd}${RESET}"
            [[ -n "$lnk_wid" ]] && link_badge+="${DIM} x${lnk_wid}${RESET}"
        fi

        printf '  %s│%s  %s %s%s%s  %s%s%s  %s%s%s%s\n' \
            "$C" "$RESET" "$cicon" "$BOLD" "$addr" "$RESET" \
            "$ccolor" "$desc_txt" "$RESET" \
            "$lbl" "$drv_badge" "$link_badge"
    done

    printf '  %s└%s┘%s\n' "$C" "$(printf '─%.0s' {1..80})" "$RESET"

    printf '\n  %sWellPCI v%s | %s%s\n\n' "$DIM" "$_WU_VERSION" "$(date '+%Y-%m-%d %H:%M:%S')" "$RESET"
}

wu_run main "$@"
