#!/usr/bin/env bash
# wellgpu -- Beautiful GPU overview (adapters, driver, live stats)
# Part of wellutils by wellbou_
set -euo pipefail

# ─── Shared libs ────────────────────────────────────────────────
_WU_TOOLNAME="wellgpu" _WU_NAME="WellGPU" _WU_VERSION="1.0"
_WU_SHORT_OK=1
_WU_TAGLINE="Beautiful GPU overview (adapters, driver, live stats)"
_WU_BOOT_DIR="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="$(dirname -- "$_WU_BOOT_DIR")/share/wellutils"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="/usr/local/share/wellutils"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="/usr/share/wellutils"
source "$_WU_BOOT_DIR/bootstrap.sh" lang box cli
# ─── Rare-hardware guards ─────────────────────────────────────────
command -v awk    >/dev/null 2>&1 || awk()    { :; }
command -v date   >/dev/null 2>&1 || date()   { printf '%s' '1970-01-01 00:00:00'; }


# ─── Adapter list (machine-readable, quoted) ─────────────────────
# lspci -mmnn:  01:00.0 "VGA compatible controller [0300]" "NVIDIA Corporation [10de]" "GP107 [GeForce GTX 1050 Ti] [1c82]" ...
gpu_adapters() {
    _GPU_BUS=() _GPU_VENDOR=() _GPU_DEVICE=() _GPU_AIB=()
    local line bus vendor device aib
    while IFS= read -r line; do
        [[ "$line" =~ '"VGA compatible controller' || "$line" =~ '"3D controller' ]] || continue
        set -- $line
        bus=$1
        vendor=$(printf '%s' "$line" | awk -F'"' '{print $4}')
        device=$(printf '%s' "$line" | awk -F'"' '{print $6}')
        [[ -z "$device" ]] && device="$vendor" && vendor=""
        aib=$(gpu_aib_vendor "$bus")
        _GPU_BUS+=("$bus")
        _GPU_VENDOR+=("$vendor")
        _GPU_DEVICE+=("$device")
        _GPU_AIB+=("$aib")
    done < <(lspci -mmnn 2>/dev/null)
}

gpu_driver() {
    local bus="$1" drv _dev
    _dev="/sys/bus/pci/devices/0000:${bus}"
    [[ -d "$_dev" ]] || _dev=$(find /sys/bus/pci/devices/ -maxdepth 1 -name "*:${bus}" -type d 2>/dev/null | head -1)
    [[ -d "$_dev" ]] || { printf ''; return; }
    drv=$(readlink "${_dev}/driver" 2>/dev/null || true)
    [[ -n "$drv" ]] && printf '%s' "$(basename "$drv")" || true
}

# ─── Sections ───────────────────────────────────────────────────
print_gpu_list() {
    if ! command -v lspci &>/dev/null; then
        pline "${DIM}$(t gpu_pciutils)${RESET}"
        return
    fi
    gpu_adapters

    if (( ${#_GPU_BUS[@]} == 0 )); then
        pline "${DIM}$(t gpu_none)${RESET}"
        return
    fi

    local i bus vendor device drv aib
    for (( i = 0; i < ${#_GPU_BUS[@]}; i++ )); do
        bus=${_GPU_BUS[$i]}
        vendor=${_GPU_VENDOR[$i]}
        device=${_GPU_DEVICE[$i]}
        drv=$(gpu_driver "$bus")
        aib=${_GPU_AIB[$i]}

        local disp_name="${device}"
        [[ -n "$aib" ]] && disp_name="${aib} ${device}"

        # Explicit per-adapter index (GPU1, GPU2, ...) so a multi-GPU box
        # is readable; the PCI bus is shown for unambiguous identification.
        pline_hw "$(_emu '🎮')" "$(t gpu_vendor) $((i + 1))" "${disp_name}${vendor:+  ${DIM}(${vendor})${RESET}}"
        pline_sub "${DIM}${bus}${RESET}  $(t gpu_driver): ${W}${drv:-$(t blk_smart_unknown)}${RESET}"
    done
}

print_nvidia() {
    local out line
    out=$(nvidia-smi --query-gpu=index,name,driver_version,memory.total,memory.used,temperature.gpu,utilization.gpu,clocks.sm,clocks.mem,power.draw,fan.speed,pci.bus_id \
        --format=csv,noheader,nounits 2>/dev/null) || out=""
    [[ -z "$out" ]] && { pline "${DIM}$(t gpu_nvidia_none)${RESET}"; return; }

    # Map every NVIDIA PCI bus (0000:dd:bb.f) to its AIB partner name from
    # sysfs subsystem_vendor. With multiple cards each bus is resolved
    # independently so two cards from different vendors keep distinct names.
    local -A _nvaib=()
    for _aib_dir in /sys/bus/pci/devices/*/; do
        [[ "$(cat "${_aib_dir}vendor" 2>/dev/null)" == "0x10de" ]] || continue
        local _class
        _class=$(cat "${_aib_dir}class" 2>/dev/null || echo "")
        [[ "$_class" == "0x030000" || "$_class" == "0x030200" ]] || continue
        local _aibb=$(basename "$_aib_dir")
        _nvaib[$_aibb]=$(gpu_aib_vendor "$_aibb")
    done

    local idx name drv memtot memused temp util clk_sm clk_mem pow fan bus
    local n=0
    while IFS= read -r line; do
        IFS=',' read -r idx name drv memtot memused temp util clk_sm clk_mem pow fan bus <<< "$line"
        name=$(printf '%s' "$name" | sed 's/^ *//;s/ *$//')
        bus=$(printf '%s' "$bus" | tr -d ' ')
        # nvidia-smi reports 00000000:01:00.0; sysfs uses 0000:01:00.0
        local _nb="${bus/00000000:/0000:}"
        # bus can be empty on truncated/odd nvidia-smi output; indexing the
        # map with "" would abort the whole tool (bad array subscript).
        [[ -n "$_nb" && -n "${_nvaib[$_nb]:-}" ]] && name="${_nvaib[$_nb]} ${name#NVIDIA }"
        drv=$(printf '%s' "$drv" | sed 's/^ *//;s/ *$//')
        memtot=$(printf '%s' "$memtot" | sed 's/^ *//;s/ MiB//;s/ *$//')
        memused=$(printf '%s' "$memused" | sed 's/^ *//;s/ MiB//;s/ *$//')
        temp=$(printf '%s' "$temp" | sed 's/^ *//;s/ *$//')
        # nvidia-smi CSV keeps units ("1605 MHz", "355 W", "45 %"); strip them
        # so the numeric checks below don't always degrade to "unknown".
        util=$(printf '%s' "$util" | sed 's/^ *//;s/ *$//;s/ %$//')
        clk_sm=$(printf '%s' "$clk_sm" | sed 's/^ *//;s/ *$//;s/ MHz$//')
        clk_mem=$(printf '%s' "$clk_mem" | sed 's/^ *//;s/ *$//;s/ MHz$//')
        pow=$(printf '%s' "$pow" | sed 's/^ *//;s/ *$//;s/ W$//')
        fan=$(printf '%s' "$fan" | sed 's/^ *//;s/ *$//;s/ %$//')

        pline_hw "$(_emu '🎮')" "$(t gpu_vendor) ${n}" "$name ${DIM}[${_nb}]${RESET}"
        pline_hw "$(_emu '💾')" "$(t gpu_driver)" "$drv"

        local temp_txt=""
        [[ "$temp" =~ ^[0-9]+$ ]] && temp_txt="$temp°C" || temp_txt="$(t blk_smart_unknown)"
        pline_hw "$(_emu '🌡')" "$(t gpu_temp)" "$temp_txt"

        local mem_txt=""
        if [[ "$memused" =~ ^[0-9]+$ && "$memtot" =~ ^[0-9]+$ ]]; then
            mem_txt="$memused / $memtot MiB"
            if (( memtot > 0 )); then
                mem_txt="$mem_txt  ${DIM}$(( memused * 100 / memtot ))%${RESET}"
            fi
        else
            mem_txt="$(t blk_smart_unknown)"
        fi
        pline_hw "$(_emu '🧩')" "$(t gpu_vram)" "$mem_txt"

        local util_txt=""
        [[ "$util" =~ ^[0-9]+$ ]] && util_txt="$util%" || util_txt="$(t blk_smart_unknown)"
        pline_hw "$(_emu '⚡')" "$(t gpu_util)" "$util_txt"

        local clk_txt=""
        if [[ "$clk_sm" =~ ^[0-9]+$ && "$clk_mem" =~ ^[0-9]+$ ]]; then
            local clk_gpu="" clk_mem_txt=""
            if (( clk_sm >= 1000 )); then clk_gpu="$(awk "BEGIN {printf \"%.2f\", $clk_sm/1000}") GHz"; else clk_gpu="${clk_sm} MHz"; fi
            if (( clk_mem >= 1000 )); then clk_mem_txt="$(awk "BEGIN {printf \"%.2f\", $clk_mem/1000}") GHz"; else clk_mem_txt="${clk_mem} MHz"; fi
            clk_txt="$clk_gpu  ${DIM}/  mem $clk_mem_txt${RESET}"
        else
            clk_txt="$(t blk_smart_unknown)"
        fi
        pline_hw "$(_emu '🕐')" "$(t gpu_clocks)" "$clk_txt"

        local pow_txt=""
        if [[ "$pow" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
            pow_txt="${pow} W"
        else
            # power.draw is [N/A] on some cards -- fall back to the NVML
            # power-sample average (Avg line of the Power Samples section).
            pow=$(nvidia-smi -q -d POWER 2>/dev/null | grep -A6 'Power Samples' | sed -n 's/^[[:space:]]*Avg[[:space:]]*:[[:space:]]*\([0-9.]*\).*/\1/p' | head -1) || true
            [[ "$pow" =~ ^[0-9]+(\.[0-9]+)?$ ]] && pow_txt="~${pow} W" || pow_txt="$(t blk_smart_unknown)"
        fi
        pline_hw "$(_emu '🔌')" "$(t gpu_power)" "$pow_txt"

        local fan_txt=""
        [[ "$fan" =~ ^[0-9]+$ ]] && fan_txt="$fan%" || fan_txt="$(t blk_smart_unknown)"
        pline_hw "$(_emu '🌀')" "$(t gpu_fan)" "$fan_txt"
        n=$((n + 1))
    done <<< "$out"
}

# ─── JSON output ────────────────────────────────────────────────
json_out() {
    gpu_adapters

    wu_json_head "$_WU_TOOLNAME" "$_WU_VERSION"
    printf ',\n  "adapters": [\n'
    local first=1 i bus vendor device drv aib
    for (( i = 0; i < ${#_GPU_BUS[@]}; i++ )); do
        bus=${_GPU_BUS[$i]}
        vendor=${_GPU_VENDOR[$i]}
        device=${_GPU_DEVICE[$i]}
        drv=$(gpu_driver "$bus")
        aib=${_GPU_AIB[$i]}
        (( first )) && first=0 || printf ',\n'
        printf '    { "bus": "%s", "vendor": "%s", "device": "%s", "subsystem_vendor": "%s", "driver": "%s" }' \
            "$(json_esc "$bus")" "$(json_esc "$vendor")" "$(json_esc "$device")" "$(json_esc "$aib")" "$(json_esc "$drv")"
    done
    printf '\n  ],\n'

    printf '  "nvidia": [\n'
    local out line
    out=$(nvidia-smi --query-gpu=index,name,driver_version,memory.total,memory.used,temperature.gpu,utilization.gpu,clocks.sm,clocks.mem,power.draw,fan.speed,pci.bus_id \
        --format=csv,noheader,nounits 2>/dev/null) || out=""
    first=1
    if [[ -n "$out" ]]; then
        # Map every NVIDIA PCI bus to its own AIB partner (multi-GPU safe)
        local -A _nvaib=()
        for _nvdir in /sys/bus/pci/devices/*/; do
            [[ "$(cat "${_nvdir}vendor" 2>/dev/null)" == "0x10de" ]] || continue
            local _nvclass
            _nvclass=$(cat "${_nvdir}class" 2>/dev/null || echo "")
            [[ "$_nvclass" == "0x030000" || "$_nvclass" == "0x030200" ]] || continue
            local _nvbb=$(basename "$_nvdir")
            _nvaib[$_nvbb]=$(gpu_aib_vendor "$_nvbb")
        done
        local idx name drv memtot memused temp util clk_sm clk_mem pow fan bus nvb
        while IFS= read -r line; do
            IFS=',' read -r idx name drv memtot memused temp util clk_sm clk_mem pow fan bus <<< "$line"
            name=$(printf '%s' "$name" | sed 's/^ *//;s/ *$//')
            bus=$(printf '%s' "$bus" | tr -d ' ')
            nvb="${bus/00000000:/0000:}"
            [[ -n "${_nvaib[$nvb]:-}" ]] && name="${_nvaib[$nvb]} ${name#NVIDIA }"
            drv=$(printf '%s' "$drv" | sed 's/^ *//;s/ *$//')
            memtot=$(printf '%s' "$memtot" | sed 's/^ *//;s/ MiB//;s/ *$//')
            memused=$(printf '%s' "$memused" | sed 's/^ *//;s/ MiB//;s/ *$//')
            temp=$(printf '%s' "$temp" | sed 's/^ *//;s/ *$//')
            util=$(printf '%s' "$util" | sed 's/^ *//;s/ *$//')
            clk_sm=$(printf '%s' "$clk_sm" | sed 's/^ *//;s/ *$//')
            clk_mem=$(printf '%s' "$clk_mem" | sed 's/^ *//;s/ *$//')
            pow=$(printf '%s' "$pow" | sed 's/^ *//;s/ *$//')
            fan=$(printf '%s' "$fan" | sed 's/^ *//;s/ *$//')
            (( first )) && first=0 || printf ',\n'
            printf '    { "index": %s, "name": "%s", "driver": "%s", "subsystem_vendor": "%s", "bus": "%s", "memory_total_mib": %s, "memory_used_mib": %s, "temp_c": %s, "utilization_percent": %s, "clock_sm_mhz": %s, "clock_mem_mhz": %s, "power_w": %s, "fan_percent": %s }' \
                "$(wu_json_num "$idx")" "$(json_esc "$name")" "$(json_esc "$drv")" "$(json_esc "${_nvaib[$nvb]:-}")" "$(json_esc "$nvb")" \
                "$(wu_json_num "$memtot")" "$(wu_json_num "$memused")" "$(wu_json_num "$temp")" \
                "$(wu_json_num "$util")" "$(wu_json_num "$clk_sm")" "$(wu_json_num "$clk_mem")" \
                "$(wu_json_num "$pow")" "$(wu_json_num "$fan")"
        done <<< "$out"
    fi
    printf '\n  ]\n'
    wu_json_end
}

# ─── Main ────────────────────────────────────────────────────────
short_out() {
    local out temp util
    # Aggregate across ALL GPUs: max temperature + max utilization, and
    # expose the card count when more than one is present. This is a
    # per-processor tool, so a machine with two GPUs reports the hottest
    # one rather than silently picking the first.
    if command -v nvidia-smi &>/dev/null; then
        out=$(nvidia-smi --query-gpu=temperature.gpu,utilization.gpu --format=csv,noheader,nounits 2>/dev/null) || out=""
        if [[ -n "$out" ]]; then
            local maxt=0 maxu=0 cnt=0
            while IFS=',' read -r temp util; do
                temp=$(printf '%s' "$temp" | tr -d ' ')
                util=$(printf '%s' "$util" | tr -d ' ')
                cnt=$((cnt + 1))
                [[ "$temp" =~ ^[0-9]+$ ]] && (( temp > maxt )) && maxt=$temp
                [[ "$util" =~ ^[0-9]+$ ]] && (( util > maxu )) && maxu=$util
            done <<< "$out"
            if (( cnt > 0 )); then
                if (( cnt > 1 )); then
                    printf '%dx  %s°C  %d%%\n' "$cnt" "$maxt" "$maxu"
                else
                    printf '%s°C %d%%\n' "$maxt" "$maxu"
                fi
                return 0
            fi
        fi
    fi
    local d name f t maxt=0 hdir
    for d in /sys/class/hwmon/hwmon*/name; do
        [[ -f "$d" ]] || continue
        name=$(cat "$d" 2>/dev/null || true)
        [[ "$name" == amdgpu || "$name" == i915 ]] || continue
        hdir=$(dirname "$d")
        f="$hdir/temp1_input"
        [[ -f "$f" ]] || continue
        t=$(cat "$f" 2>/dev/null || true)
        [[ "$t" =~ ^[0-9]+$ ]] || continue
        t=$(( t / 1000 ))
        (( t > maxt )) && maxt=$t
    done
    (( maxt > 0 )) && { printf '%d°C\n' "$maxt"; return 0; }
    printf -- '-\n'
}

main() {
    if [[ "$_WU_JSON" == "1" ]]; then json_out; return 0; fi
    if [[ "$_WU_SHORT" == "1" ]]; then short_out; return 0; fi

    box_header "$(_emu '🎮')" "wellgpu" "$(t gpu_title)"

    box "$(_emu '🖥')" "$(t gpu_summary)" print_gpu_list

    if command -v nvidia-smi &>/dev/null; then
        box "$(_emu '⚡')" "$(t gpu_detail)" print_nvidia
    fi

    printf '\n  %sWellGPU v1.0 | %s%s\n\n' "$DIM" "$(date '+%Y-%m-%d %H:%M:%S')" "$RESET"
}

wu_run main "$@"
