#!/usr/bin/env bash
# wellfetch -- detailed system info display with ANSI logo (wellutils suite)
# Style: bash, 2-space indent.
set -uo pipefail

# shellcheck disable=SC2034,SC2059,SC2154

_WU_NAME="wellfetch"
_WU_VERSION="1.4.0"
_WU_TAGLINE="detailed system information with logo"

_WU_MANUAL=0
_WU_EXTRA_PARSE="wf_extra_parse"
# ─── Rare-hardware guards (Termux/PS5/ARM/laptops may lack tools) ──
command -v awk    >/dev/null 2>&1 || awk()    { :; }
command -v free   >/dev/null 2>&1 || free()   { printf 'Mem: 0 0 0 0 0 0\n'; }
command -v df     >/dev/null 2>&1 || df()     { :; }
command -v uptime >/dev/null 2>&1 || uptime() { :; }
command -v nproc  >/dev/null 2>&1 || nproc()  { getconf _NPROCESSORS_ONLN 2>/dev/null || printf '1'; }

_WU_BOOT_DIR="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="$(dirname -- "$_WU_BOOT_DIR")/share/wellutils"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="/usr/local/share/wellutils"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="/usr/share/wellutils"
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    # wellfetch runs without `set -e` (unlike the other tools), so bootstrap's
    # bash-3.2 guard must be paired with an explicit exit here or the script
    # would continue and die with rc=127 ("wu_run: command not found").
    source "$_WU_BOOT_DIR/bootstrap.sh" lang box cli parse || exit 1
else
    source "$_WU_BOOT_DIR/bootstrap.sh" lang box cli parse || return 1 2>/dev/null || exit 1
    return 0 2>/dev/null || exit 0
fi
# Suite version from the VERSION file (single source of truth).
[[ -r "$_WU_BOOT_DIR/VERSION" ]] && { read -r _WU_VERSION < "$_WU_BOOT_DIR/VERSION" || true; }

_WF_LOGO=1
_WF_PNG=0
_WF_LWIDTH=0
_WF_ALL=0

wf_extra_parse() {
    _WU_EXTRA_CONSUMED=0
    case "$1" in
        --no-logo|--text) _WF_LOGO=0; _WU_EXTRA_CONSUMED=1; return 0 ;;
        --logo)           _WF_LOGO=1; _WU_EXTRA_CONSUMED=1; return 0 ;;
        --png)            _WF_PNG=1; _WU_EXTRA_CONSUMED=1; return 0 ;;
        --all)            _WF_ALL=1; WF_SECTIONS="$WF_ALL_SECTIONS"; _WU_EXTRA_CONSUMED=1; return 0 ;;
        --full)           _WF_ALL=1; WF_SECTIONS="$WF_ALL_SECTIONS"; _WU_EXTRA_CONSUMED=1; return 0 ;;
        --logo-width)
            if [[ -n "${2:-}" ]] && [[ "$2" =~ ^[0-9]+$ ]]; then
                _WF_LWIDTH=$2; _WU_EXTRA_CONSUMED=2; return 0
            fi
            return 1 ;;
        --logo-width=*)
            _WF_LWIDTH="${1#*=}"
            [[ "$_WF_LWIDTH" =~ ^[0-9]+$ ]] || { printf 'wellfetch: --logo-width must be a number\n' >&2; return 1; }
            _WU_EXTRA_CONSUMED=1; return 0 ;;
    esac
    return 1
}

_WU_EXTRA_HELP="      --no-logo, --text     text only, no logo
      --logo                show logo (default on tty)
      --png                 force the PNG-rendered logo instead of distro art
      --all, --full         show all sections (audio, resolution, peripherals…)
      --logo-width N        logo width in cells"

# --- i18n ---------------------------------------------------------------------

# wf_tv KEY -- translation into $_WF_T without a subshell (t() is only
# forked for parametrised keys that are not in the tables).
wf_tv() {
    _WF_T=""
    if [[ "${WELLUTILS_LANG:-EN}" == "RU" && -n ${_T_RU[$1]+x} ]]; then _WF_T=${_T_RU[$1]}; fi
    if [[ -z "$_WF_T" && -n ${_T_EN[$1]+x} ]]; then _WF_T=${_T_EN[$1]}; fi
    if [[ -z "$_WF_T" ]]; then _WF_T=$(t "$1"); fi
    return 0
}

# The default sections (os kernel cpu gpu mem resolution) use compact
# single-width geometric glyphs: they align perfectly and match the
# wellutils box style. The rest (--all/--full) keep emoji.
wf_emoji_raw() {
    case "$1" in
        user) _WF_E='◉' ;; os) _WF_E='◆' ;; kernel) _WF_E='◈' ;; uptime) _WF_E='◔' ;;
        shell) _WF_E='🐚' ;; desktop) _WF_E='🪟' ;; wm) _WF_E='🎨' ;; terminal) _WF_E='⌨' ;;
        theme) _WF_E='🎭' ;; icons) _WF_E='🖌' ;; font) _WF_E='🔠' ;; cpu) _WF_E='▚' ;;
        gpu) _WF_E='▞' ;; mem) _WF_E='▤' ;; swap) _WF_E='🔁' ;; disk) _WF_E='💽' ;;
        disks) _WF_E='💿' ;; monitors) _WF_E='📺' ;; resolution) _WF_E='▣' ;;
        audio) _WF_E='🎚' ;; peripherals) _WF_E='🔌' ;; packages) _WF_E='📦' ;;
        locale) _WF_E='🌍' ;; date) _WF_E='📅' ;; backlight) _WF_E='◐' ;;
        battery) _WF_E='🔋' ;; custom) _WF_E='•' ;;
        *) _WF_E='•' ;;
    esac
}

# wf_icon_v SEC|GLYPH [raw] -- icon padded to 2 columns + separator into
# $_WF_IC, so every label starts in the same column (1- and 2-column glyphs
# mix in --all). Emoji off: a single space, as before.
wf_icon_v() {
    local _WU_VL
    if [[ "${_WU_EMOJI:-no}" != "yes" ]]; then _WF_IC=" "; return 0; fi
    if [[ "${2:-}" == raw ]]; then _WF_E=$1; else wf_emoji_raw "$1"; fi
    _WF_E=${_WF_E//$_WU_VS16/}
    _wu_vislen_v "$_WF_E"
    if (( _WU_VL < 2 )); then _WF_IC="${_WF_E}  "; else _WF_IC="${_WF_E} "; fi
}
# Backward compatible printer (config files may call it).
wf_emoji() { local _WF_E _WF_IC; wf_icon_v "$1"; printf '%s' "$_WF_IC"; }

# --- row collection -----------------------------------------------------------

WF_SECS=() WF_LABELS=() WF_VALUES=()

wf_push() {
    WF_SECS+=("$1") WF_LABELS+=("$2") WF_VALUES+=("$3")
}
# wf_pushl SEC KEY VALUE -- push with a translated label.
wf_pushl() { wf_tv "$2"; wf_push "$1" "$_WF_T" "$3"; }

# wf_clean_v STR -- drop control characters (keeps Cyrillic/CJK, unlike
# tr -cd '[:print:]' in a C locale), squeeze and trim blanks. Sets $_WF_C.
wf_clean_v() {
    local s="$1"
    # Control bytes never occur inside UTF-8 sequences: byte-wise is safe.
    if [[ "$s" == *[![:print:]]* ]]; then
        local LC_ALL=C
        s=${s//[$'\001'-$'\037'$'\177']/ }
    fi
    while [[ "$s" == *"  "* ]]; do s=${s//  / }; done
    s=${s# }; s=${s% }
    _WF_C=$s
}
wf_clean() { local _WF_C; wf_clean_v "$1"; printf '%s' "$_WF_C"; }

# --- value providers (each pushes one or more rows) ----------------------------

wfv_user() {
    local u="${USER:-}" h="${HOSTNAME:-}"
    [[ -n "$u" ]] || u=$(id -un 2>/dev/null)
    [[ -n "$u" ]] || u="?"
    [[ -n "$h" ]] || wu_read /proc/sys/kernel/hostname h || h=""
    [[ -n "$h" ]] || h=$(hostname 2>/dev/null)
    [[ -n "$h" ]] || h="?"
    wf_pushl user wf_user "$u@$h"
}

wfv_os() {
    local pretty arch
    pretty=$(wu_os_pretty 2>/dev/null)
    wf_clean_v "$pretty"; pretty=$_WF_C
    arch=$(uname -m 2>/dev/null)
    if [[ -n "$pretty" ]]; then
        wf_pushl os wf_os "$pretty${arch:+ ($arch)}"
    else
        wf_pushl os wf_os "-"
    fi
}

wfv_kernel() {
    local r=""
    wu_read /proc/sys/kernel/osrelease r || r=$(uname -r 2>/dev/null)
    wf_pushl kernel wf_kernel "${r:--}"
}

wfv_uptime() {
    local s="" d h m up="" boot="" bt="" now
    { read -r s _ < /proc/uptime; } 2>/dev/null
    s=${s%%.*}
    if [[ ! "$s" =~ ^[0-9]+$ ]]; then wf_pushl uptime wf_uptime "-"; return 0; fi
    d=$(( s / 86400 )); h=$(( (s % 86400) / 3600 )); m=$(( (s % 3600) / 60 ))
    if (( d > 0 )); then up="${d}d ${h}h ${m}m"
    elif (( h > 0 )); then up="${h}h ${m}m"
    else up="${m}m"; fi
    # printf %()T is bash >= 4.2 and fork-free; `date -d @N` is GNU-only
    # (busybox lacks it) -- only mention the boot time when we got one.
    if printf -v now '%(%s)T' -1 2>/dev/null && [[ "$now" =~ ^[0-9]+$ ]]; then
        boot=$(( now - s ))
        printf -v bt '%(%Y-%m-%d %H:%M)T' "$boot" 2>/dev/null || bt=""
    elif command -v date >/dev/null 2>&1; then
        now=$(date +%s 2>/dev/null)
        if [[ "$now" =~ ^[0-9]+$ ]]; then
            boot=$(( now - s ))
            bt=$(date -d "@$boot" '+%F %H:%M' 2>/dev/null) || bt=""
        fi
    fi
    if [[ -n "$bt" ]]; then wf_tv wf_boot; up+=" · $_WF_T $bt"; fi
    wf_pushl uptime wf_uptime "$up"
}

wfv_shell() {
    local base="" ver=""
    base="${SHELL:-}"; base="${base##*/}"
    [[ -n "$base" ]] || base="${_WU_SHELL:-?}"
    case "$base" in
        bash) ver="${BASH_VERSION%%(*}" ;;
        zsh)  ver="${ZSH_VERSION:-}" ;;
        fish) ver="${FISH_VERSION:-}" ;;
    esac
    if [[ -n "$ver" ]]; then wf_pushl shell wf_shell "$base $ver"
    else wf_pushl shell wf_shell "$base"; fi
}

wfv_desktop() {
    wf_clean_v "${XDG_CURRENT_DESKTOP:-${DESKTOP_SESSION:-}}"
    wf_pushl desktop wf_desktop "${_WF_C:--}"
}

wfv_wm() {
    wf_clean_v "${GDMSESSION:-${DESKTOP_SESSION:-${WM:-}}}"
    wf_pushl wm wf_wm "${_WF_C:--}"
}

wfv_terminal() {
    local v="${TERM_PROGRAM:-}"
    if [[ -n "$v" ]]; then
        [[ -n "${TERM_PROGRAM_VERSION:-}" ]] && v+=" $TERM_PROGRAM_VERSION"
    else
        v="${TERM:-}"
    fi
    wf_clean_v "$v"
    wf_pushl terminal wf_terminal "${_WF_C:--}"
}

# gsettings is slow-ish and absent outside GNOME-ish desktops.
wf_gsetting() {
    _WF_G=""
    command -v gsettings >/dev/null 2>&1 || return 0
    _WF_G=$(gsettings get org.gnome.desktop.interface "$1" 2>/dev/null) || _WF_G=""
    _WF_G=${_WF_G//\'/}
    return 0
}

wfv_theme() {
    local v="${GTK_THEME:-}"
    if [[ -z "$v" ]]; then wf_gsetting gtk-theme; v=$_WF_G; fi
    wf_clean_v "$v"
    wf_pushl theme wf_theme "${_WF_C:--}"
}

wfv_icons() {
    wf_gsetting icon-theme; wf_clean_v "$_WF_G"
    wf_pushl icons wf_icons "${_WF_C:--}"
}

wfv_font() {
    wf_gsetting font-name; wf_clean_v "$_WF_G"
    wf_pushl font wf_font "${_WF_C:--}"
}

wfv_cpu() {
    local m cores threads="" freq="" load="" khz="" detail="" f
    m=$(wu_cpu_model_generic 2>/dev/null)
    wf_clean_v "$m"; m=$_WF_C
    cores=$(wu_kv /proc/cpuinfo "cpu cores")
    [[ "$cores" =~ ^[0-9]+$ ]] || cores=""
    threads=$(nproc 2>/dev/null) || threads=""
    [[ "$threads" =~ ^[0-9]+$ ]] || threads=""
    freq=$(wu_kv /proc/cpuinfo "cpu MHz")
    if [[ ! "$freq" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
        freq=""
        for f in /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq /sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq; do
            if wu_read "$f" khz && [[ "$khz" =~ ^[0-9]+$ ]] && (( khz > 0 )); then
                freq=$(( (khz + 500) / 1000 )); break
            fi
        done
    fi
    { read -r load _ < /proc/loadavg; } 2>/dev/null || load=""
    wf_pushl cpu wf_cpu "${m:--}"
    if [[ -n "$threads" ]]; then
        if [[ -n "$cores" ]]; then
            detail="${cores} $(t_plural "$cores" core) / ${threads} $(t_plural "$threads" thread)"
        else
            detail="${threads} $(t_plural "$threads" thread)"
        fi
        if [[ -n "$freq" ]]; then
            local fi_=${freq%%.*} fr=${freq#*.}
            [[ "$freq" == *.* ]] || fr=0
            [[ "${fr:0:1}" =~ ^[5-9]$ ]] && fi_=$(( fi_ + 1 ))
            wf_tv wf_freq
            detail+=" @ ${fi_} $_WF_T"
        fi
    fi
    if [[ -n "$load" ]]; then
        wf_tv wf_load
        detail+="${detail:+ · }$_WF_T $load"
    fi
    [[ -z "$detail" ]] || wf_push cpu "" "$detail"
}

# Does the machine have an NVIDIA (0x10de) PCI display device? Checked via
# sysfs so nvidia-smi (slow, noisy without the driver) only runs when useful.
wf_has_nvidia() {
    local d v c
    for d in /sys/bus/pci/devices/*; do
        wu_read "$d/vendor" v || continue
        [[ "$v" == 0x10de ]] || continue
        wu_read "$d/class" c || continue
        [[ "$c" == 0x03* ]] && return 0
    done
    return 1
}

# GPUs from sysfs/DT when lspci is missing (ARM SBCs, Termux, containers).
wf_gpu_sysfs() {
    local d key val drv compat pciid name seen="" vid did
    for d in /sys/class/drm/card[0-9]*; do
        [[ "${d##*/}" == *-* ]] && continue
        [[ -r "$d/device/uevent" ]] || continue
        drv="" compat="" pciid=""
        while IFS='=' read -r key val; do
            case "$key" in
                DRIVER) drv=$val ;;
                OF_COMPATIBLE_0) compat=$val ;;
                PCI_ID) pciid=$val ;;
            esac
        done < "$d/device/uevent"
        name=""
        if [[ -n "$pciid" ]]; then
            vid=${pciid%%:*} did=${pciid#*:}
            name=$(wu_pci_name "$vid" "$did" 2>/dev/null)
            [[ -n "$name" ]] || name="PCI $pciid"
        elif [[ -n "$compat" ]]; then
            name=$compat
        fi
        if [[ -n "$drv" ]]; then name="${name:+$name }($drv)"; fi
        [[ -n "$name" ]] || continue
        case "$_WU_US$seen$_WU_US" in *"$_WU_US$name$_WU_US"*) continue ;; esac
        seen+="$_WU_US$name"
        _WF_GPUS+=("$name")
    done
    return 0
}

wfv_gpu() {
    local line name i nv=0 vram
    local -a vr=()
    _WF_GPUS=()
    if command -v lspci >/dev/null 2>&1; then
        while IFS= read -r line; do
            case "$line" in
                *"VGA compatible controller: "*) name=${line#*VGA compatible controller: } ;;
                *"3D controller: "*)             name=${line#*3D controller: } ;;
                *"Display controller: "*)        name=${line#*Display controller: } ;;
                *) continue ;;
            esac
            [[ "$name" == \[*\]\ * ]] && name=${name#*\] }
            name=${name% }
            name=${name% (rev*)}
            [[ -n "$name" ]] && _WF_GPUS+=("$name")
        done < <(LC_ALL=C lspci 2>/dev/null)
    fi
    (( ${#_WF_GPUS[@]} )) || wf_gpu_sysfs
    if (( ${#_WF_GPUS[@]} == 0 )) && command -v getprop >/dev/null 2>&1; then
        name=$(getprop ro.hardware.egl 2>/dev/null)
        [[ -n "$name" ]] || name=$(getprop ro.hardware.vulkan 2>/dev/null)
        [[ -n "$name" ]] && _WF_GPUS+=("$name")
    fi
    if (( ${#_WF_GPUS[@]} == 0 )); then wf_pushl gpu wf_gpu "-"; return 0; fi
    if wf_has_nvidia && command -v nvidia-smi >/dev/null 2>&1; then
        while IFS= read -r line; do
            line=${line// /}
            [[ "$line" =~ ^[0-9]+$ ]] && vr+=("$(( line / 1024 )) GiB")
        done < <(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null)
    fi
    for (( i = 0; i < ${#_WF_GPUS[@]}; i++ )); do
        name=${_WF_GPUS[i]}
        vram=""
        if [[ "$name" == *NVIDIA* ]] && (( nv < ${#vr[@]} )); then vram=${vr[nv]}; nv=$(( nv + 1 )); fi
        case "$name" in
            "Advanced Micro Devices, Inc. [AMD/ATI] "*) name=${name#Advanced Micro Devices, Inc. \[AMD/ATI\] } ;;
            "Advanced Micro Devices, Inc. "*) name=${name#Advanced Micro Devices, Inc. } ;;
            "NVIDIA Corporation "*) name=${name#NVIDIA Corporation } ;;
            "Intel Corporation "*)  name=${name#Intel Corporation } ;;
            "Advanced Micro Devices "*) name=${name#Advanced Micro Devices } ;;
            "AMD "*|"Intel "*) name=${name#* } ;;
        esac
        if (( i == 0 )); then wf_pushl gpu wf_gpu "$name${vram:+ · $vram}"
        else wf_push gpu "" "$name${vram:+ · $vram}"; fi
    done
}

# Format kibibytes as GiB: one decimal below 10, integer above (no awk).
fmt_gib_v() {
    local k="$1" t
    [[ "$k" =~ ^[0-9]+$ ]] || { _WF_GIB="0 GiB"; return 0; }
    t=$(( (k * 10 + 524288) / 1048576 ))
    if (( t < 100 )); then _WF_GIB="$(( t / 10 )).$(( t % 10 )) GiB"
    else _WF_GIB="$(( (k + 524288) / 1048576 )) GiB"; fi
}
fmt_gib() { local _WF_GIB; fmt_gib_v "$1"; printf '%s' "$_WF_GIB"; }

# One pass over /proc/meminfo into _WF_MI_<key> (kB).
_WF_MI_DONE=0
wf_meminfo() {
    (( _WF_MI_DONE )) && return 0
    _WF_MI_DONE=1
    _WF_MI_MemTotal="" _WF_MI_MemAvailable="" _WF_MI_MemFree="" _WF_MI_Buffers=""
    _WF_MI_Cached="" _WF_MI_SwapTotal="" _WF_MI_SwapFree=""
    local k v
    [[ -r /proc/meminfo ]] || return 0
    while read -r k v _; do
        case "$k" in
            MemTotal:|MemAvailable:|MemFree:|Buffers:|Cached:|SwapTotal:|SwapFree:)
                [[ "$v" =~ ^[0-9]+$ ]] && printf -v "_WF_MI_${k%:}" '%s' "$v" ;;
        esac
    done < /proc/meminfo
    return 0
}

wfv_mem() {
    local total avail pct a b
    wf_meminfo
    total=$_WF_MI_MemTotal avail=$_WF_MI_MemAvailable
    # Kernels < 3.14 (old ARM vendor trees, Xbox 360) lack MemAvailable.
    if [[ -z "$avail" && -n "$_WF_MI_MemFree" ]]; then
        avail=$(( _WF_MI_MemFree + ${_WF_MI_Buffers:-0} + ${_WF_MI_Cached:-0} ))
    fi
    if [[ -z "$total" || -z "$avail" ]] || (( total == 0 )); then wf_pushl mem wf_mem "-"; return 0; fi
    (( avail > total )) && avail=$total
    pct=$(( (total - avail) * 100 / total ))
    fmt_gib_v "$(( total - avail ))"; a=$_WF_GIB
    fmt_gib_v "$total"; b=$_WF_GIB
    wf_pushl mem wf_mem "$a / $b ($pct%)"
}

wfv_swap() {
    local total free pct a b
    wf_meminfo
    total=${_WF_MI_SwapTotal:-0} free=${_WF_MI_SwapFree:-0}
    (( total > 0 )) || return 0
    pct=$(( (total - free) * 100 / total ))
    fmt_gib_v "$(( total - free ))"; a=$_WF_GIB
    fmt_gib_v "$total"; b=$_WF_GIB
    wf_pushl swap wf_swap "$a / $b ($pct%)"
}

wfv_disk() {
    local line="" _fs size used _av pct mnt
    while read -r _fs size used _av pct mnt; do
        [[ "$_fs" == Filesystem ]] && continue
        [[ -n "$mnt" ]] && line="$mnt $used / $size ($pct)"
    done < <(LC_ALL=C df -hP / 2>/dev/null)
    wf_pushl disk wf_disk "${line:--}"
}

# Sectors (512 B) -> "465.8G" like lsblk.
wf_sect_human() {
    local s="$1" b u i=0 t
    local -a units=(B K M G T P)
    [[ "$s" =~ ^[0-9]+$ ]] || { _WF_H="?"; return 0; }
    b=$(( s * 512 )); t=$(( b * 10 ))
    while (( t >= 10240 && i < 5 )); do t=$(( t / 1024 )); i=$(( i + 1 )); done
    u=${units[i]}
    if (( t % 10 )); then _WF_H="$(( t / 10 )).$(( t % 10 ))$u"; else _WF_H="$(( t / 10 ))$u"; fi
}

wf_disk_skip() {
    case "$1" in
        loop*|ram*|zram*|dm-*|sr*|fd*|nbd*|mtdblock*|*boot[0-9]|*rpmb) return 0 ;;
    esac
    return 1
}

wfv_disks() {
    local first=1 name type size model d s got=0
    local -a rows=()
    if command -v lsblk >/dev/null 2>&1; then
        while read -r name type size model; do
            [[ "$type" == "disk" ]] || continue
            wf_disk_skip "$name" && continue
            wf_clean_v "$model"; model=${_WF_C:--}
            rows+=("$name $model · $size"); got=1
        done < <(LC_ALL=C lsblk -dno NAME,TYPE,SIZE,MODEL 2>/dev/null)
    fi
    if (( ! got )); then
        for d in /sys/block/*; do
            [[ -e "$d" ]] || continue
            name=${d##*/}
            wf_disk_skip "$name" && continue
            wu_read "$d/size" s || continue
            [[ "$s" =~ ^[0-9]+$ ]] && (( s > 0 )) || continue
            model=""
            wu_read "$d/device/model" model || wu_read "$d/device/name" model || model=""
            wf_clean_v "$model"; model=${_WF_C:--}
            wf_sect_human "$s"
            rows+=("$name $model · $_WF_H")
        done
    fi
    for (( d = 0; d < ${#rows[@]}; d++ )); do
        if (( first )); then wf_pushl disks wf_disks "${rows[d]}"; first=0
        else wf_push disks "" "${rows[d]}"; fi
    done
    return 0
}

# Connected DRM connectors -> _WF_MON_OUT[] / _WF_MON_MODE[] (any connector
# type: eDP, LVDS, DSI, DPI, Composite, VGA, Virtual, HDMI, DP, DVI...).
wf_drm_connected() {
    _WF_MON_OUT=() _WF_MON_MODE=()
    local d st mode
    for d in /sys/class/drm/card*-*; do
        wu_read "$d/status" st || continue
        [[ "$st" == connected ]] || continue
        mode=""
        wu_read "$d/modes" mode || mode=""
        _WF_MON_OUT+=("${d##*/}"); _WF_MON_MODE+=("$mode")
    done
    return 0
}

wf_xrandr_modes() {
    _WF_X_OUT=() _WF_X_MODE=()
    local line out geo w
    if command -v xrandr >/dev/null 2>&1 && [[ -n "${DISPLAY:-}" ]]; then
        while IFS= read -r line; do
            [[ "$line" == *" connected"* ]] || continue
            out=${line%% *}; geo=""
            for w in $line; do
                if [[ "$w" =~ ^([0-9]+x[0-9]+)\+ ]]; then geo=${BASH_REMATCH[1]}; break; fi
            done
            _WF_X_OUT+=("$out"); _WF_X_MODE+=("$geo")
        done < <(xrandr --query 2>/dev/null)
    fi
    if (( ${#_WF_X_OUT[@]} == 0 )) && command -v wlr-randr >/dev/null 2>&1; then
        out=""
        while IFS= read -r line; do
            case "$line" in
                [!\ ]*) out=${line%% *} ;;
                *current*) w=${line#"${line%%[! ]*}"}; w=${w%% *}; _WF_X_OUT+=("${out:-?}"); _WF_X_MODE+=("$w") ;;
            esac
        done < <(wlr-randr 2>/dev/null)
    fi
    return 0
}

wfv_monitors() {
    local i n
    local -a outs=() modes=()
    wf_drm_connected
    for (( i = 0; i < ${#_WF_MON_OUT[@]}; i++ )); do
        outs+=("${_WF_MON_OUT[i]}"); modes+=("${_WF_MON_MODE[i]:-?}")
    done
    if (( ${#outs[@]} == 0 )); then
        wf_xrandr_modes
        for (( i = 0; i < ${#_WF_X_OUT[@]}; i++ )); do
            outs+=("${_WF_X_OUT[i]}"); modes+=("${_WF_X_MODE[i]:-?}")
        done
    fi
    n=${#outs[@]}
    if (( n == 0 )); then wf_pushl monitors wf_monitors "-"; return 0; fi
    wf_pushl monitors wf_monitors "$n"
    for (( i = 0; i < n; i++ )); do
        wf_push monitors "" "${outs[i]} · ${modes[i]}"
    done
}

wfv_resolution() {
    local i r=""
    wf_drm_connected
    for (( i = 0; i < ${#_WF_MON_MODE[@]}; i++ )); do
        [[ -n "${_WF_MON_MODE[i]}" ]] && { r=${_WF_MON_MODE[i]}; break; }
    done
    if [[ -z "$r" ]]; then
        # Proprietary drivers often leave sysfs modes empty.
        wf_xrandr_modes
        for (( i = 0; i < ${#_WF_X_MODE[@]}; i++ )); do
            [[ -n "${_WF_X_MODE[i]}" ]] && { r=${_WF_X_MODE[i]}; break; }
        done
    fi
    wf_pushl resolution wf_resolution "${r:--}"
}

# F3: backlight brightness as percent; no row at all on desktops/headless.
wfv_backlight() {
    local bl max b
    for bl in /sys/class/backlight/*; do
        [[ -d "$bl" ]] || continue
        wu_read "$bl/max_brightness" max || continue
        wu_read "$bl/brightness" b || continue
        [[ "$max" =~ ^[0-9]+$ && "$b" =~ ^[0-9]+$ ]] || continue
        (( max > 0 )) || continue
        wf_pushl backlight wf_backlight "$(( b * 100 / max ))%"
    done
    return 0
}

wfv_audio() {
    local n=0 names="" line re='^[[:space:]]*[0-9]+[[:space:]]*\[([^]]*)\]'
    if [[ -r /proc/asound/cards ]]; then
        while IFS= read -r line; do
            [[ "$line" =~ $re ]] || continue
            wf_clean_v "${BASH_REMATCH[1]}"
            [[ -n "$_WF_C" ]] || continue
            n=$(( n + 1 ))
            names+="${names:+, }$_WF_C"
        done < /proc/asound/cards
    fi
    if (( n > 0 )); then wf_pushl audio wf_audio "$n: $names"
    else wf_pushl audio wf_audio "-"; fi
}

# wf_classify_v BCLASS PRODUCT MANUFACTURER -> $_WF_CLS
wf_classify_v() {
    local bclass="$1" hay="$2 $3"
    hay=${hay,,}
    case "$hay" in
        *xp-pen*|*wacom*|*huion*|*gaomon*|*drawing*|*graphics*|*pen*tablet*|*graphire*|*bamboo*|*intuos*|*cintiq*|*stylus*)
            _WF_CLS=tablet; return 0 ;;
        *touch*) _WF_CLS=touchscreen; return 0 ;;
        *keyboard*|*k63*|*k55*|*k70*|*typewriter*) _WF_CLS=keyboard; return 0 ;;
        *mouse*|*trackball*|*deathadder*|*razer*|*logitech*g*) _WF_CLS=mouse; return 0 ;;
        *gamepad*|*controller*|*xbox*|*dualshock*|*joystick*|*fightstick*|*nintendo*)
            _WF_CLS=gamepad; return 0 ;;
        *webcam*|*camera*|*cam*) _WF_CLS=webcam; return 0 ;;
        *headset*|*headphone*|*earphone*|*microphone*|*audio*|*mic*) _WF_CLS=audio; return 0 ;;
        *wlan*|*wireless*lan*|*wifi*|*wi-fi*|*802.11*|*ralink*|*mediatek*|*bluetooth*) _WF_CLS=network; return 0 ;;
        *storage*|*flash*|*disk*|*ssd*|*sata*|*hdd*) _WF_CLS=storage; return 0 ;;
        *printer*|*scanner*|*mfp*) _WF_CLS=printer; return 0 ;;
        *phone*|*huawei*|*honor*|*xiaomi*|*redmi*|*pixel*|*galaxy*|*samsung*|*nokia*|*oppo*|*vivo*|*oneplus*|*realme*|*android*|*mao-lx*)
            _WF_CLS=phone; return 0 ;;
    esac
    case "$bclass" in
        0e) _WF_CLS=webcam ;; 01|04) _WF_CLS=audio ;;
        08) _WF_CLS=storage ;; 07) _WF_CLS=printer ;;
        02) _WF_CLS=network ;; 03) _WF_CLS=hid ;;
        09) _WF_CLS=hub ;; ff) _WF_CLS=vendor ;;
        *)  _WF_CLS=device ;;
    esac
    return 0
}
wf_classify() { local _WF_CLS; wf_classify_v "$@"; printf '%s' "$_WF_CLS"; }

wf_ptype_key() {
    case "$1" in
        keyboard) _WF_PK=p_kbd ;; mouse) _WF_PK=p_mouse ;; touchscreen) _WF_PK=p_touch ;;
        stylus) _WF_PK=p_stylus ;; tablet) _WF_PK=p_tablet ;;
        gamepad)  _WF_PK=p_pad ;; audio) _WF_PK=p_audio ;; webcam) _WF_PK=p_cam ;;
        printer)  _WF_PK=p_print ;; storage) _WF_PK=p_store ;; network) _WF_PK=p_net ;;
        phone)    _WF_PK=p_phone ;; hub) _WF_PK=p_hub ;; hid) _WF_PK=p_hid ;;
        vendor)   _WF_PK=p_vend ;; *) _WF_PK=p_dev ;;
    esac
}
wf_ptype() { local _WF_PK; wf_ptype_key "$1"; t "$_WF_PK"; }

wf_picon() {
    case "$1" in
        keyboard) printf '⌨' ;; mouse) printf '🖱' ;; touchscreen) printf '👆' ;;
        stylus) printf '✏' ;; tablet) printf '🎨' ;;
        gamepad) printf '🎮' ;; audio) printf '🎧' ;; webcam) printf '📷' ;;
        printer) printf '🖨' ;; storage) printf '💾' ;; network) printf '📶' ;;
        phone) printf '📱' ;; hub) printf '🔌' ;; hid) printf '⚙' ;;
        *) printf '🔌' ;;
    esac
}

_WF_PORDER=(keyboard mouse touchscreen stylus tablet gamepad audio webcam printer storage network phone hid vendor device)

# Index of a peripheral type in _WF_PORDER into $_WF_PI (no subshell).
wfv_pindex() {
    local i
    for (( i = 0; i < ${#_WF_PORDER[@]}; i++ )); do
        if [[ "${_WF_PORDER[i]}" == "$1" ]]; then _WF_PI=$i; return 0; fi
    done
    _WF_PI=$(( ${#_WF_PORDER[@]} - 1 ))
}

# Add NAME under TYPE unless already listed. Names are US-separated
# (a USB product string may legitimately contain commas).
wf_padd() {
    wfv_pindex "$1"
    case "${_WF_P[_WF_PI]:-}$_WU_US" in *"$_WU_US$2$_WU_US"*) return 0 ;; esac
    _WF_P[_WF_PI]+="$_WU_US$2"
}

wfv_peripherals() {
    local devdir base bclass prod mfg name sdesc evline evname="" evskip="" hay type
    _WF_P=()

    # ── USB devices (primary source) ──────────────────────────
    for devdir in /sys/bus/usb/devices/*; do
        [[ -r "$devdir/idVendor" ]] || continue
        base=${devdir##*/}
        [[ "$base" == usb[0-9]* ]] && continue
        wu_read "$devdir/bDeviceClass" bclass || bclass=""
        [[ "$bclass" == "09" ]] && continue
        wu_read "$devdir/product" prod || prod=""
        wu_read "$devdir/manufacturer" mfg || mfg=""
        wf_clean_v "$prod"; prod=$_WF_C
        wf_clean_v "$mfg"; mfg=$_WF_C
        name=${prod:-$mfg}
        [[ -n "$name" ]] || continue
        wf_classify_v "$bclass" "$prod" "$mfg"
        wf_padd "$_WF_CLS" "$name"
    done

    # ── PS/2 keyboards and mice ───────────────────────────────
    for devdir in /sys/bus/serio/devices/*; do
        wu_read "$devdir/description" sdesc || continue
        case "$sdesc" in
            *keyboard*|*kbd*) type="keyboard" ;;
            *mouse*|*pointing*) type="mouse" ;;
            *) continue ;;
        esac
        wf_clean_v "$sdesc"; name=${_WF_C:-PS/2 $type}
        wf_padd "$type" "$name"
    done

    # ── evdev input devices (touchscreens, styluses, tablets) ─
    if [[ -r /proc/bus/input/devices ]]; then
        while IFS= read -r evline; do
            case "$evline" in
                N:\ *)
                    evname=${evline#*Name=}; evname=${evname//\"/}
                    wf_clean_v "$evname"; evname=$_WF_C
                    evskip="" ;;
                P:\ *)
                    # skip USB devices -- already detected via /sys/bus/usb
                    case "${evline#*Phys=}" in usb-*) evskip=1 ;; esac ;;
                H:\ *Handlers=*)
                    if [[ "$evskip" == "1" || -z "$evname" ]]; then evname=""; continue; fi
                    hay=${evname,,}
                    type=""
                    case "$hay" in
                        *sensor*|*accel*|*gyro*) type="" ;;  # internal sensors
                        *touch*) type="touchscreen" ;;
                        *stylus*|*pen*|*wacom*|*huion*|*xp-pen*|*gaomon*|*digitizer*) type="stylus" ;;
                        *tablet*|*graphics*|*intuos*|*cintiq*|*bamboo*) type="tablet" ;;
                        *joystick*|*gamepad*|*controller*|*xbox*|*ps3*|*ps4*|*ps5*|*nintendo*) type="gamepad" ;;
                        *keyboard*|*kbd*) type="keyboard" ;;
                        *mouse*|*trackball*) type="mouse" ;;
                    esac
                    [[ -n "$type" ]] && wf_padd "$type" "$evname"
                    evname=""
                    ;;
            esac
        done < /proc/bus/input/devices
    fi

    # ── Bluetooth input devices ────────────────────────────────
    for devdir in /sys/bus/bluetooth/devices/*; do
        wu_read "$devdir/name" name || continue
        wf_clean_v "$name"; name=$_WF_C
        [[ -n "$name" ]] || continue
        hay=${name,,}
        type="device"
        case "$hay" in
            *keyboard*|*kbd*) type="keyboard" ;;
            *mouse*|*trackball*) type="mouse" ;;
            *controller*|*gamepad*|*xbox*|*dualshock*) type="gamepad" ;;
            *headphone*|*headset*|*buds*|*earphone*|*speaker*|*audio*) type="audio" ;;
            *pen*|*stylus*|*tablet*) type="tablet" ;;
            *printer*) type="printer" ;;
        esac
        wf_padd "$type" "$name"
    done

    local i count=0 seps names
    local -a rows=()
    for (( i = 0; i < ${#_WF_PORDER[@]}; i++ )); do
        [[ -n "${_WF_P[i]:-}" ]] || continue
        rows+=("$i")
        seps=${_WF_P[i]//[!$_WU_US]/}
        count=$(( count + ${#seps} ))
    done
    if (( ${#rows[@]} == 0 )); then
        wf_pushl peripherals wf_peripherals "-"
        return 0
    fi
    wf_pushl peripherals wf_peripherals "$count"
    for i in "${rows[@]}"; do
        names=${_WF_P[i]#"$_WU_US"}
        names=${names//$_WU_US/, }
        wf_icon_v "$(wf_picon "${_WF_PORDER[i]}")" raw
        wf_ptype_key "${_WF_PORDER[i]}"; wf_tv "$_WF_PK"
        wf_push peripherals "" "${_WF_IC}${_WF_T}: $names"
    done
}

# Count lines starting with PREFIX in FILE (one grep, busybox-safe).
wf_count_prefix() {
    local c
    c=$(grep -c -- "$2" "$1" 2>/dev/null) || c=0
    [[ "$c" =~ ^[0-9]+$ ]] || c=0
    _WF_N=$c
}

wfv_packages() {
    local -a parts=() g=()
    local f d n joined="" p
    shopt -s nullglob
    # pacman: one directory per package (no `pacman -Q` fork)
    if [[ -d /var/lib/pacman/local ]]; then
        g=(/var/lib/pacman/local/*/)
        (( ${#g[@]} )) && parts+=("${#g[@]} pacman")
    fi
    # dpkg (Debian/Ubuntu, Termux under $PREFIX)
    for f in /var/lib/dpkg/status "${PREFIX:-/nonexistent}/var/lib/dpkg/status"; do
        [[ -r "$f" ]] || continue
        wf_count_prefix "$f" '^Status: [a-z]* ok installed$'
        (( _WF_N )) && { parts+=("$_WF_N dpkg"); break; }
    done
    if [[ -r /lib/apk/db/installed ]]; then
        wf_count_prefix /lib/apk/db/installed '^P:'
        (( _WF_N )) && parts+=("$_WF_N apk")
    fi
    if command -v xbps-query >/dev/null 2>&1; then
        n=$(xbps-query -l 2>/dev/null | wc -l); n=${n// /}
        [[ "$n" =~ ^[1-9][0-9]*$ ]] && parts+=("$n xbps")
    fi
    # rpm only where an rpm database actually exists (Debian ships the
    # binary without packages; rpm -qa is also the slowest query here).
    if command -v rpm >/dev/null 2>&1 && [[ -d /var/lib/rpm || -d /usr/lib/sysimage/rpm ]]; then
        n=$(rpm -qa 2>/dev/null | wc -l); n=${n// /}
        [[ "$n" =~ ^[1-9][0-9]*$ ]] && parts+=("$n rpm")
    fi
    # Gentoo: /var/db/pkg/<category>/<package>/
    if [[ -d /var/db/pkg ]]; then
        g=(/var/db/pkg/*/*/)
        (( ${#g[@]} )) && parts+=("${#g[@]} emerge")
    fi
    for f in /usr/lib/opkg/status /var/lib/opkg/status; do
        [[ -r "$f" ]] || continue
        wf_count_prefix "$f" '^Package:'
        (( _WF_N )) && { parts+=("$_WF_N opkg"); break; }
    done
    if command -v nix-store >/dev/null 2>&1; then
        for d in /run/current-system "${HOME:-/nonexistent}/.nix-profile"; do
            [[ -e "$d" ]] || continue
            n=$(nix-store -qR "$d" 2>/dev/null | wc -l); n=${n// /}
            [[ "$n" =~ ^[1-9][0-9]*$ ]] && parts+=("$n nix")
        done
    fi
    # flatpak: <root>/{app,runtime}/<id>/<arch>/<branch>/active (skip the
    # "current" alias), system + user installations.
    n=0
    for d in /var/lib/flatpak "${HOME:-/nonexistent}/.local/share/flatpak"; do
        [[ -d "$d" ]] || continue
        g=("$d"/app/*/*/*/active "$d"/runtime/*/*/*/active)
        for p in ${g[@]+"${g[@]}"}; do
            [[ "$p" == */current/* ]] || n=$(( n + 1 ))
        done
    done
    (( n )) && parts+=("$n flatpak")
    if [[ -d /snap ]]; then
        g=(/snap/*/current)
        (( ${#g[@]} )) && parts+=("${#g[@]} snap")
    fi
    shopt -u nullglob
    for p in ${parts[@]+"${parts[@]}"}; do
        joined+="${joined:+, }$p"
    done
    wf_pushl packages wf_packages "${joined:--}"
}

wfv_locale() { wf_pushl locale wf_locale "${LC_ALL:-${LANG:--}}"; }

wfv_date() {
    local v=""
    if command -v date >/dev/null 2>&1; then
        if [[ "${WELLUTILS_LANG:-EN}" == "EN" ]]; then
            v=$(LC_ALL=C date '+%A %d %B %Y %H:%M' 2>/dev/null)
        else
            v=$(date '+%A %d %B %Y %H:%M' 2>/dev/null)
        fi
    fi
    wf_pushl date wf_date "${v:--}"
}

wfv_battery() {
    local bat_dir cap status icon
    while IFS= read -r bat_dir; do
        [[ -n "$bat_dir" ]] || continue
        wu_read "$bat_dir/capacity" cap || continue
        [[ "$cap" =~ ^[0-9]+$ ]] || continue
        wu_read "$bat_dir/status" status || status=""
        case "$status" in
            Charging) icon=$(_emu '🔌') ;;
            Full)     icon=$(_emu '🔋') ;;
            *)        icon=$(_emu '🪫') ;;
        esac
        wf_pushl battery wf_battery "${icon:+$icon }${cap}%${status:+ ($status)}"
        return 0
    done < <(wu_batteries 2>/dev/null)
    return 0
}

wf_custom() { :; }

# --- collection ---------------------------------------------------------------

# Default set: essentials only -- user@host, system, kernel, uptime, cpu,
# gpu, memory, screen, storage, brightness. Everything else stays available
# via --all/--full.
WF_SECTIONS="user os kernel uptime cpu gpu mem resolution disks backlight"
WF_ALL_SECTIONS="user os kernel uptime shell desktop wm terminal theme icons font cpu gpu mem swap disk disks monitors packages locale audio resolution peripherals battery date backlight"

wf_collect() {
    WF_SECS=() WF_LABELS=() WF_VALUES=()
    local sec vname line
    for sec in $WF_SECTIONS; do
        vname="WF_VALUE_${sec}"
        if [[ -n "${!vname:-}" ]]; then
            wf_pushl "$sec" "wf_$sec" "${!vname}"
        elif declare -F "wfv_${sec}" >/dev/null; then
            "wfv_${sec}"
        fi
    done
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        wf_push custom "${line%%|*}" "${line#*|}"
    done < <(wf_custom 2>/dev/null)
    return 0
}

# --- logo ---------------------------------------------------------------------

# Count lines of $WF_LOGO_LINES into WF_LOGO_ROWS (no wc).
_wf_count_rows() {
    local l
    WF_LOGO_ROWS=0
    [[ -n "$WF_LOGO_LINES" ]] || return 0
    while IFS= read -r l; do WF_LOGO_ROWS=$(( WF_LOGO_ROWS + 1 )); done <<< "$WF_LOGO_LINES"
}

# Distro ASCII art (plain text, no colour needed).
wf_distro_lines() {
    WF_LOGO_LINES="" WF_LOGO_ROWS=0
    if ! declare -F wf_distro_art >/dev/null; then
        [[ -f "$_WU_BOOT_DIR/distro_art.sh" ]] || return 0
        # shellcheck source=/dev/null
        source "$_WU_BOOT_DIR/distro_art.sh" || return 0
    fi
    WF_LOGO_LINES=$(wf_distro_art 2>/dev/null) || WF_LOGO_LINES=""
    _wf_count_rows
}

# PNG logo rendered as truecolour half-blocks (needs colour + python3).
wf_logo_lines() {
    local art="$1" lw="$2"
    WF_LOGO_LINES="" WF_LOGO_ROWS=0
    [[ -f "$art" && -f "$WF_LOGO" ]] || return 0
    command -v python3 >/dev/null 2>&1 || return 0
    local cache_dir="${WF_CACHE_DIR:-${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}/wellutils}"
    local key
    key=$(cat "$WF_LOGO" "$art" 2>/dev/null | cksum 2>/dev/null) || key=""
    key=${key// /-}
    local cached="$cache_dir/logo-${lw}-${WF_KEY:-40}-${WF_BG:-x}-${key:-0}"
    cached=${cached//,/_}
    if [[ -n "$key" && -f "$cached" ]]; then
        WF_LOGO_LINES=$(<"$cached")
    else
        local -a cmd=(python3 "$art" "$WF_LOGO" --width "$lw" --key "${WF_KEY:-40}")
        [[ -n "${WF_BG:-}" ]] && cmd+=(--bg "$WF_BG")
        WF_LOGO_LINES=$("${cmd[@]}" 2>/dev/null) || WF_LOGO_LINES=""
        if [[ -n "$WF_LOGO_LINES" && -n "$key" ]]; then
            mkdir -p "$cache_dir" 2>/dev/null && printf '%s\n' "$WF_LOGO_LINES" > "$cached" 2>/dev/null
        fi
    fi
    _wf_trim_logo
}

# Trim transparent rows around the logo (keep horizontal offset).
_wf_trim_logo() {
    local -a arr=()
    local line i start=-1 end=-1 kept="" _WU_SA
    [[ -n "$WF_LOGO_LINES" ]] || { WF_LOGO_ROWS=0; return 0; }
    while IFS= read -r line; do arr+=("$line"); done <<< "$WF_LOGO_LINES"
    for (( i = 0; i < ${#arr[@]}; i++ )); do
        _wu_strip_ansi "${arr[i]}"
        if [[ "$_WU_SA" == *[![:space:]]* ]]; then
            (( start < 0 )) && start=$i
            end=$i
        fi
    done
    if (( start < 0 )); then WF_LOGO_LINES=""; WF_LOGO_ROWS=0; return 0; fi
    for (( i = start; i <= end; i++ )); do kept+="${arr[i]}"$'\n'; done
    WF_LOGO_LINES="${kept%$'\n'}"
    WF_LOGO_ROWS=$(( end - start + 1 ))
}

wf_info_line() {
    printf '%s%s:%s %s' "${C}${1}" "${RESET}" "${RESET}" "$2"
}

# --- compact row layout ------------------------------------------------------
# Every section becomes a single row: "label: value" followed by
# indented continuation lines for multi-line sections (CPU, GPUs, disks…).
# The logo is drawn on the left, info column height matches the logo.

WF_RTYPE=() WF_RTEXT=() WF_RSUBS=() WF_RITEM=()

wf_build_rows() {
    WF_RTYPE=() WF_RTEXT=() WF_RSUBS=() WF_RITEM=()
    local i n=${#WF_LABELS[@]} j subs
    for (( i = 0; i < n; i++ )); do
        [[ -n "${WF_LABELS[i]}" ]] || continue
        wf_icon_v "${WF_SECS[i]}"
        subs=""
        for (( j = i + 1; j < n; j++ )); do
            [[ -z "${WF_LABELS[j]}" ]] || break
            subs+="${WF_VALUES[j]}"$'\n'
        done
        WF_RTYPE+=(block)
        WF_RTEXT+=("${_WF_IC}${C}${WF_LABELS[i]}${RESET}:${RESET} ${WF_VALUES[i]}")
        WF_RSUBS+=("${subs%$'\n'}")
        WF_RITEM+=(1)
        i=$(( j - 1 ))
    done
}

# Flatten rows into WF_INFO_LINES[] and measure each once (WF_INFO_W[]).
wf_collect_info_lines() {
    WF_INFO_LINES=() WF_INFO_W=() WF_INFO_MAXW=0
    local i sub _WU_VL
    for (( i = 0; i < ${#WF_RTYPE[@]}; i++ )); do
        WF_INFO_LINES+=("${WF_RTEXT[i]}")
        if [[ "${WF_RTYPE[i]}" == "block" && -n "${WF_RSUBS[i]}" ]]; then
            while IFS= read -r sub; do
                [[ -n "$sub" ]] && WF_INFO_LINES+=("      $sub")
            done <<< "${WF_RSUBS[i]}"
        fi
    done
    for (( i = 0; i < ${#WF_INFO_LINES[@]}; i++ )); do
        _wu_vislen_v "${WF_INFO_LINES[i]}"
        WF_INFO_W+=("$_WU_VL")
        (( _WU_VL > WF_INFO_MAXW )) && WF_INFO_MAXW=$_WU_VL
    done
    return 0
}

wf_print_plain() {
    local i
    wf_collect_info_lines
    for (( i = 0; i < ${#WF_INFO_LINES[@]}; i++ )); do
        printf '%s\n' "${WF_INFO_LINES[i]}"
    done
}

wf_strip_ansi() { local _WU_SA; _wu_strip_ansi "$1"; printf '%s' "$_WU_SA"; }

# --- JSON output -----------------------------------------------------------
# Reuse wf_collect: sections become { section, label, value, subs[] } blocks
# with the same grouping as wf_build_rows (subs = following unlabelled rows).
wf_json_out() {
    wu_json_head "$_WU_TOOLNAME" "$_WU_VERSION"
    printf ',\n  "sections": ['
    local first=1 i n=${#WF_LABELS[@]} j sfirst
    for (( i = 0; i < n; i++ )); do
        [[ -n "${WF_LABELS[i]}" ]] || continue
        if (( first )); then first=0; printf '\n'; else printf ',\n'; fi
        printf '    { "section": "%s", "label": "%s", "value": "%s", "subs": [' \
            "$(json_esc "${WF_SECS[i]}")" "$(json_esc "${WF_LABELS[i]}")" "$(json_esc "${WF_VALUES[i]}")"
        sfirst=1
        for (( j = i + 1; j < n; j++ )); do
            [[ -z "${WF_LABELS[j]}" ]] || break
            [[ -n "${WF_VALUES[j]}" ]] || continue
            if (( sfirst )); then sfirst=0; else printf ','; fi
            printf ' "%s"' "$(json_esc "${WF_VALUES[j]}")"
        done
        printf ' ] }'
        i=$(( j - 1 ))
    done
    printf '\n  ]'
    wu_json_end
}

# Frame around the info column only (no logo / logo does not fit).
wf_print_framed() {
    local inner i maxin _WU_COLS
    _wu_cols
    inner=$(( WF_INFO_MAXW + 2 ))
    maxin=$(( _WU_COLS - 4 ))
    (( inner > maxin )) && inner=$maxin
    (( inner < 28 )) && inner=28
    box_top '◆' "wellfetch v${_WU_VERSION}" "$inner"
    for (( i = 0; i < ${#WF_INFO_LINES[@]}; i++ )); do
        box_row " ${WF_INFO_LINES[i]}" "$inner"
    done
    box_bottom "$inner"
}

wf_footer() {
    local d=""
    printf -v d '%(%Y-%m-%d %H:%M:%S)T' -1 2>/dev/null || d=$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null)
    printf '\n  %sWellFetch v%s | %s%s\n\n' "$DIM" "$_WU_VERSION" "$d" "$RESET"
}

main() {
    wf_collect
    if [[ "$_WU_JSON" == "1" ]]; then wf_json_out; return 0; fi

    wf_build_rows
    (( ${#WF_RTYPE[@]} < 1 )) && return 0

    if [[ "$_WU_PLAIN" == "1" ]]; then
        wf_print_plain
        return 0
    fi

    wf_collect_info_lines
    local info_w=$WF_INFO_MAXW total=${#WF_INFO_LINES[@]}
    local cols gap=4 avail lw rows maxr i _WU_VL _WU_SA _WU_COLS
    _wu_cols; cols=$_WU_COLS
    # frame budget: indent 2 + borders 2 + one space padding on each side
    avail=$(( cols - 6 - info_w - gap ))

    if [[ "$_WF_LOGO" -eq 0 ]]; then
        wf_print_framed; wf_footer; return 0
    fi

    # resolve logo + art paths
    local libdir="${_WU_LIBDIR:-$_WU_BOOT_DIR}" art=""
    WF_LOGO="${WF_LOGO:-$libdir/logo.png}"
    [[ -f "$WF_LOGO" ]] || WF_LOGO="/usr/local/share/wellutils/logo.png"
    [[ -f "$WF_LOGO" ]] || WF_LOGO="/usr/share/wellutils/logo.png"
    art="$libdir/wfetch_art.py"
    [[ -f "$art" ]] || art="/usr/local/share/wellutils/wfetch_art.py"
    [[ -f "$art" ]] || art="/usr/share/wellutils/wfetch_art.py"

    # native image support (kitty/iTerm2) beats ASCII half-blocks
    local gfx=""
    if [[ "$_WU_COLOR_ON" == 1 && "${_WU_TTY:-0}" == 1 ]] && command -v python3 >/dev/null 2>&1; then
        if [[ -z "${WF_GFX:-}" || "${WF_GFX:-}" == "auto" ]]; then
            case "${TERM:-}" in xterm-kitty) gfx="kitty" ;; esac
            case "${TERM_PROGRAM:-}" in
                WezTerm|ghostty|konsole) gfx="kitty" ;;
                iTerm.app|mintty)        gfx="iterm" ;;
            esac
            [[ -n "${ITERM_PROFILE:-}" ]] && gfx="iterm"
        fi
        case "${WF_GFX:-}" in
            off|none) gfx="" ;;
            auto|"")  : ;;
            *)        gfx="$WF_GFX" ;;
        esac
    fi

    # A native image protocol wins over any text art (as before).
    if [[ -n "$gfx" && -f "$art" && -f "$WF_LOGO" ]]; then
        if (( _WF_LWIDTH > 0 )); then lw=$_WF_LWIDTH; else lw=$(( avail / 2 )); fi
        (( lw > cols / 2 )) && lw=$(( cols / 2 ))
        if (( lw >= 8 )); then
            python3 "$art" "$WF_LOGO" --width "$lw" --key "${WF_KEY:-40}" --gfx "$gfx" 2>/dev/null
        fi
        wf_print_framed; wf_footer; return 0
    fi

    WF_LOGO_LINES="" WF_LOGO_ROWS=0
    local png=$_WF_PNG
    if (( _WF_PNG == 0 )); then
        wf_distro_lines
        (( WF_LOGO_ROWS > 0 )) || png=1
    fi

    if (( png )); then
        WF_LOGO_LINES="" WF_LOGO_ROWS=0
        if [[ "$_WU_COLOR_ON" == 1 ]]; then
            if (( _WF_LWIDTH > 0 )); then
                lw=$_WF_LWIDTH
            else
                # the logo takes about half the space left by the info column
                lw=$(( avail / 2 ))
                (( lw > cols / 2 )) && lw=$(( cols / 2 ))
            fi
            if (( lw >= 8 && lw <= avail )); then
                wf_logo_lines "$art" "$lw"
                # re-render at the visible width so the frame hugs the logo
                local wv=0 line_ lead trail tmp
                while IFS= read -r line_; do
                    _wu_strip_ansi "$line_"
                    tmp=${_WU_SA%%[! ]*}; lead=${#tmp}
                    tmp=${_WU_SA##*[! ]}; trail=${#tmp}
                    _wu_vislen_v "$line_"
                    (( _WU_VL - lead - trail > wv )) && wv=$(( _WU_VL - lead - trail ))
                done <<< "$WF_LOGO_LINES"
                if (( _WF_LWIDTH == 0 && wv > 0 && wv + 2 < lw )); then
                    wf_logo_lines "$art" "$(( wv + 2 ))"
                fi
            fi
        fi
    fi

    rows=$WF_LOGO_ROWS
    local -a logo_arr=() logo_w=()
    local artw=0 line
    if (( rows > 0 )); then
        while IFS= read -r line; do
            logo_arr+=("$line")
            _wu_vislen_v "$line"; logo_w+=("$_WU_VL")
            (( _WU_VL > artw )) && artw=$_WU_VL
        done <<< "$WF_LOGO_LINES"
        rows=${#logo_arr[@]}
    fi
    # Narrow terminal: logo + info must fit inside the frame, else drop it.
    if (( rows == 0 || artw + gap + info_w + 6 > cols )); then
        wf_print_framed; wf_footer; return 0
    fi

    local inner left right pad sp
    inner=$(( artw + gap + info_w + 2 ))
    printf -v sp '%*s' "$gap" ''
    maxr=$(( rows > total ? rows : total ))
    box_top '◆' "wellfetch v${_WU_VERSION}" "$inner"
    for (( i = 0; i < maxr; i++ )); do
        if (( i < rows )); then
            printf -v pad '%*s' $(( artw - logo_w[i] )) ''
            left="${logo_arr[i]}${RESET}${pad}"
        else
            printf -v left '%*s' "$artw" ''
        fi
        if (( i < total )); then
            printf -v pad '%*s' $(( info_w - WF_INFO_W[i] )) ''
            right="${WF_INFO_LINES[i]}${RESET}${pad}"
        else
            printf -v right '%*s' "$info_w" ''
        fi
        box_row " ${left}${sp}${right}" "$inner"
    done
    box_bottom "$inner"
    wf_footer
    return 0
}

# config override (function redefinitions or WF_VALUE_<sec>= overrides)
if [[ -n "${WELLFETCH_CONFIG:-}" ]]; then
    [[ -f "$WELLFETCH_CONFIG" ]] && . "$WELLFETCH_CONFIG"
elif [[ -f "${XDG_CONFIG_HOME:-${HOME:-/tmp}/.config}/wellutils/wellfetch.conf" ]]; then
    . "${XDG_CONFIG_HOME:-${HOME:-/tmp}/.config}/wellutils/wellfetch.conf"
fi

wu_run main "$@"
exit $?
