#!/usr/bin/env bash
# wellutils -- launcher for wellutils system utility kit
# Usage: wellutils [global options] <command> [args]
#        wellutils --lang RU|EN    -- set language persistently
#        wellutils --help          -- show help

# Must run before anything bash-4-only is parsed (macOS ships bash 3.2).
if [ -z "${BASH_VERSINFO:-}" ] || [ "${BASH_VERSINFO[0]}" -lt 4 ]; then
    echo "wellutils: bash >= 4.0 required, found ${BASH_VERSION:-none}." >&2
    echo "wellutils: this is a Linux tool suite (reads /proc and /sys); on macOS it is not supported." >&2
    exit 1
fi
set -euo pipefail

_wu_self="$0"
_wu_real="$(readlink -f -- "$_wu_self" 2>/dev/null || true)"
[[ -n "$_wu_real" ]] || _wu_real="$_wu_self"
_WU_DIR="$(cd -- "$(dirname -- "$_wu_real")" 2>/dev/null && pwd || dirname -- "$_wu_real")"
# No HOME and no XDG_CONFIG_HOME: there is no per-user place to save the
# preference (writing it to a shared /tmp would leak into other users).
_WU_LANG_FILE=""
if [[ -n "${XDG_CONFIG_HOME:-}" ]]; then _WU_LANG_FILE="$XDG_CONFIG_HOME/wellutils/lang.conf"
elif [[ -n "${HOME:-}" ]]; then _WU_LANG_FILE="$HOME/.config/wellutils/lang.conf"; fi

# ─── Shared libs (own dir first, then ../share/wellutils, then system) ──
_WU_BOOT_DIR="$_WU_DIR"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="$(dirname -- "$_WU_DIR")/share/wellutils"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="/usr/local/share/wellutils"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="/usr/share/wellutils"
if [[ ! -f "$_WU_BOOT_DIR/bootstrap.sh" ]]; then
    echo "wellutils: cannot find the shared libraries (bootstrap.sh); reinstall wellutils" >&2
    exit 1
fi
source "$_WU_BOOT_DIR/bootstrap.sh" lang box

_WU_VERSION=""
if [[ -r "$_WU_BOOT_DIR/VERSION" ]]; then
    IFS= read -r _WU_VERSION < "$_WU_BOOT_DIR/VERSION" || true
    _WU_VERSION="${_WU_VERSION//[[:space:]]/}"
fi
[[ -n "$_WU_VERSION" ]] || _WU_VERSION="1.4.0"

# no escape codes when piped or when NO_COLOR is set
if [[ ! -t 1 || -n "${NO_COLOR:-}" || "${TERM:-}" == "dumb" ]]; then
    R="" G="" Y="" B="" M="" C="" W="" DIM="" BOLD="" RESET=""
fi

show_help() {
    local ttl pad
    ttl="🛠  wellutils -- $(t launcher_title)"
    pad=$(( 54 - $(vislen "$ttl") - 1 ))      # box inner is 54 cells
    (( pad < 1 )) && pad=1
    printf '\n'
    printf '  %s╔══════════════════════════════════════════════════════╗%s\n' "$C" "$RESET"
    printf '  %s║%s%s  %s%*s%s%s║%s\n' "$C" "$RESET" "${BOLD}${W}" "$ttl" "$pad" '' "$RESET" "$C" "$RESET"
    printf '  %s╚══════════════════════════════════════════════════════╝%s\n' "$C" "$RESET"
    printf '\n'
    printf '  %s%s:%s\n' "$BOLD" "$(t launcher_usage)" "$RESET"
    printf '    wellutils <command>              %s\n' "$(t launcher_run)"
    printf '    wellutils --lang RU|EN          %s\n' "$(t launcher_set_lang)"
    printf '    wellutils --help                %s\n' "$(t launcher_help)"
    printf '    wellutils --version             %s\n' "$(t launcher_version)"
    printf '\n'
    printf '  %s%s:%s\n' "$BOLD" "$(t launcher_commands)" "$RESET"
    printf '    %susb%s       -- %s\n' "$G" "$RESET" "$(t cmd_usb)"
    printf '    %spci%s       -- %s\n' "$G" "$RESET" "$(t cmd_pci)"
    printf '    %sblock%s     -- %s\n' "$G" "$RESET" "$(t cmd_block)"
    printf '    %smem%s       -- %s\n' "$G" "$RESET" "$(t cmd_mem)"
    printf '    %smod%s       -- %s\n' "$G" "$RESET" "$(t cmd_mod)"
    printf '    %ssensors%s   -- %s\n' "$G" "$RESET" "$(t cmd_sensors)"
    printf '    %shw%s         -- %s\n' "$G" "$RESET" "$(t cmd_hw)"
    printf '    %sper%s        -- %s\n' "$G" "$RESET" "$(t cmd_per)"
    printf '    %sgpu%s        -- %s\n' "$G" "$RESET" "$(t cmd_gpu)"
    printf '    %scpu%s        -- %s\n' "$G" "$RESET" "$(t cmd_cpu)"
    printf '    %sfetch%s      -- %s\n' "$G" "$RESET" "$(t cmd_fetch)"
    printf '    %sup%s         -- %s\n' "$G" "$RESET" "$(t cmd_up)"
    printf '    %snet%s        -- %s\n' "$G" "$RESET" "$(t cmd_net)"
    printf '    %spower%s      -- %s\n' "$G" "$RESET" "$(t cmd_power)"
    printf '    %sdoctor%s     -- %s\n' "$G" "$RESET" "$(t cmd_doctor)"
    printf '    %swhtml%s      -- %s\n' "$G" "$RESET" "$(t cmd_report)"
    printf '    %sself-update%s  -- %s\n' "$G" "$RESET" "$(t cmd_selfupdate)"
    printf '\n'
    printf '  %s%s:%s\n' "$BOLD" "$(t launcher_options)" "$RESET"
    printf '    %s--plain%s / %s--color auto|always|never%s  %s\n' "$G" "$RESET" "$G" "$RESET" "$(t opt_plain_color)"
    printf '    %s--short%s  %s\n' "$G" "$RESET" "$(t opt_short)"
    printf '    %s--html%s   %s\n' "$G" "$RESET" "$(t opt_html)"
    printf '    %s--json%s   %s\n' "$G" "$RESET" "$(t opt_json)"
    printf '    %s--all%s / %s--full%s / %s--no-logo%s        %s\n' "$G" "$RESET" "$G" "$RESET" "$G" "$RESET" "$(t opt_more)"
    printf '    %s--<option>%s               %s\n' "$G" "$RESET" "$(t opt_passthru)"
    printf '    %s--help%s                   %s\n' "$G" "$RESET" "$(t launcher_help)"
    printf '\n'
    printf '  %s%s:%s  usb=wellusb  wusb=wellusb  pci=wellpci  wpci=wellpci\n' "$DIM" "$(t launcher_aliases)" "$RESET"
    printf '                block=wellblock  wblock=wellblock  mem=wmem=wellmem\n'
    printf '                ram=wram=wellram=wellmem  mod=wellmod\n'
    printf '                wsensors=wellsensors  wtemp=wellsensors  hw=wellhw\n'
    printf '                whw=wellhw  per=wellper  wper=wellper  gpu=wellgpu\n'
    printf '                wgpu=wellgpu  cpu=wellcpu  wcpu=wellcpu  fetch=wellfetch\n'
    printf '                up=wellup  wup=wellup  net=wellnet  wnet=wellnet\n'
    printf '                power=wellpower  wpower=wellpower  wbatt=wellpower\n'
    printf '                doctor=welldoctor  wdoc=welldoctor  wdoctor=welldoctor\n'
    printf '                html=whtml  report=whtml  whtml=whtml\n'
    printf '\n'
    printf '  %s%s:%s %s%s%s\n\n' "$DIM" "$(t launcher_current_lang)" "$RESET" "$BOLD" "$WELLUTILS_LANG" "$RESET"
}

set_lang() {
    local lang
    lang=$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')
    case "$lang" in
        RU|EN|ENG)
            [[ "$lang" == "ENG" ]] && lang="EN"
            if [[ -z "$_WU_LANG_FILE" ]]; then
                printf '  %s%s:%s %s\n\n' "$R" "$(t launcher_error)" "$RESET" "$(t launcher_no_home)" >&2
                exit 1
            fi
            if ! { mkdir -p "${_WU_LANG_FILE%/*}" && printf '%s\n' "$lang" > "$_WU_LANG_FILE"; } 2>/dev/null; then
                printf '  %s%s:%s %s %s\n\n' "$R" "$(t launcher_error)" "$RESET" "$(t launcher_lang_write_fail)" "$_WU_LANG_FILE" >&2
                exit 1
            fi
            printf '  %s%s:%s %s%s%s\n\n' "$G" "$(t launcher_set_lang_done)" "$RESET" "$BOLD" "$lang" "$RESET"
            ;;
        *)
            printf '  %s%s:%s %s\n\n' "$R" "$(t launcher_error)" "$RESET" "$(t launcher_error_lang "$lang")"
            exit 1
            ;;
    esac
}

# ─── Parse args ─────────────────────────────────────────────────
# Global output flags may precede the command (`wellutils --json mem`);
# they are forwarded to the tool. Any other --option before the command
# (e.g. `wellutils --all fetch`) is passed through to the tool as-is, after
# the global flags. `--lang X` without a command stays the legacy "set
# language persistently" action.
CMD=""
FWD=()
PASS=()
LANG_ARG=""
WANT_HELP=0
WANT_VERSION=0

_wu_norm_lang() {
    local l
    l=$(printf '%s' "$1" | LC_ALL=C tr '[:lower:]' '[:upper:]')
    [[ "$l" == "ENG" ]] && l="EN"
    printf '%s' "$l"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --lang|-l)
            [[ $# -lt 2 || "$2" == -* ]] && { printf '  %s%s:%s --lang %s\n' "$R" "$(t launcher_error)" "$RESET" "$(t launcher_set_lang)"; exit 1; }
            LANG_ARG="$(_wu_norm_lang "$2")"; shift 2; continue ;;
        --lang=*)
            LANG_ARG="$(_wu_norm_lang "${1#*=}")"; shift; continue ;;
        --color)
            [[ $# -ge 2 ]] || { printf 'wellutils: --color needs always|auto|never\n' >&2; exit 2; }
            FWD+=("$1" "$2"); shift 2; continue ;;
        --color=*|--plain|--box|--json|--short|--html|--no-emoji|--emoji|--debug)
            FWD+=("$1"); shift; continue ;;
        --help|-h)    WANT_HELP=1; shift; continue ;;
        --version|-V) WANT_VERSION=1; shift; continue ;;
        -?*)          PASS+=("$1"); shift; continue ;;
        usb|wellusb|wusb)          CMD="wellusb" ;;
        pci|wellpci|wpci)          CMD="wellpci" ;;
        block|wellblock|wblock)    CMD="wellblock" ;;
        mem|wellmem|wmem|ram|wellram|wram) CMD="wellmem" ;;
        mod|wellmod|wmod)          CMD="wellmod" ;;
        sensors|wellsensors|wsensors|wtemp) CMD="wellsensors" ;;
        hw|wellhw|whw)             CMD="wellhw" ;;
        per|wellper|wper)          CMD="wellper" ;;
        gpu|wellgpu|wgpu)          CMD="wellgpu" ;;
        cpu|wellcpu|wcpu)          CMD="wellcpu" ;;
        fetch|wellfetch|wfetch)    CMD="wellfetch" ;;
        up|wellup|wup)             CMD="wellup" ;;
        net|wellnet|wnet)          CMD="wellnet" ;;
        power|wellpower|wpower|wbatt) CMD="wellpower" ;;
        doctor|welldoctor|wdoc|wdoctor) CMD="welldoctor" ;;
        html|report|whtml)         CMD="whtml" ;;
        self-update|selfupdate)    CMD="wellup"; FWD+=("--self-update") ;;
        *)
            printf '  %s%s: %s "%s"\n\n' "$R" "$(t launcher_error)" "$(t launcher_error_cmd)" "$1"
            show_help
            exit 2
            ;;
    esac
    shift
    break    # the rest of the arguments belong to the tool
done

if [[ -z "$CMD" ]]; then
    if (( ${#PASS[@]} > 0 )) && (( ! WANT_HELP && ! WANT_VERSION )); then
        printf '  %s%s:%s %s: %s\n\n' "$R" "$(t launcher_error)" "$RESET" "$(t launcher_opt_needs_cmd)" "${PASS[*]}" >&2
        exit 2
    fi
    if (( WANT_VERSION )); then
        printf '%s %s\n' "wellutils" "$_WU_VERSION"
        exit 0
    fi
    if [[ -n "$LANG_ARG" ]] && (( ! WANT_HELP )); then
        set_lang "$LANG_ARG"
        exit 0
    fi
    case "$LANG_ARG" in RU|EN) WELLUTILS_LANG="$LANG_ARG" ;; esac
    show_help
    exit 0
fi

# one-shot language for this run (tool accepts ru|en|auto)
if [[ -n "$LANG_ARG" ]]; then
    case "$LANG_ARG" in
        RU|EN|AUTO) FWD=(--lang "$(printf '%s' "$LANG_ARG" | LC_ALL=C tr '[:upper:]' '[:lower:]')" ${FWD[@]+"${FWD[@]}"}) ;;
        *) printf '  %s%s:%s %s\n\n' "$R" "$(t launcher_error)" "$RESET" "$(t launcher_error_lang "$LANG_ARG")"; exit 1 ;;
    esac
fi
(( WANT_HELP )) && FWD+=(--help)
(( WANT_VERSION )) && FWD+=(--version)

# whtml has its own small CLI (HTML output only): terminal-rendering flags
# make no sense there and would be rejected, so drop them for it.
if [[ "$CMD" == whtml ]]; then
    _wu_keep=() _wu_i=0
    while (( _wu_i < ${#FWD[@]} )); do
        case "${FWD[_wu_i]}" in
            --color) _wu_i=$(( _wu_i + 2 )); continue ;;
            --color=*|--plain|--short|--box|--emoji|--no-emoji|--html) ;;
            *) _wu_keep+=("${FWD[_wu_i]}") ;;
        esac
        _wu_i=$(( _wu_i + 1 ))
    done
    FWD=(${_wu_keep[@]+"${_wu_keep[@]}"})
fi
FWD+=(${PASS[@]+"${PASS[@]}"})

# Prefer the tool next to this launcher (same install / checkout), then PATH.
if [[ -f "$_WU_DIR/$CMD" && -x "$_WU_DIR/$CMD" ]]; then
    exec "$_WU_DIR/$CMD" ${FWD[@]+"${FWD[@]}"} "$@"
elif command -v "$CMD" >/dev/null 2>&1; then
    exec "$CMD" ${FWD[@]+"${FWD[@]}"} "$@"
else
    printf '  %s%s: %s "%s"\n\n' "$R" "$(t launcher_error)" "$(t launcher_error_cmd)" "$CMD"
    exit 127
fi
