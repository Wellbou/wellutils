#!/usr/bin/env bash
# wellusb v2 -- Beautiful USB device listing with IDS database lookup
# Part of wellutils by wellbou_
set -euo pipefail

# ─── Shared libs ────────────────────────────────────────────────
_WU_TOOLNAME="wellusb" _WU_NAME="WellUSB" _WU_VERSION="2.0" _WU_MANUAL=1
_WU_TAGLINE="USB device listing with IDS database lookup"
_WU_BOOT_DIR="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="$(dirname -- "$_WU_BOOT_DIR")/share/wellutils"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="/usr/local/share/wellutils"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="/usr/share/wellutils"
source "$_WU_BOOT_DIR/bootstrap.sh" lang box cli parse



# ─── Fork-free i18n / icon helpers ──────────────────────────────
# _tk KEY -> $_TK  (same lookup as t(), without the $(...) subshell)
_tk() {
    _TK=""
    if [[ "$WELLUTILS_LANG" == "RU" && -n ${_T_RU[$1]+x} ]]; then _TK=${_T_RU[$1]}; fi
    if [[ -z "$_TK" && -n ${_T_EN[$1]+x} ]]; then _TK=${_T_EN[$1]}; fi
    [[ -n "$_TK" ]] || _TK=$1
}
# _icv EMOJI [SPACE] -> $_IC (icon, VS16 stripped; "" when emoji are off)
_icv() {
    _IC=""
    [[ "$_WU_EMOJI" == "yes" ]] || return 0
    _IC=${1//$_WU_VS16/}
    [[ -n "${2:-}" ]] && _IC+=" "
    return 0
}

# _jev STR -> $_JE: JSON-escaped STR without a $(json_esc) subshell per
# field; strings with raw control chars still go through cli.sh json_esc.
_jev() {
    local LC_ALL=C
    _JE=$1
    # control chars or invalid UTF-8 (Latin-1 "Kingst\xf6n") -> full json_esc
    if [[ "$_JE" == *[$'\001'-$'\037'$'\177'$'\200'-$'\377']* ]]; then
        if [[ "$_JE" == *[$'\001'-$'\037'$'\177']* ]]; then _JE=$(json_esc "$1"); return; fi
        _wu_utf8_fix "$_JE" _JE
    fi

    _JE=${_JE//\\/\\\\}; _JE=${_JE//\"/\\\"}
}

# ─── usb.ids database ───────────────────────────────────────────
USB_IDS=""
for _p in /usr/local/share/hwdata/usb.ids /usr/share/hwdata/usb.ids /usr/share/misc/usb.ids \
          /usr/share/usb.ids ${PREFIX:+"$PREFIX/share/hwdata/usb.ids"} ${PREFIX:+"$PREFIX/share/misc/usb.ids"}; do
    [[ -f "$_p" ]] && { USB_IDS="$_p"; break; }
done

# usb_ids_lookup Q... -- ONE awk pass for every "vid:pid" query.
# Prints "Q<TAB>vendor<TAB>device". mawk-safe (no {n}, no [[:space:]]).
usb_ids_lookup() {
    [[ -n "$USB_IDS" && $# -gt 0 ]] || return 0
    awk -v q="$*" '
    BEGIN { n = split(q, Q, " ")
            for (i = 1; i <= n; i++) { split(Q[i], p, ":"); V[p[1]] = 1; D[Q[i]] = 1 } }
    /^C / { exit }
    /^#/ { next }
    /^[0-9a-f][0-9a-f][0-9a-f][0-9a-f] / {
        cv = $1; inv = (cv in V)
        if (inv) { s = $0; sub(/^[0-9a-f]+ +/, "", s); vname[cv] = s }
        next }
    inv && /^\t[0-9a-f][0-9a-f][0-9a-f][0-9a-f] / {
        k = cv ":" substr($0, 2, 4)
        if (k in D) { s = substr($0, 6); sub(/^ +/, "", s); dname[k] = s }
        next }
    END { for (i = 1; i <= n; i++) { split(Q[i], p, ":")
              printf "%s\t%s\t%s\n", Q[i], vname[p[1]], dname[Q[i]] } }
    ' "$USB_IDS" 2>/dev/null || true
}

# ─── Speed helpers ───────────────────────────────────────────────
speed_color_v() {
    case "$1" in
        1.5|12)            _SC=$R ;;
        480)               _SC=$Y ;;
        5000|10000|20000|40000|80000) _SC=$G ;;
        *)                 _SC=$DIM ;;
    esac
}

speed_name_v() {
    case "$1" in
        1.5)    _tk usb_speed_15 ;;
        12)     _tk usb_speed_12 ;;
        480)    _tk usb_speed_480 ;;
        5000)   _tk usb_speed_5000 ;;
        10000)  _tk usb_speed_10000 ;;
        20000)  _tk usb_speed_20000 ;;
        40000)  _tk usb_speed_40000 ;;   # USB4 Gen 3x2
        80000)  _tk usb_speed_80000 ;;   # USB4 v2
        *)      # "Unknown (%s Mbps)" format from the language table, no subshell
                _tk usb_speed_unknown_fmt
                if [[ "$_TK" == *%s* ]]; then printf -v _TK "${_TK//\\/\\\\}" "${1:-?}"
                else _TK="? (${1:-?} Mbps)"; fi ;;
    esac
    _SN=$_TK
}

# ─── Device classification (sets $_UK = usb_type_* key) ─────────
# Name regexes are only a fallback after the class/protocol bytes. Short
# words are anchored (_B = non-alphanumeric or string edge) so "pen" does not
# match "Openmoko" and "star" does not match "Startech".
_B='(^|[^a-z0-9])'  _E='([^a-z0-9]|$)'
_RX_GAMEPAD='gamepad|joystick|fightstick|arcade.*stick|x-box|xbox|360.*pad|dualshock|dualsense|switch.*pro|joy-con|joycon|8bitdo|steam.*controller|pro.*controller|wireless.*controller|wolverine|gamesir|gulikit|flydigi'
_RX_KBD="keyboard|keypad|numpad|blackwidow|huntsman|ornata|cynosa|${_B}kbd${_E}|${_B}k(55|57|63|65|68|70|95|100)${_E}|gaming.*key"
_RX_MOUSE="mouse|trackball|deathadder|basilisk|${_B}naga${_E}|mamba|orochi|lancehead|abyssus|${_B}viper${_E}|${_B}g(102|203|303|304|305|402|403|502|603|703|903)${_E}|${_B}mx (master|anywhere|vertical|ergo)"
_RX_TABLET="tablet|xp-pen|wacom|huion|gaomon|veikk|${_B}pen${_E}|${_B}star ?(g?[0-9])"
_RX_AUDIO='headset|headphone|audio'
_RX_RECV_STRONG='receiver|unifying|dongle|lightspeed'
_RX_RECV_WEAK="wireless|${_B}2\\.4 ?g"
_RX_PHONE="phone|${_B}mao${_E}|huawei|android|samsung|pixel|xiaomi|redmi|oneplus|motorola|${_B}mtp${_E}"
# USB vendors whose PTP/MTP (06:01) devices are phones rather than cameras
_USB_PHONE_VIDS=" 18d1 04e8 2717 12d1 22b8 2a70 05c6 0bb4 1004 0fce 05ac 2ae5 22d9 2d95 0e8d 1bbb 19d2 2916 "

hid_type_v() {   # $1 = lowercased "product vendor"  $2 = interface triples
    local s=$1 ip=" ${2:-} " bk=0 bm=0
    # HID boot protocol (class 03, subclass 01): 01 keyboard, 02 mouse
    [[ "$ip" == *" 03:01:01 "* ]] && bk=1
    [[ "$ip" == *" 03:01:02 "* ]] && bm=1
    if (( bk && bm )); then          # combo: receiver, gaming mouse w/ macros, ...
        if   [[ "$s" =~ $_RX_RECV_STRONG ]]; then _UK=usb_type_receiver
        elif [[ "$s" =~ $_RX_MOUSE ]];  then _UK=usb_type_mouse
        elif [[ "$s" =~ $_RX_KBD ]];    then _UK=usb_type_keyboard
        elif [[ "$s" =~ $_RX_TABLET ]]; then _UK=usb_type_tablet
        elif [[ "$s" =~ $_RX_RECV_WEAK ]]; then _UK=usb_type_receiver
        else _UK=usb_type_hid; fi
    elif (( bm )); then
        if [[ "$s" =~ $_RX_TABLET ]]; then _UK=usb_type_tablet
        elif [[ "$s" =~ $_RX_RECV_STRONG ]]; then _UK=usb_type_receiver
        else _UK=usb_type_mouse; fi
    elif (( bk )); then
        if   [[ "$s" =~ $_RX_MOUSE ]];  then _UK=usb_type_mouse     # macro keys
        elif [[ "$s" =~ $_RX_TABLET ]]; then _UK=usb_type_tablet    # express keys
        elif [[ "$s" =~ $_RX_RECV_STRONG ]]; then _UK=usb_type_receiver
        else _UK=usb_type_keyboard; fi
    elif [[ "$s" =~ $_RX_KBD ]];    then _UK=usb_type_keyboard
    elif [[ "$s" =~ $_RX_MOUSE ]];  then _UK=usb_type_mouse
    elif [[ "$s" =~ $_RX_TABLET ]]; then _UK=usb_type_tablet
    elif [[ "$s" =~ $_RX_AUDIO ]];  then _UK=usb_type_audio
    elif [[ "$s" =~ $_RX_RECV_STRONG ]]; then _UK=usb_type_receiver
    else _UK=usb_type_hid; fi
    return 0
}

# classify_device_v BCLASS PRODUCT MFG VID IFACES TRIPLES DRIVERS
#   TRIPLES = space-separated "class:subclass:protocol" per interface.
classify_device_v() {
    local bclass=$1 product=$2 mfg=$3 vid=$4 ifaces=$5 ip=" $6 " drvs=",${7:-},"
    local s="${product,,} ${mfg,,}"

    # 1. bound driver is the strongest hint
    case "$drvs" in
        *,rndis_host,*|*,rndis_wlan,*) _UK=usb_type_network; return 0 ;;
        *,xpad,*|*,xone*|*,xpadneo*)   _UK=usb_type_gamepad; return 0 ;;
        *,btusb,*)                     _UK=usb_type_bluetooth; return 0 ;;
    esac
    # 2. class:subclass:protocol bytes
    # Xbox 360 (ff:5d:xx) / Xbox One GIP (ff:47:xx) pads are vendor-class
    if [[ "$ip" == *" ff:5d:"* || "$ip" == *" ff:47:"* ]]; then _UK=usb_type_gamepad; return 0; fi
    # Wireless controller e0:01: protocol 01 = Bluetooth, 03 = RNDIS
    if [[ "$ip" == *" e0:01:01 "* ]]; then _UK=usb_type_bluetooth; return 0; fi
    if [[ "$ip" == *" e0:01:03 "* || "$ip" == *" ef:04:"* ]]; then _UK=usb_type_network; return 0; fi
    # CDC 02:02 with vendor protocol ff = Microsoft RNDIS (must beat ACM)
    if [[ "$ip" == *" 02:02:ff "* ]]; then _UK=usb_type_network; return 0; fi
    if [[ "$ip" == *" 02:02:"* ]]; then _UK=usb_type_serial; return 0; fi     # CDC ACM
    if [[ "$ip" == *" 02:06:"* || "$ip" == *" 02:0d:"* || "$ip" == *" 02:0e:"* ]]; then
        _UK=usb_type_network; return 0                                     # ECM/NCM/MBIM
    fi
    # Still image 06:01 = PTP/MTP: phone or digital camera
    if [[ "$ip" == *" 06:01:"* ]]; then
        if [[ "$s" =~ $_RX_PHONE || "$_USB_PHONE_VIDS" == *" $vid "* ]]; then _UK=usb_type_phone
        else _UK=usb_type_camera; fi
        return 0
    fi
    if [[ "$ip" == *" 0e:02:"* ]]; then _UK=usb_type_webcam; return 0; fi
    if [[ "$ip" == *" 0e:01:"* ]]; then _UK=usb_type_video;  return 0; fi
    case "$vid" in
        1a86|0403|067b|10c4|12d1|1eab|0fe6|2341|2a03)
            if [[ "$bclass" == "ff" || " $ifaces " == *" 0a "* || " $ifaces " == *" 02 "* ]]; then
                _UK=usb_type_serial; return 0
            fi ;;
    esac
    # HID boot keyboard/mouse beats name guessing
    if [[ "$ip" == *" 03:01:0"[12]" "* ]]; then
        if [[ "$s" =~ $_RX_GAMEPAD ]]; then _UK=usb_type_gamepad; else hid_type_v "$s" "$6"; fi
        return 0
    fi
    if [[ "$s" =~ $_RX_GAMEPAD ]]; then _UK=usb_type_gamepad; return 0; fi

    case "$bclass" in
        09) _UK=usb_type_hub ;;
        0e) _UK=usb_type_video ;;
        03) hid_type_v "$s" "$6" ;;
        e0) _UK=usb_type_bluetooth ;;
        08) _UK=usb_type_storage ;;
        07) _UK=usb_type_printer ;;
        01|04) _UK=usb_type_audio ;;
        0a) _UK=usb_type_data ;;
        02) _UK=usb_type_network ;;
        ff) _UK=usb_type_vendor ;;
        ef)
            if   [[ "$s" =~ $_RX_PHONE ]]; then _UK=usb_type_phone
            elif [[ "$s" == *cam* ]];        then _UK=usb_type_webcam
            else _UK=usb_type_misc; fi ;;
        *)
            case " $ifaces " in
                *" 07 "*) _UK=usb_type_printer ;;
                *" 08 "*) _UK=usb_type_storage ;;
                *" 0e "*) _UK=usb_type_webcam ;;
                *" 02 "*) _UK=usb_type_network ;;
                *" 01 "*) _UK=usb_type_audio ;;   # audio + HID buttons = audio
                *" 03 "*) hid_type_v "$s" "$6" ;;
                *" 04 "*) _UK=usb_type_audio ;;
                *" 06 "*) _UK=usb_type_camera ;;
                *" 09 "*) _UK=usb_type_hub ;;
                *" e0 "*) _UK=usb_type_bluetooth ;;
                *) _UK=usb_type_device ;;
            esac ;;
    esac
    return 0
}

# icon from the type *key* (language independent)
device_icon_v() {
    case "$1" in
        usb_type_keyboard) _icv "⌨" ;;
        usb_type_mouse)    _icv "🖱" ;;
        usb_type_webcam|usb_type_video) _icv "📷" ;;
        usb_type_tablet)   _icv "🎨" ;;
        usb_type_storage)  _icv "💾" ;;
        usb_type_printer)  _icv "🖨" ;;
        usb_type_phone)    _icv "📱" ;;
        usb_type_audio)    _icv "🔊" ;;
        usb_type_network)  _icv "🌐" ;;
        usb_type_serial)   _icv "🔗" ;;
        usb_type_hid)      _icv "⚙" ;;
        usb_type_gamepad)  _icv "🎮" ;;
        usb_type_misc)     _icv "🔧" ;;
        usb_type_bluetooth) _icv "📶" ;;
        usb_type_receiver) _icv "📡" ;;
        usb_type_camera)   _icv "📷" ;;
        *)                 _icv "🔌" ;;
    esac
}

# ─── Native sysfs scan ──────────────────────────────────────────
# Reads /sys/bus/usb/devices directly (no usb-devices/lsusb dependency, so
# it works on busybox, Termux and containers). Fills DEV_* arrays sorted
# by bus + topology. Returns 1 when USB sysfs is not available.
_rd() { _V=""; { IFS= read -r _V < "$1"; } 2>/dev/null || true; _V=${_V%$'\r'}; }
# _rds FILE -> $_V: device-supplied string (manufacturer/product/serial):
# trimmed, C0 controls + DEL removed so a malicious device cannot inject
# terminal escape sequences.
_rds() {
    _rd "$1"
    local LC_ALL=C
    [[ "$_V" == *[$'\001'-$'\037'$'\177']* ]] && _V=${_V//[$'\001'-$'\037'$'\177']/}
    wu_trim "$_V" _V
}
# Insertion sort of the caller's tmp[] by byte order: [[ a > b ]] uses the
# locale's collation (ru_RU/en_US ignore "." and ":"), so force C here.
_usb_sort_tmp() {
    local LC_ALL=C n=${#tmp[@]} i j x
    for (( i = 1; i < n; i++ )); do
        x=${tmp[i]}; j=$(( i - 1 ))
        while (( j >= 0 )) && [[ "${tmp[j]}" > "$x" ]]; do tmp[j+1]=${tmp[j]}; j=$(( j - 1 )); done
        tmp[j+1]=$x
    done
    return 0
}

usb_scan() {
    DEV_BUS=() DEV_DEVNUM=() DEV_PATH=() DEV_VID=() DEV_PID=() DEV_MFG=() DEV_PROD=() DEV_SERIAL=()
    DEV_SPD=() DEV_VER=() DEV_DRIVER=() DEV_DRIVERS=() DEV_CLASS=() DEV_IFACES=() DEV_IPAIRS=()
    DEV_VNAME=() DEV_DNAME=() DEV_TYPEKEY=()
    dev_count=0 total_hubs=0
    local root=${WELLUSB_SYSFS_ROOT:-/sys/bus/usb/devices}   # override: tests
    [[ -d "$root" ]] || return 1

    local d name f ic isc ipr line drv drvs ifs ips bus key k i
    local -a tmp=()
    for d in "$root"/*; do
        name=${d##*/}
        [[ "$name" == *:* ]] && continue
        [[ -r "$d/idVendor" ]] || continue
        _rd "$d/busnum"; bus=${_V:-0}
        [[ "$bus" =~ ^[0-9]+$ ]] || bus=0
        # sort key: bus, then topology path with every port zero-padded
        case "$name" in usb*) k="000" ;; *) k=${name#*-}; k=${k//./ } ;; esac
        key=""
        for f in $k; do printf -v f '%03d' "$((10#${f//[!0-9]/0}))"; key+="$f."; done
        printf -v key '%03d:%s' "$((10#$bus))" "$key"
        tmp+=("$key $name")
    done
    (( ${#tmp[@]} )) || return 0
    # insertion sort (a handful of devices; avoids a sort(1) fork)
    local x
    _usb_sort_tmp

    local -a qs=()
    for x in "${tmp[@]}"; do
        name=${x#* }; d="$root/$name"
        _rd "$d/busnum";       printf -v bus '%02d' "$((10#${_V:-0}))"
        DEV_BUS+=("$bus")
        _rd "$d/devnum";       DEV_DEVNUM+=("$_V")
        DEV_PATH+=("$name")
        _rd "$d/idVendor";     DEV_VID+=("${_V,,}")
        _rd "$d/idProduct";    DEV_PID+=("${_V,,}")
        _rds "$d/manufacturer"; DEV_MFG+=("$_V")
        _rds "$d/product";      DEV_PROD+=("$_V")
        _rds "$d/serial";       DEV_SERIAL+=("$_V")
        _rds "$d/speed";        DEV_SPD+=("$_V")
        _rds "$d/version";      DEV_VER+=("$_V")
        _rd "$d/bDeviceClass"; DEV_CLASS+=("${_V:-00}")
        [[ "${_V:-00}" == "09" ]] && total_hubs=$(( total_hubs + 1 ))
        # interfaces: class list, class:subclass:protocol triples, drivers
        ifs="" ips="" drvs=""
        for f in "$d"/*:*; do
            [[ -d "$f" ]] || continue
            _rd "$f/bInterfaceClass";    ic=${_V,,}
            _rd "$f/bInterfaceSubClass"; isc=${_V,,}
            _rd "$f/bInterfaceProtocol"; ipr=${_V,,}
            [[ -n "$ic" && " $ifs " != *" $ic "* ]] && ifs+=" $ic"
            [[ -n "$ic$isc" && " $ips " != *" ${ic:-00}:${isc:-00}:${ipr:-00} "* ]] && ips+=" ${ic:-00}:${isc:-00}:${ipr:-00}"
            drv=""
            if [[ -r "$f/uevent" ]]; then
                while IFS= read -r line; do
                    case "$line" in DRIVER=*) drv=${line#DRIVER=}; break ;; esac
                done < "$f/uevent" 2>/dev/null || true
            fi
            [[ -n "$drv" && ",$drvs," != *",$drv,"* ]] && drvs+="${drvs:+,}$drv"
        done
        DEV_IFACES+=("${ifs# }"); DEV_IPAIRS+=("${ips# }")
        DEV_DRIVER+=("${drvs%%,*}"); DEV_DRIVERS+=("$drvs")
        qs+=("${DEV_VID[dev_count]}:${DEV_PID[dev_count]}")
        dev_count=$(( dev_count + 1 ))
    done

    # names from usb.ids: one awk pass for every device
    local -A idv=() idd=()
    local q vn dn
    if [[ -n "$USB_IDS" ]]; then
        while IFS=$'\t' read -r q vn dn; do
            [[ -n "$q" ]] || continue
            idv[$q]=$vn idd[$q]=$dn
        done < <(usb_ids_lookup "${qs[@]}")
    fi
    _tk usb_unknown; local unk=$_TK
    for (( i = 0; i < dev_count; i++ )); do
        q=${qs[i]}
        vn=${DEV_MFG[i]}; dn=${DEV_PROD[i]}
        [[ -z "$vn" ]] && vn=${idv[$q]:-}
        [[ -z "$dn" ]] && dn=${idd[$q]:-}
        [[ -z "$vn" ]] && { _tk hw_unknown; vn=$_TK; }
        [[ -z "$dn" ]] && dn=$unk
        DEV_VNAME+=("$vn"); DEV_DNAME+=("$dn")
        classify_device_v "${DEV_CLASS[i]}" "$dn" "$vn" "${DEV_VID[i]}" "${DEV_IFACES[i]}" "${DEV_IPAIRS[i]}" "${DEV_DRIVERS[i]}"
        DEV_TYPEKEY+=("$_UK")
    done
    return 0
}

# ─── JSON output ────────────────────────────────────────────────
json_out() {
    local sysfs=true
    usb_scan || sysfs=false
    wu_json_head "$_WU_TOOLNAME" "$_WU_VERSION"
    printf ',\n  "summary": { "devices": %d, "hubs": %d },\n' "$dev_count" "$total_hubs"
    printf '  "sysfs": %s,\n' "$sysfs"
    printf '  "ids_db_loaded": %s,\n' "$([[ -n $USB_IDS ]] && printf 'true' || printf 'false')"
    printf '  "devices": ['
    local i first=1 f v ref
    for (( i = 0; i < dev_count; i++ )); do
        speed_name_v "${DEV_SPD[i]}"
        _tk "${DEV_TYPEKEY[i]}"
        (( first )) && { first=0; printf '\n'; } || printf ',\n'
        local sn=$_SN tn=$_TK
        printf '    {'
        for f in bus:DEV_BUS devnum:DEV_DEVNUM path:DEV_PATH vid:DEV_VID pid:DEV_PID manufacturer:DEV_VNAME \
                 product:DEV_DNAME serial:DEV_SERIAL speed:DEV_SPD speed_name: usb_version:DEV_VER driver:DEV_DRIVER \
                 drivers:DEV_DRIVERS class:DEV_CLASS type: type_key: interfaces:DEV_IFACES interface_ids:DEV_IPAIRS; do

            case "${f%%:*}" in
                speed_name) v=$sn ;;
                type) v=$tn ;;
                type_key) v=${DEV_TYPEKEY[i]#usb_type_} ;;
                *) ref="${f#*:}[i]"; v=${!ref} ;;
            esac
            _jev "$v"
            [[ "${f%%:*}" == bus ]] && printf ' "%s": "%s"' "${f%%:*}" "$_JE" || printf ', "%s": "%s"' "${f%%:*}" "$_JE"
        done
        printf ' }'
    done
    (( first )) && printf ']\n' || printf '\n  ]\n'
    wu_json_end
}

# ─── Main ────────────────────────────────────────────────────────
main() {
    if [[ "$_WU_JSON" == "1" ]]; then json_out; return 0; fi

    _tk usb_title; _icv "🔌" 1
    printf '\n  %s╔═╗%s\n' "$C" "$RESET"
    printf '  %s║%s  %s%swellusb -- %s%s\n' "$C" "$RESET" "$_IC" "${BOLD}${W}" "$_TK" "$RESET"
    printf '  %s╚═╝%s\n' "$C" "$RESET"

    if ! usb_scan; then
        _tk usb_no_sysfs; _icv "⚠" 1
        printf '\n  %s%s%s%s\n\n' "$Y" "$_IC" "$_TK" "$RESET"
        return 0
    fi

    local ids_status L_dev L_hubs L_db
    if [[ -n $USB_IDS ]]; then _tk loaded; ids_status="${G}${_TK}${RESET}"
    else _tk not_found; ids_status="${R}${_TK}${RESET}"; fi
    _tk usb_devices; L_dev=$_TK; _tk usb_hubs; L_hubs=$_TK; _tk usb_ids_db; L_db=$_TK
    _icv "📊" 1
    printf '  %s%s%s:%s %d (%s: %d)  |  %s%s:%s %s\n' \
        "$_IC" "$BOLD" "$L_dev" "$W" "$dev_count" "$L_hubs" "$total_hubs" "$BOLD" "$L_db" "$W" "$ids_status"

    if (( dev_count == 0 )); then
        _tk per_usb_none
        printf '\n  %s%s%s\n\n' "$DIM" "$_TK" "$RESET"
        return 0
    fi

    local L_mfg L_spd L_drv L_ser L_type L_bus IC_bus
    _tk usb_manufacturer; L_mfg=$_TK; _tk usb_speed; L_spd=$_TK; _tk usb_driver; L_drv=$_TK
    _tk usb_serial; L_ser=$_TK; _tk usb_type; L_type=$_TK; _tk usb_bus; L_bus=$_TK
    _icv "🏭" 1; IC_bus=$_IC

    # root-hub speed per bus (the usbN device of that bus)
    local -A bus_spd=()
    local i
    for (( i = 0; i < dev_count; i++ )); do
        [[ "${DEV_PATH[i]}" == usb* ]] && bus_spd[${DEV_BUS[i]}]=${DEV_SPD[i]}
    done

    local prev_bus="" bus sc icon drv
    for (( i = 0; i < dev_count; i++ )); do
        bus=${DEV_BUS[i]}
        if [[ "$bus" != "$prev_bus" ]]; then
            [[ -n "$prev_bus" ]] && printf '  %s└┘%s\n' "$C" "$RESET"
            speed_name_v "${bus_spd[$bus]:-0}"; speed_color_v "${bus_spd[$bus]:-0}"
            printf '\n  %s┌───%s %s%s%s %s%s%s  %s%s%s\n' "$C" "$RESET" "$IC_bus" "$BOLD" "$L_bus" "$W" "$bus" "$RESET" "$_SC" "$_SN" "$RESET"
            printf '  %s│%s\n' "$C" "$RESET"
            prev_bus=$bus
        fi
        device_icon_v "${DEV_TYPEKEY[i]}"; icon=$_IC${_IC:+ }
        speed_name_v "${DEV_SPD[i]}"; speed_color_v "${DEV_SPD[i]}"
        printf '  %s│%s  %s%s%s%s:%s %s\n' "$C" "$RESET" "$icon" "$BOLD" "${DEV_VID[i]}" "$RESET" "${DEV_PID[i]}" "${DEV_DNAME[i]}"
        printf '  %s│%s     %s├─%s %s:  %s%s%s\n' "$C" "$RESET" "$DIM" "$RESET" "$L_mfg" "$W" "${DEV_VNAME[i]}" "$RESET"
        printf '  %s│%s     %s├─%s %s:  %s%s%s\n' "$C" "$RESET" "$DIM" "$RESET" "$L_spd" "$_SC" "$_SN" "$RESET"
        drv=${DEV_DRIVERS[i]}
        if [[ -n "$drv" && "$drv" != "(none)" ]]; then
            printf '  %s│%s     %s├─%s %s:  %s%s%s\n' "$C" "$RESET" "$DIM" "$RESET" "$L_drv" "$G" "${drv//,/, }" "$RESET"
        fi
        if [[ -n "${DEV_SERIAL[i]}" ]]; then
            printf '  %s│%s     %s├─%s %s:  %s%s%s\n' "$C" "$RESET" "$DIM" "$RESET" "$L_ser" "$DIM" "${DEV_SERIAL[i]}" "$RESET"
        fi
        _tk "${DEV_TYPEKEY[i]}"
        printf '  %s│%s     %s└─%s %s:  %s%s%s\n' "$C" "$RESET" "$DIM" "$RESET" "$L_type" "$M" "$_TK" "$RESET"
        printf '  %s│%s\n' "$C" "$RESET"
    done
    printf '  %s└┘%s\n' "$C" "$RESET"

    _tk usb_legend
    if [[ "${_WU_UNICODE:-1}" == 1 ]]; then
        printf '\n  %s%s:%s %s▁%s USB 1.1  %s▃%s USB 2.0  %s▅▇%s USB 3.0  %s▅▇█%s USB 3.1+\n' \
            "$BOLD" "$_TK" "$RESET" "$R" "$RESET" "$Y" "$RESET" "$G" "$RESET" "$G" "$RESET"
    else
        printf '\n  %s%s:%s %s.%s USB 1.1  %s-%s USB 2.0  %s=%s USB 3.0  %s#%s USB 3.1+\n' \
            "$BOLD" "$_TK" "$RESET" "$R" "$RESET" "$Y" "$RESET" "$G" "$RESET" "$G" "$RESET"
    fi
    local now=""
    printf -v now '%(%Y-%m-%d %H:%M:%S)T' -1 2>/dev/null || now=$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null)
    printf '\n  %s%s v%s | %s%s\n\n' "$DIM" "$_WU_NAME" "$_WU_VERSION" "$now" "$RESET"
}

wu_run main "$@"
