#!/usr/bin/env bash
# wellmod -- Beautiful kernel module listing
# Part of wellutils by wellbou_
set -euo pipefail

# ─── Shared libs ────────────────────────────────────────────────
_WU_TOOLNAME="wellmod" _WU_NAME="WellMod" _WU_VERSION="1.0" _WU_MANUAL=1
_WU_TAGLINE="Kernel modules listing"
_WU_BOOT_DIR="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="$(dirname -- "$_WU_BOOT_DIR")/share/wellutils"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="/usr/local/share/wellutils"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="/usr/share/wellutils"
source "$_WU_BOOT_DIR/bootstrap.sh" lang cli box parse
_MOD_DEPS="" _MOD_FILTER=""
wmod_extra_parse() {
    case "$1" in
        --deps)
            [[ $# -ge 2 ]] || { printf 'wellmod: --deps needs a module name\n' >&2; exit 2; }
            _MOD_DEPS="$2"; _WU_EXTRA_CONSUMED=2; return 0 ;;
        --filter|-f)
            [[ $# -ge 2 ]] || { printf 'wellmod: --filter needs a pattern\n' >&2; exit 2; }
            _MOD_FILTER="$2"; _WU_EXTRA_CONSUMED=2; return 0 ;;
    esac
    return 1
}
_WU_EXTRA_PARSE=wmod_extra_parse
_WU_EXTRA_HELP="      --deps MODULE          show module dependencies
      --filter, -f PATTERN   filter modules by name"


# ─── Colors ──────────────────────────────────────────────────────
R=$'\033[1;31m'  G=$'\033[1;32m'  Y=$'\033[1;33m'  B=$'\033[1;34m'
M=$'\033[1;35m'  C=$'\033[1;36m'  W=$'\033[1;37m'  DIM=$'\033[2m'
BOLD=$'\033[1m'  RESET=$'\033[0m'

# ─── Fork-free helpers ──────────────────────────────────────────
# _tk KEY -> $_TK  (t() without a $(...) subshell)
_tk() {
    _TK=""
    if [[ "$WELLUTILS_LANG" == "RU" && -n ${_T_RU[$1]+x} ]]; then _TK=${_T_RU[$1]}; fi
    if [[ -z "$_TK" && -n ${_T_EN[$1]+x} ]]; then _TK=${_T_EN[$1]}; fi
    [[ -n "$_TK" ]] || _TK=$1
}
# _jev STR -> $_JE (JSON-escaped; control chars go through cli.sh json_esc)
_jev() {
    local LC_ALL=C
    _JE=$1
    if [[ "$_JE" == *[$'\001'-$'\037'$'\177']* ]]; then _JE=$(json_esc "$1"); return; fi
    _JE=${_JE//\\/\\\\}; _JE=${_JE//\"/\\\"}
}
_now() {
    _NOW=""
    printf -v _NOW '%(%Y-%m-%d %H:%M:%S)T' -1 2>/dev/null || _NOW=$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null)
}

# fmt_size_v BYTES -> $_FS  (integer math, one decimal, no awk)
fmt_size_v() {
    local b=${1:-0} t
    [[ "$b" =~ ^[0-9]+$ ]] || b=0
    if (( b >= 1048576 )); then
        t=$(( (b * 10 + 524288) / 1048576 )); _FS="$(( t / 10 )).$(( t % 10 )) MB"
    elif (( b >= 1024 )); then
        t=$(( (b * 10 + 512) / 1024 )); _FS="$(( t / 10 )).$(( t % 10 )) KB"
    else
        _FS="$b B"
    fi
}
fmt_size() { local _FS; fmt_size_v "$1"; printf '%s' "$_FS"; }

size_color_v() {
    local b=${1:-0}
    if   (( b >= 1048576 )); then _SC=$R
    elif (( b >= 262144 ));  then _SC=$Y
    elif (( b >= 65536 ));   then _SC=$C
    else _SC=$G; fi
}

# ─── Categories ──────────────────────────────────────────────────
CAT_ORDER=(gpu_dri audio usb storage filesystem networking wifi bluetooth virtualization display bus timer cpu_virt netfs other)
CAT_ICONS=("🎮" "🔊" "🔌" "💾" "📁" "🌐" "📡" "📶" "☁" "🖥" "🔗" "⏰" "🧠" "🗂" "📦")

# mod_cat NAME -> $_CI (index into CAT_ORDER). The icon of a module is the
# icon of its category, so the TOP-10 and the category lists always agree.
mod_cat() {
    case "$1" in
        mac80211|cfg80211|rt2*|rt61*|rt73*|iwl*|ath9k*|ath10k*|ath11k*|ath12k*|ath5k|ath6kl*|carl9170|\
        brcmfmac*|brcmsmac*|b43*|rtw88*|rtw89*|rtl8*|rtl_*|mt76*|mt7*|mwifiex*|wl12*|wl18*|libertas*|\
        zd1211rw|p54*|orinoco*|ipw2*|libipw|lib80211*) _CI=6 ;;
        nvidia*|nouveau*|amdgpu|radeon|i915|xe|gma500*|mgag200|ast|vc4|v3d|panfrost|lima|msm|etnaviv|\
        virtio_gpu|vmwgfx|qxl|bochs|cirrus*) _CI=0 ;;
        snd|snd_*|snd-*|sound*|soundcore|pulse*|ac97*) _CI=1 ;;
        usb_*|uas|usb*|xhci*|ehci*|ohci*|uhci*|dwc2|dwc3*|typec*|ucsi*) _CI=2 ;;
        nfs*|cifs*|smb*|ksmbd|9p|9pnet*|ceph|lockd|sunrpc|grace|fscache|netfs|auth_rpcgss|rpcsec*) _CI=13 ;;
        ext2|ext3|ext4|xfs|btrfs|vfat|fat|msdos|exfat|ntfs*|fuse*|f2fs|jfs|reiserfs|hfs*|isofs|udf|\
        squashfs|overlay|zfs|bcachefs|nilfs2|erofs|jbd2|mbcache|crc32c*|zstd*|xor|raid6_pq|libcrc32c) _CI=4 ;;
        sd_mod|sr_mod|sg|sd*|ahci|libahci|libata|ata_*|pata_*|sata_*|scsi*|nvme*|mmc*|sdhci*|dm_*|dm-*|\
        md_mod|raid*|loop|nbd|zram|virtio_blk|virtio_scsi|cdrom|mptsas|megaraid*|mpt3sas) _CI=3 ;;
        bluetooth*|bt[!r]*|rfkill*|hci_*|rfcomm|bnep|hidp) _CI=7 ;;
        vmw_*|vsock*|vmw*|vhost*|virtio*|hv_*|hyperv*|xen*|vboxguest|vboxsf|vboxvideo|vboxdrv|vboxnet*|\
        vboxpci|kvm_pv*) _CI=8 ;;
        drm*|fb*|video*|backlight|i2c_algo_bit|ttm|syscopyarea|sysfillrect|sysimgblt|cec) _CI=9 ;;
        ip_*|nf_*|nft*|ipt_*|ip6*|x_tables|xt_*|ebt*|arp_tables|br_netfilter|bridge|stp|llc|veth|tun|tap|\
        macvlan|macvtap|ipvlan|vxlan|wireguard|bonding|8021q|garp|mrp|r8169|r8168|e1000*|igb|igc|ixgbe*|\
        tg3|bnx2*|atl1*|alx|sky2|forcedeth|mlx*|virtio_net|realtek|libphy|mii|udp_diag|tcp_diag|inet_diag|\
        *_diag|af_packet|nfnetlink*|nf_conntrack*|pppox|ppp_*|slhc|cdc_ether|rndis_host|usbnet|qmi_wwan) _CI=5 ;;
        i2c_*|i801*|i2c-*|smbus*|spi_*|spi-*|gpio*|pinctrl*|mei*|lpc_ich|intel_lpss*) _CI=10 ;;
        rtc*|timer*|hpet*) _CI=11 ;;
        intel_*|amd_*|kvm*|coretemp|k10temp|x86_pkg_temp*|cpufreq*|acpi_cpufreq|msr|cpuid|microcode|\
        aesni*|ghash*|crc32_pclmul|polyval*|sha*_ssse3|sha*_x86*|aes*_x86*|zenpower) _CI=12 ;;
        *) _CI=14 ;;
    esac
}

mod_icon_v() {   # $1 = category index -> $_IC (with trailing space, "" if no emoji)
    _IC=""
    [[ "$_WU_EMOJI" == "yes" ]] && _IC="${CAT_ICONS[$1]//$_WU_VS16/} "
    return 0
}

# compat wrapper (icon for a module name)
module_icon() { local _CI _IC; mod_cat "$1"; mod_icon_v "$_CI"; printf '%s' "${_IC% }"; }

# ─── Header ──────────────────────────────────────────────────────
print_header() {
    local ic=""
    [[ "$_WU_EMOJI" == "yes" ]] && ic="📦 "
    _tk mod_title
    printf '\n  %s╔═╗%s\n' "$C" "$RESET"
    printf '  %s║%s  %s%s%swellmod -- %s%s\n' "$C" "$RESET" "$ic" "$BOLD" "$W" "$_TK" "$RESET"
    printf '  %s╚═╝%s\n' "$C" "$RESET"
}

# ─── Module list (/proc/modules, read by bash: no awk/cut forks) ─
# Fills names[] sizes[] used_bys[] total total_size (caller declares them).
_MOD_SRC=${WELLMOD_PROC_MODULES:-/proc/modules}   # override: tests
load_modules() {
    local name size used rest filt=${_MOD_FILTER//-/_}
    [[ -r "$_MOD_SRC" ]] || return 0
    while read -r name size used rest; do
        [[ -n "$name" ]] || continue
        [[ -z "$filt" || "$name" == *$filt* ]] || continue
        [[ "$size" =~ ^[0-9]+$ ]] || size=0
        names+=("$name"); sizes+=("$size"); used_bys+=("$used")
        total=$(( total + 1 )); total_size=$(( total_size + size ))
    done < "$_MOD_SRC" 2>/dev/null || true
}

# ─── Dependencies (--deps) ───────────────────────────────────────
# modules.dep is searched under /lib/modules and /usr/lib/modules (merged
# /usr, Fedora/Arch/NixOS layouts). Names are compared with "-" == "_"
# (the file lists snd-hda-intel.ko while lsmod shows snd_hda_intel).
find_depfile() {
    local kver="" d
    _DEPFILE=""
    wu_read /proc/sys/kernel/osrelease kver || kver=$(uname -r 2>/dev/null || true)
    for d in ${WELLMOD_DEPFILE:+"$WELLMOD_DEPFILE"} "/lib/modules/$kver/modules.dep" "/usr/lib/modules/$kver/modules.dep"; do
        [[ -r "$d" ]] && { _DEPFILE=$d; return 0; }
    done
    _DEPFILE="/lib/modules/$kver/modules.dep"
    return 1
}

# deps_lookup MODULE -> DEP_PATH (module file) + DEP_LIST[] (dependency files)
# return 1 = module not in modules.dep, 2 = no modules.dep
deps_lookup() {
    local want=${1//-/_} line
    want=${want%.ko*}
    DEP_PATH="" DEP_LIST=()
    find_depfile || return 2
    # one awk pass (a bash read loop over ~6000 lines takes ~1 s on a netbook)
    line=$(awk -v w="$want" '{ f = $1; sub(/:$/, "", f); n = split(f, a, "/"); f = a[n]
            sub(/\.ko.*$/, "", f); gsub(/-/, "_", f); if (f == w) { print; exit } }' "$_DEPFILE" 2>/dev/null) || line=""
    [[ -n "$line" ]] || return 1
    DEP_PATH=${line%%:*}
    read -ra DEP_LIST <<< "${line#*:}"
    return 0
}

_mod_norm() { _MN=${1##*/}; _MN=${_MN%%.ko*}; _MN=${_MN//-/_}; }
_mod_short() { _MS=${1##*/}; _MS=${_MS%%.ko*}; _MS=${_MS//-/_}; }

deps_json() {
    local rc=0 d first=1
    deps_lookup "$_MOD_DEPS" || rc=$?
    wu_json_head "$_WU_TOOLNAME" "$_WU_VERSION"
    _mod_norm "$_MOD_DEPS"; _jev "$_MN"; printf ',\n  "module": "%s",\n' "$_JE"
    if (( rc == 0 )); then printf '  "found": true,\n'; else printf '  "found": false,\n'; fi
    _jev "$_DEPFILE"; printf '  "modules_dep": "%s",\n' "$_JE"
    _jev "$DEP_PATH"; printf '  "path": "%s",\n' "$_JE"
    printf '  "depends": ['
    for d in ${DEP_LIST[@]+"${DEP_LIST[@]}"}; do
        _mod_short "$d"; _jev "$_MS"
        local jn=$_JE; _jev "$d"
        (( first )) && first=0 || printf ','
        printf '\n    { "name": "%s", "path": "%s" }' "$jn" "$_JE"
    done
    (( first )) && printf ']' || printf '\n  ]'
    wu_json_end
    return 0
}

deps_box() {
    local rc=0 d n=0 ic="" br _MN
    _mod_norm "$_MOD_DEPS"
    print_header
    deps_lookup "$_MOD_DEPS" || rc=$?
    _tk mod_deps_title
    [[ "$_WU_EMOJI" == "yes" ]] && ic="🔗 "
    printf '\n  %s┌───%s %s%s%s: %s%s\n' "$C" "$RESET" "$ic" "$BOLD" "$_TK" "$_MN" "$RESET"
    if (( rc == 2 )); then
        _tk mod_not_found
        printf '  %s│%s  %s%s: %s%s\n' "$C" "$RESET" "$R" "$_TK" "$_DEPFILE" "$RESET"
        printf '  %s└┘%s\n' "$C" "$RESET"
        return 1
    elif (( rc == 1 )); then
        _tk mod_not_found
        printf '  %s│%s  %s%s: %s%s\n' "$C" "$RESET" "$R" "$_TK" "$_MOD_DEPS" "$RESET"
        printf '  %s└┘%s\n' "$C" "$RESET"
        return 1
    fi
    local _CI _IC
    mod_cat "$_MN"; mod_icon_v "$_CI"
    printf '  %s│%s  %s%s%s%s  %s%s%s\n' "$C" "$RESET" "$_IC" "$BOLD$W" "$_MN" "$RESET" "$DIM" "$DEP_PATH" "$RESET"
    for d in ${DEP_LIST[@]+"${DEP_LIST[@]}"}; do
        n=$(( n + 1 ))
        _mod_short "$d"; mod_cat "$_MS"; mod_icon_v "$_CI"
        br='├─'; (( n == ${#DEP_LIST[@]} )) && br='└─'
        printf '  %s│%s     %s%s%s %s%s%s%s  %s%s%s\n' "$C" "$RESET" "$DIM" \
            "$br" "$RESET" "$_IC" "$BOLD" "$_MS" "$RESET" "$DIM" "$d" "$RESET"
    done
    if (( n == 0 )); then
        _tk mod_no_deps
        printf '  %s│%s     %s%s%s\n' "$C" "$RESET" "$DIM" "$_TK" "$RESET"
    fi
    printf '  %s└┘%s\n' "$C" "$RESET"
    _now
    printf '\n  %s%s v%s | %s%s\n\n' "$DIM" "$_WU_NAME" "$_WU_VERSION" "$_NOW" "$RESET"
    return 0
}

# ─── JSON output ────────────────────────────────────────────────
json_out() {
    local -a names=() sizes=() used_bys=()
    local total=0 total_size=0 i first=1 refs
    load_modules
    wu_json_head "$_WU_TOOLNAME" "$_WU_VERSION"
    printf ',\n  "modules": ['
    for (( i = 0; i < total; i++ )); do
        (( first )) && { first=0; printf '\n'; } || printf ',\n'
        mod_cat "${names[i]}"
        _jev "${names[i]}"
        refs=${used_bys[i]}; [[ "$refs" =~ ^[0-9]+$ ]] || refs=null
        printf '    { "name": "%s", "size_bytes": %d, "refs": %s, "category": "%s" }' \
            "$_JE" "${sizes[i]}" "$refs" "${CAT_ORDER[_CI]}"
    done
    (( first )) && printf '],\n' || printf '\n  ],\n'
    printf '  "summary": { "count": %d, "total_bytes": %d, "proc_modules": %s }\n' "$total" "$total_size" \
        "$([[ -r $_MOD_SRC ]] && printf true || printf false)"
    wu_json_end
}

# ─── Main ────────────────────────────────────────────────────────
main() {
    if [[ -n "$_MOD_DEPS" ]]; then
        if [[ "$_WU_JSON" == "1" ]]; then deps_json; return 0; fi
        deps_box; return $?
    fi
    if [[ "$_WU_JSON" == "1" ]]; then json_out; return 0; fi

    print_header

    local -a names=() sizes=() used_bys=()
    local total=0 total_size=0 i j ic
    load_modules

    local _FS _SC _CI _IC L_tot L_size
    fmt_size_v "$total_size"
    _tk mod_total; L_tot=$_TK; _tk mod_total_size; L_size=$_TK
    ic=""; [[ "$_WU_EMOJI" == "yes" ]] && ic="📊 "
    printf '  %s%s%s:%s %d  |  %s%s:%s %s%s\n' "$ic" "$BOLD" "$L_tot" "$W" "$total" "$BOLD" "$L_size" "$W" "$_FS" "$RESET"

    if (( total == 0 )); then
        _tk mod_none
        printf '\n  %s%s%s\n\n' "$DIM" "$_TK" "$RESET"
        return 0
    fi

    # name column: longest module name (ASCII), capped
    local nw=16
    for (( i = 0; i < total; i++ )); do (( ${#names[i]} > nw )) && nw=${#names[i]}; done
    (( nw > 40 )) && nw=40

    # TOP 10 by size: partial selection sort in bash (no sort|head|awk)
    local -a top=() taken=()
    local best bi k lim=10
    (( total < lim )) && lim=$total
    for (( k = 0; k < lim; k++ )); do
        best=-1 bi=-1
        for (( i = 0; i < total; i++ )); do
            [[ -n "${taken[i]:-}" ]] && continue
            (( sizes[i] > best )) && { best=${sizes[i]}; bi=$i; }
        done
        (( bi < 0 )) && break
        taken[bi]=1; top+=("$bi")
    done

    _tk mod_top10
    ic=""; [[ "$_WU_EMOJI" == "yes" ]] && ic="🏆 "
    printf '\n  %s┌───%s %s%s%s%s\n' "$C" "$RESET" "$ic" "$BOLD" "$_TK" "$RESET"
    local rank=0 idx
    for idx in ${top[@]+"${top[@]}"}; do
        rank=$(( rank + 1 ))
        fmt_size_v "${sizes[idx]}"; size_color_v "${sizes[idx]}"
        mod_cat "${names[idx]}"; mod_icon_v "$_CI"
        printf '  %s│%s  %s%s%2d.%s %s%s%-*s%s %s%10s%s' \
            "$C" "$RESET" "$BOLD" "$W" "$rank" "$RESET" "$_IC" "$BOLD" "$nw" "${names[idx]}" "$RESET" "$_SC" "$_FS" "$RESET"
        [[ "${used_bys[idx]}" != "0" ]] && printf '  %s×%s%s' "$G" "${used_bys[idx]}" "$RESET"
        printf '\n'
    done
    printf '  %s└┘%s\n' "$C" "$RESET"

    # categories: index set directly by mod_cat (no subshell per module)
    local -a cats=()
    for (( i = 0; i < total; i++ )); do
        mod_cat "${names[i]}"
        cats[_CI]+="${cats[_CI]:+ }$i"
    done
    for (( j = 0; j < ${#CAT_ORDER[@]}; j++ )); do
        [[ -n "${cats[j]:-}" ]] || continue
        mod_icon_v "$j"; _tk "mod_${CAT_ORDER[j]}"
        printf '\n  %s┌───%s %s%s%s%s\n' "$C" "$RESET" "$_IC" "$BOLD" "$_TK" "$RESET"
        for i in ${cats[j]}; do
            fmt_size_v "${sizes[i]}"; size_color_v "${sizes[i]}"
            printf '  %s│%s  %s%s%-*s%s %s%10s%s\n' \
                "$C" "$RESET" "$_IC" "$BOLD" "$(( nw + 4 ))" "${names[i]}" "$RESET" "$_SC" "$_FS" "$RESET"
        done
        printf '  %s└┘%s\n' "$C" "$RESET"
    done

    local a b c d e
    _tk mod_size_legend; a=$_TK; _tk mod_size_small; b=$_TK; _tk mod_size_med; c=$_TK
    _tk mod_size_large; d=$_TK; _tk mod_size_huge; e=$_TK
    printf '\n  %s%s:%s %s%s%s  %s%s%s  %s%s%s  %s%s%s\n' \
        "$BOLD" "$a" "$RESET" "$G" "$b" "$RESET" "$C" "$c" "$RESET" "$Y" "$d" "$RESET" "$R" "$e" "$RESET"
    _now
    printf '\n  %s%s v%s | %s%s\n\n' "$DIM" "$_WU_NAME" "$_WU_VERSION" "$_NOW" "$RESET"
}

wu_run main "$@"
