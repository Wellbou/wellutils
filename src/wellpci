#!/usr/bin/env bash
# wellpci v2 -- Beautiful PCI device listing with IDS database lookup
# Part of wellutils by wellbou_
set -euo pipefail

# ─── Shared libs ────────────────────────────────────────────────
_WU_TOOLNAME="wellpci" _WU_NAME="WellPCI" _WU_VERSION="2.1" _WU_MANUAL=1
_WU_TAGLINE="PCI device listing with IDS database lookup"
_WU_BOOT_DIR="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="$(dirname -- "$_WU_BOOT_DIR")/share/wellutils"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="/usr/local/share/wellutils"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="/usr/share/wellutils"
source "$_WU_BOOT_DIR/bootstrap.sh" lang box cli parse
_PCI_ALL=0

wpci_extra_parse() {
    case "$1" in
        --all)  _PCI_ALL=1; _WU_EXTRA_CONSUMED=1; return 0 ;;
    esac
    return 1
}
_WU_EXTRA_PARSE=wpci_extra_parse
_WU_EXTRA_HELP="      --all                   show all devices (default: expansion cards only)"


# ─── Colors ──────────────────────────────────────────────────────
R=$'\033[1;31m'  G=$'\033[1;32m'  Y=$'\033[1;33m'  B=$'\033[1;34m'
M=$'\033[1;35m'  C=$'\033[1;36m'  W=$'\033[1;37m'  DIM=$'\033[2m'
BOLD=$'\033[1m'  RESET=$'\033[0m'

PCI_IDS=${_WU_PCI_IDS:-}   # located by box.sh
PCI_SYSFS=${WELLPCI_SYSFS_ROOT:-/sys/bus/pci/devices}   # override: tests

# ─── Fork-free helpers ──────────────────────────────────────────
# _tk KEY -> $_TK  (t() without a $(...) subshell)
_tk() {
    _TK=""
    if [[ "$WELLUTILS_LANG" == "RU" && -n ${_T_RU[$1]+x} ]]; then _TK=${_T_RU[$1]}; fi
    if [[ -z "$_TK" && -n ${_T_EN[$1]+x} ]]; then _TK=${_T_EN[$1]}; fi
    [[ -n "$_TK" ]] || _TK=$1
}
_rd() { _V=""; { IFS= read -r _V < "$1"; } 2>/dev/null || true; _V=${_V%$'\r'}; }
# _jev STR -> $_JE (JSON-escaped; control chars go through cli.sh json_esc)
_jev() {
    local LC_ALL=C
    _JE=$1
    # control chars or invalid UTF-8 (Latin-1 "Kingst\xf6n") -> full json_esc
    if [[ "$_JE" == *[$'\001'-$'\037'$'\177'$'\200'-$'\377']* ]]; then
        if [[ "$_JE" == *[$'\001'-$'\037'$'\177']* ]]; then _JE=$(json_esc "$1"); return; fi
        _wu_utf8_fix "$_JE" _JE
    fi

    _JE=${_JE//\\/\\\\}; _JE=${_JE//\"/\\\"}
}

# ─── PCI class helpers (set $_CN / $_CC / $_CI) ─────────────────
pci_class_name_v() {
    case "${1:0:2}" in
        00) _tk pci_class_legacy ;;    01) _tk pci_class_storage ;;
        02) _tk pci_class_network ;;   03) _tk pci_class_display ;;
        04) _tk pci_class_multimedia ;; 05) _tk pci_class_memory ;;
        06) _tk pci_class_bridge ;;    07) _tk pci_class_comm ;;
        08) _tk pci_class_system ;;    09) _tk pci_class_input ;;
        0a) _tk pci_class_dock ;;      0b) _tk pci_class_processor ;;
        0c) _tk pci_class_serial ;;    0d) _tk pci_class_wireless ;;
        ff) _tk pci_class_vendor ;;    *)  _tk pci_class_unknown ;;
    esac
    _CN=$_TK
}

pci_class_color_v() {
    case "${1:0:2}" in
        03) _CC=$G ;; 02) _CC=$C ;; 01) _CC=$Y ;;
        04) _CC=$M ;; 0c) _CC=$B ;; 06) _CC=$DIM ;;
        *)  _CC=$W ;;
    esac
}

pci_class_icon_v() {
    local e
    case "${1:0:2}" in
        03) e="🎮" ;; 02) e="🌐" ;; 01) e="💾" ;; 04) e="🔊" ;; 0c) e="🔌" ;;
        06) e="🌉" ;; 08) e="⌨" ;; 0d) e="📡" ;; *) e="🔧" ;;
    esac
    _CI=""
    [[ "$_WU_EMOJI" == "yes" ]] && _CI="${e//$_WU_VS16/} "
    return 0
}

# Expansion-card filter (same rules as box.sh pci_slot_devices):
# drop bridges/memory/processors/SMBus/FireWire; always keep display,
# wireless, RAID, NVMe; on bus 00 drop the remaining chipset functions,
# on other buses drop embedded storage/network/comm/USB.
_pci_is_slot() {   # $1 = addr  $2 = class hex (6 digits)
    local bus=${1#*:} major=${2:0:2} sub=${2:2:2}
    bus=${bus%%:*}
    case "$major" in 06|05|0b) return 1 ;; esac
    [[ "$major" == "0c" && ( "$sub" == "05" || "$sub" == "00" ) ]] && return 1
    [[ "$major" == "03" || "$major" == "0d" ]] && return 0
    [[ "$major" == "01" && ( "$sub" == "04" || "$sub" == "08" ) ]] && return 0
    [[ "$bus" == "00" ]] && return 1
    case "$major" in 01|02|07|0c) return 1 ;; esac
    return 0
}

# ─── Scan (fills global arrays + count/total) ───────────────────
# All data from sysfs + ONE `lspci -D` (descriptions) + ONE awk pass over
# pci.ids (vendor/device names). Without lspci (busybox/Termux) the
# description falls back to "Vendor Device" from pci.ids.
pci_scan() {
    ADDRS=() CLASSES=() DRIVERS=() VENDORS=() DEVICES=() DESCS=() VENDOR_NAMES=() DEVICE_NAMES=()
    LINK_SPD=() LINK_WID=()
    count=0 total=0
    [[ -d "$PCI_SYSFS" ]] || return 0
    local d addr cls vid did drv line i
    local -a qs=()
    for d in "$PCI_SYSFS"/*; do
        [[ -e "$d" ]] || continue
        addr=${d##*/}
        _rd "$d/class"; cls=${_V#0x}; [[ -n "$cls" ]] || cls=000000
        total=$(( total + 1 ))
        [[ "$_PCI_ALL" == "1" ]] || _pci_is_slot "$addr" "$cls" || continue
        _rd "$d/vendor"; vid=${_V#0x}; vid=${vid,,}; [[ -n "$vid" ]] || vid=0000
        _rd "$d/device"; did=${_V#0x}; did=${did,,}; [[ -n "$did" ]] || did=0000
        drv="none"
        if [[ -r "$d/uevent" ]]; then
            while IFS= read -r line; do
                case "$line" in DRIVER=*) drv=${line#DRIVER=}; break ;; esac
            done < "$d/uevent" 2>/dev/null || true
        fi
        _rd "$d/current_link_speed"; LINK_SPD+=("$_V")
        _rd "$d/current_link_width"; LINK_WID+=("$_V")
        ADDRS+=("$addr") CLASSES+=("$cls") DRIVERS+=("$drv") VENDORS+=("$vid") DEVICES+=("$did")
        DESCS+=("") VENDOR_NAMES+=("") DEVICE_NAMES+=("")
        qs+=("$vid:$did")
        count=$(( count + 1 ))
    done
    (( count )) || return 0

    local -A idx=()
    for (( i = 0; i < count; i++ )); do idx[${ADDRS[i]}]=$i; done
    if command -v lspci >/dev/null 2>&1; then
        while IFS= read -r line; do
            i=${idx[${line%% *}]:-}
            [[ -n "$i" ]] && DESCS[i]=${line#* }
        done < <(lspci -D 2>/dev/null || true)
    fi

    local -A vn=() dn=()
    local q v n
    while IFS=$'\t' read -r q v n _; do
        [[ -n "$q" ]] || continue
        vn[$q]=$v dn[$q]=$n
    done < <(wu_pci_lookup "${qs[@]}")
    _tk hw_unknown; local unk=$_TK
    for (( i = 0; i < count; i++ )); do
        q=${qs[i]}
        v=${vn[$q]:-} n=${dn[$q]:-}
        VENDOR_NAMES[i]=${v:-$unk}
        DEVICE_NAMES[i]=${n:-[$q]}
        if [[ -z "${DESCS[i]}" ]]; then
            if [[ -n "$v$n" ]]; then DESCS[i]="${v}${v:+${n:+ }}${n}"
            else DESCS[i]="[$q]"; fi
        fi
    done
}

# ─── JSON output ────────────────────────────────────────────────
json_out() {
    pci_scan

    wu_json_head "$_WU_TOOLNAME" "$_WU_VERSION"
    printf ',\n  "summary": { "devices": %d, "total": %d, "filter": "%s" },\n' \
        "$count" "$total" "$([[ "$_PCI_ALL" == 1 ]] && printf all || printf expansion)"
    printf '  "ids_db_loaded": %s,\n' "$([[ -n $PCI_IDS ]] && printf 'true' || printf 'false')"
    printf '  "devices": ['
    local i f v first=1 cls wid
    for (( i = 0; i < count; i++ )); do
        cls=${CLASSES[i]}
        pci_class_name_v "$cls"
        (( first )) && { first=0; printf '\n'; } || printf ',\n'
        printf '    {'
        for f in addr class major class_name vendor_id device_id vendor device description driver link_speed link_width; do
            case "$f" in
                addr) v=${ADDRS[i]} ;; class) v=$cls ;; major) v=${cls:0:2} ;; class_name) v=$_CN ;;
                vendor_id) v=${VENDORS[i]} ;; device_id) v=${DEVICES[i]} ;;
                vendor) v=${VENDOR_NAMES[i]} ;; device) v=${DEVICE_NAMES[i]} ;;
                description) v=${DESCS[i]} ;; driver) v=${DRIVERS[i]} ;;
                link_speed) v=${LINK_SPD[i]}; [[ "$v" == Unknown* ]] && v="" ;;
                link_width) v=${LINK_WID[i]}; [[ "$v" == 0 ]] && v="" ;;
            esac
            _jev "$v"
            [[ "$f" == addr ]] && printf ' "%s": "%s"' "$f" "$_JE" || printf ', "%s": "%s"' "$f" "$_JE"
        done
        printf ' }'
    done
    (( first )) && printf ']\n' || printf '\n  ]\n'
    wu_json_end
}

# ─── Main ────────────────────────────────────────────────────────
main() {
    if [[ "$_WU_JSON" == "1" ]]; then json_out; return 0; fi

    local ic=""
    [[ "$_WU_EMOJI" == "yes" ]] && ic="🌉 "
    _tk pci_title
    printf '\n  %s╔═╗%s\n' "$C" "$RESET"
    printf '  %s║%s  %s%s%swellpci -- %s%s\n' "$C" "$RESET" "$ic" "$BOLD" "$W" "$_TK" "$RESET"
    printf '  %s╚═╝%s\n' "$C" "$RESET"

    pci_scan

    local ids_status L_db
    if [[ -n $PCI_IDS ]]; then _tk loaded; ids_status="${G}${_TK}${RESET}"
    else _tk not_found; ids_status="${R}${_TK}${RESET}"; fi
    _tk usb_ids_db; L_db=$_TK
    ic=""; [[ "$_WU_EMOJI" == "yes" ]] && ic="📊 "
    if [[ "$_PCI_ALL" == "1" ]]; then
        _tk pci_total
        printf '  %s%s%s:%s %d  |  %s%s:%s %s\n' "$ic" "$BOLD" "$_TK" "$W" "$count" "$BOLD" "$L_db" "$W" "$ids_status"
    else
        local L_shown L_of L_hint
        _tk pci_shown; L_shown=$_TK; _tk pci_of; L_of=$_TK; _tk pci_hint_all; L_hint=$_TK
        printf '  %s%s%s:%s %d %s %d%s  |  %s%s:%s %s\n' "$ic" "$BOLD" "$L_shown" "$W" "$count" "$L_of" "$total" "$RESET" \
            "$BOLD" "$L_db" "$W" "$ids_status"
        local _WU_COLS; _wu_cols
        _wu_wrap_print '  ' $(( _WU_COLS - 4 )) "$L_hint" "$DIM"

    fi
    printf '\n'

    if (( count == 0 )); then
        _tk per_pci_none
        printf '\n  %s%s%s\n' "$DIM" "$_TK" "$RESET"
    fi

    # display order: grouped by class, then address (stable insertion sort)
    local -a ord=()
    local i j x n
    for (( i = 0; i < count; i++ )); do ord+=("${CLASSES[i]:0:2} ${ADDRS[i]} $i"); done
    n=${#ord[@]}
    # byte-order compare: [[ > ]] collates by locale (ru_RU/en_US skip ":" ".")
    _pci_sort_ord() {
        local LC_ALL=C
        for (( i = 1; i < n; i++ )); do
            x=${ord[i]}; j=$(( i - 1 ))
            while (( j >= 0 )) && [[ "${ord[j]}" > "$x" ]]; do ord[j+1]=${ord[j]}; j=$(( j - 1 )); done
            ord[j+1]=$x
        done
        return 0
    }
    _pci_sort_ord


    local _WU_COLS _WU_VL _WU_CAP maxw lbl
    _wu_cols; maxw=$(( _WU_COLS - 4 ))
    _tk pci_drv; lbl="$_TK:"
    local prev_major="" addr cls drv desc major spd wid link fixed desc_max drv_txt drv_badge
    for (( j = 0; j < n; j++ )); do
        i=${ord[j]##* }
        addr=${ADDRS[i]} cls=${CLASSES[i]} drv=${DRIVERS[i]} desc=${DESCS[i]}
        major=${cls:0:2}
        if [[ "$major" != "$prev_major" ]]; then
            pci_class_name_v "$cls"; pci_class_color_v "$cls"; pci_class_icon_v "$cls"
            [[ -n "$prev_major" ]] && printf '  %s└┘%s\n' "$C" "$RESET"
            printf '  %s┌───%s %s%s%s%s%s\n' "$C" "$RESET" "$_CI" "$BOLD" "$_CC" "$_CN" "$RESET"
            prev_major=$major
        fi
        pci_class_color_v "$cls"; pci_class_icon_v "$cls"

        # PCIe link badge: skip "Unknown" speed and width 0 (no link / legacy PCI)
        spd=${LINK_SPD[i]} wid=${LINK_WID[i]} link=""
        [[ -n "$spd" && "$spd" != Unknown* && "$wid" != "0" ]] && link="  $spd${wid:+ x$wid}"

        _wu_cap_v "$drv" 16; drv_txt=$_WU_CAP
        _wu_vislen_v "  $_CI$addr    $lbl$drv_txt$link"; fixed=$_WU_VL
        desc_max=$(( maxw - fixed )); (( desc_max < 16 )) && desc_max=16
        _wu_cap_v "$desc" "$desc_max"; desc=$_WU_CAP
        if [[ "$drv" == "none" ]]; then drv_badge="${DIM}${drv_txt}${RESET}"; else drv_badge="${G}${drv_txt}${RESET}"; fi
        printf '  %s│%s  %s%s%s%s  %s%s%s  %s%s%s%s%s\n' \
            "$C" "$RESET" "$_CI" "$BOLD" "$addr" "$RESET" "$_CC" "$desc" "$RESET" \
            "$lbl" "$drv_badge" "$DIM" "$link" "$RESET"
    done
    (( count )) && printf '  %s└┘%s\n' "$C" "$RESET"

    local now=""
    printf -v now '%(%Y-%m-%d %H:%M:%S)T' -1 2>/dev/null || now=$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null)
    printf '\n  %s%s v%s | %s%s\n\n' "$DIM" "$_WU_NAME" "$_WU_VERSION" "$now" "$RESET"
}

wu_run main "$@"
