#!/usr/bin/env bash
# WellSensors v1.3 -- Beautiful system temperature monitor
# by wellbou_
set -euo pipefail

# ─── Shared libs ────────────────────────────────────────────────
_WU_TOOLNAME="wellsensors" _WU_NAME="WellSensors" _WU_VERSION="1.3"
_WU_SHORT_OK=1
_WU_TAGLINE="Beautiful system temperature monitor"
_WU_BOOT_DIR="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="$(dirname -- "$_WU_BOOT_DIR")/share/wellutils"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="/usr/local/share/wellutils"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="/usr/share/wellutils"
source "$_WU_BOOT_DIR/bootstrap.sh" lang box cli parse
# ─── Rare-hardware guards (Termux/PS5/ARM/laptops may lack tools) ──
command -v awk    >/dev/null 2>&1 || awk()    { :; }
command -v nproc  >/dev/null 2>&1 || nproc()  { getconf _NPROCESSORS_ONLN 2>/dev/null || printf '1'; }
command -v date   >/dev/null 2>&1 || date()   { printf '%s' '1970-01-01 00:00:00'; }

RED_BG=$'\033[1;97;41m'
ORANGE=$'\033[1;38;5;208m'

# ─── Watch / real-time mode ────────────────────────────────────
_WS_WATCH=0
_WS_INTERVAL=2

ws_extra_parse() {
    case "$1" in
        --cli)
            _WS_WATCH=1
            _WU_EXTRA_CONSUMED=1
            if [[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]]; then
                _WS_INTERVAL=$(( 10#$2 )); (( _WS_INTERVAL >= 1 )) || _WS_INTERVAL=1
                _WU_EXTRA_CONSUMED=2
            fi
            return 0 ;;
        --cli=*)
            _WS_WATCH=1
            _WU_EXTRA_CONSUMED=1
            if [[ "${1#*=}" =~ ^[0-9]+$ ]]; then
                _WS_INTERVAL=$(( 10#${1#*=} )); (( _WS_INTERVAL >= 1 )) || _WS_INTERVAL=1
            fi
            return 0 ;;
    esac
    return 1
}
_WU_EXTRA_PARSE=ws_extra_parse
_WU_EXTRA_HELP="      --cli [sec]             live view, refresh every sec (default 2)"

# ─── Rendering helpers (fork-free: they set variables) ──────────
# Emoji and bar glyphs are resolved once per run in _ws_init_glyphs
# (after the CLI decided about emoji/unicode), not per sensor row.
_WS_E=() _WS_BARS=() _WS_IC_FAN="" _WS_IC_MIN="" _WS_IC_AVG="" _WS_IC_MAX=""
_ws_init_glyphs() {
    _WS_E=( "$(_emu '❄')" "$(_emu '🌊')" "$(_emu '🔥')" "$(_emu '🌋')" "$(_emu '💀')" )
    _WS_IC_FAN=$(_ic '💨') _WS_IC_MIN=$(_ic '📈') _WS_IC_AVG=$(_ic '📉') _WS_IC_MAX=$(_ic '🔺')
    local i s="" g _WU_VL
    # Text-presentation glyphs (❄ without VS16) are 1 column: pad every
    # non-empty temperature emoji to 2 columns so tline rows stay aligned.
    for (( i = 0; i < ${#_WS_E[@]}; i++ )); do
        [[ -n "${_WS_E[i]}" ]] || continue
        _wu_vislen_v "${_WS_E[i]}"
        (( _WU_VL < 2 )) && _WS_E[i]+=" "
    done
    _WS_BARS=()
    for (( i = 0; i < 8; i++ )); do
        g=$(wu_scale "$i"); s+=$g; _WS_BARS+=("$s")
    done
}

# _ws_color_v T -> _WS_COL
_ws_color_v() {
    local t=$1
    if   (( t < 40 )); then _WS_COL=$G
    elif (( t < 55 )); then _WS_COL=$Y
    elif (( t < 70 )); then _WS_COL=$ORANGE
    elif (( t < 85 )); then _WS_COL=$R
    else                     _WS_COL=$RED_BG
    fi
}
# _ws_emoji_v T -> _WS_EMO
_ws_emoji_v() {
    local t=$1
    if   (( t < 35 )); then _WS_EMO=${_WS_E[0]-}
    elif (( t < 50 )); then _WS_EMO=${_WS_E[1]-}
    elif (( t < 65 )); then _WS_EMO=${_WS_E[2]-}
    elif (( t < 80 )); then _WS_EMO=${_WS_E[3]-}
    else                     _WS_EMO=${_WS_E[4]-}
    fi
}
# _ws_bar_v T [MAX] -> _WS_BAR (colored)
_ws_bar_v() {
    local t=$1 max=${2:-100} idx _WS_COL
    (( max > 0 )) || max=100
    idx=$(( t * 8 / max ))
    (( idx > 7 )) && idx=7
    (( idx < 0 )) && idx=0
    _ws_color_v "$t"
    _WS_BAR="${_WS_COL}${_WS_BARS[idx]-}${RESET}"
}

# Backward-compatible printing wrappers.
temp_color() { local _WS_COL; _ws_color_v "$1"; printf '%s' "$_WS_COL"; }
temp_emoji() { local _WS_EMO; _ws_emoji_v "$1"; printf '%s' "$_WS_EMO"; }
temp_bar()   { local _WS_BAR; _ws_bar_v "$1" "${2:-100}"; printf '%s' "$_WS_BAR"; }

_WS_LW=16   # label column: capped AND padded to the same width
# tline LABEL TEMP [BARMAX] [SUFFIX] [NOCAP]
tline() {
    local label="$1" temp="$2" bmax="${3:-100}" suffix="${4:-}" nocap="${5:-}"
    local _WS_COL _WS_EMO _WS_BAR _WU_CAP _WU_VL val pad
    _ws_color_v "$temp"; _ws_emoji_v "$temp"; _ws_bar_v "$temp" "$bmax"
    if [[ -z "$nocap" ]]; then _wu_cap_v "$label" "$_WS_LW"; label=$_WU_CAP; fi
    _wu_vislen_v "$label"
    printf -v pad '%*s' $(( _WU_VL < _WS_LW ? _WS_LW - _WU_VL : 0 )) ''
    printf -v val '%4d°C' "$temp"
    _LINES+=( "  ${_WS_EMO} ${BOLD}${W}${label}${pad}${RESET} ${_WS_COL}${val}${RESET}  ${_WS_BAR}${suffix}" )
}

# ─── Sensor classification: ONE list used by every section ──────
# _ws_class NAME -> _WS_CLS = cpu | gpu | acpi | disk | other
_ws_class() {
    case "$1" in
        coretemp|k10temp|k8temp|zenpower|via_cputemp|cputemp|cpu_temp|ibmpowernv|macsmc*|\
        cpu*thermal*|*-cpu-thermal|*_cpu_thermal|soc*thermal*|soc_dts*|cpuss*|bigcore*|littlecore*|\
        cluster*thermal*|loongson*|sparc*temp*|x86_pkg_temp)
            _WS_CLS=cpu ;;
        amdgpu|radeon|nouveau|i915|xe|gpu*thermal*|*-gpu-thermal)
            _WS_CLS=gpu ;;
        acpitz|acpitz_*|acpitz-*)
            _WS_CLS=acpi ;;
        nvme|drivetemp)
            _WS_CLS=disk ;;
        *)  _WS_CLS=other ;;
    esac
}

# ─── One fork-free hwmon scan shared by all sections ────────────
# hwmonN is either the attribute dir itself or (old drivers such as
# f71882fg) a stub whose attrs live on the parent device. We take exactly
# ONE source dir per hwmon and de-duplicate source dirs by inode (-ef), so
# no file is ever read twice and no readlink/cat forks are needed.
_ws_has_inputs() {
    local a
    for a in "$1"/temp*_input "$1"/fan*_input; do [[ -e "$a" ]] && return 0; done
    return 1
}

_ws_scan() {
    _WS_H_DIR=() _WS_H_NAME=() _WS_H_CLS=() _WS_H_VIRT=() _WS_H_NT=()
    _WS_T_H=() _WS_T_IDX=() _WS_T_LBL=() _WS_T_C=() _WS_T_HI=() _WS_T_CR=() _WS_T_OK=() _WS_T_IN=()
    _WS_F_H=() _WS_F_IDX=() _WS_F_RPM=()
    local h src hn virt f fn idx v lbl hi cr ok u dup hidx nt a b c
    local -a srcs=()
    for h in /sys/class/hwmon/hwmon*; do
        [[ -d "$h" ]] || continue
        src=$h
        if ! _ws_has_inputs "$h" && [[ -d "$h/device" ]] && _ws_has_inputs "$h/device"; then
            src="$h/device"
        fi
        dup=0
        for u in ${srcs[@]+"${srcs[@]}"}; do [[ "$u" -ef "$src" ]] && { dup=1; break; }; done
        (( dup )) && continue
        srcs+=("$src")
        hn=""
        wu_read "$h/name" hn || wu_read "$src/name" hn || true
        wu_trim "$hn" hn
        [[ -n "$hn" ]] || hn=chip
        _ws_class "$hn"
        # hwmon of a thermal zone (/sys/devices/virtual/thermal/...): those
        # are already listed in THERMAL ZONES (ARM would show them twice).
        virt=0
        [[ -e "$h/device/available_policies" || -e "$h/device/policy" ]] && virt=1
        hidx=${#_WS_H_DIR[@]}
        nt=0
        for f in "$src"/temp*_input; do
            [[ -e "$f" ]] || continue
            v=""; wu_read "$f" v || continue
            [[ "$v" =~ ^-?[0-9]+$ ]] || continue
            fn=${f##*/}; idx=${fn#temp}; idx=${idx%_input}
            b=${f%_input}
            lbl=""; wu_read "${b}_label" lbl || true
            wu_trim "$lbl" lbl
            hi="" cr=""
            for a in high max crit; do
                c=""; wu_read "${b}_$a" c || true
                [[ "$c" =~ ^-?[0-9]+$ ]] || continue
                (( c > 0 )) || continue
                [[ "$a" == crit ]] && cr=$(( c / 1000 ))
                [[ -z "$hi" ]] && hi=$(( c / 1000 ))
            done
            v=$(( v / 1000 ))
            # fault set / out-of-range -> wire cut / unpopulated thermistor.
            # (alarm / crit_alarm mean "too hot": the reading is real and
            # must stay visible.)
            ok=1
            (( v <= 0 || v >= 150 )) && ok=0
            c=""
            if wu_read "${b}_fault" c && [[ "$c" == 1 ]]; then ok=0; fi
            _WS_T_H+=("$hidx") _WS_T_IDX+=("$idx") _WS_T_LBL+=("$lbl") _WS_T_C+=("$v")
            _WS_T_HI+=("$hi") _WS_T_CR+=("$cr") _WS_T_OK+=("$ok") _WS_T_IN+=("$fn")
            (( ok )) && nt=$(( nt + 1 ))
        done
        for f in "$src"/fan*_input; do
            [[ -e "$f" ]] || continue
            v=""; wu_read "$f" v || continue
            [[ "$v" =~ ^[0-9]+$ ]] || continue
            fn=${f##*/}; idx=${fn#fan}; idx=${idx%_input}
            _WS_F_H+=("$hidx") _WS_F_IDX+=("$idx") _WS_F_RPM+=("$v")
        done
        _WS_H_DIR+=("$h") _WS_H_NAME+=("$hn") _WS_H_CLS+=("$_WS_CLS") _WS_H_VIRT+=("$virt") _WS_H_NT+=("$nt")
    done
    _WS_SHOWN=() _WS_CPU_SHOWN=0
}
declare -A _WS_SHOWN=()
_WS_CPU_SHOWN=0

# NVIDIA: one nvidia-smi call per report, shared by GPU box, summary, JSON.
_WS_NV_Q=name,temperature.gpu,fan.speed,power.draw,clocks.current.graphics,clocks.current.memory,memory.total,memory.used,utilization.gpu,pci.bus_id
_ws_nv_query() {
    _WS_NV=""
    command -v nvidia-smi >/dev/null 2>&1 || return 0
    _WS_NV=$(nvidia-smi --query-gpu="$_WS_NV_Q" --format=csv,noheader,nounits 2>/dev/null) || _WS_NV=""
    return 0
}
# _ws_nv_parse LINE -> nv_* vars (trimmed)
_ws_nv_parse() {
    local x
    IFS=',' read -r nv_name nv_temp nv_fan nv_pow nv_clk nv_mclk nv_vtot nv_vused nv_util nv_bus _ <<< "$1"
    for x in nv_name nv_temp nv_fan nv_pow nv_clk nv_mclk nv_vtot nv_vused nv_util nv_bus; do
        wu_trim "${!x-}" "$x"
    done
    [[ "$nv_pow" == "[N/A]" || "$nv_pow" == "N/A" || -z "$nv_pow" ]] && nv_pow="N/A"
    nv_bus=${nv_bus/#00000000:/0000:}
    nv_aib="" nv_aibhex=""
    if [[ -n "$nv_bus" ]]; then
        nv_aib=$(gpu_aib_vendor "$nv_bus")
        wu_read "/sys/bus/pci/devices/$nv_bus/subsystem_vendor" nv_aibhex || true
        nv_aibhex=${nv_aibhex#0x}
    fi
    [[ -n "$nv_aib" && "$nv_aib" != NVIDIA ]] && nv_name="${nv_aib} ${nv_name#NVIDIA }"
    return 0
}

# _ws_gpu_info HIDX -> _WS_GN (display name) _WS_GAIB _WS_GAIBHEX _WS_GBUS _WS_GMHZ
_ws_gpu_info() {
    local h=${_WS_H_DIR[$1]} hn=${_WS_H_NAME[$1]} d k v vid="" did="" slot="" r dn="" vend="" l
    d="$h/device"
    _WS_GN="" _WS_GAIB="" _WS_GAIBHEX="" _WS_GBUS="" _WS_GMHZ=""
    if [[ -r "$d/uevent" ]]; then
        while IFS='=' read -r k v; do
            case "$k" in
                PCI_SLOT_NAME) slot=$v ;;
                PCI_ID) vid=${v%%:*} did=${v#*:} ;;
            esac
        done < "$d/uevent" 2>/dev/null || true
    fi
    case "$hn" in
        amdgpu|radeon) vend=AMD ;;
        i915|xe)       vend=Intel ;;
        nouveau)       vend=NVIDIA ;;
    esac
    if [[ -n "$slot" ]]; then
        _WS_GBUS=$slot
        _WS_GAIB=$(gpu_aib_vendor "$slot")
        wu_read "$d/subsystem_vendor" _WS_GAIBHEX || true
        _WS_GAIBHEX=${_WS_GAIBHEX#0x}
    fi
    if [[ -n "$vid" && -n "$did" ]]; then
        r=$(wu_pci_lookup "${vid,,}:${did,,}")
        IFS=$'\t' read -r _ _ dn _ <<< "$r"
    fi
    if [[ -n "$dn" ]]; then
        _WS_GN="${vend:+$vend }$dn"
    else
        case "$hn" in
            amdgpu|radeon) _WS_GN="AMD GPU" ;;
            i915|xe)       _WS_GN=$(t sens_intel_gpu) ;;
            nouveau)       _WS_GN="NVIDIA GPU (nouveau)" ;;
            *)             _WS_GN=$hn ;;
        esac
    fi
    [[ -n "$_WS_GAIB" && "$_WS_GAIB" != "$vend" ]] && _WS_GN="$_WS_GAIB $_WS_GN"
    # current core clock: hwmon freq1_input (Hz) or amdgpu pp_dpm_sclk "1: 1200Mhz *"
    v=""
    if wu_read "$h/freq1_input" v && [[ "$v" =~ ^[0-9]+$ ]] && (( v > 0 )); then
        _WS_GMHZ=$(( v / 1000000 ))
    elif [[ -r "$d/pp_dpm_sclk" ]]; then
        while IFS= read -r l; do
            [[ "$l" == *'*'* ]] || continue
            l=${l#*: }; l=${l%% *}; l=${l%[Mm]hz}
            [[ "$l" =~ ^[0-9]+$ ]] && _WS_GMHZ=$l
            break
        done < "$d/pp_dpm_sclk" 2>/dev/null || true
    fi
    return 0
}

# _ws_gpu_temp HIDX -> _WS_GT (first valid temperature of that hwmon)
_ws_gpu_temp() {
    local i
    _WS_GT=""
    for (( i = 0; i < ${#_WS_T_C[@]}; i++ )); do
        [[ "${_WS_T_H[i]}" == "$1" && "${_WS_T_OK[i]}" == 1 ]] || continue
        (( _WS_T_C[i] < 125 )) || continue
        _WS_GT=${_WS_T_C[i]}; return 0
    done
}

# Row label for a temp input: "Core 0", or "chip label/idx" on multi-input chips.
_ws_label_v() {
    local i=$1 h=${_WS_T_H[$1]} hn
    hn=${_WS_H_NAME[h]}
    if (( ${_WS_H_NT[h]} > 1 )); then
        _WS_LBL="$hn ${_WS_T_LBL[i]:-${_WS_T_IDX[i]}}"
    else
        _WS_LBL=${_WS_T_LBL[i]:-$hn}
    fi
}

# CPU row label: sysfs label, else "chip idx" (multi-input) or chip name.
# Shared by text and JSON so both agree. -> _WS_CLBL
_ws_cpu_label_v() {
    local i=$1 h=${_WS_T_H[$1]}
    _WS_CLBL=${_WS_T_LBL[i]}
    [[ -n "$_WS_CLBL" ]] && return 0
    if (( ${_WS_H_NT[h]} > 1 )); then _WS_CLBL="${_WS_H_NAME[h]} ${_WS_T_IDX[i]}"
    else _WS_CLBL=${_WS_H_NAME[h]}; fi
    return 0
}

# ─── Sections ───────────────────────────────────────────────────
print_cpu() {
    local i h found=0 temp hi cr suffix lbl _WS_CLBL
    for (( i = 0; i < ${#_WS_T_C[@]}; i++ )); do
        h=${_WS_T_H[i]}
        [[ "${_WS_H_CLS[h]}" == cpu ]] || continue
        temp=${_WS_T_C[i]}
        (( temp > -50 && temp < 200 )) || continue
        hi=${_WS_T_HI[i]} cr=${_WS_T_CR[i]}
        _ws_cpu_label_v "$i"; lbl=$_WS_CLBL
        suffix=""
        [[ -n "$hi" && "$hi" != "$cr" ]] && suffix+="  hi:${hi}°"
        if [[ -n "$cr" ]]; then [[ -n "$suffix" ]] && suffix+=" " || suffix="  "; suffix+="crit:${cr}°"; fi
        if [[ -n "$cr" ]] && (( temp >= cr )); then
            suffix+="  ${R}$(t sens_crit_throttle)${RESET}"
        elif [[ -n "$hi" ]] && (( temp >= hi )); then
            suffix+="  ${Y}$(t sens_high_throttle)${RESET}"
        fi
        tline "$lbl" "$temp" 100 "$suffix"
        _WS_SHOWN[${_WS_H_NAME[h]}]=1
        _WS_CPU_SHOWN=1
        found=1
    done
    (( found )) || pline "${DIM}$(t sens_no_cpu)${RESET}"
}

print_gpu() {
    local found_gpu=0 line h nv_name nv_temp nv_fan nv_pow nv_clk nv_mclk nv_vtot nv_vused nv_util nv_bus nv_aib nv_aibhex
    local _WS_GN _WS_GAIB _WS_GAIBHEX _WS_GBUS _WS_GMHZ _WS_GT pw fan clk mclk util vram unk
    unk=$(t hw_unknown)
    while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        _ws_nv_parse "$line"
        [[ "$nv_temp" =~ ^[0-9]+$ ]] || continue
        # legacy/datacenter boards answer "[N/A]" / "[Not Supported]":
        # show "unknown" without a unit instead of "[N/A]%".
        pw=$unk; [[ "$nv_pow" =~ ^[0-9]+(\.[0-9]+)?$ ]] && pw="${nv_pow}W"
        fan=$unk; [[ "$nv_fan" =~ ^[0-9]+$ ]] && fan="${nv_fan}%"
        clk=$unk; [[ "$nv_clk" =~ ^[0-9]+$ ]] && clk="${nv_clk} MHz"
        mclk=$unk; [[ "$nv_mclk" =~ ^[0-9]+$ ]] && mclk="${nv_mclk} MHz"
        util=$unk; [[ "$nv_util" =~ ^[0-9]+$ ]] && util="${nv_util}%"
        vram=$unk; [[ "$nv_vused" =~ ^[0-9]+$ && "$nv_vtot" =~ ^[0-9]+$ ]] && vram="${nv_vused} / ${nv_vtot} MiB"
        tline "$nv_name" "$nv_temp" 100 "" nocap
        _LINES+=( "  ${DIM}  ├── $(t gpu_fan): ${fan}  |  $(t gpu_power): ${pw}  |  GPU: ${clk}${RESET}" )
        _LINES+=( "  ${DIM}  └── $(t gpu_vram): ${vram}  |  $(t gpu_util): ${util}  |  Mem: ${mclk}${RESET}" )
        found_gpu=1
    done <<< "${_WS_NV-}"

    for (( h = 0; h < ${#_WS_H_DIR[@]}; h++ )); do
        [[ "${_WS_H_CLS[h]}" == gpu ]] || continue
        _ws_gpu_temp "$h"
        [[ -n "$_WS_GT" ]] || continue
        _ws_gpu_info "$h"
        tline "$_WS_GN" "$_WS_GT" 100 "" nocap
        [[ -n "$_WS_GMHZ" ]] && _LINES+=( "  ${DIM}  └── $(t sens_clock): ${_WS_GMHZ} MHz${RESET}" )
        _WS_SHOWN[${_WS_H_NAME[h]}]=1
        found_gpu=1
    done

    if (( found_gpu == 0 )); then
        if command -v nvidia-smi &>/dev/null; then
            pline "${DIM}$(t sens_no_gpu)${RESET}"
        else
            pline "${DIM}$(t gpu_nvidia_none)${RESET}"
        fi
    fi
}

print_acpi() {
    local i h n=0
    for (( i = 0; i < ${#_WS_T_C[@]}; i++ )); do
        h=${_WS_T_H[i]}
        [[ "${_WS_H_CLS[h]}" == acpi && "${_WS_T_OK[i]}" == 1 ]] || continue
        n=$(( n + 1 ))
        tline "ACPI $n" "${_WS_T_C[i]}" 100
        _WS_SHOWN[${_WS_H_NAME[h]}]=1 _WS_SHOWN[acpitz]=1
    done
    (( n )) || pline "${DIM}$(t sens_no_acpi)${RESET}"
}

# Thermal zones not already shown by a hwmon section (same class list).
# Fills _WS_Z_TYPE/_WS_Z_C.
_ws_zones() {
    local z ty v _WS_CLS
    _WS_Z_TYPE=() _WS_Z_C=()
    for z in /sys/class/thermal/thermal_zone*; do
        [[ -d "$z" ]] || continue
        wu_read "$z/type" ty || continue
        wu_read "$z/temp" v || continue
        [[ "$v" =~ ^-?[0-9]+$ ]] || continue
        v=$(( v / 1000 ))
        _ws_class "$ty"
        [[ "$_WS_CLS" == acpi || "$ty" == coretemp ]] && continue
        # x86_pkg_temp / cpu-thermal duplicate the CPU hwmon (coretemp
        # Package, k10temp Tctl) once the CPU section showed one.
        [[ "$_WS_CLS" == cpu ]] && (( _WS_CPU_SHOWN )) && continue
        [[ -n "${_WS_SHOWN[$ty]+x}" || -n "${_WS_SHOWN[${ty//-/_}]+x}" ]] && continue
        (( v <= 0 || v > 200 )) && continue
        _WS_Z_TYPE+=("$ty") _WS_Z_C+=("$v")
    done
}

print_thermal_zones() {
    local i
    _ws_zones
    for (( i = 0; i < ${#_WS_Z_C[@]}; i++ )); do
        tline "${_WS_Z_TYPE[i]}" "${_WS_Z_C[i]}" 100
    done
    (( ${#_WS_Z_C[@]} )) || pline "${DIM}$(t sens_all_covered)${RESET}"
}

# Chips not covered by CPU/GPU/ACPI/storage sections, excluding hwmons of
# thermal zones. _ws_is_chip IDX (temp index) -> rc
_ws_is_chip_h() {
    [[ "${_WS_H_VIRT[$1]}" == 0 ]] || return 1
    case "${_WS_H_CLS[$1]}" in cpu|gpu|acpi|disk) return 1 ;; esac
    return 0
}

print_network_temp() {
    local i found=0 _WS_LBL
    for (( i = 0; i < ${#_WS_T_C[@]}; i++ )); do
        _ws_is_chip_h "${_WS_T_H[i]}" || continue
        [[ "${_WS_T_OK[i]}" == 1 ]] || continue
        _ws_label_v "$i"
        tline "$_WS_LBL" "${_WS_T_C[i]}" 100
        found=1
    done
    (( found )) || pline "${DIM}$(t sens_no_chips)${RESET}"
}

# ─── Disks ──────────────────────────────────────────────────────
# Privileged helpers go through wu_root_run (root/sudo decided ONCE in
# main); without privileges the plain command is tried (disk group, caps).
ws_smartctl_run() {
    local rc=0
    wu_root_run smartctl "$@" && return 0 || rc=$?
    (( rc == 126 )) && { smartctl "$@"; return; }
    return "$rc"
}
ws_nvme_run() {
    local rc=0
    wu_root_run nvme "$@" && return 0 || rc=$?
    (( rc == 126 )) && { nvme "$@"; return; }
    return "$rc"
}

# ws_disk_model DEV -> prints model (sysfs, smartctl -i when truncated:
# USB-SATA bridges cut SCSI INQUIRY, e.g. "8CS" for "ST9320328CS").
ws_disk_model() {
    local dev="$1" bn model="" full="" l
    bn=${dev##*/}
    wu_read "/sys/block/${bn}/device/model" model || true
    wu_trim "$model" model
    if (( ${#model} < 5 )) && command -v smartctl >/dev/null 2>&1; then
        while IFS= read -r l; do
            case "$l" in
                "Device Model:"*|"Model Number:"*|"Product:"*) full=${l#*:}; wu_trim "$full" full; break ;;
            esac
        done < <(ws_smartctl_run -n standby -i "$dev" 2>/dev/null || true)
        (( ${#full} > ${#model} )) && model=$full
    fi
    printf '%s' "${model:-$(t hw_unknown)}"
}

# _ws_disk_temp DEV -> _WS_DT ("" if unknown), _WS_DT_STATE ("" | standby).
# Order: kernel hwmon (nvme / drivetemp: no root, never wakes the disk),
# then nvme-cli / smartctl -n standby (never wakes spun-down HDDs),
# then hddtemp. A disk in STANDBY is reported, not dropped: smartctl
# -n standby exits 2 with "Device is in STANDBY mode" instead of waking it.
_ws_disk_temp() {
    local dev="$1" bn f v="" l a out rc
    bn=${dev##*/}
    _WS_DT=""; _WS_DT_STATE=""
    for f in /sys/block/"$bn"/device/hwmon*/temp1_input /sys/block/"$bn"/device/hwmon/hwmon*/temp1_input; do
        [[ -e "$f" ]] || continue
        wu_read "$f" v || continue
        [[ "$v" =~ ^[0-9]+$ ]] && (( v > 0 )) && { _WS_DT=$(( v / 1000 )); return 0; }
    done
    v=""
    if [[ "$bn" == nvme* ]]; then
        if command -v nvme >/dev/null 2>&1; then
            while IFS= read -r l; do
                case "$l" in
                    [Tt]emperature*:*) l=${l#*:}; wu_trim "$l" l
                                       [[ "$l" =~ ^([0-9]+) ]] && { v=${BASH_REMATCH[1]}; break; } ;;
                esac
            done < <(ws_nvme_run smart-log "$dev" 2>/dev/null || true)
        fi
    fi
    if [[ -z "$v" ]] && command -v smartctl >/dev/null 2>&1; then
        rc=0
        out=$(ws_smartctl_run -n standby -A "$dev" 2>&1) || rc=$?
        if (( rc == 2 )) && [[ "$out" == *STANDBY* ]]; then
            _WS_DT_STATE=standby
        else
            while IFS= read -r l; do
                case "$l" in
                    *Temperature_Celsius*|*Airflow_Temperature_Cel*|*Temperature_Internal*)
                        read -ra a <<< "$l"; v=${a[9]:-}; [[ "$v" =~ ^([0-9]+) ]] && v=${BASH_REMATCH[1]}; break ;;
                    "Current Drive Temperature:"*|"Temperature:"*)
                        l=${l#*:}; wu_trim "$l" l; [[ "$l" =~ ^([0-9]+) ]] && { v=${BASH_REMATCH[1]}; break; } ;;
                esac
            done <<< "$out"
        fi
    fi
    if [[ -z "$v" && "$_WS_DT_STATE" != standby ]] && command -v hddtemp >/dev/null 2>&1; then
        v=$(wu_root_run hddtemp -n "$dev" 2>/dev/null) || v=""
        wu_trim "$v" v
    fi
    [[ "$v" =~ ^[0-9]+$ ]] && (( v > 0 && v <= 150 )) && _WS_DT=$v
    return 0
}

# Collect disk temps once: _WS_D_DEV _WS_D_MODEL _WS_D_C _WS_D_TYPE
# _WS_D_STATE (ok | standby). Spun-down disks are kept with an empty temp
# so the user sees "standby" instead of a silently missing row.
# WELLSENSORS_DISKS overrides enumeration (tests).
_ws_disks() {
    local dev _WS_DT _WS_DT_STATE
    local -a _WS_D_DEVS
    _WS_D_DEV=() _WS_D_MODEL=() _WS_D_C=() _WS_D_TYPE=() _WS_D_STATE=()
    if [[ -n "${WELLSENSORS_DISKS:-}" ]]; then
        read -ra _WS_D_DEVS <<< "$WELLSENSORS_DISKS"
    else
        _WS_D_DEVS=( /dev/nvme[0-9]*n[0-9]* /dev/sd[a-z] /dev/sd[a-z][a-z] )
    fi
    for dev in ${_WS_D_DEVS[@]+"${_WS_D_DEVS[@]}"}; do
        [[ -n "${WELLSENSORS_DISKS:-}" ]] || [[ -b "$dev" ]] || continue
        [[ "$dev" == /dev/nvme*p[0-9]* ]] && continue      # partitions
        _ws_disk_temp "$dev"
        [[ -n "$_WS_DT" || "$_WS_DT_STATE" == standby ]] || continue
        _WS_D_DEV+=("$dev") _WS_D_C+=("$_WS_DT") _WS_D_MODEL+=("$(ws_disk_model "$dev")")
        [[ "$dev" == /dev/nvme* ]] && _WS_D_TYPE+=(nvme) || _WS_D_TYPE+=(sata)
        _WS_D_STATE+=("${_WS_DT_STATE:-ok}")
    done
}

print_disks() {
    local i label pad _WU_CAP _WU_VL
    _ws_disks
    for (( i = 0; i < ${#_WS_D_C[@]}; i++ )); do
        if [[ "${_WS_D_STATE[i]}" == standby ]]; then
            label=${_WS_D_MODEL[i]}
            _wu_cap_v "$label" "$_WS_LW"; label=$_WU_CAP
            _wu_vislen_v "$label"
            printf -v pad '%*s' $(( _WU_VL < _WS_LW ? _WS_LW - _WU_VL : 0 )) ''
            _LINES+=( "  💤 ${BOLD}${W}${label}${pad}${RESET} ${DIM}$(t sens_disk_standby)${RESET}" )
        else
            tline "${_WS_D_MODEL[i]}" "${_WS_D_C[i]}" 60
        fi
    done
    (( ${#_WS_D_C[@]} )) || pline "${DIM}$(t sens_no_disk)${RESET}"
}

# ─── Cooling ────────────────────────────────────────────────────
# ACPI thermal cooling devices are *control interfaces*, not fans: they sit
# at cur=0..max=1 and would mislead into thinking the box has N fans. They
# are only counted for the footnote. Real fans = fan*_input with RPM > 0.
_ws_cooling_devs() {
    local d ty cur
    _WS_PCLAMP=0 _WS_PROC=0 _WS_ACPIFAN=0
    for d in /sys/class/thermal/cooling_device*; do
        [[ -d "$d" ]] || continue
        wu_read "$d/type" ty || continue
        cur=0; wu_read "$d/cur_state" cur || cur=0
        [[ "$cur" =~ ^[0-9]+$ ]] || cur=0
        case "$ty" in
            *intel_powerclamp*) _WS_PCLAMP=$(( _WS_PCLAMP + cur )) ;;
            *Fan*)              _WS_ACPIFAN=$(( _WS_ACPIFAN + 1 )) ;;
            *Processor*)        _WS_PROC=$(( _WS_PROC + cur )) ;;
        esac
    done
}
# Fans shown: skip thermal-zone hwmons and ACPI chips. CPU-class chips stay:
# macsmc_hwmon (Apple Silicon) and ibmpowernv (POWER) carry the real fans.
_ws_fan_ok() {
    local h=${_WS_F_H[$1]}
    (( ${_WS_F_RPM[$1]} > 0 )) || return 1
    [[ "${_WS_H_VIRT[h]}" == 0 ]] || return 1
    [[ "${_WS_H_CLS[h]}" == acpi ]] && return 1
    return 0
}

print_cooling() {
    local i rpm color rpmval real_fan=0
    _ws_cooling_devs
    for (( i = 0; i < ${#_WS_F_RPM[@]}; i++ )); do
        _ws_fan_ok "$i" || continue
        rpm=${_WS_F_RPM[i]}
        real_fan=$(( real_fan + 1 ))
        if   (( rpm < 400 )); then color="$R"
        elif (( rpm < 800 )); then color="$Y"
        else                       color="$C"
        fi
        printf -v rpmval '%4d RPM' "$rpm"
        _LINES+=( "  ${_WS_IC_FAN}${BOLD}${W}$(t sens_fan)${_WS_F_IDX[i]}${RESET} ${color}${rpmval}${RESET}  ${DIM}(${_WS_H_NAME[${_WS_F_H[i]}]})${RESET}" )
    done

    pline_hw "$(_emu '🌀')" "$(t sens_fan)" "${C}${real_fan} $(t sens_devices)${RESET}"
    pline_hw "$(_emu '⚙')" "$(t sens_cstates)" "${C}${_WS_PROC} $(t sens_throttle)${RESET}"
    pline_hw "$(_emu '🧊')" "$(t sens_powerclamp)" "${C}${_WS_PCLAMP} $(t sens_active)${RESET}"
    (( _WS_ACPIFAN > 0 )) && pline_hw "$(_emu '📋')" "$(t sens_acpi_fans)" "${DIM}${_WS_ACPIFAN}${RESET}"
    (( real_fan )) || pline "${DIM}$(t sens_no_fan_rpm)${RESET}"
}

# ─── System (all from /proc, no free/uptime parsing) ────────────
_ws_sysinfo() {
    local a b c k v _u s d h m tot=0 avail="" free=0 buf=0 cach=0 rec=0
    _WS_LOAD="" _WS_UP="" _WS_MT="" _WS_MU="" _WS_MP=""
    if wu_read /proc/loadavg _u; then
        read -r a b c _ <<< "$_u"
        _WS_LOAD="$a $b $c"; wu_trim "$_WS_LOAD" _WS_LOAD
    fi
    s=""
    if wu_read /proc/uptime _u; then
        s=${_u%% *}; s=${s%%.*}
    fi
    if [[ "$s" =~ ^[0-9]+$ ]]; then
        d=$(( s / 86400 )) h=$(( (s % 86400) / 3600 )) m=$(( (s % 3600) / 60 ))
        if (( d > 0 )); then _WS_UP="${d}d ${h}h ${m}m"
        elif (( h > 0 )); then _WS_UP="${h}h ${m}m"
        else _WS_UP="${m}m"; fi
    fi
    if [[ -r /proc/meminfo ]]; then
        while IFS=': ' read -r k v _; do
            case "$k" in
                MemTotal)     tot=$v ;;
                MemAvailable) avail=$v ;;
                MemFree)      free=$v ;;
                Buffers)      buf=$v ;;
                Cached)       cach=$v ;;
                SReclaimable) rec=$v ;;
            esac
        done 2>/dev/null < /proc/meminfo || true
    fi
    [[ "$tot" =~ ^[0-9]+$ ]] || tot=0
    if (( tot > 0 )); then
        [[ "$avail" =~ ^[0-9]+$ ]] || avail=$(( free + buf + cach + rec ))
        (( avail > tot )) && avail=$tot
        _WS_MT=$(( tot / 1024 )) _WS_MU=$(( (tot - avail) / 1024 ))
        _WS_MP=$(( (tot - avail) * 100 / tot ))
    fi
    _WS_CORES=$(nproc 2>/dev/null) || _WS_CORES=""
    [[ "$_WS_CORES" =~ ^[0-9]+$ ]] || _WS_CORES=1
    _WS_CPU=$(wu_cpu_model_generic 2>/dev/null) || _WS_CPU=""
    return 0
}

print_system() {
    local unk load_color load_int
    unk=$(t hw_unknown)
    _ws_sysinfo
    load_int=${_WS_LOAD%%.*}
    [[ "$load_int" =~ ^[0-9]+$ ]] || load_int=0
    if   (( load_int < _WS_CORES / 2 )); then load_color="$G"
    elif (( load_int < _WS_CORES ));     then load_color="$Y"
    else                                      load_color="$R"
    fi
    pline_hw "$(_emu '🖥')" "$(t sens_cpu)" "${_WS_CPU:-$unk}  ${DIM}(${_WS_CORES} $(t hw_threads))${RESET}"
    if [[ -n "$_WS_LOAD" ]]; then
        pline_hw "$(_emu '📊')" "$(t sens_load)" "${load_color}${_WS_LOAD}${RESET}  ${DIM}($(t sens_load_periods))${RESET}"
    else
        pline_hw "$(_emu '📊')" "$(t sens_load)" "${DIM}${unk}${RESET}"
    fi
    if [[ -n "$_WS_MT" ]]; then
        pline_hw "$(_emu '🧠')" "$(t sens_ram)" "${_WS_MU} $(t sens_mb) / ${_WS_MT} $(t sens_mb)  ${DIM}(${_WS_MP}%)${RESET}"
    else
        pline_hw "$(_emu '🧠')" "$(t sens_ram)" "${DIM}${unk}${RESET}"
    fi
    pline_hw "$(_emu '⏱')" "$(t sens_uptime)" "${_WS_UP:-$unk}"
}

# ─── Summary ────────────────────────────────────────────────────
# All hwmon temps (each file once, from the shared scan) + NVIDIA.
_ws_summary_calc() {
    local i t line nv_name nv_temp nv_fan nv_pow nv_clk nv_mclk nv_vtot nv_vused nv_util nv_bus _r
    _WS_SN=0 _WS_SMIN="" _WS_SAVG="" _WS_SMAX=""
    local sum=0 max=0 min=999
    for (( i = 0; i < ${#_WS_T_C[@]}; i++ )); do
        t=${_WS_T_C[i]}
        [[ "${_WS_T_OK[i]}" == 1 ]] || continue
        sum=$(( sum + t )) _WS_SN=$(( _WS_SN + 1 ))
        (( t > max )) && max=$t; (( t < min )) && min=$t
    done
    while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        IFS=',' read -r _r t _ <<< "$line"; t=${t// /}
        [[ "$t" =~ ^[0-9]+$ ]] || continue
        sum=$(( sum + t )) _WS_SN=$(( _WS_SN + 1 ))
        (( t > max )) && max=$t; (( t < min )) && min=$t
    done <<< "${_WS_NV-}"
    (( _WS_SN )) || return 0
    _WS_SMIN=$min _WS_SMAX=$max _WS_SAVG=$(( sum / _WS_SN ))
}

print_summary() {
    local _WS_COL mv av xv cmin cavg cmax
    _ws_summary_calc
    _LINES=()
    if (( _WS_SN == 0 )); then
        _LINES+=( "${DIM}$(t no_data)${RESET}" )
    else
        _ws_color_v "$_WS_SMIN"; cmin=$_WS_COL
        _ws_color_v "$_WS_SAVG"; cavg=$_WS_COL
        _ws_color_v "$_WS_SMAX"; cmax=$_WS_COL
        printf -v mv '%4d°C' "$_WS_SMIN"; printf -v av '%4d°C' "$_WS_SAVG"; printf -v xv '%4d°C' "$_WS_SMAX"
        _LINES+=( "  ${_WS_IC_MIN}${BOLD}${W}$(t sens_min)${RESET} ${cmin}${mv}${RESET}   ${_WS_IC_AVG}${BOLD}${W}$(t sens_avg)${RESET} ${cavg}${av}${RESET}   ${_WS_IC_MAX}${BOLD}${W}$(t sens_max)${RESET} ${cmax}${xv}${RESET}" )
    fi
    banner
}

# ─── JSON output ────────────────────────────────────────────────
root_or_sudo() {   # kept for compatibility
    local rc=0
    wu_root_run "$@" && return 0 || rc=$?
    (( rc == 126 )) && { "$@"; return; }
    return "$rc"
}

_jn() { wu_json_num "$1"; }

json_out() {
    local first i h line
    _ws_scan
    _ws_nv_query
    _ws_sysinfo
    wu_json_head "$_WU_TOOLNAME" "$_WU_VERSION"

    printf ',\n  "system": {\n'
    printf '    "cpu": "%s",\n' "$(json_esc "$_WS_CPU")"
    printf '    "cores": %s,\n' "$(_jn "$_WS_CORES")"
    printf '    "load": "%s",\n' "$(json_esc "$_WS_LOAD")"
    printf '    "memory_used_mb": %s,\n' "$(_jn "$_WS_MU")"
    printf '    "memory_total_mb": %s,\n' "$(_jn "$_WS_MT")"
    printf '    "memory_percent": %s,\n' "$(_jn "$_WS_MP")"
    printf '    "uptime": "%s"\n' "$(json_esc "$_WS_UP")"
    printf '  },\n'

    printf '  "cpu_cores": [\n'
    first=1
    local lbl _WS_CLBL
    for (( i = 0; i < ${#_WS_T_C[@]}; i++ )); do
        h=${_WS_T_H[i]}
        [[ "${_WS_H_CLS[h]}" == cpu ]] || continue
        (( _WS_T_C[i] > -50 && _WS_T_C[i] < 200 )) || continue
        _ws_cpu_label_v "$i"; lbl=$_WS_CLBL
        _WS_SHOWN[${_WS_H_NAME[h]}]=1
        _WS_CPU_SHOWN=1
        (( first )) && first=0 || printf ',\n'
        printf '    { "label": "%s", "chip": "%s", "temp_c": %d, "high_c": %s, "crit_c": %s }' \
            "$(json_esc "$lbl")" "$(json_esc "${_WS_H_NAME[h]}")" "${_WS_T_C[i]}" \
            "$(_jn "${_WS_T_HI[i]}")" "$(_jn "${_WS_T_CR[i]}")"
    done
    printf '\n  ],\n'

    printf '  "gpu": [\n'
    first=1
    local nv_name nv_temp nv_fan nv_pow nv_clk nv_mclk nv_vtot nv_vused nv_util nv_bus nv_aib nv_aibhex
    while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        _ws_nv_parse "$line"
        [[ "$nv_temp" =~ ^[0-9]+$ ]] || continue
        (( first )) && first=0 || printf ',\n'
        printf '    { "name": "%s", "driver": "nvidia", "bus": "%s", "subsystem_vendor": "%s", "subsystem_name": "%s", "temp_c": %s, "fan_percent": %s, "power_w": %s, "clock_gpu_mhz": %s, "clock_mem_mhz": %s, "vram_total_mib": %s, "vram_used_mib": %s, "utilization_percent": %s }' \
            "$(json_esc "$nv_name")" "$(json_esc "$nv_bus")" "$(json_esc "$nv_aibhex")" "$(json_esc "$nv_aib")" "$(_jn "$nv_temp")" "$(_jn "$nv_fan")" "$(_jn "$nv_pow")" \
            "$(_jn "$nv_clk")" "$(_jn "$nv_mclk")" "$(_jn "$nv_vtot")" "$(_jn "$nv_vused")" "$(_jn "$nv_util")"
    done <<< "${_WS_NV-}"
    local _WS_GN _WS_GAIB _WS_GAIBHEX _WS_GBUS _WS_GMHZ _WS_GT
    for (( h = 0; h < ${#_WS_H_DIR[@]}; h++ )); do
        [[ "${_WS_H_CLS[h]}" == gpu ]] || continue
        _ws_gpu_temp "$h"
        [[ -n "$_WS_GT" ]] || continue
        _ws_gpu_info "$h"
        _WS_SHOWN[${_WS_H_NAME[h]}]=1
        (( first )) && first=0 || printf ',\n'
        printf '    { "name": "%s", "driver": "%s", "bus": "%s", "subsystem_vendor": "%s", "subsystem_name": "%s", "temp_c": %d, "clock_gpu_mhz": %s }' \
            "$(json_esc "$_WS_GN")" "$(json_esc "${_WS_H_NAME[h]}")" "$(json_esc "$_WS_GBUS")" "$(json_esc "$_WS_GAIBHEX")" \
            "$(json_esc "$_WS_GAIB")" "$_WS_GT" "$(_jn "$_WS_GMHZ")"
    done
    printf '\n  ],\n'

    printf '  "acpi": [\n'
    first=1
    local n=0
    for (( i = 0; i < ${#_WS_T_C[@]}; i++ )); do
        h=${_WS_T_H[i]}
        [[ "${_WS_H_CLS[h]}" == acpi && "${_WS_T_OK[i]}" == 1 ]] || continue
        n=$(( n + 1 ))
        _WS_SHOWN[${_WS_H_NAME[h]}]=1 _WS_SHOWN[acpitz]=1
        (( first )) && first=0 || printf ',\n'
        printf '    { "zone": %d, "temp_c": %d }' "$n" "${_WS_T_C[i]}"
    done
    printf '\n  ],\n'

    printf '  "thermal_zones": [\n'
    _ws_zones
    first=1
    for (( i = 0; i < ${#_WS_Z_C[@]}; i++ )); do
        (( first )) && first=0 || printf ',\n'
        printf '    { "type": "%s", "temp_c": %d }' "$(json_esc "${_WS_Z_TYPE[i]}")" "${_WS_Z_C[i]}"
    done
    printf '\n  ],\n'

    printf '  "chips": [\n'
    first=1
    for (( i = 0; i < ${#_WS_T_C[@]}; i++ )); do
        h=${_WS_T_H[i]}
        _ws_is_chip_h "$h" || continue
        [[ "${_WS_T_OK[i]}" == 1 ]] || continue
        (( first )) && first=0 || printf ',\n'
        printf '    { "chip": "%s", "input": "%s", "label": "%s", "temp_c": %d }' \
            "$(json_esc "${_WS_H_NAME[h]}")" "$(json_esc "${_WS_T_IN[i]}")" "$(json_esc "${_WS_T_LBL[i]}")" "${_WS_T_C[i]}"
    done
    printf '\n  ],\n'

    printf '  "disks": [\n'
    _ws_disks
    first=1
    for (( i = 0; i < ${#_WS_D_C[@]}; i++ )); do
        (( first )) && first=0 || printf ',\n'
        printf '    { "device": "%s", "model": "%s", "temp_c": %s, "type": "%s", "state": "%s" }' \
            "$(json_esc "${_WS_D_DEV[i]}")" "$(json_esc "${_WS_D_MODEL[i]}")" \
            "$(wu_json_num "${_WS_D_C[i]}")" "${_WS_D_TYPE[i]}" "${_WS_D_STATE[i]:-ok}"
    done
    printf '\n  ],\n'

    _ws_cooling_devs
    local -a fl=()
    for (( i = 0; i < ${#_WS_F_RPM[@]}; i++ )); do
        _ws_fan_ok "$i" && fl+=("$i")
    done
    printf '  "cooling": {\n'
    printf '    "real_fans": %d,\n' "${#fl[@]}"
    printf '    "processor_throttles": %d,\n' "$_WS_PROC"
    printf '    "powerclamp_active": %d,\n' "$_WS_PCLAMP"
    printf '    "acpi_fan_devices": %d,\n' "$_WS_ACPIFAN"
    printf '    "fans": [\n'
    first=1
    for i in ${fl[@]+"${fl[@]}"}; do
        (( first )) && first=0 || printf ',\n'
        printf '      { "chip": "%s", "index": %s, "rpm": %d }' \
            "$(json_esc "${_WS_H_NAME[${_WS_F_H[i]}]}")" "$(_jn "${_WS_F_IDX[i]}")" "${_WS_F_RPM[i]}"
    done
    printf '\n    ]\n'
    printf '  },\n'

    printf '  "summary": {\n'
    _ws_summary_calc
    if (( _WS_SN == 0 )); then
        printf '    "samples": 0, "min_c": null, "avg_c": null, "max_c": null\n'
    else
        printf '    "samples": %d,\n    "min_c": %d,\n    "avg_c": %d,\n    "max_c": %d\n' \
            "$_WS_SN" "$_WS_SMIN" "$_WS_SAVG" "$_WS_SMAX"
    fi
    printf '  }\n'
    wu_json_end
}

