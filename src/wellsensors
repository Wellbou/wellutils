short_out() {
    local i maxt=0 t z ty _WS_CLS
    _ws_scan
    for (( i = 0; i < ${#_WS_T_C[@]}; i++ )); do
        [[ "${_WS_H_CLS[${_WS_T_H[i]}]}" == cpu ]] || continue
        t=${_WS_T_C[i]}
        (( t > 0 && t < 125 && t > maxt )) && maxt=$t
    done
    if (( maxt == 0 )); then
        # no CPU hwmon: CPU-class thermal zone (x86_pkg_temp, cpu-thermal ...)
        for z in /sys/class/thermal/thermal_zone*; do
            wu_read "$z/type" ty || continue
            _ws_class "$ty"; [[ "$_WS_CLS" == cpu ]] || continue
            wu_read "$z/temp" t || continue
            [[ "$t" =~ ^[0-9]+$ ]] || continue
            t=$(( t / 1000 ))
            (( t > 0 && t < 125 && t > maxt )) && maxt=$t
        done
    fi
    (( maxt > 0 )) || { printf -- '-\n'; return 0; }
    printf '%d°C\n' "$maxt"
}

main() {
    if [[ "$_WU_SHORT" == "1" ]]; then short_out; return 0; fi
    # decide root/sudo once in THIS shell (subshells would lose the cache)
    wu_root_init
    if [[ "$_WU_JSON" == "1" ]]; then json_out; return 0; fi
    _ws_init_glyphs

    if [[ "$_WS_WATCH" == "1" && -t 1 ]]; then
        trap 'exit 130' INT
        while :; do
            printf '\033[2J\033[H'
            print_report
            sleep "$_WS_INTERVAL"
        done
    fi

    print_report
}

wu_run main "$@"
