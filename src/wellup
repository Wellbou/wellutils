#!/usr/bin/env bash
# WellUp -- Check for system updates and apply them automatically
# Supports: pacman (Arch), dnf/yum (Fedora/RHEL), apt (Debian/Ubuntu/Bodhi),
#           zypper (openSUSE), apk (Alpine), xbps (Void), emerge (Gentoo),
#           eopkg (Solus), opkg (OpenWrt), swupd (Clear Linux), pkg (Termux)
# by wellbou_
set -euo pipefail

# ─── Shared libs ────────────────────────────────────────────────
_WU_TOOLNAME="wellup" _WU_NAME="WellUp" _WU_VERSION="1.0"
_WU_TAGLINE="Check for system updates and apply them automatically"
_WU_BOOT_DIR="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="$(dirname -- "$_WU_BOOT_DIR")/share/wellutils"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="/usr/local/share/wellutils"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="/usr/share/wellutils"
source "$_WU_BOOT_DIR/bootstrap.sh" lang box cli parse

# ─── Flags ─────────────────────────────────────────────────────
_UP_CHECK=0
_UP_SELF=0
_UP_YES=0
_UP_PACNEW=0
_UP_FULL=0

up_extra_parse() {
    case "$1" in
        --check|--list)
            _UP_CHECK=1
            _WU_EXTRA_CONSUMED=1
            return 0 ;;
        --self-update|--self)
            _UP_SELF=1
            _WU_EXTRA_CONSUMED=1
            return 0 ;;
        --yes|-y)
            _UP_YES=1
            _WU_EXTRA_CONSUMED=1
            return 0 ;;
        --full)
            _UP_FULL=1
            _WU_EXTRA_CONSUMED=1
            return 0 ;;
        --pacnew)
            _UP_PACNEW=1
            _WU_EXTRA_CONSUMED=1
            return 0 ;;
    esac
    return 1
}
_WU_EXTRA_PARSE=up_extra_parse
_WU_EXTRA_HELP="      --check, --list         only list available updates, do not install
      --yes, -y               apply updates without confirmation
      --full                  apt: full-upgrade (may remove packages) instead of upgrade
      --pacnew                list leftover .pacnew/.pacsave files in /etc
      --self-update           update wellutils itself from GitHub
      --self                  alias of --self-update"

# ─── System / package manager detection (os-release first) ─────
_UP_OS="unknown Linux"
_UP_PM=""
detect_pm() {
    local id="" id_like="" c="" osrelease
    osrelease="/etc/os-release"
    [[ -n "${WELLUTILS_OSRELEASE:-}" && -r "$WELLUTILS_OSRELEASE" ]] && osrelease="$WELLUTILS_OSRELEASE"
    if [[ -r "$osrelease" ]]; then
        . "$osrelease" 2>/dev/null || true
        _UP_OS="${PRETTY_NAME:-${NAME:-unknown Linux}}"
        id="${ID:-}" id_like="${ID_LIKE:-}"
    fi
    # Termux: its own apt wrapper, never root
    if [[ -n "${TERMUX_VERSION:-}" || "${PREFIX:-}" == *com.termux* ]]; then
        _UP_OS="Termux (Android)"
        if command -v pkg >/dev/null 2>&1; then _UP_PM="pkg"; return 0; fi
    fi
    case "$id" in
        arch|manjaro|endeavouros|cachyos|artix|garuda|arcolinux) c=pacman ;;
        fedora|rhel|centos|rocky|almalinux|nobara|eurolinux|ol|amzn) c=dnf ;;
        debian|ubuntu|bodhi|linuxmint|pop|elementary|zorin|kali|mx|devuan|raspbian|parrot|neon) c=apt-get ;;
        opensuse*|sles|sled)                            c=zypper ;;
        alpine|postmarketos)                            c=apk ;;
        void)                                           c=xbps-install ;;
        gentoo|calculate|funtoo)                        c=emerge ;;
        solus)                                          c=eopkg ;;
        openwrt)                                        c=opkg ;;
        clear-linux-os)                                 c=swupd ;;
    esac
    if [[ -z "$c" ]]; then
        case " $id_like " in
            *" arch "*)     c=pacman ;;
            *" fedora "*|*" rhel "*|*" centos "*) c=dnf ;;
            *" debian "*|*" ubuntu "*) c=apt-get ;;
            *" suse "*)     c=zypper ;;
        esac
    fi
    # CentOS 7 & co: dnf family without dnf -> yum
    if [[ "$c" == dnf ]] && ! command -v dnf >/dev/null 2>&1 && command -v yum >/dev/null 2>&1; then c=yum; fi
    if [[ -n "$c" ]] && command -v "$c" >/dev/null 2>&1; then
        _UP_PM="$c"
        return 0
    fi
    for c in pacman dnf yum apt-get apt zypper apk xbps-install emerge eopkg opkg swupd; do
        if command -v "$c" >/dev/null 2>&1; then
            _UP_PM="$c"
            return 0
        fi
    done
    _UP_PM=""
}

# ─── Update detection ──────────────────────────────────────────
UP_LINES=()   # rows: "name|old|new"

pm_check() {
    UP_LINES=()
    local line row
    case "$_UP_PM" in
        pacman)
            # checkupdates (pacman-contrib) syncs into a temp db, so the
            # list is fresh without touching the real one; rc 2 = none.
            local row rest pout="" prc=0
            if command -v checkupdates >/dev/null 2>&1; then
                pout=$(checkupdates 2>/dev/null) || prc=$?
                if (( prc != 0 && prc != 2 )); then
                    pout=$(pacman -Qu 2>/dev/null) || pout=""
                fi
            else
                pout=$(pacman -Qu 2>/dev/null) || pout=""
            fi
            while IFS= read -r line; do
                [[ -z "$line" ]] && continue
                row="${line%% *}"
                if [[ "$line" == *" -> "* ]]; then
                    rest="${line#* }"
                    UP_LINES+=("$row|${rest% -> *}|${rest#* -> }")
                else
                    UP_LINES+=("$row||")
                fi
            done <<< "$pout" ;;
        dnf|yum)
            local arr
            while IFS= read -r line; do
                [[ -z "$line" ]] && continue
                [[ "$line" == *"Obsolet"* ]] && break
                read -r -a arr <<< "$line"
                [[ ${#arr[@]} -ge 2 ]] || continue
                [[ "${arr[1]}" =~ [0-9] ]] || continue
                UP_LINES+=("${arr[0]}||${arr[1]}")
            done < <("$_UP_PM" -q check-update 2>/dev/null || true) ;;
        eopkg)
            while IFS= read -r line; do
                [[ -z "$line" || "$line" == *"No packages"* ]] && continue
                UP_LINES+=("${line%% *}||")
            done < <(eopkg list-upgrades 2>/dev/null || true) ;;
        opkg)
            local nm rest
            while IFS= read -r line; do
                [[ "$line" == *" - "* ]] || continue
                nm="${line%% - *}"; rest="${line#* - }"
                UP_LINES+=("$nm|${rest% - *}|${rest##* - }")
            done < <(opkg list-upgradable 2>/dev/null || true) ;;
        apt-get|apt|pkg)
            local nm old rest
            while IFS= read -r line; do
                [[ "$line" == *"/"* ]] || continue
                nm="${line%%/*}"
                rest="${line#* }"
                read -r -a arr <<< "$rest"
                [[ ${#arr[@]} -ge 2 ]] || continue
                old=""
                if [[ "$rest" =~ upgradable\ from:\ ([^][]+)\] ]]; then
                    old="${BASH_REMATCH[1]}"
                fi
                UP_LINES+=("$nm|$old|${arr[0]}")
            done < <(LC_ALL=C apt list --upgradable 2>/dev/null) ;;
        zypper)
            local cols=() idx hdr_name=2 hdr_new=-1 in_hdr=0 nm nw
            while IFS= read -r line; do
                [[ -z "$line" ]] && continue
                if [[ "$line" == *"Name"* ]]; then
                    in_hdr=1
                    IFS='|' read -r -a cols <<< "$line"
                    for idx in "${!cols[@]}"; do
                        case "${cols[$idx]// /}" in
                            Name)    hdr_name=$idx ;;
                            "New"*|"Current"*) [[ "${cols[$idx]// /}" == "New"* ]] && hdr_new=$idx ;;
                        esac
                    done
                    continue
                fi
                [[ $in_hdr -eq 1 ]] || continue
                IFS='|' read -r -a cols <<< "$line"
                [[ ${#cols[@]} -lt 2 ]] && continue
                nm="${cols[$hdr_name]// /}"
                [[ -n "$nm" ]] || continue
                nw=""
                if (( hdr_new >= 0 )); then nw="${cols[$hdr_new]// /}"; fi
                [[ -n "$nw" ]] || nw="${cols[${#cols[@]}-1]// /}"
                UP_LINES+=("$nm||$nw")
            done < <(zypper --no-color list-updates 2>/dev/null || true) ;;
        apk)
            while IFS= read -r line; do
                [[ -z "$line" ]] && continue
                UP_LINES+=("$line||")
            done < <(apk info -u 2>/dev/null) ;;
        xbps-install)
            # -Mun: "pkgname-newver action arch repo [size]"; col 0 carries
            # the NEW version; only "update" rows are upgrades.
            local cols p
            while IFS= read -r line; do
                [[ -z "$line" ]] && continue
                read -r -a cols <<< "$line"
                [[ "${cols[1]:-update}" == update ]] || continue
                p="${cols[0]}"
                [[ "$p" == *-* ]] || continue
                UP_LINES+=("${p%-*}||${p##*-}")
            done < <(xbps-install -Mun 2>/dev/null || true) ;;
        swupd)
            # "Current OS version: N" / "Latest server version: M"
            local cur="" lat=""
            while IFS= read -r line; do
                case "$line" in
                    *"Current OS version:"*)    cur="${line##*:}"; cur="${cur//[!0-9]/}" ;;
                    *"Latest server version:"*) lat="${line##*:}"; lat="${lat//[!0-9]/}" ;;
                esac
            done < <(LC_ALL=C swupd check-update 2>/dev/null || true)
            if [[ -n "$lat" && -n "$cur" && "$lat" != "$cur" ]] && (( 10#$lat > 10#$cur )); then
                UP_LINES+=("clear-linux-os|$cur|$lat")
            fi ;;
        emerge)
            local t nm ver
            while IFS= read -r line; do
                [[ "$line" == "["*"ebuild"* ]] || continue
                t="${line#*\] }"
                t="${t%% *}"
                nm="${t%-*}"
                ver="${t##*-}"
                UP_LINES+=("$nm||$ver")
            done < <(emerge -puDN --color=n @world 2>/dev/null || true) ;;
    esac
    return 0
}

# ─── Root helper ───────────────────────────────────────────────
run_priv() {
    if [[ "$_UP_PM" == "pkg" || "$(id -u)" -eq 0 ]]; then
        "$@"     # Termux: the app user owns $PREFIX, no root needed
    elif command -v sudo >/dev/null 2>&1; then
        sudo "$@"
    elif command -v doas >/dev/null 2>&1; then
        doas "$@"
    else
        printf '%s\n' "$(t upd_need_root)" >&2
        return 3
    fi
}

pm_update() {
    case "$_UP_PM" in
        pacman)        run_priv pacman -Syu --noconfirm ;;
        dnf)           run_priv dnf upgrade -y ;;
        yum)           run_priv yum update -y ;;
        apt-get|apt)   if (( _UP_FULL )); then
                           run_priv apt-get update -y && run_priv apt-get full-upgrade -y
                       else
                           run_priv apt-get update -y && run_priv apt-get upgrade -y
                       fi ;;
        pkg)           run_priv pkg upgrade -y ;;
        zypper)        run_priv zypper --non-interactive update ;;
        apk)           run_priv apk update && run_priv apk upgrade ;;
        xbps-install)  if (( _UP_YES )); then run_priv xbps-install -Suy; else run_priv xbps-install -Su; fi ;;
        emerge)        run_priv emerge -uDN --with-bdeps=y @world ;;
        eopkg)         run_priv eopkg upgrade -y ;;
        opkg)          run_priv opkg update && { opkg list-upgradable 2>/dev/null | while IFS=' ' read -r p _; do [[ -n "$p" ]] && run_priv opkg upgrade "$p"; done; } ;;
        swupd)         run_priv swupd update ;;
        *)             return 1 ;;
    esac
}

# ─── JSON output (check-only) ──────────────────────────────────
json_out() {
    local count="${#UP_LINES[@]}" first=1 name from to rest row
    wu_json_head "$_WU_TOOLNAME" "$_WU_VERSION"
    printf ',\n  "package_manager": "%s",\n' "$(json_esc "$_UP_PM")"
    printf '  "os": "%s",\n' "$(json_esc "$_UP_OS")"
    printf '  "updates_available": %d,\n' "$count"
    printf '  "updates": [\n'
    for row in ${UP_LINES[@]+"${UP_LINES[@]}"}; do
        name="${row%%|*}"; rest="${row#*|}"; from="${rest%%|*}"; to="${rest#*|}"
        (( first )) || printf ',\n'
        first=0
        printf '    { "name": "%s", "from": "%s", "to": "%s" }' \
            "$(json_esc "$name")" "$(json_esc "$from")" "$(json_esc "$to")"
    done
    printf '\n  ]\n'
    wu_json_end
}

# ─── Display ───────────────────────────────────────────────────
up_system_box() {
    _LINES+=("$BOLD$(t upd_pm)$RESET  $C$_UP_PM$RESET")
    _LINES+=("$BOLD$(t upd_os)$RESET  $W$_UP_OS$RESET")
    local mode
    if [[ "$_UP_CHECK" == "1" ]]; then mode="$(t upd_mode_check)"; else mode="$(t upd_mode_update)"; fi
    _LINES+=("$BOLD$(t upd_mode)$RESET  $W$mode$RESET")
}

up_list_box() {
    local row name from to rest
    for row in ${UP_LINES[@]+"${UP_LINES[@]}"}; do
        name="${row%%|*}"; rest="${row#*|}"; from="${rest%%|*}"; to="${rest#*|}"
        if [[ -n "$from" && -n "$to" ]]; then
            _LINES+=("$Y$name$RESET  $DIM$from$RESET -> $G$to$RESET")
        elif [[ -n "$to" ]]; then
            _LINES+=("$Y$name$RESET  ->  $G$to$RESET")
        else
            _LINES+=("$Y$name$RESET")
        fi
    done
}

confirm_update() {
    (( _UP_YES )) && return 0
    if [[ ! -t 0 ]]; then
        printf '  %s\n' "$(t upd_no_tty)" >&2
        return 1
    fi
    local ans
    printf '  %s [y/N] ' "$(t upd_confirm)"
    read -r ans || return 1
    case "$ans" in
        y|Y|yes|Yes|YES|д|Д|да|Да|ДА) return 0 ;;
        *) return 1 ;;
    esac
}

# ─── Self-update: wellutils itself, from GitHub ────────────────
# Flow: detect install prefix from our own lib dir -> refuse checkouts and
# package-manager-owned installs -> resolve the newest tag (same logic as
# install.sh) -> compare with raw/<tag>/src/VERSION -> download exactly that
# tag -> (optional SHA256SUMS check) -> run the tree's own install.sh
# --prefix=<detected> --no-deps. No hand-kept file lists here.
#
# WELLUTILS_SELF_SRC=<dir>  use a local source tree instead of GitHub
#                           (offline / testing); must contain src/VERSION.
SELF_REPO="${WELLUTILS_REPO:-Wellbou/wellutils}"
SELF_RAW="${WELLUTILS_RAW:-https://raw.githubusercontent.com/$SELF_REPO}"
SELF_API="${WELLUTILS_API:-https://api.github.com/repos/$SELF_REPO}"
SELF_LIB=""
SELF_PREFIX=""
SELF_LOCAL=""
SELF_REMOTE=""
SELF_TAG=""
SELF_SRC=""
SELF_OWNER=""
_WU_SELF_TMP=""

# download URL -> FILE ("-" = stdout) with curl or wget
self_dl() {
    local url="$1" out="$2" tmo="${3:-60}"
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL --max-time "$tmo" "$url" -o "$out"
    elif command -v wget >/dev/null 2>&1; then
        wget -q -T "$tmo" -O "$out" "$url"
    else
        return 127
    fi
}

# Pure-bash version compare (busybox sort has no -V). rc 0 if $1 > $2.
ver_gt() {
    local a="${1#v}" b="${2#v}" i x y
    local -a A=() B=()
    IFS='.-_' read -r -a A <<< "$a" || true
    IFS='.-_' read -r -a B <<< "$b" || true
    for (( i=0; i < ${#A[@]} || i < ${#B[@]}; i++ )); do
        x="${A[i]:-0}" y="${B[i]:-0}"
        if [[ "$x" =~ ^[0-9]+$ && "$y" =~ ^[0-9]+$ ]]; then
            (( 10#$x > 10#$y )) && return 0
            (( 10#$x < 10#$y )) && return 1
        else
            [[ "$x" > "$y" ]] && return 0
            [[ "$x" < "$y" ]] && return 1
        fi
    done
    return 1
}

self_detect() {
    SELF_LIB="$_WU_BOOT_DIR"
    SELF_LOCAL=""
    if [[ -r "$SELF_LIB/VERSION" ]]; then
        IFS= read -r SELF_LOCAL < "$SELF_LIB/VERSION" || true
        SELF_LOCAL="${SELF_LOCAL//[[:space:]]/}"
    fi
    if [[ "$SELF_LIB" == */share/wellutils ]]; then
        SELF_PREFIX="${SELF_LIB%/share/wellutils}"
        [[ -n "$SELF_PREFIX" ]] || SELF_PREFIX="/"
    else
        SELF_PREFIX=""
    fi
}

# Installed by a distro package? Then the package manager must update it.
self_pkg_owner() {
    local f="$SELF_LIB/lang.sh"
    SELF_OWNER=""
    [[ -e "$SELF_LIB/wellutils.manifest" ]] && return 1   # our installer
    if command -v pacman >/dev/null 2>&1 && pacman -Qqo "$f" >/dev/null 2>&1; then
        SELF_OWNER="pacman"
    elif command -v dpkg >/dev/null 2>&1 && dpkg -S "$f" >/dev/null 2>&1; then
        SELF_OWNER="dpkg"
    elif command -v rpm >/dev/null 2>&1 && rpm -qf "$f" >/dev/null 2>&1; then
        SELF_OWNER="rpm"
    elif [[ "$SELF_LIB" == /usr/share/wellutils ]]; then
        SELF_OWNER="package"
    fi
    [[ -n "$SELF_OWNER" ]]
}

self_resolve_tag() {
    local line best=""
    if [[ -n "${WELLUTILS_REF:-}" ]]; then
        SELF_TAG="$WELLUTILS_REF"; return 0
    fi
    # newest tag, not /releases/latest (a stale Release can be far behind)
    while IFS= read -r line; do
        line="${line##*:}"; line="${line//[[:space:]\"]/}"
        [[ "$line" == v[0-9]* ]] || continue
        if [[ -z "$best" ]] || ver_gt "$line" "$best"; then best="$line"; fi
    done < <(self_dl "$SELF_API/tags?per_page=100" - 20 2>/dev/null \
             | grep -o '"name"[[:space:]]*:[[:space:]]*"[^"]*"' || true)
    SELF_TAG="${best:-main}"
}

self_fetch() {
    local out="" d
    SELF_REMOTE=""
    d="${WELLUTILS_SELF_SRC:-}"
    # legacy: WELLUTILS_RAW pointing at a local directory
    [[ -z "$d" && "$SELF_RAW" == /* ]] && d="$SELF_RAW"
    if [[ -n "$d" ]]; then
        [[ -r "$d/src/VERSION" ]] || return 1
        IFS= read -r out < "$d/src/VERSION" || true
        SELF_TAG="local"
    else
        command -v curl >/dev/null 2>&1 || command -v wget >/dev/null 2>&1 || return 1
        self_resolve_tag
        out="$(self_dl "$SELF_RAW/$SELF_TAG/src/VERSION" - 20 2>/dev/null)" || out=""
    fi
    out="${out//[[:space:]]/}"
    out="${out:0:100}"
    [[ "$out" =~ ^[0-9A-Za-z._-]+$ ]] || return 1
    SELF_REMOTE="$out"
}

self_status() {
    if [[ -z "$SELF_REMOTE" ]]; then
        echo "no-remote"; return
    fi
    if [[ -z "$SELF_LOCAL" ]]; then
        echo "no-local"; return
    fi
    if [[ "$SELF_REMOTE" == "$SELF_LOCAL" ]]; then
        echo "up-to-date"
    elif ver_gt "$SELF_REMOTE" "$SELF_LOCAL"; then
        echo "update-available"
    else
        echo "newer-local"
    fi
}

# Verify the tarball against a SHA256SUMS release asset when one exists.
# rc 0 = ok or nothing to verify, 1 = mismatch.
self_verify() {
    local tarball="$1" sums="$_WU_SELF_TMP/SHA256SUMS" want="" have="" line
    command -v sha256sum >/dev/null 2>&1 || return 0
    self_dl "https://github.com/$SELF_REPO/releases/download/$SELF_TAG/SHA256SUMS" "$sums" 30 2>/dev/null || return 0
    while IFS= read -r line; do
        case "$line" in
            *.tar.gz) want="${line%% *}"; break ;;
        esac
    done < "$sums"
    [[ -n "$want" ]] || return 0
    have="$(sha256sum "$tarball")"; have="${have%% *}"
    [[ "$have" == "$want" ]]
}

# Sets SELF_SRC. Runs in the main shell: the tmp dir and its trap live in
# self_main, so nothing is deleted behind our back.
self_acquire() {
    local url e v=""
    SELF_SRC=""
    if [[ -n "${WELLUTILS_SELF_SRC:-}" ]]; then
        SELF_SRC="$WELLUTILS_SELF_SRC"
    elif [[ "$SELF_RAW" == /* ]]; then
        SELF_SRC="$SELF_RAW"
    else
        if [[ "$SELF_TAG" == "main" || "$SELF_TAG" == "master" ]]; then
            url="https://codeload.github.com/$SELF_REPO/tar.gz/refs/heads/$SELF_TAG"
        else
            url="https://codeload.github.com/$SELF_REPO/tar.gz/refs/tags/$SELF_TAG"
        fi
        self_dl "$url" "$_WU_SELF_TMP/wellutils.tar.gz" 120 || return 1
        if ! self_verify "$_WU_SELF_TMP/wellutils.tar.gz"; then
            printf '  %s%s%s\n' "$R" "$(t updu_sum_fail)" "$RESET" >&2
            return 1
        fi
        tar -xzf "$_WU_SELF_TMP/wellutils.tar.gz" -C "$_WU_SELF_TMP" || return 1
        for e in "$_WU_SELF_TMP"/*/; do
            [[ -d "$e" && -f "$e/install.sh" ]] && { SELF_SRC="${e%/}"; break; }
        done
    fi
    [[ -n "$SELF_SRC" && -f "$SELF_SRC/install.sh" && -f "$SELF_SRC/src/VERSION" ]] || return 1
    # exactly the version we compared against
    IFS= read -r v < "$SELF_SRC/src/VERSION" || true
    v="${v//[[:space:]]/}"
    [[ "$v" == "$SELF_REMOTE" ]] || return 1
}

self_install_to() {
    local src="$1"
    WELLUTILS_LOCAL=1 WELLUTILS_PREFIX="" bash "$src/install.sh" \
        --prefix="$SELF_PREFIX" --no-deps </dev/null
}

self_info_box() {
    _LINES+=("$BOLD$(t updu_current)$RESET  $W${SELF_LOCAL:-?}$RESET")
    _LINES+=("$BOLD$(t updu_latest)$RESET  $G${SELF_REMOTE:-?}$RESET")
    _LINES+=("$BOLD$(t updu_prefix)$RESET  $DIM${SELF_PREFIX:-$SELF_LIB}$RESET")
}

json_self_out() {
    local status="$1"
    wu_json_head "$_WU_TOOLNAME" "$_WU_VERSION"
    printf ',\n  "self_update": {\n'
    printf '    "current": "%s",\n' "$(json_esc "${SELF_LOCAL:-}")"
    printf '    "latest": "%s",\n' "$(json_esc "${SELF_REMOTE:-}")"
    printf '    "tag": "%s",\n' "$(json_esc "${SELF_TAG:-}")"
    printf '    "status": "%s",\n' "$(json_esc "$status")"
    printf '    "owner": "%s",\n' "$(json_esc "${SELF_OWNER:-}")"
    printf '    "prefix": "%s"\n' "$(json_esc "${SELF_PREFIX:-$SELF_LIB}")"
    printf '  }\n'
    wu_json_end
}

self_footer() {
    printf '\n  %sWellUp v%s | %s%s\n\n' "$DIM" "$_WU_VERSION" "$(date '+%Y-%m-%d %H:%M:%S')" "$RESET"
}

self_main() {
    self_detect
    if [[ -f "$SELF_LIB/wellup" || -z "$SELF_PREFIX" ]]; then
        if [[ "$_WU_JSON" == "1" ]]; then json_self_out "checkout"; return 0; fi
        printf '  %s\n' "$(t updu_checkout)" >&2
        return 0
    fi
    if self_pkg_owner; then
        if [[ "$_WU_JSON" == "1" ]]; then json_self_out "package-managed"; return 0; fi
        printf '  %s (%s)\n' "$(t updu_pkg_owned)" "$SELF_OWNER" >&2
        printf '  %s\n' "$(t updu_pkg_hint)" >&2
        return 0
    fi

    if ! self_fetch; then
        [[ "$_WU_JSON" == "1" ]] && json_self_out "no-remote"
        printf '%s\n' "$(t updu_fetch_fail)" >&2
        exit 3
    fi
    local status
    status="$(self_status)"

    if [[ "$_WU_JSON" == "1" ]]; then
        json_self_out "$status"
        return 0
    fi

    box_header "$(_emu '🔄')" "wellup --self-update" "$(t updu_title)"
    box "$(_emu '⚙')" "$(t updu_system)" self_info_box

    if [[ "$status" == "up-to-date" || "$status" == "newer-local" ]]; then
        printf '\n  %s%s%s\n' "$G" "$(t updu_up_to_date)" "$RESET"
        self_footer
        return 0
    fi

    printf '\n  %s%s %s%s\n' "$G" "$(t updu_update)" "$RESET" "$SELF_REMOTE"

    if [[ "$_UP_CHECK" == "1" ]]; then
        self_footer
        return 0
    fi

    if ! confirm_update; then
        printf '\n  %s\n\n' "$(t upd_aborted)"
        return 0
    fi

    local tmpbase="${TMPDIR:-/tmp}"
    [[ -d "$tmpbase" && -w "$tmpbase" ]] || tmpbase="${PREFIX:+$PREFIX/tmp}"
    [[ -n "$tmpbase" && -d "$tmpbase" && -w "$tmpbase" ]] || tmpbase="${HOME:-.}"
    _WU_SELF_TMP="$(mktemp -d "$tmpbase/wellup-self.XXXXXX")" \
        || { printf '\n  %s%s%s\n\n' "$R" "$(t updu_error)" "$RESET"; return 3; }
    trap '[[ -n "$_WU_SELF_TMP" && -d "$_WU_SELF_TMP" ]] && rm -rf -- "$_WU_SELF_TMP"' EXIT
    trap 'printf "\n  %s\n\n" "$(t upd_aborted)"; exit 130' INT
    printf '  %s\n\n' "$(t updu_applying)"
    if ! self_acquire; then
        trap - INT
        printf '\n  %s%s%s\n\n' "$R" "$(t updu_error)" "$RESET"
        return 3
    fi
    if self_install_to "$SELF_SRC"; then
        trap - INT
        printf '\n  %s%s %s%s\n' "$G" "$(t updu_done)" "$RESET" "$SELF_REMOTE"
        self_footer
        return 0
    else
        trap - INT
        printf '\n  %s%s%s\n\n' "$R" "$(t updu_error)" "$RESET"
        return 3
    fi
}

pacnew_list() {
    local f n=0
    while IFS= read -r f; do
        [[ -z "$f" ]] && continue
        n=$(( n + 1 ))
        pline_sub "$(_emu '📄') ${BOLD}${f%.pacnew}${RESET} ${DIM}(${f##*.})${RESET}"
    done < <(find /etc -name '*.pacnew' -o -name '*.pacsave' 2>/dev/null | sort || true)
    if (( n == 0 )); then
        pline "$(_emu '✔') ${G}$(t pacnew_none)${RESET}"
    else
        pline ""
        pline_sub "$(_emu '🧹') $(t pacnew_count): ${BOLD}${n}${RESET} · $(t pacnew_hint) ${DIM}sudo pacdiff${RESET}"
    fi
}

pacnew_main() {
    box_header "$(_emu '📦')" "wellup" "$(t pacnew_title)"
    box "$(_emu '📦')" "$(t pacnew_title)" pacnew_list
    printf '\n  %sWellUp v%s | %s%s\n\n' "$DIM" "$_WU_VERSION" "$(date '+%Y-%m-%d %H:%M:%S')" "$RESET"
}

main() {
    if [[ "$_UP_PACNEW" == "1" ]]; then
        pacnew_main
        return $?
    fi

    if [[ "$_UP_SELF" == "1" ]]; then
        self_main
        return $?
    fi

    detect_pm

    if [[ -z "$_UP_PM" ]]; then
        printf '%s\n' "$(t upd_no_pm)" >&2
        exit 3
    fi

    pm_check
    local count="${#UP_LINES[@]}"

    if [[ "$_WU_JSON" == "1" ]]; then
        json_out
        return 0
    fi

    box_header "$(_emu '🔄')" "wellup" "$(t upd_title)"
    box "$(_emu '💻')" "$(t upd_system)" up_system_box

    if (( count > 0 )); then
        box "$(_emu '📦')" "$(t upd_available): $count" up_list_box
    else
        printf '\n  %s%s%s\n' "$G" "$(t upd_no_updates)" "$RESET"
    fi

    if [[ "$_UP_CHECK" == "1" || $count -eq 0 ]]; then
        printf '\n  %sWellUp v%s | %s%s\n\n' "$DIM" "$_WU_VERSION" "$(date '+%Y-%m-%d %H:%M:%S')" "$RESET"
        return 0
    fi

    if ! confirm_update; then
        printf '\n  %s\n\n' "$(t upd_aborted)"
        return 0
    fi

    trap 'printf "\n  %s\n\n" "$(t upd_aborted)"; exit 130' INT
    printf '  %s\n\n' "$(t upd_applying)"
    if pm_update; then
        printf '\n  %s%s%s\n\n' "$G" "$(t upd_done)" "$RESET"
    else
        printf '\n  %s%s%s\n\n' "$R" "$(t upd_error)" "$RESET"
        return 3
    fi
    trap - INT

    printf '\n  %sWellUp v%s | %s%s\n\n' "$DIM" "$_WU_VERSION" "$(date '+%Y-%m-%d %H:%M:%S')" "$RESET"
}

wu_run main "$@"
