#compdef wellnet
# zsh completion for wellnet
# Part of wellutils by wellbou_

_wellnet() {
    _arguments -S \
        --help[show help] \
        --version[show version] \
        --lang=[output language]: :(ru en auto) \
        --color=[colorize output]: :(always auto never) \
        --json[] \
        --short[] \
        --html[] \
        --plain[] \
        --box[] \
        --no-emoji[] \
        --emoji[] \
        --debug[shell tracing] \
        --
}

_wellnet "$@"
