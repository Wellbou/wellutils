#compdef whtml
# zsh completion for whtml
# Part of wellutils by wellbou_
# Generated by tools/gen-completions.sh from `whtml --help` -- do not edit.

_whtml() {
    _arguments -s \
        '--output=[save HTML to FILE (default\: ~/wellreport.html)]:file:_files' \
        '--no-open[do not auto-open the report in a browser]' \
        '--open[force open in browser]' \
        '--ami[render the classic AMI BIOS 2000s setup look]' \
        '--ai[OPTIONAL AI analysis. Requires WHTML_AI_ENDPOINT to be set]' \
        '--lang=[report language (auto = from locale; --ami is English only)]:value:(ru en auto)' \
        '-l+[report language (auto = from locale; --ami is English only)]:value:(ru en auto)' \
        '--debug[shell tracing + progress log on stderr]' \
        '--help[this help]' \
        '-h[this help]' \
        '--version[print version]' \
        '-V[print version]' \
        '*: :'
}

_whtml "$@"
