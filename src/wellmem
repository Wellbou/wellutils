#!/usr/bin/env bash
# wellmem -- Beautiful memory overview
# Part of wellutils by wellbou_
set -euo pipefail

# ─── Shared libs ────────────────────────────────────────────────
_WU_TOOLNAME="wellmem" _WU_NAME="WellMem" _WU_VERSION="1.1"
_WU_SHORT_OK=1
_WU_TAGLINE="Beautiful memory overview"
_WU_BOOT_DIR="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="$(dirname -- "$_WU_BOOT_DIR")/share/wellutils"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="/usr/local/share/wellutils"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="/usr/share/wellutils"
source "$_WU_BOOT_DIR/bootstrap.sh" lang box cli parse jedec
# ─── Rare-hardware guards (Termux/PS5/ARM/laptops may lack tools) ──


ORANGE=$'\033[1;38;5;208m'

# dmidecode is only needed for the DIMM list in the full report; --short and
# --json never pay for the exec (or a sudo prompt check).
_WU_DMIDECODE=""
wm_load_dmi() {
    command -v dmidecode >/dev/null 2>&1 || return 0
    _WU_DMIDECODE=$(wu_root_run dmidecode -t memory 2>/dev/null) || _WU_DMIDECODE=""
    [[ -n "$_WU_DMIDECODE" ]] || _WU_DMIDECODE=$(dmidecode -t memory 2>/dev/null) || _WU_DMIDECODE=""
}

# ─── /proc/meminfo, parsed once ─────────────────────────────────
MI_total=0 MI_free=0 MI_avail="" MI_buffers=0 MI_cached=0 MI_srecl=0 MI_shmem=0
MI_swtotal=0 MI_swfree=0 MI_htotal=0 MI_hfree=0 MI_hsize=""
wm_meminfo() {
    local k v u
    [[ -r /proc/meminfo ]] || return 0
    while IFS=': ' read -r k v u; do
        [[ "$v" =~ ^[0-9]+$ ]] || continue
        case "$k" in
            MemTotal) MI_total=$v ;;         MemFree) MI_free=$v ;;
            MemAvailable) MI_avail=$v ;;     Buffers) MI_buffers=$v ;;
            Cached) MI_cached=$v ;;          SReclaimable) MI_srecl=$v ;;
            Shmem) MI_shmem=$v ;;            SwapTotal) MI_swtotal=$v ;;
            SwapFree) MI_swfree=$v ;;        HugePages_Total) MI_htotal=$v ;;
            HugePages_Free) MI_hfree=$v ;;   Hugepagesize) MI_hsize="$v${u:+ $u}" ;;
        esac
    done < /proc/meminfo 2>/dev/null || true
    # Kernels < 3.14 have no MemAvailable: estimate it like free(1) did.
    [[ -n "$MI_avail" ]] || MI_avail=$(( MI_free + MI_buffers + MI_cached ))
    (( MI_avail > MI_total && MI_total > 0 )) && MI_avail=$MI_total
    return 0
}

# NUMA node count: sysfs glob (no fork) -> zoneinfo -> 1.
wm_numa() {
    local n=0 d
    for d in /sys/devices/system/node/node[0-9]*; do [[ -d "$d" ]] && n=$(( n + 1 )); done
    if (( n == 0 )) && [[ -r /proc/zoneinfo ]]; then
        n=$(awk '/^Node / { nodes[$2] = 1 } END { c = 0; for (x in nodes) c++; print c }' /proc/zoneinfo 2>/dev/null) || n=0
        [[ "$n" =~ ^[0-9]+$ ]] || n=0
    fi
    (( n > 0 )) || n=1
    printf '%d' "$n"
}

# zram compression algorithm: "lzo [lz4] zstd" -> lz4
wm_zram_algo() {
    local l="" a="unknown"
    if wu_read "$1/comp_algorithm" l && [[ "$l" == *"["*"]"* ]]; then
        a=${l#*[}; a=${a%%]*}
    elif [[ -n "$l" && "$l" != *" "* ]]; then
        a=$l
    elif wu_read "$1/algorithm" l && [[ -n "$l" ]]; then
        a=$l
    fi
    printf '%s' "$a"
}

# ─── Helpers ─────────────────────────────────────────────────────
usage_color() {
    local pct=$1
    if   (( pct < 50 )); then printf '%s' "$G"
    elif (( pct < 75 )); then printf '%s' "$Y"
    elif (( pct < 90 )); then printf '%s' "$ORANGE"
    else                      printf '%s' "$R"
    fi
}

usage_bar() {
    local pct=$1 width=${2:-30}
    local filled=$(( pct * width / 100 ))
    local empty=$(( width - filled ))
    usage_color "$pct"
    wu_bar "$filled" "$empty"
    printf '%s' "$RESET"
}

# fmt_kb KB [VAR] -- integer math, one decimal, no awk fork.
fmt_kb() {
    local kb=$1 _o t
    [[ "$kb" =~ ^[0-9]+$ ]] || kb=0
    if (( kb >= 1048576 )); then
        t=$(( (kb * 10 + 524288) / 1048576 )); _o="$(( t / 10 )).$(( t % 10 )) GiB"
    elif (( kb >= 1024 )); then
        t=$(( (kb * 10 + 512) / 1024 ))
        if (( t >= 10240 )); then _o="1.0 GiB"; else _o="$(( t / 10 )).$(( t % 10 )) MiB"; fi
    else
        _o="$kb KiB"
    fi
    if [[ -n "${2:-}" ]]; then printf -v "$2" '%s' "$_o"; else printf '%s' "$_o"; fi
}

pct_of() {  # pct_of PART TOTAL -> integer percent
    local p=$1 t=$2
    (( t > 0 )) || { printf 0; return; }
    printf '%d' $(( p * 100 / t ))
}

# ─── DIMM list from dmidecode -t memory ─────────────────────────
# Fields are anchored on the leading TAB so "Volatile Size", "Logical Size",
# "Configured Memory Speed", "Bank Locator", "Error Correction Type" etc.
# can't overwrite the real Size / Speed / Locator / Type values.
wm_dimms() {
    local -a dimm_sz=() dimm_type=() dimm_speed=() dimm_manuf=() dimm_pn=() dimm_loc=()
    local _dline _v _ds="" _dt="" _dp="" _dm="" _dsp="" _dl="" _in=0
    _wm_flush() {
        (( _in )) || return 0
        local mb; mb=$(wu_size_mb "$_ds")
        [[ "$mb" =~ ^[0-9]+$ ]] || mb=0
        if (( mb > 0 )); then
            dimm_sz+=("$mb"); dimm_type+=("$_dt"); dimm_speed+=("$_dsp")
            dimm_manuf+=("$_dm"); dimm_pn+=("$_dp"); dimm_loc+=("$_dl")
        fi
        return 0
    }
    while IFS= read -r _dline; do
        _dline=${_dline%$'\r'}
        case "$_dline" in
            "Memory Device"*)
                _wm_flush
                _ds=""; _dt=""; _dp=""; _dm=""; _dsp=""; _dl=""; _in=1 ;;
            $'\tSize: '*)          _ds=${_dline#*: } ;;
            $'\tType: '*)          wu_trim "${_dline#*: }" _v; wu_junk "$_v" || _dt=$_v ;;
            $'\tSpeed: '*)         _dsp=$(wu_speed "${_dline#*: }") ;;
            $'\tManufacturer: '*)  wu_trim "${_dline#*: }" _v; wu_junk "$_v" || _dm=$_v ;;
            $'\tPart Number: '*)   wu_trim "${_dline#*: }" _v; wu_junk "$_v" || _dp=$_v ;;
            $'\tLocator: '*)       wu_trim "${_dline#*: }" _v; wu_junk "$_v" || _dl=$_v ;;
        esac
    done <<< "$_WU_DMIDECODE"
    _wm_flush
    unset -f _wm_flush

    local nmod=${#dimm_sz[@]} i _m _dec _nmb _sz _row
    (( nmod > 0 )) || return 0
    _LINES+=( "" )
    _LINES+=( "  ${BOLD}${W}$(_ic '🧬')DIMM${RESET} (${nmod} $(t_plural "$nmod" mem_module))" )
    for (( i=0; i<nmod; i++ )); do
        _m="${dimm_manuf[$i]}"
        # JEDEC-coded manufacturer ("80AD", "0198", "80AD000080AD")
        if [[ "$_m" =~ ^[0-9A-Fa-f]{4}$ || "$_m" =~ ^([0-9A-Fa-f]{4})0000[0-9A-Fa-f]{4}$ ]] && declare -F wu_jedec_decode &>/dev/null; then
            # Bytes carry an odd-parity bit (0x80): "80AD" = bank 1, 0x2D (SK Hynix).
            printf -v _dec '%02X%02X' $(( 16#${_m:0:2} & 127 )) $(( 16#${_m:2:2} & 127 ))
            _dec=$(wu_jedec_decode "$_dec" 2>/dev/null) || _dec=""
            [[ -n "$_dec" && ! "$_dec" =~ ^[0-9A-Fa-f]{4}$ ]] && _m="$_dec"
        fi
        # "Bank 5, Hex 0xCD" (dmidecode >= 3.x on some boards)
        if [[ "$_m" =~ ^Bank\ ([0-9]+),\ Hex\ 0x([0-9A-Fa-f]{2})$ ]] && declare -F wu_jedec_decode &>/dev/null \
           && (( BASH_REMATCH[1] >= 1 )); then
            printf -v _dec '%02X%02X' $(( BASH_REMATCH[1] - 1 )) $(( 16#${BASH_REMATCH[2]} & 127 ))
            _dec=$(wu_jedec_decode "$_dec" 2>/dev/null) || _dec=""
            [[ -n "$_dec" && ! "$_dec" =~ ^[0-9A-Fa-f]{4}$ ]] && _m="$_dec"
        fi
        _nmb=${dimm_sz[$i]}
        if (( _nmb >= 1024 && _nmb % 1024 == 0 )); then _sz="$(( _nmb / 1024 )) GiB"
        elif (( _nmb >= 1024 )); then _sz="$(( _nmb / 1024 )).$(( (_nmb % 1024) * 10 / 1024 )) GiB"
        else _sz="${_nmb} MiB"
        fi
        _row="       └─ ${dimm_loc[$i]:-DIMM $(( i + 1 ))}: ${_sz}"
        [[ -n "${dimm_type[$i]}" ]] && _row+=" ${dimm_type[$i]}"
        if [[ -n "${dimm_speed[$i]}" ]]; then
            if [[ -n "${dimm_type[$i]}" ]]; then _row+="-${dimm_speed[$i]}"; else _row+=" ${dimm_speed[$i]} MT/s"; fi
        fi
        _row+="${DIM}"
        [[ -n "$_m" ]] && _row+=" · ${_m}"
        [[ -n "${dimm_pn[$i]}" ]] && _row+=" ${dimm_pn[$i]}"
        _row+="${RESET}"
        _LINES+=( "$_row" )
    done
}

# ECC / EDAC error counters (kernel reports corrected / uncorrected)
WM_EDAC_DIR=${WM_EDAC_DIR:-/sys/devices/system/edac/mc}
wm_edac() {
    [[ -d "$WM_EDAC_DIR" ]] || return 0
    local ce_total=0 ue_total=0 mc_count=0 mc ce ue
    for mc in "$WM_EDAC_DIR"/mc*; do
        [[ -d "$mc" ]] || continue
        mc_count=$(( mc_count + 1 ))
        wu_read "$mc/ce_count" ce || ce=0
        wu_read "$mc/ue_count" ue || ue=0
        [[ "$ce" =~ ^[0-9]+$ ]] || ce=0
        [[ "$ue" =~ ^[0-9]+$ ]] || ue=0
        ce_total=$(( ce_total + ce ))
        ue_total=$(( ue_total + ue ))
    done
    (( mc_count > 0 )) || return 0
    _LINES+=( "" )
    local _ecc_color="$G"
    (( ue_total > 0 )) && _ecc_color="$R"
    (( ce_total > 0 && ue_total == 0 )) && _ecc_color="$Y"
    _LINES+=( "  ${BOLD}${W}$(_ic '🔒')ECC / EDAC${RESET} ${mc_count} MC: CE=${_ecc_color}${ce_total}${RESET} UE=${_ecc_color}${ue_total}${RESET}" )
}

# ─── Content ─────────────────────────────────────────────────────
ml() {
    local label="$1" color="$2" value="$3" v
    printf -v v '%9s' "$value"
    _LINES+=( "  ${BOLD}$(_wu_pad_r "${label}:" 14)${RESET}  ${color}${v}${RESET}" )
}

print_all() {
    local total=$MI_total available=$MI_avail used
    local cached=$(( MI_cached + MI_srecl ))
    (( total > 0 )) || total=1
    (( available < 0 )) && available=0
    used=$(( total - available ))
    (( used < 0 )) && used=0

    local pct_used; pct_used=$(pct_of "$used" "$total")
    local total_h used_h available_h buffers_h cached_h shared_h free_h
    fmt_kb "$MI_total" total_h;  fmt_kb "$used" used_h
    fmt_kb "$available" available_h; fmt_kb "$MI_buffers" buffers_h
    fmt_kb "$cached" cached_h;   fmt_kb "$MI_shmem" shared_h
    fmt_kb "$MI_free" free_h

    _LINES+=( "" )
    _LINES+=( "  ${BOLD}$(usage_bar "$pct_used" 40)${RESET} ${pct_used}% $(t mem_pct_used)" )
    _LINES+=( "" )
    ml "$(t mem_total)" "$W" "$total_h"
    ml "$(t mem_used)" "$R" "$used_h"
    ml "$(t mem_available)" "$G" "$available_h"
    ml "$(t mem_buffers)" "$C" "$buffers_h"
    ml "$(t mem_cached)" "$C" "$cached_h"
    ml "$(t mem_shared)" "$DIM" "$shared_h"
    ml "$(t mem_free)" "$DIM" "$free_h"

    local swap_total=$MI_swtotal swap_free=$MI_swfree swap_used
    (( swap_free > swap_total )) && swap_free=$swap_total
    swap_used=$(( swap_total - swap_free ))

    _LINES+=( "" )
    _LINES+=( "  ${BOLD}${W}$(_ic '🔄')$(t mem_swap)${RESET}" )
    if (( swap_total > 0 )); then
        local swap_pct swap_total_h swap_used_h swap_free_h
        swap_pct=$(pct_of "$swap_used" "$swap_total")
        fmt_kb "$swap_total" swap_total_h; fmt_kb "$swap_used" swap_used_h; fmt_kb "$swap_free" swap_free_h
        _LINES+=( "  ${BOLD}$(usage_bar "$swap_pct" 40)${RESET} ${swap_pct}% $(t mem_pct_used)" )
        _LINES+=( "  $(t mem_total): ${W}${swap_total_h}${RESET}  $(t mem_used): ${R}${swap_used_h}${RESET}  $(t mem_free): ${DIM}${swap_free_h}${RESET}" )
    else
        _LINES+=( "  ${DIM}$(t mem_no_swap)${RESET}" )
    fi

    local zram_dev zram_size zram_h zram_algorithm zorig zcompr zdata_h zcompr_h zr
    for zram_dev in /sys/block/zram*; do
        [[ -d "$zram_dev" ]] || continue
        wu_read "$zram_dev/disksize" zram_size || zram_size=0
        [[ "$zram_size" =~ ^[0-9]+$ ]] || zram_size=0
        fmt_kb "$(( zram_size / 1024 ))" zram_h
        zram_algorithm=$(wm_zram_algo "$zram_dev")
        _LINES+=( "" )
        _LINES+=( "  ${BOLD}${W}$(_ic '📦')$(t mem_zram)${RESET}" )
        _LINES+=( "  $(t mem_size): ${G}${zram_h}${RESET}  $(t mem_algorithm): ${DIM}${zram_algorithm}${RESET}" )
        zorig=0 zcompr=0
        [[ -r "$zram_dev/mm_stat" ]] && { read -r zorig zcompr _ < "$zram_dev/mm_stat"; } 2>/dev/null || true
        [[ "$zorig" =~ ^[0-9]+$ ]] || zorig=0
        [[ "$zcompr" =~ ^[0-9]+$ ]] || zcompr=0
        if (( zorig > 0 )); then
            fmt_kb "$(( zorig / 1024 ))" zdata_h; fmt_kb "$(( zcompr / 1024 ))" zcompr_h
            if (( zcompr > 0 )); then zr=$(( zorig * 10 / zcompr )); zr="$(( zr / 10 )).$(( zr % 10 ))"; else zr=0; fi
            _LINES+=( "  ${DIM}$(t mem_zram_data): ${W}${zdata_h}${RESET}  $(t mem_zram_compr): ${W}${zcompr_h}${RESET}  ($(t mem_zram_ratio): ${zr}x)${RESET}" )
        fi
    done

    if [[ -n "$MI_hsize" ]] && (( MI_htotal > 0 )); then
        _LINES+=( "" )
        _LINES+=( "  ${BOLD}${W}$(_ic '📏')$(t mem_huge)${RESET}" )
        _LINES+=( "  $(t mem_total): ${W}${MI_htotal}${RESET}  $(t mem_free): ${G}${MI_hfree}${RESET}  $(t mem_size): ${DIM}${MI_hsize}${RESET}" )
    fi

    local numa_nodes; numa_nodes=$(wm_numa)
    if (( numa_nodes > 1 )); then
        _LINES+=( "" )
        _LINES+=( "  ${BOLD}${W}$(_ic '🔢')$(t mem_numa)${RESET} ${numa_nodes}" )
    fi

    [[ -n "${_WU_DMIDECODE:-}" ]] && wm_dimms
    wm_edac
    return 0
}

# ─── JSON output ────────────────────────────────────────────────
json_out() {
    local total=$MI_total free=$MI_free available=$MI_avail used
    local cached=$(( MI_cached + MI_srecl ))
    used=$(( total - available )); (( used < 0 )) && used=0
    local swap_total=$MI_swtotal swap_free=$MI_swfree swap_used
    swap_used=$(( swap_total - swap_free )); (( swap_used < 0 )) && swap_used=0
    local numa_nodes; numa_nodes=$(wm_numa)

    wu_json_head "$_WU_TOOLNAME" "$_WU_VERSION"
    printf ',\n  "memory": {\n'
    printf '    "total_kb": %d,\n' "$total"
    printf '    "used_kb": %d,\n' "$used"
    printf '    "free_kb": %d,\n' "$free"
    printf '    "available_kb": %d,\n' "$available"
    printf '    "buffers_kb": %d,\n' "$MI_buffers"
    printf '    "cached_kb": %d,\n' "$cached"
    printf '    "shared_kb": %d\n' "$MI_shmem"
    printf '  },\n'
    printf '  "swap": {\n'
    printf '    "total_kb": %d,\n' "$swap_total"
    printf '    "used_kb": %d,\n' "$swap_used"
    printf '    "free_kb": %d\n' "$swap_free"
    printf '  },\n'
    printf '  "zram": [\n'
    local first=1 zram_dev zram_size zram_algorithm zorig zcompr zused
    for zram_dev in /sys/block/zram*; do
        [[ -d "$zram_dev" ]] || continue
        wu_read "$zram_dev/disksize" zram_size || zram_size=0
        [[ "$zram_size" =~ ^[0-9]+$ ]] || zram_size=0
        zram_algorithm=$(wm_zram_algo "$zram_dev")
        zorig=0 zcompr=0 zused=0
        [[ -r "$zram_dev/mm_stat" ]] && { read -r zorig zcompr zused _ < "$zram_dev/mm_stat"; } 2>/dev/null || true
        [[ "$zorig" =~ ^[0-9]+$ ]] || zorig=0
        [[ "$zcompr" =~ ^[0-9]+$ ]] || zcompr=0
        [[ "$zused" =~ ^[0-9]+$ ]] || zused=0
        (( first )) && first=0 || printf ',\n'
        printf '    { "name": "%s", "size_kb": %d, "algorithm": "%s", "data_kb": %d, "compr_kb": %d, "mem_used_kb": %d }' \
            "$(json_esc "${zram_dev##*/}")" "$(( zram_size / 1024 ))" "$(json_esc "$zram_algorithm")" \
            "$(( zorig / 1024 ))" "$(( zcompr / 1024 ))" "$(( zused / 1024 ))"
    done
    printf '\n  ],\n'
    printf '  "hugepages": {\n'
    printf '    "total": %d,\n' "$MI_htotal"
    printf '    "free": %d,\n' "$MI_hfree"
    printf '    "size": "%s"\n' "$(json_esc "$MI_hsize")"
    printf '  },\n'
    printf '  "numa_nodes": %d\n' "$numa_nodes"
    wu_json_end
}

# ─── Main ────────────────────────────────────────────────────────
short_out() {
    (( MI_total > 0 )) || { printf -- '-\n'; return 0; }
    local u t
    u=$(( ( (MI_total - MI_avail) * 10 + 524288 ) / 1048576 ))
    t=$(( ( MI_total * 10 + 524288 ) / 1048576 ))
    printf '%d.%d/%d.%dGiB\n' $(( u / 10 )) $(( u % 10 )) $(( t / 10 )) $(( t % 10 ))
}

main() {
    wm_meminfo
    if [[ "$_WU_JSON" == "1" ]]; then json_out; return 0; fi
    if [[ "$_WU_SHORT" == "1" ]]; then short_out; return 0; fi

    wm_load_dmi
    box_header "$(_emu '🧠')" "wellmem" "$(t mem_title)"
    box "$(_emu '🧩')" "$(t mem_ram)" print_all

    printf '\n  %sWellMem v%s | %s%s\n\n' "$DIM" "$_WU_VERSION" "$(date '+%Y-%m-%d %H:%M:%S')" "$RESET"
}

wu_run main "$@"
