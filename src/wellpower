#!/usr/bin/env bash
# wellpower v1 -- Battery health and power management overview.
# Part of wellutils by wellbou_
set -euo pipefail

_WU_TOOLNAME="wellpower" _WU_NAME="WellPower" _WU_VERSION="1.0"
_WU_SHORT_OK=1
_WU_TAGLINE="battery health and power profiles"
_WU_BOOT_DIR="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="$(dirname -- "$_WU_BOOT_DIR")/share/wellutils"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="/usr/local/share/wellutils"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="/usr/share/wellutils"
source "$_WU_BOOT_DIR/bootstrap.sh" lang cli box parse

PS_DIR=/sys/class/power_supply

# ─── Helpers ────────────────────────────────────────────────────
# Supplies are classified by type (wu_batteries / wu_ac_adapters), not by
# name: CMB0, macsmc-battery, axp20x-battery, ADP1, ACAD ... all count.
_WP_BATS=() _WP_ACS=()
_wp_scan() {
    local d
    _WP_BATS=() _WP_ACS=()
    while IFS= read -r d; do [[ -n "$d" ]] && _WP_BATS+=("$d"); done < <(wu_batteries)
    while IFS= read -r d; do [[ -n "$d" ]] && _WP_ACS+=("$d"); done < <(wu_ac_adapters)
    return 0
}

wp_read() { local _v=""; wu_read "$1" _v || true; printf '%s' "$_v"; }
wp_pct() {
    local v="$1"
    [[ "$v" =~ ^[0-9]+(\.[0-9]+)?$ ]] || return 1
    printf '%d' "${v%%.*}"
}

# _wp_int FILE VAR -- non-negative integer from sysfs (abs of negative
# values: some drivers report discharge as negative current/power), or "".
_wp_int() {
    local _x=""
    wu_read "$1" _x || true
    _x=${_x#-}
    [[ "$_x" =~ ^[0-9]+$ ]] || _x=""
    printf -v "$2" '%s' "$_x"
}

# _wp_wear DIR -> sets _WP_WEAR ("" when unknown). energy_* (uWh) or
# charge_* (uAh) pairs, whichever is complete; never divides by zero.
_wp_wear() {
    local d="$1" f="" fd="" pre
    _WP_WEAR=""
    for pre in energy charge; do
        _wp_int "$d/${pre}_full" f
        _wp_int "$d/${pre}_full_design" fd
        [[ -n "$f" && -n "$fd" ]] && (( f > 0 && fd > 0 )) && break
        f="" fd=""
    done
    [[ -n "$f" ]] || return 0
    _WP_WEAR=$(( 100 - f * 100 / fd ))
    (( _WP_WEAR < 0 )) && _WP_WEAR=0
    return 0
}

# _wp_rate DIR -> sets _WP_UW (discharge/charge rate in uW, or "").
_wp_rate() {
    local d="$1" p="" c="" v=""
    _WP_UW=""
    _wp_int "$d/power_now" p
    if [[ -n "$p" ]]; then _WP_UW=$p; return 0; fi
    _wp_int "$d/current_now" c
    _wp_int "$d/voltage_now" v
    [[ -n "$c" && -n "$v" ]] && (( v > 0 )) && _WP_UW=$(( c * v / 1000000 ))   # uA*uV -> uW
    return 0
}

print_batteries() {
    local found=0 d name status cap cycles tech _WP_WEAR wear
    for d in ${_WP_BATS[@]+"${_WP_BATS[@]}"}; do
        found=1
        name=${d##*/}
        status=$(wp_read "$d/status")
        cap=$(wp_pct "$(wp_read "$d/capacity")") || cap="?"
        _wp_wear "$d"; wear=$_WP_WEAR
        cycles=$(wp_read "$d/cycle_count")
        tech=$(wp_read "$d/technology")

        local ccolor="$G"
        [[ "$cap" != "?" ]] && (( cap <= 20 )) && ccolor="$R"
        [[ "$cap" != "?" ]] && (( cap > 20 && cap <= 45 )) && ccolor="$Y"

        local line_out="$(_emu '🔋') ${BOLD}${name}${RESET}: ${ccolor}${cap}%${RESET}"
        [[ -n "$status" ]] && line_out+=" (${status})"
        [[ -n "$tech" ]] && line_out+="${DIM} · ${tech}${RESET}"
        pline "$line_out"
        if [[ -n "$wear" ]]; then
            local wcolor="$G"; (( wear >= 25 )) && wcolor="$Y"; (( wear >= 40 )) && wcolor="$R"
            local wtxt="$(t pwr_wear): ${wcolor}${wear}%${RESET}"
            [[ "$cycles" =~ ^[0-9]+$ ]] && (( cycles > 0 )) && wtxt+=" · $(t pwr_cycles): $cycles"
            pline_sub "$wtxt"
        elif [[ "$cycles" =~ ^[0-9]+$ ]] && (( cycles > 0 )); then
            pline_sub "$(t pwr_cycles): $cycles"
        fi
    done
    (( found )) || pline "${DIM}$(t pwr_no_battery)${RESET}"
}

print_ac() {
    local found=0 d name online
    for d in ${_WP_ACS[@]+"${_WP_ACS[@]}"}; do
        name=${d##*/}
        online=$(wp_read "$d/online")
        case "$online" in
            1) pline "$(_emu '⚡') ${BOLD}${name}${RESET}: $(t pwr_online)"; found=1 ;;
            0) pline "$(_emu '🔌') ${BOLD}${name}${RESET}: $(t pwr_offline)"; found=1 ;;
            *) : ;;
        esac
    done
    (( found )) || pline "${DIM}$(t pwr_no_ac)${RESET}"
}

print_thresholds() {
    local d name start stop found=0
    for d in ${_WP_BATS[@]+"${_WP_BATS[@]}"}; do
        name=${d##*/}
        start=$(wp_read "$d/charge_control_start_threshold")
        stop=$(wp_read "$d/charge_control_end_threshold")
        [[ -n "$start$stop" ]] || continue
        found=1
        local ttxt=""
        [[ -n "$start" ]] && ttxt="$(t pwr_thr_start): ${start}%"
        [[ -n "$stop" ]] && { [[ -n "$ttxt" ]] && ttxt+=" · "; ttxt+="$(t pwr_thr_stop): ${stop}%"; }
        pline_sub "$(_emu '🎚') ${BOLD}${name}${RESET}: $ttxt"
    done
    (( found )) || pline "${DIM}$(t pwr_no_thresholds)${RESET}"
}

print_governor() {
    local prof="" src=""
    if command -v powerprofilesctl &>/dev/null; then
        prof=$(powerprofilesctl get 2>/dev/null || true)
        [[ -n "$prof" ]] && src="power-profiles-daemon"
    fi
    if [[ -z "$prof" ]]; then
        prof=$(wp_read /sys/firmware/acpi/platform_profile)
        [[ -n "$prof" ]] && src="platform_profile"
    fi
    if [[ -z "$prof" ]] && command -v tlp &>/dev/null; then
        prof="TLP"; src="tlp"
    fi
    if [[ -n "$prof" ]]; then
        pline "$(_emu '⚙') $(t pwr_profile): ${BOLD}${prof}${RESET} ${DIM}(${src})${RESET}"
    else
        pline "$(_emu '⚙') ${DIM}$(t pwr_no_profile)${RESET}"
    fi
}

print_drain() {
    # Current charge/discharge rate in watts when available.
    local d name found=0 _WP_UW tenths
    for d in ${_WP_BATS[@]+"${_WP_BATS[@]}"}; do
        name=${d##*/}
        _wp_rate "$d"
        [[ -n "$_WP_UW" ]] || continue
        found=1
        tenths=$(( (_WP_UW + 50000) / 100000 ))
        pline_sub "$(_emu '📉') ${BOLD}${name}${RESET}: $(( tenths / 10 )).$(( tenths % 10 )) W"
    done
    (( found )) || pline "${DIM}$(t pwr_no_rate)${RESET}"
}

json_out() {
    _wp_scan
    wu_json_head "$_WU_TOOLNAME" "$_WU_VERSION"
    printf ',\n  "batteries": [\n'
    local first=1 d name status cap cycles wear_j _WP_WEAR _WP_UW pw
    for d in ${_WP_BATS[@]+"${_WP_BATS[@]}"}; do
        name=${d##*/}; status=$(wp_read "$d/status")
        cap=$(wp_read "$d/capacity"); cycles=$(wp_read "$d/cycle_count")
        _wp_wear "$d"; wear_j=${_WP_WEAR:-null}
        _wp_rate "$d"; pw=null
        [[ -n "$_WP_UW" ]] && printf -v pw '%d.%06d' $(( _WP_UW / 1000000 )) $(( _WP_UW % 1000000 ))
        [[ "$cap" =~ ^[0-9]+$ ]] || cap=null
        [[ "$cycles" =~ ^[0-9]+$ ]] || cycles=null
        (( first )) && first=0 || printf ',\n'
        printf '    { "name": "%s", "status": "%s", "capacity_percent": %s, "wear_percent": %s, "cycle_count": %s, "power_w": %s }' \
            "$(json_esc "$name")" "$(json_esc "$status")" "$cap" "$wear_j" "$cycles" "$pw"
    done
    printf '\n  ],\n'
    local ac="null" v
    for d in ${_WP_ACS[@]+"${_WP_ACS[@]}"}; do
        v=$(wp_read "$d/online")
        [[ "$v" == 1 ]] && { ac=1; break; }
        [[ "$v" == 0 ]] && ac=0
    done
    printf '  "ac_online": %s,\n' "$ac"
    printf '  "thresholds": [\n'
    first=1
    local st sp
    for d in ${_WP_BATS[@]+"${_WP_BATS[@]}"}; do
        st=$(wp_read "$d/charge_control_start_threshold")
        sp=$(wp_read "$d/charge_control_end_threshold")
        [[ -n "$st$sp" ]] || continue
        (( first )) && first=0 || printf ',\n'
        printf '    { "name": "%s", "start": "%s", "end": "%s" }' \
            "$(json_esc "${d##*/}")" "$(json_esc "$st")" "$(json_esc "$sp")"
    done
    printf '\n  ]\n'
    wu_json_end
}

short_out() {
    _wp_scan
    local d cap status _WP_WEAR out
    for d in ${_WP_BATS[@]+"${_WP_BATS[@]}"}; do
        cap=$(wp_pct "$(wp_read "$d/capacity")") || cap=""
        [[ -n "$cap" ]] || continue
        status=$(wp_read "$d/status")
        out="${cap}%"
        [[ "$status" == "Charging" ]] && out+="+"
        _wp_wear "$d"
        [[ -n "$_WP_WEAR" ]] && out+=" ($(t pwr_wear) ${_WP_WEAR}%)"
        printf '%s\n' "$out"
        return 0
    done
    printf -- '-\n'
}

main() {
    if [[ "$_WU_JSON" == "1" ]]; then json_out; return 0; fi
    if [[ "$_WU_SHORT" == "1" ]]; then short_out; return 0; fi

    _wp_scan
    box_header "$(_emu '🔋')" "wellpower" "$(t pwr_title)"

    box "$(_emu '🔋')" "$(t pwr_battery)" print_batteries
    box "$(_emu '⚡')" "$(t pwr_ac)" print_ac
    box "$(_emu '📉')" "$(t pwr_drain)" print_drain
    box "$(_emu '🎚')" "$(t pwr_thresholds)" print_thresholds
    box "$(_emu '⚙')" "$(t pwr_mgmt)" print_governor

    printf '\n  %sWellPower v%s | %s%s\n\n' "$DIM" "$_WU_VERSION" "$(date '+%Y-%m-%d %H:%M:%S')" "$RESET"
}

wu_run main "$@"
