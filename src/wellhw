# ─── Helpers ────────────────────────────────────────────────────
# _hw_clean STR VAR -- trim + blank SMBIOS placeholders (never "PN: Unknown").
_hw_clean() {
    local __v
    wu_trim "${1//$'\r'/}" __v
    if wu_junk "$__v"; then __v=""
    else
        case "${__v,,}" in
            "not applicable"|"x.x"|"other"|"<bad index>"|"bad index"|"type2 - board version"|\
            "type2 - board vendor name1"|"type2 - board product name1"|"rev x.0x"|"123456789abc") __v="" ;;
        esac
    fi
    printf -v "$2" '%s' "$__v"
}

# _hw_norm_manuf STR VAR -- SMBIOS/SPD vendor field -> JEDEC name when possible.
#   "Bank 5, Hex 0xCD" -> 04CD, "80AD000080AD" -> 80AD, "0x80CE" -> 80CE,
#   0000/FFFF -> "" ; the 4-hex id is then resolved via wu_jedec_decode.
_hw_norm_manuf() {
    local __m __h="" __d
    _hw_clean "$1" __m
    if [[ "$__m" =~ ^[Bb]ank[[:space:]]*([0-9]+),?[[:space:]]*[Hh]ex[[:space:]]*(0[xX])?([0-9A-Fa-f]{2})$ ]]; then
        local __b=$(( 10#${BASH_REMATCH[1]} ))
        (( __b >= 1 )) || __b=1
        printf -v __h '%02X%s' $(( __b - 1 )) "${BASH_REMATCH[3]^^}"
    elif [[ "$__m" =~ ^(0[xX])?([0-9A-Fa-f]{4})$ ]]; then
        __h=${BASH_REMATCH[2]^^}
    elif [[ "$__m" =~ ^([0-9A-Fa-f]{4})([0-9A-Fa-f]{4}|[0-9A-Fa-f]{8}|[0-9A-Fa-f]{12})$ ]]; then
        __h=${BASH_REMATCH[1]^^}
    fi
    if [[ -n "$__h" ]]; then
        case "$__h" in 0000|FFFF|7F7F) __m="" ;; *)
            __m=$__h
            if declare -F wu_jedec_decode >/dev/null && __d=$(wu_jedec_decode "$__h"); then
                [[ -n "$__d" ]] && __m=$__d
            fi ;;
        esac
    fi
    printf -v "$2" '%s' "$__m"
}

# _hw_mb_txt MB VAR -- "8 GiB" / "1.5 GiB" / "512 MiB"
_hw_mb_txt() {
    local __mb=$1 __o
    if (( __mb >= 1024 )); then
        if (( __mb % 1024 == 0 )); then __o="$(( __mb / 1024 )) GiB"
        else __o="$(( __mb / 1024 )).$(( (__mb % 1024) * 10 / 1024 )) GiB"; fi
    else __o="${__mb} MiB"; fi
    printf -v "$2" '%s' "$__o"
}

# _hw_human BYTES VAR -- same rounding as lsblk (465.8G, 8G, 512B) so the
# JSON "size" stays identical to what older releases got from lsblk.
_hw_human() {
    local __b=$1 __e=0 __u="" __d __f=0 __us=(B K M G T P E)
    local __i=0
    while (( __i < 6 && __b >= (1 << (__e + 10)) )); do __e=$(( __e + 10 )); __i=$(( __i + 1 )); done
    __u=${__us[__i]}
    if (( __e == 0 )); then printf -v "$2" '%dB' "$__b"; return; fi
    __d=$(( __b >> __e ))
    __f=$(( __b & ((1 << __e) - 1) ))
    if (( __f )); then
        __f=$(( ((__f >> (__e - 10)) + 50) / 100 ))
        (( __f == 10 )) && { __d=$(( __d + 1 )); __f=0; }
    fi
    if (( __f )); then printf -v "$2" '%d.%d%s' "$__d" "$__f" "$__u"
    else printf -v "$2" '%d%s' "$__d" "$__u"; fi
}

# _hw_plural N -> module/modules (RU: модуль/модуля/модулей)
_hw_plural() {
    local n=$1 k=many
    if (( n % 10 == 1 && n % 100 != 11 )); then k=one
    elif (( n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) )); then k=few; fi
    t "mem_module_$k"
}

# ─── Collectors (one implementation shared by text, JSON, snapshot) ──
_HW_CPU_DONE=0 HW_CPU_MODEL="" HW_CPU_CORES="" HW_CPU_THREADS=""
hw_collect_cpu() {
    (( _HW_CPU_DONE )) && return 0; _HW_CPU_DONE=1
    HW_CPU_MODEL=$(wu_cpu_model_generic)
    local t=0 c=0 cc=0 line key val phys="" 
    local -A seen=()
    if [[ -r /proc/cpuinfo ]]; then
        while IFS= read -r line; do
            key=${line%%:*}; key=${key%"${key##*[![:space:]]}"}
            val=${line#*:}; val=${val#"${val%%[![:space:]]*}"}
            case "$key" in
                processor) [[ "$val" =~ ^[0-9]+$ ]] && t=$(( t + 1 )) ;;
                "physical id") phys=$val ;;
                "core id") [[ -n "${seen["$phys:$val"]+x}" ]] || { seen["$phys:$val"]=1; c=$(( c + 1 )); } ;;
                "cpu cores") [[ "$val" =~ ^[0-9]+$ ]] && (( cc == 0 )) && cc=$val ;;
            esac
        done < /proc/cpuinfo
    fi
    if (( t == 0 )); then
        t=$(getconf _NPROCESSORS_ONLN 2>/dev/null || nproc 2>/dev/null || printf 1)
        [[ "$t" =~ ^[0-9]+$ ]] || t=1
    fi
    (( c == 0 )) && c=$cc
    (( c == 0 || c > t )) && c=$t
    HW_CPU_CORES=$c HW_CPU_THREADS=$t
}

_HW_GPU_DONE=0 HW_GPU="" HW_GPU_VENDOR=""
hw_collect_gpu() {
    (( _HW_GPU_DONE )) && return 0; _HW_GPU_DONE=1
    local line bus vendor device aib
    if command -v lspci >/dev/null 2>&1; then
        while IFS= read -r line; do
            case "$line" in *'"VGA compatible controller'*|*'"3D controller'*|*'"Display controller'*) ;; *) continue ;; esac
            bus=${line%% *}
            IFS='"' read -r _ _ _ vendor _ device _ <<< "$line"
            [[ -z "$device" ]] && { device=$vendor; vendor=""; }
            aib=$(gpu_aib_vendor "$bus")
            HW_GPU="${aib:+$aib }${device}" HW_GPU_VENDOR=$vendor
            return 0
        done < <(lspci -mmnn 2>/dev/null)
    fi
    # No lspci: PCI class 03xx straight from sysfs + pci.ids.
    local d cls vid did nm
    for d in /sys/bus/pci/devices/*; do
        wu_read "$d/class" cls || continue
        [[ "$cls" == 0x03* ]] || continue
        wu_read "$d/vendor" vid; wu_read "$d/device" did
        nm=$(wu_pci_name "$vid" "$did")
        aib=$(gpu_aib_vendor "${d##*/}")
        HW_GPU="${aib:+$aib }${nm:-[${vid#0x}:${did#0x}]}"
        return 0
    done
    # SoC GPUs (vc4/v3d, panfrost, lima, msm, etnaviv, apple, ...): DRM
    # driver name, plus the DT compatible string when there is one.
    local c drv comp out="" seen=" "
    for c in /sys/class/drm/card[0-9]*; do
        [[ "${c##*/}" == *-* ]] && continue
        [[ -e "$c/device/driver" ]] || continue
        drv=$(readlink "$c/device/driver" 2>/dev/null) || continue
        drv=${drv##*/}
        [[ "$seen" == *" $drv "* ]] && continue
        seen+="$drv "
        comp=""
        [[ -r "$c/device/of_node/compatible" ]] && { IFS= read -r -d '' comp < "$c/device/of_node/compatible" || true; }
        out+="${out:+, }${drv}${comp:+ ($comp)}"
    done
    HW_GPU=$out
}

_HW_BOARD_DONE=0 HW_B_VENDOR="" HW_B_NAME="" HW_B_VERSION="" HW_BIOS_VENDOR="" HW_BIOS_VER="" HW_BIOS_DATE=""
hw_collect_board() {
    (( _HW_BOARD_DONE )) && return 0; _HW_BOARD_DONE=1
    local r f v
    local id=/sys/class/dmi/id
    for f in board_vendor:HW_B_VENDOR board_name:HW_B_NAME board_version:HW_B_VERSION \
             bios_vendor:HW_BIOS_VENDOR bios_version:HW_BIOS_VER bios_date:HW_BIOS_DATE; do
        r=""; wu_read "$id/${f%%:*}" r || r=""
        _hw_clean "$r" v; printf -v "${f#*:}" '%s' "$v"
    done
    # Laptops/NUCs often blank the baseboard but fill the system fields.
    if [[ -z "$HW_B_NAME" ]]; then
        r=""; wu_read "$id/product_name" r || r=""; _hw_clean "$r" HW_B_NAME
        if [[ -n "$HW_B_NAME" && -z "$HW_B_VENDOR" ]]; then
            r=""; wu_read "$id/sys_vendor" r || r=""; _hw_clean "$r" HW_B_VENDOR
        fi
    fi
    # No DMI at all (ARM/PPC/MIPS/RISC-V boards, Asahi): device-tree model.
    if [[ -z "$HW_B_VENDOR$HW_B_NAME" ]]; then
        r=$(wu_dt_model); _hw_clean "$r" HW_B_NAME
    fi
}

# RAM slots: parallel arrays, filled from dmidecode, else decode-dimms.
_HW_RAM_DONE=0
HW_R_LOC=() HW_R_MB=() HW_R_SIZE=() HW_R_TYPE=() HW_R_SPEED=() HW_R_MANUF=() HW_R_PN=() HW_R_FORM=() HW_R_SERIAL=() HW_R_CSPEED=()
HW_RAM_TOTAL_MB=0

_hw_ram_add() {  # loc mb type speed(running) manuf pn form serial [rated-speed]
    local sz; _hw_mb_txt "$2" sz
    HW_R_LOC+=("$1") HW_R_MB+=("$2") HW_R_SIZE+=("$sz") HW_R_TYPE+=("$3") HW_R_SPEED+=("$4")
    HW_R_MANUF+=("$5") HW_R_PN+=("$6") HW_R_FORM+=("$7") HW_R_SERIAL+=("$8") HW_R_CSPEED+=("${9:-}")
    HW_RAM_TOTAL_MB=$(( HW_RAM_TOTAL_MB + $2 ))
}

_hw_ram_dmi() {
    local line inb=0 v k
    local s_mb=0 s_type="" s_speed="" s_cspeed="" s_manuf="" s_pn="" s_form="" s_loc="" s_ser=""
    _hw_mflush() {
        if (( inb && s_mb > 0 )); then
            _hw_norm_manuf "$s_manuf" s_manuf
            [[ -z "$s_loc" ]] && s_loc="DIMM $(( ${#HW_R_LOC[@]} + 1 ))"
            _hw_ram_add "$s_loc" "$s_mb" "$s_type" "${s_cspeed:-$s_speed}" "$s_manuf" "$s_pn" "$s_form" "$s_ser" "$s_speed"
        fi
        inb=0 s_mb=0 s_type="" s_speed="" s_cspeed="" s_manuf="" s_pn="" s_form="" s_loc="" s_ser=""
    }
    while IFS= read -r line; do
        line=${line%$'\r'}
        case "$line" in
            "Memory Device") _hw_mflush; inb=1; continue ;;
            Handle\ *|"") [[ "$line" == Handle\ * ]] && _hw_mflush; continue ;;
        esac
        (( inb )) || continue
        # Anchor on the leading tab: "Volatile Size", "Non-Volatile Size",
        # "Cache Size", "Logical Size", "Type Detail", "Configured ..." differ.
        [[ "$line" == $'\t'*': '* || "$line" == $'\t'*':' ]] || continue
        k=${line#$'\t'}; k=${k%%:*}
        v=${line#*:}
        case "$k" in
            Size)            _hw_clean "$v" v; s_mb=0; [[ -n "$v" ]] && s_mb=$(wu_size_mb "$v") ;;
            Type)            _hw_clean "$v" s_type ;;
            Speed)           _hw_clean "$v" v; s_speed=$(wu_speed "$v") ;;
            "Configured Memory Speed"|"Configured Clock Speed") _hw_clean "$v" v; s_cspeed=$(wu_speed "$v") ;;
            Manufacturer)    s_manuf=$v ;;
            "Part Number")   _hw_clean "$v" s_pn ;;
            "Serial Number") _hw_clean "$v" s_ser ;;
            "Form Factor")   _hw_clean "$v" s_form ;;
            Locator)         _hw_clean "$v" s_loc ;;
        esac
    done <<< "$_WU_DMIDECODE"
    _hw_mflush
    unset -f _hw_mflush
}

_hw_ram_spd() {
    command -v decode-dimms >/dev/null 2>&1 || return 0
    local dout line v
    wu_root_init
    if (( _WU_ROOT )); then dout=$(wu_root_run decode-dimms 2>/dev/null) || dout=""
    else dout=$(decode-dimms 2>/dev/null) || dout=""; fi
    [[ "$dout" == *"Decoding EEPROM"* ]] || return 0
    local inb=0 _s=0 _m="" _p="" _f="" _t="" _sp="" n=0
    _dflush() {
        if (( inb && _s > 0 )); then
            n=$(( n + 1 ))
            _hw_norm_manuf "$_m" _m
            _hw_ram_add "DIMM $n" "$_s" "${_t:-DDR}" "$_sp" "$_m" "$_p" "${_f:-UDIMM}" ""
        fi
        inb=0 _s=0 _m="" _p="" _f="" _t="" _sp=""
    }
    while IFS= read -r line; do
        case "$line" in
            "Decoding EEPROM"*) _dflush; inb=1 ;;
            "Size "*)                     _hw_clean "${line#Size}" v; _s=$(wu_size_mb "$v") ;;
            "Module Manufacturer"*)       _m=${line#Module Manufacturer} ;;
            "Part Number"*)               _hw_clean "${line#Part Number}" _p ;;
            "Module Type"*)               _hw_clean "${line#Module Type}" _f ;;
            "Fundamental Memory type"*)   _hw_clean "${line#Fundamental Memory type}" _t; _t=${_t% SDRAM} ;;
            "Memory Type"*)               _hw_clean "${line#Memory Type}" _t; _t=${_t% SDRAM} ;;
            "Maximum module speed"*)      _sp=$(wu_speed "${line#Maximum module speed}") ;;
        esac
    done <<< "$dout"
    _dflush
    unset -f _dflush
}

hw_collect_ram() {
    (( _HW_RAM_DONE )) && return 0; _HW_RAM_DONE=1
    [[ -n "$_WU_DMIDECODE" ]] && _hw_ram_dmi
    (( ${#HW_R_LOC[@]} )) || _hw_ram_spd
    return 0
}

# _hw_udev_model SYSDIR VAR -- full model from the udev db (sysfs model is
# truncated to 16 chars for SCSI/SATA). Empty when udev is absent.
_hw_udev_model() {
    local __mm="" __l __m=""
    wu_read "$1/dev" __mm || { printf -v "$2" '%s' ""; return 1; }
    if [[ -r "/run/udev/data/b$__mm" ]]; then
        while IFS= read -r __l; do
            case "$__l" in E:ID_MODEL=*) __m=${__l#E:ID_MODEL=}; __m=${__m//_/ }; break ;; esac
        done < "/run/udev/data/b$__mm"
    fi
    printf -v "$2" '%s' "$__m"
    [[ -n "$__m" ]]
}

# Storage: one lsblk call in C locale with raw byte sizes, or /sys/block.
_HW_ST_DONE=0 HW_S_NAME=() HW_S_MODEL=() HW_S_SIZE=()
_hw_st_skip() { case "$1" in loop*|zram*|sr*|ram*|fd*|"") return 0 ;; esac; return 1; }
hw_collect_storage() {
    (( _HW_ST_DONE )) && return 0; _HW_ST_DONE=1
    local line name size model hs re='^NAME="([^"]*)" SIZE="([0-9]*)" MODEL="(.*)"$'
    if command -v lsblk >/dev/null 2>&1; then
        while IFS= read -r line; do
            [[ "$line" =~ $re ]] || continue
            name=${BASH_REMATCH[1]} size=${BASH_REMATCH[2]} model=${BASH_REMATCH[3]}
            _hw_st_skip "$name" && continue
            [[ -n "$size" && "$size" != 0 ]] || continue
            model=${model//\\x20/ }; model=${model//\\x22/\"}; model=${model//\\x5c/\\}
            wu_trim "$model" model
            _hw_human "$size" hs
            HW_S_NAME+=("$name") HW_S_MODEL+=("$model") HW_S_SIZE+=("$hs")
        done < <(LC_ALL=C lsblk -dnb -P -o NAME,SIZE,MODEL 2>/dev/null)
        (( ${#HW_S_NAME[@]} )) && return 0
    fi
    local d
    for d in /sys/block/*; do
        name=${d##*/}
        _hw_st_skip "$name" && continue
        [[ "$name" == mmcblk*boot* || "$name" == mmcblk*rpmb ]] && continue
        size=0; wu_read "$d/size" size || continue
        [[ "$size" =~ ^[0-9]+$ ]] && (( size > 0 )) || continue
        _hw_udev_model "$d" model || { wu_read "$d/device/model" model || wu_read "$d/device/name" model || model=""; }
        wu_trim "$model" model
        _hw_human $(( size * 512 )) hs
        HW_S_NAME+=("$name") HW_S_MODEL+=("$model") HW_S_SIZE+=("$hs")
    done
    return 0
}

HW_N_NAME=() HW_N_OP=() HW_N_MAC=() _HW_NET_DONE=0
hw_collect_net() {
    (( _HW_NET_DONE )) && return 0; _HW_NET_DONE=1
    local d n op mac
    for d in /sys/class/net/*; do
        [[ -e "$d" ]] || continue
        n=${d##*/}
        case "$n" in lo|virbr*|docker*|br-*|veth*) continue ;; esac
        op=down; wu_read "$d/operstate" op || op=down
        mac=""; wu_read "$d/address" mac || mac=""
        HW_N_NAME+=("$n") HW_N_OP+=("$op") HW_N_MAC+=("$mac")
    done
}

HW_F_CHIP=() HW_F_LABEL=() HW_F_RPM=() _HW_FAN_DONE=0
hw_collect_fans() {
    (( _HW_FAN_DONE )) && return 0; _HW_FAN_DONE=1
    local f rpm dir chip idx label
    for f in /sys/devices/platform/*/fan*_input /sys/class/hwmon/hwmon*/fan*_input; do
        [[ -r "$f" ]] || continue
        rpm=0; wu_read "$f" rpm || continue
        [[ "$rpm" =~ ^[0-9]+$ ]] && (( rpm > 0 )) || continue
        dir=${f%/*}; chip=${dir##*/}
        idx=${f##*/fan}; idx=${idx%_input}
        [[ "$idx" =~ ^[0-9]+$ ]] || continue
        label=""; wu_read "$dir/fan${idx}_label" label || label="$(t hw_cooling) ${idx}"
        HW_F_CHIP+=("$chip") HW_F_LABEL+=("$label") HW_F_RPM+=("$rpm")
    done
}

HW_BAT=() _HW_BAT_DONE=0
hw_collect_bat() {
    (( _HW_BAT_DONE )) && return 0; _HW_BAT_DONE=1
    local b
    while IFS= read -r b; do
        [[ -n "$b" ]] && HW_BAT+=("$b")
    done < <(wu_batteries)
    return 0
}

# Cache dmidecode once (memory section). Must run before snapshot/diff too.
_WU_DMIDECODE="" _HW_DMI_DONE=0
hw_dmi_init() {
    (( _HW_DMI_DONE )) && return 0; _HW_DMI_DONE=1
    if [[ -n "${WELLHW_DMI_FILE:-}" ]]; then        # test hook: canned dmidecode output
        _WU_DMIDECODE=$(<"$WELLHW_DMI_FILE") || _WU_DMIDECODE=""
        return 0
    fi
    command -v dmidecode >/dev/null 2>&1 || return 0
    wu_root_init
    if (( _WU_ROOT )); then
        _WU_DMIDECODE=$(wu_root_run dmidecode -t memory 2>/dev/null) || _WU_DMIDECODE=""
    elif [[ -r /sys/firmware/dmi/tables/DMI ]]; then
        _WU_DMIDECODE=$(dmidecode -t memory 2>/dev/null) || _WU_DMIDECODE=""
    fi
    return 0
}

# ─── Sections ───────────────────────────────────────────────────
print_cpu() {
    hw_collect_cpu
    pline_hw "$(_emu '🧠')" "$(t hw_cpu)" "${HW_CPU_MODEL:-$(t hw_unknown)}  ${DIM}($(t hw_cores): ${HW_CPU_CORES}, $(t hw_threads): ${HW_CPU_THREADS})${RESET}"
}

print_gpu() {
    hw_collect_gpu
    if [[ -n "$HW_GPU" ]]; then
        pline_hw "$(_emu '🎮')" "$(t hw_gpu)" "${HW_GPU}${HW_GPU_VENDOR:+  ${DIM}(${HW_GPU_VENDOR})${RESET}}"
    else
        pline_hw "$(_emu '🎮')" "$(t hw_gpu)" "${DIM}$(t hw_unknown)${RESET}"
    fi
}

print_board() {
    hw_collect_board
    local board="${HW_B_VENDOR}${HW_B_VENDOR:+${HW_B_NAME:+ }}${HW_B_NAME}"
    [[ -n "$board" && -n "$HW_B_VERSION" ]] && board+=" (v${HW_B_VERSION#[vV]})"
    local bios="${HW_BIOS_VENDOR}${HW_BIOS_VENDOR:+${HW_BIOS_VER:+ }}${HW_BIOS_VER}"
    [[ -n "$HW_BIOS_DATE" ]] && bios+="${bios:+ }(${HW_BIOS_DATE})"
    pline_hw "$(_emu '🖥')" "$(t hw_board)" "${board:-${DIM}$(t hw_unknown)${RESET}}"
    [[ -n "$bios" ]] && pline_hw "$(_emu '💾')" "$(t hw_bios)" "$bios"
    return 0
}

print_ram() {
    hw_collect_ram
    local modules=${#HW_R_LOC[@]} i
    if (( modules == 0 )); then
        pline_hw "$(_emu '🧩')" "$(t hw_ram)" "${DIM}$(t hw_ram_none)${RESET}"
        return 0
    fi
    local first_t="${HW_R_TYPE[0]}" first_s="${HW_R_SPEED[0]}" first_sz="${HW_R_SIZE[0]}" first_form="${HW_R_FORM[0]}"
    local same_speed=1 same_type=1 uniform=1
    for (( i=1; i<modules; i++ )); do
        [[ "${HW_R_TYPE[i]}" == "$first_t" ]] || same_type=0
        [[ "${HW_R_SPEED[i]}" == "$first_s" ]] || same_speed=0
        [[ "${HW_R_SIZE[i]}" == "$first_sz" && "${HW_R_FORM[i]}" == "$first_form" ]] || uniform=0
    done
    (( same_type && same_speed )) || uniform=0

    local total_txt
    _hw_mb_txt "$HW_RAM_TOTAL_MB" total_txt; total_txt="$(t hw_ram_total): $total_txt"

    # Channels from the Locator (ChannelA-DIMM0, DIMM_A1, "CHANNEL B", ...).
    local chans=" " ch loc
    for (( i=0; i<modules; i++ )); do
        loc=${HW_R_LOC[i]^^}
        ch=""
        if [[ "$loc" =~ CHANNEL[[:space:]_-]*([A-Z]) ]]; then ch=${BASH_REMATCH[1]}
        elif [[ "$loc" =~ DIMM_([A-Z]) ]]; then ch=${BASH_REMATCH[1]}; fi
        [[ -n "$ch" && "$chans" != *" $ch "* ]] && chans+="$ch "
    done
    local nch=0 _c
    for _c in $chans; do nch=$(( nch + 1 )); done
    local single_channel=0
    (( modules > 1 && nch == 1 )) && single_channel=1

    local ram_line
    if (( uniform )); then
        ram_line="${modules}× ${first_sz}${first_t:+ $first_t}${first_s:+-$first_s}"
        [[ -n "$first_form" && "$first_form" != "DIMM" ]] && ram_line+=" ${first_form}"
        ram_line+=" · ${DIM}${total_txt}${RESET}"
        (( single_channel )) && ram_line+=" ${Y}⚠ $(t hw_ram_single_ch)${RESET}"
        pline_hw "$(_emu '🧩')" "$(t hw_ram)" "$ram_line"
        local sub="${HW_R_MANUF[0]}"
        [[ -n "${HW_R_PN[0]}" ]] && sub+="${sub:+ | }$(t hw_pn): ${HW_R_PN[0]}"
        [[ -n "$sub" ]] && pline_sub "$sub"
        return 0
    fi

    pline_hw "$(_emu '🧩')" "$(t hw_ram)" "${modules} $(_hw_plural "$modules") · ${DIM}${total_txt}${RESET}"
    local warn=""
    if (( ! same_speed )); then
        local slowest="" _min=-1 sv
        for (( i=0; i<modules; i++ )); do
            sv=${HW_R_SPEED[i]}
            [[ "$sv" =~ ^[0-9]+$ ]] || continue
            if (( _min < 0 || sv < _min )); then _min=$sv; slowest=$sv; fi
        done
        [[ -n "$slowest" ]] && warn+="${Y}⚠ $(t hw_ram_downclock) ${slowest} MT/s${RESET}"
    fi
    if (( ! same_type )); then
        local types="" ty
        for (( i=0; i<modules; i++ )); do
            ty=${HW_R_TYPE[i]:-?}
            [[ " / $types / " == *" / $ty / "* ]] || types+="${types:+ / }$ty"
        done
        warn+="${warn:+ · }${Y}⚠ $(t hw_ram_mixed): ${types}${RESET}"
    fi
    (( single_channel )) && warn+="${warn:+ · }${Y}⚠ $(t hw_ram_single_ch)${RESET}"
    [[ -n "$warn" ]] && pline_sub "$warn"
    local detail extra
    for (( i=0; i<modules; i++ )); do
        detail="${HW_R_LOC[i]}: ${HW_R_SIZE[i]}${HW_R_TYPE[i]:+ ${HW_R_TYPE[i]}}${HW_R_SPEED[i]:+-${HW_R_SPEED[i]}}"
        [[ -n "${HW_R_FORM[i]}" && "${HW_R_FORM[i]}" != "DIMM" ]] && detail+=" ${HW_R_FORM[i]}"
        extra="${HW_R_MANUF[i]}"
        [[ -n "${HW_R_PN[i]}" ]] && extra+="${extra:+ }${HW_R_PN[i]}"
        [[ -n "$extra" ]] && detail+=" ${DIM}(${extra})${RESET}"
        pline_sub "$detail"
    done
}

print_storage() {
    hw_collect_storage
    local i n=${#HW_S_NAME[@]} row
    if (( n == 0 )); then
        pline_hw "$(_emu '💿')" "$(t hw_storage)" "${DIM}$(t hw_unknown)${RESET}"
        return 0
    fi
    for (( i=0; i<n; i++ )); do
        row="${HW_S_NAME[i]}: ${HW_S_MODEL[i]:-$(t hw_unknown)} ${DIM}(${HW_S_SIZE[i]})${RESET}"
        if (( i == 0 )); then pline_hw "$(_emu '💿')" "$(t hw_storage)" "$row"
        else pline_sub "$row"; fi
    done
}

print_network() {
    hw_collect_net
    local i n=${#HW_N_NAME[@]} row
    if (( n == 0 )); then
        pline_hw "$(_emu '🌐')" "$(t hw_network)" "${DIM}$(t hw_unknown)${RESET}"
        return 0
    fi
    for (( i=0; i<n; i++ )); do
        row="${HW_N_NAME[i]} ${HW_N_OP[i]} ${HW_N_MAC[i]}"
        if (( i == 0 )); then pline_hw "$(_emu '🌐')" "$(t hw_network)" "$row"
        else pline_sub "$row"; fi
    done
}

print_battery() {
    hw_collect_bat
    local b cap stat
    for b in ${HW_BAT[@]+"${HW_BAT[@]}"}; do
        cap=""; wu_read "$b/capacity" cap || continue
        stat=""; wu_read "$b/status" stat || stat=""
        pline_hw "$(_emu '🔋')" "$(t hw_battery)" "${W}${cap}%${RESET}${stat:+ ${DIM}(${stat})${RESET}}"
    done
    return 0
}

print_cooling() {
    hw_collect_fans
    local i n=${#HW_F_RPM[@]} row
    if (( n == 0 )); then
        pline_hw "$(_emu '🌀')" "$(t hw_cooling)" "${DIM}$(t hw_unknown)${RESET}"
        return 0
    fi
    for (( i=0; i<n; i++ )); do
        row="${HW_F_LABEL[i]} ${W}${HW_F_RPM[i]}${RESET} ${DIM}RPM (${HW_F_CHIP[i]})${RESET}"
        if (( i == 0 )); then pline_hw "$(_emu '🌀')" "$(t hw_cooling)" "$row"
        else pline_sub "$row"; fi
    done
}

# ─── PCI Expansion Cards ───────────────────────────────────────
print_pci() {
    pci_slot_devices
    if (( ${#_PCI_BUS[@]} == 0 )); then
        pline "${DIM}$(t hw_pci_none)${RESET}"
        return 0
    fi
    local i
    for (( i=0; i<${#_PCI_BUS[@]}; i++ )); do
        pline_hw "$(_emu '🔌')" "${_PCI_BUS[$i]}" "${_PCI_DESC[$i]}"
    done
}

# ─── JSON output ────────────────────────────────────────────────
json_out() {
    hw_dmi_init
    hw_collect_cpu; hw_collect_gpu; hw_collect_board; hw_collect_ram
    hw_collect_storage; hw_collect_net; hw_collect_fans; hw_collect_bat
    local i first modules=${#HW_R_LOC[@]}

    wu_json_head "$_WU_TOOLNAME" "$_WU_VERSION"
    printf ',\n  "cpu": { "model": "%s", "cores": "%s", "threads": "%s" },\n' \
        "$(json_esc "$HW_CPU_MODEL")" "$HW_CPU_CORES" "$HW_CPU_THREADS"
    printf '  "gpu": { "name": "%s"' "$(json_esc "$HW_GPU")"
    [[ -n "$HW_GPU_VENDOR" ]] && printf ', "vendor": "%s"' "$(json_esc "$HW_GPU_VENDOR")"
    printf ' },\n'
    printf '  "board": {\n'
    printf '    "vendor": "%s",\n' "$(json_esc "$HW_B_VENDOR")"
    printf '    "name": "%s",\n' "$(json_esc "$HW_B_NAME")"
    printf '    "version": "%s",\n' "$(json_esc "$HW_B_VERSION")"
    printf '    "bios": { "vendor": "%s", "version": "%s", "date": "%s" }\n' \
        "$(json_esc "$HW_BIOS_VENDOR")" "$(json_esc "$HW_BIOS_VER")" "$(json_esc "$HW_BIOS_DATE")"
    printf '  },\n'
    printf '  "memory": {\n'
    printf '    "modules": %d,\n' "$modules"
    printf '    "size_mb": %d,\n' "$HW_RAM_TOTAL_MB"
    printf '    "slots": ['
    first=1
    for (( i=0; i<modules; i++ )); do
        (( first )) && { first=0; printf '\n'; } || printf ',\n'
        printf '      { "locator": "%s", "size": "%s", "size_mb": %d, "type": "%s", "speed_mts": "%s", "manufacturer": "%s", "part_number": "%s", "form_factor": "%s", "serial": "%s", "rated_speed_mts": "%s" }' \
            "$(json_esc "${HW_R_LOC[i]}")" "$(json_esc "${HW_R_SIZE[i]}")" "${HW_R_MB[i]}" "$(json_esc "${HW_R_TYPE[i]}")" \
            "$(json_esc "${HW_R_SPEED[i]}")" "$(json_esc "${HW_R_MANUF[i]}")" "$(json_esc "${HW_R_PN[i]}")" \
            "$(json_esc "${HW_R_FORM[i]}")" "$(json_esc "${HW_R_SERIAL[i]}")" "$(json_esc "${HW_R_CSPEED[i]}")"
    done
    (( first )) || printf '\n    '
    printf ']\n  },\n'

    printf '  "storage": ['
    first=1
    for (( i=0; i<${#HW_S_NAME[@]}; i++ )); do
        (( first )) && { first=0; printf '\n'; } || printf ',\n'
        printf '    { "name": "%s", "model": "%s", "size": "%s" }' \
            "$(json_esc "${HW_S_NAME[i]}")" "$(json_esc "${HW_S_MODEL[i]}")" "$(json_esc "${HW_S_SIZE[i]}")"
    done
    (( first )) || printf '\n  '
    printf '],\n'

    printf '  "network": ['
    first=1
    for (( i=0; i<${#HW_N_NAME[@]}; i++ )); do
        (( first )) && { first=0; printf '\n'; } || printf ',\n'
        printf '    { "name": "%s", "operstate": "%s", "mac": "%s" }' \
            "$(json_esc "${HW_N_NAME[i]}")" "$(json_esc "${HW_N_OP[i]}")" "$(json_esc "${HW_N_MAC[i]}")"
    done
    (( first )) || printf '\n  '
    printf '],\n'

    local cap="" stat="" b
    for b in ${HW_BAT[@]+"${HW_BAT[@]}"}; do
        wu_read "$b/capacity" cap || continue
        wu_read "$b/status" stat || stat=""
        break
    done
    printf '  "battery": { "capacity": "%s", "status": "%s" },\n' "$(json_esc "$cap")" "$(json_esc "$stat")"

    printf '  "cooling": ['
    first=1
    for (( i=0; i<${#HW_F_RPM[@]}; i++ )); do
        (( first )) && { first=0; printf '\n'; } || printf ',\n'
        printf '    { "chip": "%s", "label": "%s", "rpm": %d }' \
            "$(json_esc "${HW_F_CHIP[i]}")" "$(json_esc "${HW_F_LABEL[i]}")" "${HW_F_RPM[i]}"
    done
    (( first )) || printf '\n  '
    printf '],\n'

    printf '  "pci_expansion": ['
    first=1
    pci_slot_devices
    for (( i=0; i<${#_PCI_BUS[@]}; i++ )); do
        (( first )) && { first=0; printf '\n'; } || printf ',\n'
        printf '    { "bus": "%s", "class": "%s", "description": "%s" }' \
            "$(json_esc "${_PCI_BUS[$i]}")" "$(json_esc "${_PCI_CLASS[$i]}")" "$(json_esc "${_PCI_DESC[$i]}")"
    done
    (( first )) || printf '\n  '
    printf '],\n'

    printf '  "summary": { "cpu": "%s", "gpu": "%s", "ram_modules": %d, "ram_size_mb": %d, "storage_devices": %d, "network_interfaces": %d }' \
        "$(json_esc "$HW_CPU_MODEL")" "$(json_esc "$HW_GPU")" "$modules" "$HW_RAM_TOTAL_MB" "${#HW_S_NAME[@]}" "${#HW_N_NAME[@]}"
    wu_json_end
}

# ─── Main ────────────────────────────────────────────────────────
main() {
    # dmidecode first: snapshot/diff build their JSON from the same data.
    hw_dmi_init
    if (( _HW_SNAPSHOT )); then do_snapshot; return $?; fi
    if (( _HW_DIFF )); then do_diff; return $?; fi
    if [[ "$_WU_JSON" == "1" ]]; then json_out; return 0; fi

    box_header "$(_emu '🖥')" "wellhw" "$(t hw_title)"

    box "$(_emu '🧠')" "$(t hw_cpu)" print_cpu
    box "$(_emu '🎮')" "$(t hw_gpu)" print_gpu
    box "$(_emu '🖥')" "$(t hw_board)" print_board
    box "$(_emu '🧩')" "$(t hw_ram)" print_ram
    box "$(_emu '💿')" "$(t hw_storage)" print_storage
    box "$(_emu '🌐')" "$(t hw_network)" print_network
    box "$(_emu '🌀')" "$(t hw_cooling)" print_cooling
    box "$(_emu '🔌')" "$(t hw_pci)" print_pci

    hw_collect_bat
    (( ${#HW_BAT[@]} )) && box "$(_emu '🔋')" "$(t hw_battery)" print_battery

    printf '\n  %sWellHW v%s | %s%s\n\n' "$DIM" "$_WU_VERSION" "$(date '+%Y-%m-%d %H:%M:%S')" "$RESET"
}

wu_run main "$@"
