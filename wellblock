#!/usr/bin/env bash
# wellblock -- Beautiful block device listing
# Part of wellutils by wellbou_
set -euo pipefail

# ─── Shared libs ────────────────────────────────────────────────
_WU_TOOLNAME="wellblock" _WU_NAME="WellBlock" _WU_VERSION="1.1" _WU_MANUAL=1
_WU_TAGLINE="Block device listing (use 'wellblock [N|device]' for disk detail + S.M.A.R.T.)"
_WU_BOOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "$_WU_BOOT_DIR/bootstrap.sh" lang box cli
_WU_EXTRA_HELP="  [N|device]            disk detail: index or name (sda, nvme0n1, /dev/sda)"
_WU_EXTRA_PARSE="_wblock_arg"


# ─── CLI arg: optional disk index or name ────────────────────────
_WU_DISK_ARG=""
_wblock_arg() {
    case "$1" in
        /dev/*) _WU_DISK_ARG="${1#/dev/}"; _WU_EXTRA_CONSUMED=1; return 0 ;;
        sd*|hd*|vd*|nvme*|mmcblk*|sr*) _WU_DISK_ARG="$1"; _WU_EXTRA_CONSUMED=1; return 0 ;;
        *[!0-9]*|"") return 1 ;;
        *) _WU_DISK_ARG="$1"; _WU_EXTRA_CONSUMED=1; return 0 ;;
    esac
}

# ─── Helpers ─────────────────────────────────────────────────────
fmt_size() {
    local bytes=$1
    if (( bytes >= 1073741824 )); then
        printf '%s GB' "$(awk "BEGIN {printf \"%.1f\", $bytes/1073741824}")"
    elif (( bytes >= 1048576 )); then
        printf '%s MB' "$(awk "BEGIN {printf \"%.1f\", $bytes/1048576}")"
    elif (( bytes >= 1024 )); then
        printf '%s KB' "$(awk "BEGIN {printf \"%.1f\", $bytes/1024}")"
    else
        printf '%d B' "$bytes"
    fi
}

# Ordered list of physical disk sysfs paths (summary + index resolution).
wblock_disks() {
    local glob dev
    for glob in /sys/block/sd? /sys/block/sd?? /sys/block/hd? /sys/block/vd? /sys/block/nvme* /sys/block/mmcblk*; do
        for dev in $glob; do
            [[ -d "$dev" ]] || continue
            local bn
            bn=$(basename "$dev")
            [[ "$bn" == loop* || "$bn" == ram* || "$bn" == sr* ]] && continue
            [[ "$bn" == mmcblk*boot* ]] && continue
            printf '%s\n' "$dev"
        done
    done
}

disk_model() {
    local dev="$1" model="" name_file="$dev/device/name"
    local model_file="$dev/device/model"
    if [[ -e "$model_file" ]]; then
        model=$(cat "$model_file" 2>/dev/null | xargs) || model=""
    fi
    if [[ -z "$model" && -e "$name_file" ]]; then
        model=$(cat "$name_file" 2>/dev/null | xargs) || model=""
    fi
    # USB-SATA adapters often split SCSI INQUIRY across vendor/model
    # fields, producing a truncated sysfs model (e.g. "8CS" for
    # "ST9320328CS"). Fall back to smartctl when the name is too short.
    if [[ ${#model} -lt 5 && -b "/dev/$(basename "$dev")" ]] && command -v smartctl &>/dev/null; then
        local full
        full=$(root_run smartctl -i "/dev/$(basename "$dev")" 2>/dev/null \
               | awk -F': ' '/^Device Model:/{print $2; exit}') || true
        full=$(printf '%s' "$full" | xargs)
        [[ ${#full} -gt ${#model} ]] && model="$full"
    fi
    printf '%s' "${model:-$(t hw_unknown)}"
}

# ─── Detail: S.M.A.R.T. via smartctl ─────────────────────────────
root_run() {
    if (( EUID == 0 )); then "$@"
    elif sudo -n true 2>/dev/null; then sudo -n "$@"
    else "$@"; fi
}

wblock_smart() {
    local devnode="/dev/$(basename "$_WU_DETAIL_DEV")"
    if ! command -v smartctl &>/dev/null; then
        pline "${DIM}$(t blk_smart_na)${RESET}"
        return
    fi

    local out
    # smartctl exits non-zero on error bits but still prints the report.
    out=$(root_run smartctl -a "$devnode" 2>/dev/null) || true

    # Seagate drives encode attrs 1 & 7 as composite raw values:
    #   high 32 bits = error count, low 32 bits = total operations.
    local _SM_SEAGATE=0
    grep -qi 'Vendor:\|Seagate\|^Device Model:.*ST[0-9]' <<< "$out" && _SM_SEAGATE=1

    # S.M.A.R.T. unavailable for the device (e.g. USB card readers)
    if ! grep -q 'SMART overall-health' <<< "$out" && ! grep -q 'SMART Health Information' <<< "$out"; then
        pline "${DIM}$(t blk_smart_no)${RESET}"
        return
    fi

    local risk=0 overall
    overall=$(awk '/SMART overall-health self-assessment test result:/{print $6; exit}' <<< "$out")
    [[ "$overall" == "FAILED" ]] && risk=2

    local attrs=""
    attrs=$(awk '
        /^Vendor Specific SMART Attributes/ { inattrs=1; next }
        inattrs && /^[[:space:]]*[0-9]+[[:space:]]+[A-Za-z_]/ {
            id=$1; name=$2; val=$4; worst=$5; thr=$6
            raw=$10; for (i=11; i<=NF; i++) raw=raw " " $i
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", raw)
            printf "%s|%s|%s|%s|%s|%s\n", id, name, val, worst, thr, raw
        }
        inattrs && /^SMART Error Log/ { exit }
    ' <<< "$out")

    if [[ -z "$attrs" ]]; then
        # NVMe: report the key health fields instead of an attribute table
        local temp="" used="" spare="" verdict padl e label value
        temp=$(awk '/^Temperature:[[:space:]]+[0-9]+/ {print $2; exit}' <<< "$out")
        used=$(awk '/^Percentage Used:/ {print $3; exit}' <<< "$out")
        spare=$(awk '/^Available Spare:/ {print $3; exit}' <<< "$out")
        if (( risk )); then verdict="${R}$(t blk_smart_fail)${RESET}"
        else verdict="${G}$(t blk_smart_pass)${RESET}"; fi

        local -a rows=()
        label="$(t blk_smart_health)"; maxl=${#label}
        rows+=("$label|$verdict")
        [[ -n "$temp" ]] && { label="$(t blk_attr_temp)"; rows+=("$label|${W}${temp}°C${RESET}"); (( ${#label} > maxl )) && maxl=${#label}; }
        [[ -n "$used" ]] && { label="$(t blk_nvme_used)"; rows+=("$label|${W}${used}%${RESET}"); (( ${#label} > maxl )) && maxl=${#label}; }
        [[ -n "$spare" ]] && { label="$(t blk_nvme_spare)"; rows+=("$label|${W}${spare}%${RESET}"); (( ${#label} > maxl )) && maxl=${#label}; }
        padl=$(( maxl + 1 ))
        for e in "${rows[@]}"; do
            label="${e%%|*}"; value="${e#*|}"
            _LINES+=( "  $(_emu '📊') ${BOLD}${W}$(_wu_pad_r "${label}:" "$padl")${RESET} $value" )
        done
        return
    fi

    # First pass: any risky attribute with a nonzero value raises attention.
    local id name val worst thr raw
    while IFS='|' read -r id name val worst thr raw; do
        case "$id" in
            5|187|197|198|200|201)
                [[ "$raw" =~ ^[0-9] ]] && (( ${raw%% *} + 0 > 0 )) && (( risk < 1 )) && risk=1 ;;
        esac
    done <<< "$attrs"

    local verdict
    if   (( risk == 2 )); then verdict="${R}$(t blk_smart_fail)${RESET}"
    elif (( risk == 1 )); then verdict="${Y}$(t blk_health_warn)${RESET}"
    else verdict="${G}$(t blk_smart_pass)${RESET}"; fi

    # Readable readout: health verdict + curated attributes, values aligned
    # to the longest label. Risky attributes are always shown (with the raw
    # name if not curated); obscure attributes are dropped.
    local -a rows=() _shown_labels=()
    local label="" value="" shown=0 maxl
    label="$(t blk_smart_health)"
    maxl=${#label}
    rows+=("$label|$verdict")
    while IFS='|' read -r id name val worst thr raw; do
        label=$(sm_attr_label "$id")
        if [[ -z "$label" ]]; then
            case "$id" in 5|187|197|198|200|201) label="$name" ;; *) continue ;; esac
        fi
        # Deduplicate: skip if this label was already emitted (e.g. attrs 190 & 194 both → "Temperature").
        local _dup=0 _sl
        for _sl in "${_shown_labels[@]}"; do [[ "$_sl" == "$label" ]] && { _dup=1; break; }; done
        (( _dup )) && continue
        _shown_labels+=("$label")
        raw="${raw%% *}"
        value=$(sm_attr_value "$id" "$raw")
        case "$id" in
            5|187|197|198|200|201)
                if [[ "$raw" =~ ^[0-9] ]] && (( raw + 0 > 0 )); then
                    value="${Y}${value}${RESET}  ${Y}$(t blk_smart_risk)${RESET}"
                else
                    value="${G}${value}${RESET}"
                fi ;;
            *)  value="${W}${value}${RESET}" ;;
        esac
        rows+=("$label|$value")
        (( ${#label} > maxl )) && maxl=${#label}
        shown=1
    done <<< "$attrs"

    if (( shown )); then
        local padl e
        padl=$(( maxl + 1 ))
        for e in "${rows[@]}"; do
            label="${e%%|*}"; value="${e#*|}"
            _LINES+=( "  $(_emu '📊') ${BOLD}${W}$(_wu_pad_r "${label}:" "$padl")${RESET} $value" )
        done
    else
        pline "${DIM}$(t blk_smart_no)${RESET}"
    fi
}

# Translated label for a known S.M.A.R.T. attribute id; empty = not surfaced.
sm_attr_label() {
    case "$1" in
        1)   printf '%s' "$(t blk_attr_reread)" ;;
        7)   printf '%s' "$(t blk_attr_seekerr)" ;;
        5)   printf '%s' "$(t blk_attr_realloc)" ;;
        9)   printf '%s' "$(t blk_attr_poh)" ;;
        12)  printf '%s' "$(t blk_attr_pcc)" ;;
        163) printf '%s' "$(t blk_attr_maxerase)" ;;
        164) printf '%s' "$(t blk_attr_avgerase)" ;;
        184) printf '%s' "$(t blk_attr_endtoend)" ;;
        187) printf '%s' "$(t blk_attr_uncorr)" ;;
        188) printf '%s' "$(t blk_attr_timeout)" ;;
        190) printf '%s' "$(t blk_attr_temp)" ;;
        194) printf '%s' "$(t blk_attr_temp)" ;;
        197) printf '%s' "$(t blk_attr_pending)" ;;
        198) printf '%s' "$(t blk_attr_offline)" ;;
        199) printf '%s' "$(t blk_attr_crc)" ;;
        200) printf '%s' "$(t blk_attr_multi)" ;;
        231) printf '%s' "$(t blk_attr_life)" ;;
        241) printf '%s' "$(t blk_attr_written)" ;;
        242) printf '%s' "$(t blk_attr_read)" ;;
    esac
}

# Human-formatted raw value for a known attribute id.
sm_attr_value() {
    local id="$1" raw="$2"
    [[ "$raw" =~ ^[0-9]+$ ]] || { printf '%s' "$raw"; return; }
    case "$id" in
        9)   printf '%s h' "$((10#$raw))" ;;
        190|194) printf '%s°C' "$((10#$raw))" ;;
        241|242) fmt_size $(( 10#$raw * 512 )) ;;
        1|7) if [[ "${_SM_SEAGATE:-0}" == "1" ]]; then
                 local _hi _lo
                 _hi=$(( (10#$raw) >> 32 ))
                 _lo=$(( (10#$raw) & 0xFFFFFFFF ))
                 printf '%s / %s ops' "$_hi" "$_lo"
             else
                 printf '%s' "$((10#$raw))"
             fi ;;
        188) if [[ "${_SM_SEAGATE:-0}" == "1" ]]; then
                  local _hi _lo
                  _hi=$(( (10#$raw) >> 32 ))
                  _lo=$(( (10#$raw) & 0xFFFFFFFF ))
                  printf '%s / %s cmds' "$_hi" "$_lo"
              else
                  printf '%s' "$((10#$raw))"
              fi ;;
        *)   printf '%s' "$((10#$raw))" ;;
    esac
}

# ─── Detail view ─────────────────────────────────────────────────
wblock_detail() {
    local dev="$1" devnode="/dev/$(basename "$dev")"
    local bn
    bn=$(basename "$dev")
    _WU_DETAIL_DEV="$dev"

    box_header "$(_emu '💾')" "wellblock" "$devnode"

    box "$(_emu '📊')" "$(t blk_detail)" detail_info
    box "$(_emu '🗂️')" "$(t blk_parts)" detail_parts
    box "$(_emu '🛡️')" "$(t blk_smart)" wblock_smart

    printf '\n  %sWellBlock v1.1 | %s%s\n\n' "$DIM" "$(date '+%Y-%m-%d %H:%M:%S')" "$RESET"
}

detail_info() {
    local dev=$_WU_DETAIL_DEV bn
    bn=$(basename "$dev")
    local size_bytes=$(cat "$dev/size" 2>/dev/null || echo "0")
    size_bytes=$(( size_bytes * 512 ))
    size_human=$(fmt_size "$size_bytes")

    local rotational=$(cat "$dev/queue/rotational" 2>/dev/null || echo "1")
    local removable=$(cat "$dev/removable" 2>/dev/null || echo "0")
    if [[ "$removable" == "1" ]]; then
        type_label="$(t blk_removable)"; type_color="$M"
    elif [[ "$rotational" == "0" ]]; then
        type_label="$(t blk_ssd)"; type_color="$G"
    else
        type_label="$(t blk_hdd)"; type_color="$Y"
    fi

    serial=""
    [[ -e "$dev/device/serial" ]] && serial=$(cat "$dev/device/serial" 2>/dev/null | xargs) || true
    # USB-SATA adapters often omit the sysfs serial; fall back to smartctl.
    if [[ -z "$serial" ]] && command -v smartctl &>/dev/null; then
        serial=$(root_run smartctl -i "/dev/$bn" 2>/dev/null \
                 | awk -F': ' '/^Serial Number:/{print $2; exit}') || true
        serial=$(printf '%s' "$serial" | xargs)
    fi
    fwrev=""
    [[ -e "$dev/device/fwrev" ]] && fwrev=$(cat "$dev/device/fwrev" 2>/dev/null | xargs) || true
    [[ -e "$dev/device/firmware_rev" ]] && fwrev=$(cat "$dev/device/firmware_rev" 2>/dev/null | xargs) || true
    transport=""
    if command -v lsblk &>/dev/null; then
        transport=$(lsblk -dn -o TRAN "/dev/$bn" 2>/dev/null) || true
    fi

    pline_hw "$(_emu '💾')" "$(t blk_model)" "$(disk_model "$dev")"
    pline_hw "$(_emu '🔢')" "$(t blk_serial)" "${serial:-$(t blk_smart_unknown)}"
    [[ -n "$fwrev" ]] && pline_hw "$(_emu '📝')" "$(t blk_firmware)" "$fwrev"
    pline_hw "$(_emu '📏')" "$(t blk_size)" "$size_human"
    pline_hw "$(_emu '🏷️')" "$(t blk_type)" "$type_color$type_label$RESET"
    [[ -n "$transport" ]] && pline_hw "$(_emu '🔌')" "$(t blk_transport)" "${transport%% *}"
}

detail_parts() {
    local dev=$_WU_DETAIL_DEV bn
    bn=$(basename "$dev")
    local found=0 part
    for part in "$dev"/${bn}*; do
        [[ -d "$part" ]] || continue
        local pname
        pname=$(basename "$part")
        [[ "$pname" == "$bn" ]] && continue

        local psize_bytes=$(cat "$part/size" 2>/dev/null || echo "0")
        psize_bytes=$(( psize_bytes * 512 ))
        local psize_human
        psize_human=$(fmt_size "$psize_bytes")

        local fstype="" mountpoint=""
        if command -v lsblk &>/dev/null; then
            local lsblk_out
            lsblk_out=$(lsblk -n -o FSTYPE,MOUNTPOINT "/dev/$pname" 2>/dev/null) || true
            fstype=$(echo "$lsblk_out" | awk '{print $1}')
            mountpoint=$(echo "$lsblk_out" | awk '{print $2}')
        fi

        local mp_icon=""
        [[ -n "$mountpoint" ]] && mp_icon="$(_emu '📁')"
        [[ "$fstype" == "swap" || "$mountpoint" == "[SWAP]" ]] && mp_icon="$(_emu '🔄')"

        local line="  ├─ ${BOLD}${W}${pname}${RESET}  ${DIM}${psize_human}${RESET}"
        [[ -n "$fstype" ]] && line="$line  $fstype"
        [[ -n "$mountpoint" ]] && line="$line  ${mp_icon}-> ${G}${mountpoint}${RESET}"
        _LINES+=( "$line" )
        found=1
    done
    (( found )) || _LINES+=( "  ${DIM}$(t blk_smart_unknown)${RESET}" )
}

# ─── JSON output ────────────────────────────────────────────────
json_out() {
    local target_dev="" dev
    if [[ -n "$_WU_DISK_ARG" ]]; then
        if [[ "$_WU_DISK_ARG" =~ ^[0-9]+$ ]]; then
            local n=0
            while IFS= read -r dev; do
                if (( n == _WU_DISK_ARG )); then target_dev="$dev"; break; fi
                n=$(( n + 1 ))
            done < <(wblock_disks)
        else
            for dev in $(wblock_disks); do
                if [[ "$(basename "$dev")" == "$_WU_DISK_ARG" ]]; then target_dev="$dev"; break; fi
            done
        fi
        if [[ -z "$target_dev" ]]; then
            printf '%s: disk %s not found\n' "$_WU_TOOLNAME" "$_WU_DISK_ARG" >&2
            exit 3
        fi
    fi

    wu_json_head "$_WU_TOOLNAME" "$_WU_VERSION"

    if [[ -n "$target_dev" ]]; then
        local bn size_bytes model serial rotational removable dtype
        bn=$(basename "$target_dev")
        size_bytes=$(cat "$target_dev/size" 2>/dev/null || echo "0")
        size_bytes=$(( size_bytes * 512 ))
        model=$(disk_model "$target_dev")
        serial=""
        if [[ -e "$target_dev/device/serial" ]]; then
            serial=$(cat "$target_dev/device/serial" 2>/dev/null | xargs) || serial=""
        fi
        rotational=$(cat "$target_dev/queue/rotational" 2>/dev/null || echo "1")
        removable=$(cat "$target_dev/removable" 2>/dev/null || echo "0")

        dtype="unknown"
        if [[ "$removable" == "1" ]]; then dtype="usb"
        elif [[ "$bn" == nvme* ]]; then dtype="nvme"
        elif [[ "$rotational" == "1" ]]; then dtype="hdd"
        else dtype="ssd"; fi

        local smart_avail=0 smart_health=""
        local _s_seagate=0 smart_attrs_json="" _s_afirst=1
        if command -v smartctl &>/dev/null; then
            local sout sattrs srisk=0 s_overall
            sout=$(root_run smartctl -a "/dev/$bn" 2>/dev/null) || true
            # USB-SATA adapters often omit the sysfs serial; pull from smartctl.
            if [[ -z "$serial" && -n "$sout" ]]; then
                serial=$(awk -F': ' '/^Serial Number:/{print $2; exit}' <<< "$sout" | xargs)
            fi
            # Detect Seagate: composite raw values for attrs 1, 7, 188.
            grep -qi 'Vendor:\|Seagate\|^Device Model:.*ST[0-9]' <<< "$sout" && _s_seagate=1
            if [[ -n "$sout" ]] && { grep -q 'SMART overall-health' <<< "$sout" || grep -q 'SMART Health Information' <<< "$sout"; }; then
                smart_avail=1
                s_overall=$(awk '/^SMART overall-health self-assessment test result:/{print $6; exit}' <<< "$sout")
                [[ "$s_overall" == "FAILED" ]] && srisk=2
                sattrs=$(awk '
                    /^Vendor Specific SMART Attributes/ { inattrs=1; next }
                    inattrs && /^[[:space:]]*[0-9]+[[:space:]]+[A-Za-z_]/ {
                        id=$1; name=$2; val=$4; worst=$5; thr=$6
                        raw=$10; for (i=11; i<=NF; i++) raw=raw " " $i
                        gsub(/^[[:space:]]+|[[:space:]]+$/, "", raw)
                        printf "%s|%s|%s|%s|%s|%s\n", id, name, val, worst, thr, raw
                    }
                    inattrs && /^SMART Error Log/ { exit }
                ' <<< "$sout")
                local sid sname sval sworst sthr sraw sdec
                while IFS='|' read -r sid sname sval sworst sthr sraw; do
                    [[ "$sid" =~ ^[0-9]+$ && "$sval" =~ ^[0-9]+$ && "$sworst" =~ ^[0-9]+$ && "$sthr" =~ ^[0-9]+$ ]] || continue
                    local _sraw_val="${sraw%% *}"
                    [[ "$_sraw_val" =~ ^[0-9]+$ ]] || _sraw_val=0
                    # Risk check
                    case "$sid" in
                        5|187|197|198|200|201)
                            if (( _sraw_val > 0 )); then (( srisk < 1 )) && srisk=1; fi ;;
                    esac
                    # Decode Seagate composite raw values for attrs 1, 7, 188.
                    sdec=""
                    case "$sid" in
                        1|7|188) if [[ "$_s_seagate" == "1" ]]; then
                                     local _hi _lo
                                     _hi=$(( _sraw_val >> 32 ))
                                     _lo=$(( _sraw_val & 0xFFFFFFFF ))
                                     printf -v sdec '%d / %d' "$_hi" "$_lo"
                                 fi ;;
                    esac
                    (( _s_afirst )) && _s_afirst=0 || smart_attrs_json+=","
                    smart_attrs_json+="{\"id\":$sid,\"name\":\"$(json_esc "$sname")\",\"value\":$sval,\"worst\":$sworst,\"threshold\":$sthr,\"raw\":\"$(json_esc "${sdec:-${_sraw_val}}")\"}"
                done <<< "$sattrs"
                case "$srisk" in
                    2) smart_health="FAILED" ;;
                    1) smart_health="WARN" ;;
                    0) smart_health="PASSED" ;;
                esac
            fi
        fi

        printf ',\n  "disk": {\n'
        printf '    "name": "%s",\n' "$(json_esc "$bn")"
        printf '    "path": "/dev/%s",\n' "$(json_esc "$bn")"
        printf '    "size_bytes": %d,\n' "$size_bytes"
        printf '    "model": "%s",\n' "$(json_esc "$model")"
        printf '    "serial": "%s",\n' "$(json_esc "$serial")"
        printf '    "rotational": %s,\n' "$rotational"
        printf '    "removable": %s,\n' "$removable"
        printf '    "type": "%s",\n' "$dtype"
        printf '    "smart": { "available": %s, "health": "%s"' "$smart_avail" "$(json_esc "$smart_health")"
        if [[ -n "$smart_attrs_json" ]]; then
            printf ', "attributes": [%s]' "$smart_attrs_json"
        fi
        printf ' },\n'
        printf '    "partitions": [\n'
        local first=1 part pname psize_bytes fstype mountpoint lsblk_out
        for part in "$target_dev"/${bn}*; do
            [[ -d "$part" ]] || continue
            pname=$(basename "$part")
            [[ "$pname" == "$bn" ]] && continue
            psize_bytes=$(cat "$part/size" 2>/dev/null || echo "0")
            psize_bytes=$(( psize_bytes * 512 ))
            fstype="" mountpoint=""
            if command -v lsblk &>/dev/null; then
                lsblk_out=$(lsblk -n -o FSTYPE,MOUNTPOINT "/dev/$pname" 2>/dev/null) || true
                fstype=$(echo "$lsblk_out" | awk '{print $1}')
                mountpoint=$(echo "$lsblk_out" | awk '{print $2}')
            fi
            (( first )) && first=0 || printf ',\n'
            printf '    { "name": "%s", "size_bytes": %d, "fs_type": "%s", "mountpoint": "%s" }' \
                "$(json_esc "$pname")" "$psize_bytes" "$(json_esc "$fstype")" "$(json_esc "$mountpoint")"
        done
        printf '\n    ]\n'
        printf '  }\n'
        wu_json_end
        return 0
    fi

    printf ',\n  "disks": [\n'
    local first=1 total_disks=0 total_parts=0 total_bytes=0
    while IFS= read -r dev; do
        total_disks=$(( total_disks + 1 ))
        local bn size_bytes model serial rotational removable
        bn=$(basename "$dev")
        size_bytes=$(cat "$dev/size" 2>/dev/null || echo "0")
        size_bytes=$(( size_bytes * 512 ))
        model=$(disk_model "$dev")
        serial=""
        if [[ -e "$dev/device/serial" ]]; then
            serial=$(cat "$dev/device/serial" 2>/dev/null | xargs) || serial=""
        fi
        rotational=$(cat "$dev/queue/rotational" 2>/dev/null || echo "1")
        removable=$(cat "$dev/removable" 2>/dev/null || echo "0")

        local dtype
        if [[ "$removable" == "1" ]]; then dtype="removable"
        elif [[ "$rotational" == "0" ]]; then dtype="ssd"
        else dtype="hdd"; fi

        (( first )) && first=0 || printf ',\n'
        printf '    {\n'
        printf '      "name": "%s",\n' "$(json_esc "$bn")"
        printf '      "path": "/dev/%s",\n' "$(json_esc "$bn")"
        printf '      "size_bytes": %d,\n' "$size_bytes"
        printf '      "model": "%s",\n' "$(json_esc "$model")"
        printf '      "serial": "%s",\n' "$(json_esc "$serial")"
        printf '      "rotational": %s,\n' "$rotational"
        printf '      "removable": %s,\n' "$removable"
        printf '      "type": "%s",\n' "$dtype"
        printf '      "partitions": [\n'
        local pfirst=1 part pname psize_bytes fstype mountpoint lsblk_out
        for part in "$dev"/${bn}*; do
            [[ -d "$part" ]] || continue
            pname=$(basename "$part")
            [[ "$pname" == "$bn" ]] && continue
            psize_bytes=$(cat "$part/size" 2>/dev/null || echo "0")
            psize_bytes=$(( psize_bytes * 512 ))
            total_parts=$(( total_parts + 1 ))
            fstype="" mountpoint=""
            if command -v lsblk &>/dev/null; then
                lsblk_out=$(lsblk -n -o FSTYPE,MOUNTPOINT "/dev/$pname" 2>/dev/null) || true
                fstype=$(echo "$lsblk_out" | awk '{print $1}')
                mountpoint=$(echo "$lsblk_out" | awk '{print $2}')
            fi
            (( pfirst )) && pfirst=0 || printf ',\n'
            printf '        { "name": "%s", "size_bytes": %d, "fs_type": "%s", "mountpoint": "%s" }' \
                "$(json_esc "$pname")" "$psize_bytes" "$(json_esc "$fstype")" "$(json_esc "$mountpoint")"
        done
        printf '\n      ]\n'
        printf '    }'
        total_bytes=$(( total_bytes + size_bytes ))
    done < <(wblock_disks)
    printf '\n  ],\n'

    printf '  "virtual": [\n'
    first=1
    local vdev vbn vsize_bytes
    for vdev in /sys/block/zram* /sys/block/loop*; do
        [[ -d "$vdev" ]] || continue
        vbn=$(basename "$vdev")
        vsize_bytes=$(cat "$vdev/size" 2>/dev/null || echo "0")
        vsize_bytes=$(( vsize_bytes * 512 ))
        (( first )) && first=0 || printf ',\n'
        printf '    { "name": "%s", "size_bytes": %d, "kind": "%s" }' \
            "$(json_esc "$vbn")" "$vsize_bytes" "$([[ "$vbn" == loop* ]] && printf 'loop' || printf 'zram')"
    done
    printf '\n  ],\n'

    printf '  "summary": { "disks": %d, "partitions": %d, "total_bytes": %d }\n' "$total_disks" "$total_parts" "$total_bytes"
    wu_json_end
}

# ─── Main ────────────────────────────────────────────────────────
main() {
    if [[ "$_WU_JSON" == "1" ]]; then json_out; return 0; fi

    local line
    line=$(printf '═%.0s' {1..80})

    if [[ -n "$_WU_DISK_ARG" ]]; then
        local target_dev="" dev
        if [[ "$_WU_DISK_ARG" =~ ^[0-9]+$ ]]; then
            local n=0
            while IFS= read -r dev; do
                if (( n == _WU_DISK_ARG )); then target_dev="$dev"; break; fi
                n=$(( n + 1 ))
            done < <(wblock_disks)
        else
            for dev in $(wblock_disks); do
                if [[ "$(basename "$dev")" == "$_WU_DISK_ARG" ]]; then target_dev="$dev"; break; fi
            done
        fi
        if [[ -z "$target_dev" ]]; then
            printf '%s: disk %s not found\n' "$_WU_TOOLNAME" "$_WU_DISK_ARG" >&2
            exit 3
        fi
        _WU_DETAIL_DEV="$target_dev"
        wblock_detail "$target_dev"
        return
    fi

    printf '\n  %s╔═%s═╗%s\n' "$C" "$line" "$RESET"
    local hw_title hw_ic hw_pad
    hw_title="wellblock -- $(t blk_title)"
    hw_ic="$(_ic '💾')"
    hw_pad=$(( 82 - 5 - ${#hw_title} ))
    [[ -z "$hw_ic" ]] && hw_pad=$(( hw_pad + 3 ))
    (( hw_pad < 1 )) && hw_pad=1
    printf '  %s║%s  %s%s%s%*s%s║%s\n' "$C" "$RESET" "$hw_ic" "${BOLD}${W}" "$hw_title" "$hw_pad" "" "$RESET" "$C"
    printf '  %s╚═%s═╝%s\n' "$C" "$line" "$RESET"

    local total_disks=0 total_parts=0 total_bytes=0 dev
    while IFS= read -r dev; do
        total_disks=$(( total_disks + 1 ))
    done < <(wblock_disks)

    printf '\n  %s┌───%s '"$(_ic "📊")"'%s%s%s\n' "$C" "$RESET" "$BOLD" "$(t blk_summary)" "$RESET"
    printf '  %s│%s\n' "$C" "$RESET"

    while IFS= read -r dev; do
        local bn
        bn=$(basename "$dev")

        local size_bytes=$(cat "$dev/size" 2>/dev/null || echo "0")
        size_bytes=$(( size_bytes * 512 ))

        local model
        model=$(disk_model "$dev")
        local serial=""
        if [[ -e "$dev/device/serial" ]]; then
            serial=$(cat "$dev/device/serial" 2>/dev/null | xargs) || serial=""
        fi

        local rotational=$(cat "$dev/queue/rotational" 2>/dev/null || echo "1")
        local removable=$(cat "$dev/removable" 2>/dev/null || echo "0")

        local type_icon type_label type_color
        if [[ "$removable" == "1" ]]; then
            type_icon="$(_emu '⏏️')"
            type_label="$(t blk_removable)"
            type_color="$M"
        elif [[ "$rotational" == "0" ]]; then
            type_icon="$(_emu '⚡')"
            type_label="$(t blk_ssd)"
            type_color="$G"
        else
            type_icon="$(_emu '💿')"
            type_label="$(t blk_hdd)"
            type_color="$Y"
        fi

        local size_human
        size_human=$(fmt_size "$size_bytes")
        total_bytes=$(( total_bytes + size_bytes ))

        # Disk health badge (fast -H check, skip removable)
        local health_badge=""
        if [[ "$removable" != "1" ]] && command -v smartctl &>/dev/null; then
            local smart_h
            smart_h=$(root_run smartctl -H "/dev/$bn" 2>/dev/null) || true
            case "$smart_h" in
                *PASSED*)            health_badge=" ${G}✓${RESET}" ;;
                *FAILED*)            health_badge=" ${R}✗${RESET}" ;;
                *"SMART not supported"*) health_badge="" ;;
                *)                   health_badge="" ;;
            esac
        fi

        printf '  %s│%s  %s %s%s%s%s  %s%-20s%s  %s%s%s  %s%8s%s%s\n' \
            "$C" "$RESET" "$type_icon" "$BOLD" "$W" "/dev/$bn" "$RESET" \
            "$type_color" "$type_label" "$RESET" \
            "$G" "$model" "$RESET" \
            "$DIM" "$size_human" "$RESET" \
            "$health_badge"

        if [[ -n "$serial" ]]; then
            printf '  %s│%s     %s%s: %s%s\n' "$C" "$RESET" "$DIM" "$(t blk_serial)" "$serial" "$RESET"
        fi

        for part in "$dev"/${bn}*; do
            [[ -d "$part" ]] || continue
            local pname
            pname=$(basename "$part")
            [[ "$pname" == "$bn" ]] && continue

            local psize_bytes=$(cat "$part/size" 2>/dev/null || echo "0")
            psize_bytes=$(( psize_bytes * 512 ))
            local psize_human
            psize_human=$(fmt_size "$psize_bytes")
            total_parts=$(( total_parts + 1 ))

            local fstype="" mountpoint=""
            if command -v lsblk &>/dev/null; then
                local lsblk_out
                lsblk_out=$(lsblk -n -o FSTYPE,MOUNTPOINT "/dev/$pname" 2>/dev/null) || true
                fstype=$(echo "$lsblk_out" | awk '{print $1}')
                mountpoint=$(echo "$lsblk_out" | awk '{print $2}')
            fi

            local mp_icon=""
            [[ -n "$mountpoint" ]] && mp_icon="$(_emu '📁')"
            [[ "$fstype" == "swap" || "$mountpoint" == "[SWAP]" ]] && mp_icon="$(_emu '🔄')"

            printf '  %s│%s     %s├─ %s%s%s  %s%8s%s' \
                "$C" "$RESET" "$DIM" "$BOLD" "$W" "$pname" "$DIM" "$psize_human" "$RESET"

            if [[ -n "$fstype" ]]; then
                printf '  %s%s%s' "$C" "$fstype" "$RESET"
            fi
            if [[ -n "$mountpoint" ]]; then
                printf '  -> %s%s%s' "$G" "$mountpoint" "$RESET"
            fi
            printf '\n'
        done

        printf '  %s│%s\n' "$C" "$RESET"
    done < <(wblock_disks)

    local has_special=0
    for dev in /sys/block/zram* /sys/block/loop*; do
        [[ -d "$dev" ]] || continue
        has_special=1
        break
    done

    if (( has_special )); then
        printf '  %s┌───%s '"$(_ic "🔄")"'%s%s%s\n' "$C" "$RESET" "$BOLD" "$(t blk_virtual)" "$RESET"
        printf '  %s│%s\n' "$C" "$RESET"

        for dev in /sys/block/zram* /sys/block/loop*; do
            [[ -d "$dev" ]] || continue
            local bn
            bn=$(basename "$dev")

            local size_bytes=$(cat "$dev/size" 2>/dev/null || echo "0")
            size_bytes=$(( size_bytes * 512 ))
            local size_human
            size_human=$(fmt_size "$size_bytes")

            local icon="$(_emu '🔄')"
            [[ "$bn" == loop* ]] && icon="$(_emu '📀')"

            printf '  %s│%s  %s %s%s%s  %s%s%s\n' \
                "$C" "$RESET" "$icon" "$BOLD" "$W" "$bn" "$DIM" "$size_human" "$RESET"
        done

        printf '  %s│%s\n' "$C" "$RESET"
    fi

    printf '  %s└%s┘%s\n' "$C" "$(printf '─%.0s' {1..82})" "$RESET"

    local total_human
    total_human=$(fmt_size "$total_bytes")
    printf '\n  %s│%s  '"$(_ic "📊")"'%s%s:%s %d %s  |  %d %s  |  %s\n' \
        "$C" "$RESET" "$BOLD" "$(t blk_total)" "$W" \
        "$total_disks" "$(t blk_disks)" "$total_parts" "$(t blk_partitions)" "$total_human"

    printf '\n  %s%s %s%s\n\n' "$DIM" "$(_emu '💡')" "$(t blk_hint)" "$RESET"
    printf '  %sWellBlock v1.1 | %s%s\n\n' "$DIM" "$(date '+%Y-%m-%d %H:%M:%S')" "$RESET"
}

wu_run main "$@"
