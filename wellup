#!/usr/bin/env bash
# WellUp -- Check for system updates and apply them automatically
# Supports: pacman (Arch), dnf/yum (Fedora/RHEL), apt (Debian/Ubuntu/Bodhi),
#           zypper (openSUSE), apk (Alpine), xbps (Void), emerge (Gentoo)
# by wellbou_
set -euo pipefail

# ─── Shared libs ────────────────────────────────────────────────
_WU_TOOLNAME="wellup" _WU_NAME="WellUp" _WU_VERSION="1.0"
_WU_TAGLINE="Check for system updates and apply them automatically"
_WU_BOOT_DIR="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="$(dirname -- "$_WU_BOOT_DIR")/share/wellutils"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="/usr/local/share/wellutils"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="/usr/share/wellutils"
source "$_WU_BOOT_DIR/bootstrap.sh" lang box cli

# ─── Flags ─────────────────────────────────────────────────────
_UP_CHECK=0
_UP_SELF=0
_UP_YES=0
_UP_PACNEW=0

up_extra_parse() {
    case "$1" in
        --check|--list)
            _UP_CHECK=1
            _WU_EXTRA_CONSUMED=1
            return 0 ;;
        --self-update|--self)
            _UP_SELF=1
            _WU_EXTRA_CONSUMED=1
            return 0 ;;
        --yes|-y)
            _UP_YES=1
            _WU_EXTRA_CONSUMED=1
            return 0 ;;
        --pacnew)
            _UP_PACNEW=1
            _WU_EXTRA_CONSUMED=1
            return 0 ;;
    esac
    return 1
}
_WU_EXTRA_PARSE=up_extra_parse
_WU_EXTRA_HELP="      --check, --list         only list available updates, do not install
      --yes, -y               apply updates without confirmation
      --pacnew                list leftover .pacnew/.pacsave files in /etc
      --self-update           update wellutils itself from GitHub
      --self                  alias of --self-update"

# ─── System / package manager detection (os-release first) ─────
_UP_OS="unknown Linux"
_UP_PM=""
detect_pm() {
    local id="" id_like="" c="" osrelease
    osrelease="/etc/os-release"
    [[ -n "${WELLUTILS_OSRELEASE:-}" && -r "$WELLUTILS_OSRELEASE" ]] && osrelease="$WELLUTILS_OSRELEASE"
    if [[ -r "$osrelease" ]]; then
        . "$osrelease" 2>/dev/null || true
        _UP_OS="${PRETTY_NAME:-${NAME:-unknown Linux}}"
        id="${ID:-}" id_like="${ID_LIKE:-}"
    fi
    case "$id" in
        arch|manjaro|endeavouros|cachyos|artix)        c=pacman ;;
        fedora|rhel|centos|rocky|almalinux|nobara|eurolinux) c=dnf ;;
        debian|ubuntu|bodhi|linuxmint|pop|elementary|zorin|kali|mx|devuan) c=apt-get ;;
        opensuse*|sles|sled)                            c=zypper ;;
        alpine)                                         c=apk ;;
        void)                                           c=xbps-install ;;
        gentoo|calculate)                               c=emerge ;;
    esac
    case " $id_like " in
        *" arch "*)     c=pacman ;;
        *" fedora "*|*" rhel "*|*" centos "*) c=dnf ;;
        *" debian "*|*" ubuntu "*) c=apt-get ;;
        *" suse "*)     c=zypper ;;
    esac
    if [[ -n "$c" ]] && command -v "$c" >/dev/null 2>&1; then
        _UP_PM="$c"
        return 0
    fi
    for c in pacman dnf yum apt-get apt zypper apk xbps-install emerge; do
        if command -v "$c" >/dev/null 2>&1; then
            _UP_PM="$c"
            return 0
        fi
    done
    _UP_PM=""
}

# ─── Update detection ──────────────────────────────────────────
UP_LINES=()   # rows: "name|old|new"

pm_check() {
    UP_LINES=()
    local line row
    case "$_UP_PM" in
        pacman)
            local row rest
            while IFS= read -r line; do
                [[ -z "$line" ]] && continue
                row="${line%% *}"
                if [[ "$line" == *" -> "* ]]; then
                    rest="${line#* }"
                    UP_LINES+=("$row|${rest% -> *}|${rest#* -> }")
                else
                    UP_LINES+=("$row||")
                fi
            done < <(pacman -Qu 2>/dev/null) ;;
        dnf|yum)
            local arr
            while IFS= read -r line; do
                [[ -z "$line" ]] && continue
                [[ "$line" == *"Obsolet"* ]] && break
                read -r -a arr <<< "$line"
                [[ ${#arr[@]} -ge 2 ]] || continue
                [[ "${arr[1]}" =~ [0-9] ]] || continue
                UP_LINES+=("${arr[0]}||${arr[1]}")
            done < <(dnf check-update 2>/dev/null || true) ;;
        apt-get|apt)
            local nm old rest
            while IFS= read -r line; do
                [[ "$line" == *"/"* ]] || continue
                nm="${line%%/*}"
                rest="${line#* }"
                read -r -a arr <<< "$rest"
                [[ ${#arr[@]} -ge 2 ]] || continue
                old=""
                if [[ "$rest" =~ upgradable\ from:\ ([^][]+)\] ]]; then
                    old="${BASH_REMATCH[1]}"
                fi
                UP_LINES+=("$nm|$old|${arr[0]}")
            done < <(LC_ALL=C apt list --upgradable 2>/dev/null) ;;
        zypper)
            local cols=() idx hdr_name=2 hdr_new=-1 in_hdr=0 nm nw
            while IFS= read -r line; do
                [[ -z "$line" ]] && continue
                if [[ "$line" == *"Name"* ]]; then
                    in_hdr=1
                    IFS='|' read -r -a cols <<< "$line"
                    for idx in "${!cols[@]}"; do
                        case "${cols[$idx]// /}" in
                            Name)    hdr_name=$idx ;;
                            "New"*|"Current"*) [[ "${cols[$idx]// /}" == "New"* ]] && hdr_new=$idx ;;
                        esac
                    done
                    continue
                fi
                [[ $in_hdr -eq 1 ]] || continue
                IFS='|' read -r -a cols <<< "$line"
                [[ ${#cols[@]} -lt 2 ]] && continue
                nm="${cols[$hdr_name]// /}"
                [[ -n "$nm" ]] || continue
                nw=""
                if (( hdr_new >= 0 )); then nw="${cols[$hdr_new]// /}"; fi
                [[ -n "$nw" ]] || nw="${cols[${#cols[@]}-1]// /}"
                UP_LINES+=("$nm||$nw")
            done < <(zypper --no-color list-updates 2>/dev/null || true) ;;
        apk)
            while IFS= read -r line; do
                [[ -z "$line" ]] && continue
                UP_LINES+=("$line||")
            done < <(apk info -u 2>/dev/null) ;;
        xbps-install)
            local cols p nm nw i
            while IFS= read -r line; do
                [[ -z "$line" ]] && continue
                read -r -a cols <<< "$line"
                p="${cols[0]//[\[\]*]/}"
                nm="${p%-*}"
                nw=""
                for i in "${!cols[@]}"; do
                    if [[ "${cols[$i]}" == "update:" && -n "${cols[$((i+1))]:-}" ]]; then
                        nw="${cols[$((i+1))]}"
                        nw="${nw#${cols[0]%-*}-}"
                        break
                    fi
                done
                UP_LINES+=("$nm||$nw")
            done < <(xbps-install -un 2>/dev/null || true) ;;
        emerge)
            local t nm ver
            while IFS= read -r line; do
                [[ "$line" == "["*"ebuild"* ]] || continue
                t="${line#*\] }"
                t="${t%% *}"
                nm="${t%-*}"
                ver="${t##*-}"
                UP_LINES+=("$nm||$ver")
            done < <(emerge -puDN --color=n @world 2>/dev/null || true) ;;
    esac
}

# ─── Root helper ───────────────────────────────────────────────
run_priv() {
    if [[ "$(id -u)" -eq 0 ]]; then
        "$@"
    elif command -v sudo >/dev/null 2>&1; then
        sudo "$@"
    else
        printf '%s\n' "$(t upd_need_root)" >&2
        return 3
    fi
}

pm_update() {
    case "$_UP_PM" in
        pacman)        run_priv pacman -Syu --noconfirm ;;
        dnf|yum)       run_priv dnf upgrade -y ;;
        apt-get|apt)   run_priv apt-get update -y && run_priv apt-get full-upgrade -y ;;
        zypper)        run_priv zypper --non-interactive update ;;
        apk)           run_priv apk update && run_priv apk upgrade ;;
        xbps-install)  run_priv xbps-install -Su ;;
        emerge)        run_priv emerge -uDN --with-bdeps=y @world ;;
    esac
}

# ─── JSON output (check-only) ──────────────────────────────────
json_out() {
    local count="${#UP_LINES[@]}" first=1 name from to rest
    wu_json_head "$_WU_TOOLNAME" "$_WU_VERSION"
    printf ',\n  "package_manager": "%s",\n' "$(json_esc "$_UP_PM")"
    printf '  "os": "%s",\n' "$(json_esc "$_UP_OS")"
    printf '  "updates_available": %d,\n' "$count"
    printf '  "updates": [\n'
    for row in "${UP_LINES[@]}"; do
        name="${row%%|*}"; rest="${row#*|}"; from="${rest%%|*}"; to="${rest#*|}"
        (( first )) || printf ',\n'
        first=0
        printf '    { "name": "%s", "from": "%s", "to": "%s" }' \
            "$(json_esc "$name")" "$(json_esc "$from")" "$(json_esc "$to")"
    done
    printf '\n  ]\n'
    wu_json_end
}

# ─── Display ───────────────────────────────────────────────────
up_system_box() {
    _LINES+=("$BOLD$(t upd_pm)$RESET  $C$_UP_PM$RESET")
    _LINES+=("$BOLD$(t upd_os)$RESET  $W$_UP_OS$RESET")
    local mode
    if [[ "$_UP_CHECK" == "1" ]]; then mode="$(t upd_mode_check)"; else mode="$(t upd_mode_update)"; fi
    _LINES+=("$BOLD$(t upd_mode)$RESET  $W$mode$RESET")
}

up_list_box() {
    local row name from to rest
    for row in "${UP_LINES[@]}"; do
        name="${row%%|*}"; rest="${row#*|}"; from="${rest%%|*}"; to="${rest#*|}"
        if [[ -n "$from" && -n "$to" ]]; then
            _LINES+=("$Y$name$RESET  $DIM$from$RESET -> $G$to$RESET")
        elif [[ -n "$to" ]]; then
            _LINES+=("$Y$name$RESET  ->  $G$to$RESET")
        else
            _LINES+=("$Y$name$RESET")
        fi
    done
}

confirm_update() {
    (( _UP_YES )) && return 0
    if [[ ! -t 0 ]]; then
        printf '  %s\n' "$(t upd_no_tty)" >&2
        return 1
    fi
    local ans
    printf '  %s [y/N] ' "$(t upd_confirm)"
    read -r ans || return 1
    case "$ans" in
        y|Y|yes|Yes|YES|д|Д|да|Да|ДА) return 0 ;;
        *) return 1 ;;
    esac
}

# ─── Self-update: wellutils itself, from GitHub ────────────────
SELF_REPO="${WELLUTILS_REPO:-Wellbou/wellutils}"
SELF_RAW="${WELLUTILS_RAW:-https://raw.githubusercontent.com/$SELF_REPO}"
SELF_LIB=""
SELF_LOCAL=""
SELF_REMOTE=""
SELF_ALIASES="wellusb=wusb wellpci=wpci wellblock=wblock wellcpu=wcpu wellgpu=wgpu wellmem=wmem wellmem=wram wellmem=wellram wellmod=wmod wellsensors=wsensors wellsensors=wtemp wellhw=whw wellper=wper wellfetch=wfetch wellup=wup"

self_detect() {
    SELF_LIB="$(dirname "$_WU_LIB")"
    if [[ -f "$SELF_LIB/VERSION" ]]; then
        SELF_LOCAL="$(tr -d '[:space:]' < "$SELF_LIB/VERSION")"
    fi
}

self_fetch() {
    local url="$SELF_RAW/VERSION"
    local out
    if [[ "$SELF_RAW" == /* ]]; then
        [[ -f "$url" ]] || return 1
        out="$(cat "$url")"
    elif command -v curl >/dev/null 2>&1; then
        out="$(curl -fsSL --max-time 20 "$url" 2>/dev/null)" \
            || out="$(curl -fsSL -H 'Accept: application/vnd.github.raw' --max-time 20 "https://api.github.com/repos/$SELF_REPO/contents/VERSION" 2>/dev/null)" \
            || out="$(curl -fsSL --max-time 20 "https://api.github.com/repos/$SELF_REPO/contents/VERSION" 2>/dev/null | sed -n 's/.*"content":"\([^"]*\)".*/\1/p' | tr -d '[:space:]' | base64 -d 2>/dev/null)"
    elif command -v wget >/dev/null 2>&1; then
        out="$(wget -qO- --timeout=20 "$url")"
    else
        return 1
    fi
    SELF_REMOTE="$(printf '%s' "$out" | tr -d '[:space:]' | head -c 100)"
    [[ -n "$SELF_REMOTE" ]] || return 1
}

ver_gt() {
    [[ "$1" != "$2" && "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n1)" == "$1" ]]
}

self_status() {
    if [[ -z "$SELF_REMOTE" ]]; then
        echo "no-remote"; return
    fi
    if [[ -z "$SELF_LOCAL" ]]; then
        echo "no-local"; return
    fi
    if [[ "$SELF_REMOTE" == "$SELF_LOCAL" ]]; then
        echo "up-to-date"
    elif ver_gt "$SELF_REMOTE" "$SELF_LOCAL"; then
        echo "update-available"
    else
        echo "newer-local"
    fi
}

self_acquire() {
    local tmp url
    if [[ "$SELF_RAW" == /* ]]; then
        echo "$SELF_RAW"
        return 0
    fi
    tmp="$(mktemp -d)"
    _WU_SELF_TMP="$tmp"
    trap '[[ -n "$_WU_SELF_TMP" ]] && rm -rf -- "$_WU_SELF_TMP"' EXIT
    url="https://codeload.github.com/$SELF_REPO/tar.gz/refs/heads/main"
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL --max-time 60 "$url" -o "$tmp/wellutils.tar.gz"
    elif command -v wget >/dev/null 2>&1; then
        wget -qO "$tmp/wellutils.tar.gz" --timeout=60 "$url"
    else
        rm -rf "$tmp"
        return 1
    fi
    tar -xzf "$tmp/wellutils.tar.gz" -C "$tmp" || { rm -rf "$tmp"; return 1; }
    find "$tmp" -maxdepth 1 -type d ! -name "$tmp" | tail -n1
}

self_write() {
    if [[ "$(id -u)" -eq 0 || -w "$(dirname "$2")" ]]; then
        install -D "$@"
    elif command -v sudo >/dev/null 2>&1; then
        sudo install -D "$@"
    else
        printf '%s\n' "$(t upd_need_root)" >&2
        return 1
    fi
}

self_install_to() {
    local src="$1" prefix bin mandir compdir licdir name f base
    prefix="${SELF_LIB%/share/wellutils}"
    bin="$prefix/bin"
    mandir="$prefix/share/man/man1"
    licdir="$prefix/share/licenses/wellutils"
    compdir="$prefix/share/bash-completion/completions"
    if [[ "$prefix" == "/usr" || "$prefix" == "/usr/local" ]] && [[ -d /usr/share/bash-completion/completions ]]; then
        compdir="/usr/share/bash-completion/completions"
    elif [[ "$prefix" == "/usr" || "$prefix" == "/usr/local" ]] && [[ -d /etc/bash_completion.d ]]; then
        compdir="/etc/bash_completion.d"
    fi

    for f in "$src"/well*; do
        [[ -f "$f" && -x "$f" ]] || continue
        name="${f##*/}"
        [[ "$name" == well* ]] || continue
        self_write -m755 "$f" "$bin/$name" || return 1
    done
    for f in lang.sh box.sh cli.sh jedec.sh wfetch_art.py logo.png VERSION; do
        [[ -f "$src/$f" ]] || continue
        self_write -m644 "$src/$f" "$SELF_LIB/$f" || return 1
    done
    [[ -f "$src/LICENSE" ]] && { self_write -m644 "$src/LICENSE" "$licdir/LICENSE" || return 1; }
    for f in "$src"/*.1; do
        [[ -f "$f" ]] || continue
        self_write -m644 "$f" "$mandir/${f##*/}" || return 1
    done
    for f in "$src"/*.bash; do
        [[ -f "$f" ]] || continue
        name="${f##*/}"
        self_write -m644 "$f" "$compdir/${name%.bash}" || return 1
    done
    for a in $SELF_ALIASES; do
        base="${a%%=*}"
        if [[ "$(id -u)" -eq 0 || -w "$bin" ]]; then
            ln -sf "$bin/$base" "$bin/${a#*=}"
        elif command -v sudo >/dev/null 2>&1; then
            sudo ln -sf "$bin/$base" "$bin/${a#*=}"
        fi
    done
}

self_info_box() {
    _LINES+=("$BOLD$(t updu_current)$RESET  $W${SELF_LOCAL:-?}$RESET")
    _LINES+=("$BOLD$(t updu_latest)$RESET  $G${SELF_REMOTE:-?}$RESET")
    _LINES+=("$BOLD$(t updu_prefix)$RESET  $DIM${SELF_LIB%/share/wellutils}$RESET")
}

json_self_out() {
    local status="$1"
    wu_json_head "$_WU_TOOLNAME" "$_WU_VERSION"
    printf ',\n  "self_update": {\n'
    printf '    "current": "%s",\n' "$(json_esc "${SELF_LOCAL:-}")"
    printf '    "latest": "%s",\n' "$(json_esc "${SELF_REMOTE:-}")"
    printf '    "status": "%s",\n' "$(json_esc "$status")"
    printf '    "prefix": "%s"\n' "$(json_esc "${SELF_LIB%/share/wellutils}")"
    printf '  }\n'
    wu_json_end
}

self_main() {
    self_detect
    if [[ -f "$SELF_LIB/wellup" ]]; then
        printf '  %s\n' "$(t updu_checkout)" >&2
        exit 0
    fi

    if ! self_fetch; then
        printf '%s\n' "$(t updu_fetch_fail)" >&2
        exit 3
    fi
    local status
    status="$(self_status)"

    if [[ "$_WU_JSON" == "1" ]]; then
        json_self_out "$status"
        return 0
    fi

    box_header "$(_emu '🔄')" "wellup --self-update" "$(t updu_title)"
    box "$(_emu '⚙')" "$(t updu_system)" self_info_box

    if [[ "$status" == "up-to-date" || "$status" == "newer-local" ]]; then
        printf '\n  %s%s%s\n' "$G" "$(t updu_up_to_date)" "$RESET"
        printf '\n  %sWellUp v%s | %s%s\n\n' "$DIM" "$_WU_VERSION" "$(date '+%Y-%m-%d %H:%M:%S')" "$RESET"
        return 0
    fi

    printf '\n  %s%s %s%s\n' "$G" "$(t updu_update)" "$RESET" "$SELF_REMOTE"

    if [[ "$_UP_CHECK" == "1" ]]; then
        printf '\n  %sWellUp v%s | %s%s\n\n' "$DIM" "$_WU_VERSION" "$(date '+%Y-%m-%d %H:%M:%S')" "$RESET"
        return 0
    fi

    if ! confirm_update; then
        printf '\n  %s\n\n' "$(t upd_aborted)"
        return 0
    fi

    trap 'printf "\n  %s\n\n" "$(t upd_aborted)"; exit 130' INT
    printf '  %s\n\n' "$(t updu_applying)"
    local src
    src="$(self_acquire)" || { printf '\n  %s%s%s\n\n' "$R" "$(t updu_error)" "$RESET"; return 3; }
    if self_install_to "$src"; then
        trap - INT
        printf '\n  %s%s %s%s\n\n' "$G" "$(t updu_done)" "$RESET" "$SELF_REMOTE"
        printf '  %sWellUp v%s | %s%s\n\n' "$DIM" "$_WU_VERSION" "$(date '+%Y-%m-%d %H:%M:%S')" "$RESET"
        return 0
    else
        trap - INT
        printf '\n  %s%s%s\n\n' "$R" "$(t updu_error)" "$RESET"
        return 3
    fi
}

pacnew_list() {
    local f n=0
    while IFS= read -r f; do
        [[ -z "$f" ]] && continue
        n=$(( n + 1 ))
        pline_sub "$(_emu '📄') ${BOLD}${f%.pacnew}${RESET} ${DIM}(${f##*.})${RESET}"
    done < <(find /etc -name '*.pacnew' -o -name '*.pacsave' 2>/dev/null | sort || true)
    if (( n == 0 )); then
        pline "$(_emu '✔') ${G}$(t pacnew_none)${RESET}"
    else
        pline ""
        pline_sub "$(_emu '🧹') $(t pacnew_count): ${BOLD}${n}${RESET} · $(t pacnew_hint) ${DIM}sudo pacdiff${RESET}"
    fi
}

pacnew_main() {
    box_header "$(_emu '📦')" "wellup" "$(t pacnew_title)"
    box "$(_emu '📦')" "$(t pacnew_title)" pacnew_list
    printf '\n  %sWellUp v%s | %s%s\n\n' "$DIM" "$_WU_VERSION" "$(date '+%Y-%m-%d %H:%M:%S')" "$RESET"
}

main() {
    if [[ "$_UP_PACNEW" == "1" ]]; then
        pacnew_main
        return $?
    fi

    if [[ "$_UP_SELF" == "1" ]]; then
        self_main
        return $?
    fi

    detect_pm

    if [[ -z "$_UP_PM" ]]; then
        printf '%s\n' "$(t upd_no_pm)" >&2
        exit 3
    fi

    pm_check
    local count="${#UP_LINES[@]}"

    if [[ "$_WU_JSON" == "1" ]]; then
        json_out
        return 0
    fi

    box_header "$(_emu '🔄')" "wellup" "$(t upd_title)"
    box "$(_emu '💻')" "$(t upd_system)" up_system_box

    if (( count > 0 )); then
        box "$(_emu '📦')" "$(t upd_available): $count" up_list_box
    else
        printf '\n  %s%s%s\n' "$G" "$(t upd_no_updates)" "$RESET"
    fi

    if [[ "$_UP_CHECK" == "1" || $count -eq 0 ]]; then
        printf '\n  %sWellUp v%s | %s%s\n\n' "$DIM" "$_WU_VERSION" "$(date '+%Y-%m-%d %H:%M:%S')" "$RESET"
        return 0
    fi

    if ! confirm_update; then
        printf '\n  %s\n\n' "$(t upd_aborted)"
        return 0
    fi

    trap 'printf "\n  %s\n\n" "$(t upd_aborted)"; exit 130' INT
    printf '  %s\n\n' "$(t upd_applying)"
    if pm_update; then
        printf '\n  %s%s%s\n\n' "$G" "$(t upd_done)" "$RESET"
    else
        printf '\n  %s%s%s\n\n' "$R" "$(t upd_error)" "$RESET"
        return 3
    fi
    trap - INT

    printf '\n  %sWellUp v%s | %s%s\n\n' "$DIM" "$_WU_VERSION" "$(date '+%Y-%m-%d %H:%M:%S')" "$RESET"
}

wu_run main "$@"
