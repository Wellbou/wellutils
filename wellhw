#!/usr/bin/env bash
# wellhw — Beautiful hardware report (chat-ready)
# Part of wellutils by wellbou_
set -euo pipefail

# ─── Shared libs ────────────────────────────────────────────────
_WU_LIB="$(dirname "$(readlink -f "$0")")/lang.sh"
[[ -f "$_WU_LIB" ]] || _WU_LIB="$(dirname "$(dirname "$(readlink -f "$0")")")/share/wellutils/lang.sh"
[[ -f "$_WU_LIB" ]] || _WU_LIB="/usr/local/share/wellutils/lang.sh"
[[ -f "$_WU_LIB" ]] || _WU_LIB="/usr/share/wellutils/lang.sh"
[[ -f "$_WU_LIB" ]] || _WU_LIB="/etc/wellutils/lang.sh"
source "$_WU_LIB"
_WU_BOX="$(dirname "$(readlink -f "$0")")/box.sh"
[[ -f "$_WU_BOX" ]] || _WU_BOX="$(dirname "$(dirname "$(readlink -f "$0")")")/share/wellutils/box.sh"
[[ -f "$_WU_BOX" ]] || _WU_BOX="/usr/local/share/wellutils/box.sh"
[[ -f "$_WU_BOX" ]] || _WU_BOX="/usr/share/wellutils/box.sh"
[[ -f "$_WU_BOX" ]] || _WU_BOX="/etc/wellutils/box.sh"
source "$_WU_BOX"
# JEDEC JEP106 manufacturer table (wellhw resolves dmidecode RAM vendor codes)
_WU_JEDEC="$(dirname "$(readlink -f "$0")")/jedec.sh"
# ─── Rare-hardware guards (Termux/PS5/ARM/laptops may lack tools) ──
command -v awk    >/dev/null 2>&1 || awk()    { :; }
command -v free   >/dev/null 2>&1 || free()   { printf 'Mem: 0 0 0 0 0 0\n'; }
command -v df     >/dev/null 2>&1 || df()     { :; }
command -v uptime >/dev/null 2>&1 || uptime() { :; }
command -v nproc  >/dev/null 2>&1 || nproc()  { getconf _NPROCESSORS_ONLN 2>/dev/null || printf '1'; }
command -v date   >/dev/null 2>&1 || date()   { printf '%s' '1970-01-01 00:00:00'; }
[[ -f "$_WU_JEDEC" ]] || _WU_JEDEC="$(dirname "$(dirname "$(readlink -f "$0")")")/share/wellutils/jedec.sh"
[[ -f "$_WU_JEDEC" ]] || _WU_JEDEC="/usr/local/share/wellutils/jedec.sh"
[[ -f "$_WU_JEDEC" ]] || _WU_JEDEC="/usr/share/wellutils/jedec.sh"
[[ -f "$_WU_JEDEC" ]] || _WU_JEDEC="/etc/wellutils/jedec.sh"
source "$_WU_JEDEC"
# ─── CLI (shared cli.sh) ──────────────────────────────────
_WU_TOOLNAME="wellhw" _WU_NAME="WellHW" _WU_VERSION="1.3"
_WU_TAGLINE="Beautiful hardware report (chat-ready)"
_WU_CLI="$(dirname "$(readlink -f "$0")")/cli.sh"
[[ -f "$_WU_CLI" ]] || _WU_CLI="$(dirname "$(dirname "$(readlink -f "$0")")")/share/wellutils/cli.sh"
[[ -f "$_WU_CLI" ]] || _WU_CLI="/usr/local/share/wellutils/cli.sh"
[[ -f "$_WU_CLI" ]] || _WU_CLI="/usr/share/wellutils/cli.sh"
[[ -f "$_WU_CLI" ]] || _WU_CLI="/etc/wellutils/cli.sh"
source "$_WU_CLI"


# ─── Helpers ────────────────────────────────────────────────────
root_run() {
    if (( EUID == 0 )); then "$@"
    elif sudo -n true 2>/dev/null; then sudo -n "$@"
    else "$@"; fi
}

# ─── Sections ───────────────────────────────────────────────────
print_cpu() {
    local model cores threads
    model=$(awk -F': *' '/^model name/{print $2; exit}' /proc/cpuinfo)
    cores=$(awk '/^cpu cores/{print $4; exit}' /proc/cpuinfo)
    threads=$(awk '/^processor/{c++} END{print c+0}' /proc/cpuinfo)
    pline_hw "$(_emu '🧠')" "$(t hw_cpu)" "${model}  ${DIM}($(t hw_cores): ${cores}, $(t hw_threads): ${threads})${RESET}"
}

print_gpu() {
    local gpu
    gpu=$(lspci 2>/dev/null | grep -iE 'vga compatible|3d controller' | sed -E 's/^[0-9a-f:.]+ [^:]+: //' | head -1) || gpu=""
    if [[ -n "$gpu" ]]; then
        pline_hw "$(_emu '🎮')" "$(t hw_gpu)" "$gpu"
    else
        pline_hw "$(_emu '🎮')" "$(t hw_gpu)" "${DIM}$(t hw_unknown)${RESET}"
    fi
}

print_board() {
    local vendor name version bios
    vendor=$(cat /sys/class/dmi/id/board_vendor 2>/dev/null || true)
    name=$(cat /sys/class/dmi/id/board_name 2>/dev/null || true)
    version=$(cat /sys/class/dmi/id/board_version 2>/dev/null || true)
    bios=$(cat /sys/class/dmi/id/bios_vendor 2>/dev/null || true)
    local bver bdate
    bver=$(cat /sys/class/dmi/id/bios_version 2>/dev/null || true)
    bdate=$(cat /sys/class/dmi/id/bios_date 2>/dev/null || true)
    bios="$bios $bver"
    [[ -n "$bdate" ]] && bios="$bios ($bdate)"
    bios="${bios//  / }"
    [[ -z "${bios// /}" ]] && bios=""

    local board="$vendor $name"
    [[ -n "$version" ]] && board="$board (v$version)"
    board="${board//  / }"

    pline_hw "$(_emu '🖥️')" "$(t hw_board)" "${board:-$(t hw_unknown)}"
    pline_hw "$(_emu '💾')" "$(t hw_bios)" "${bios:-$(t hw_unknown)}"
}

print_ram() {
    local mout modules types sizes speeds manufs pns forms concat ram_line="" ram_sub=""
    mout=$(root_run dmidecode -t memory 2>/dev/null) || mout=""
    modules=$(awk '/^[[:space:]]*Size: [0-9]+ /{c++} END{print c+0}' <<< "$mout")
    if (( modules > 0 )); then
        local msize_mb per_gb
        msize_mb=$(awk '/^[[:space:]]*Size: [0-9]+ (MiB|GiB)/{if($3=="GiB") s+=$2*1024; else s+=$2} END{print s+0}' <<< "$mout")
        per_gb=$(( (msize_mb / modules + 512) / 1024 ))
        mtype=$(awk '/^[[:space:]]*Type: (DDR|LPDDR)/{print $2; exit}' <<< "$mout")
        mspeed=$(awk '/^[[:space:]]*Speed: [0-9]+ MT\/s/{print $2; exit}' <<< "$mout")
        mmanuf=$(awk '/^[[:space:]]*Manufacturer:/{sub(/^[[:space:]]*Manufacturer:[[:space:]]*/,""); gsub(/\r/,""); sub(/[[:space:]]+$/,""); print; exit}' <<< "$mout")
        mpn=$(awk '/^[[:space:]]*Part Number:/{sub(/^[[:space:]]*Part Number:[[:space:]]*/,""); gsub(/\r/,""); sub(/[[:space:]]+$/,""); print; exit}' <<< "$mout")
        mform=$(awk '/^[[:space:]]*Form Factor:/{sub(/^[[:space:]]*Form Factor:[[:space:]]*/,""); gsub(/\r/,""); sub(/[[:space:]]+$/,""); print; exit}' <<< "$mout")
        mform="${mform//[$'\t']}"

        local type_label="DDR"
        case "$mtype" in
            DDR2|DDR3|DDR4|DDR5) type_label="$mtype" ;;
            DDR) : ;;
        esac
        local speed_txt=""
        [[ -n "$mspeed" ]] && speed_txt="-${mspeed}"

        local form_label=""
        [[ -n "$mform" && "$mform" != "DIMM" ]] && form_label=" (${mform})"

        # Resolve JEDEC vendor code if present (e.g. "8313" -> Golden Empire)
        if [[ "$mmanuf" =~ ^[0-9A-Fa-f]{4}$ ]]; then
            local dec
            dec=$(wu_jedec_decode "$mmanuf") || dec=""
            [[ -n "$dec" ]] && mmanuf="$dec"
        fi

        ram_line="${modules}× ${per_gb} GiB ${type_label}${speed_txt}${form_label}"

        local sub_parts=()
        [[ -n "$mmanuf" ]] && sub_parts+=("$mmanuf")
        [[ -n "$mpn" ]]  && sub_parts+=("$(t hw_pn): ${mpn}")
        if ((${#sub_parts[@]})); then
            printf -v ram_sub "%s | " "${sub_parts[@]}"
            ram_sub="${ram_sub% | }"
        fi
    fi

    # If dmidecode gave nothing, fall back to decode-dimms SPD JSON-less output
    if [[ -z "$ram_line" ]] && command -v decode-dimms &>/dev/null; then
        local dout dcount dsize_mb dper dmanu dpart dform
        dout=$(root_run decode-dimms 2>/dev/null) || dout=""
        dcount=$(awk '/^Decoding EEPROM/{c++} END{print c+0}' <<< "$dout")
        if (( dcount > 0 )); then
            dmanu=$(awk '/^Module Manufacturer/{sub(/^Module Manufacturer[ \t]+/, ""); print; exit}' <<< "$dout")
            dpart=$(awk '/^Part Number/{sub(/^Part Number[ \t]+/, ""); print; exit}' <<< "$dout")
            dform=$(awk '/^Module Type/{sub(/^Module Type[ \t]+/, ""); print; exit}' <<< "$dout")   # e.g. UDIMM
            dsize_mb=$(awk '/^Size/{sub(/^Size[ \t]+/, ""); sub(/ MB.*/,""); print; exit}' <<< "$dout")
            dper=""
            [[ "$dsize_mb" =~ ^[0-9]+$ ]] && dper=$(( (dsize_mb + 512) / 1024 ))
            ram_line="${dcount}× ${dper:+${dper} GiB }${dform:-UDIMM} ${dmanu}"
            [[ -n "$dpart" ]] && ram_sub="$(t hw_pn): ${dpart}"
        fi
    fi

    if [[ -n "$ram_line" ]]; then
        pline_hw "$(_emu '🧩')" "$(t hw_ram)" "$ram_line"
        [[ -n "$ram_sub" ]] && pline_sub "$ram_sub"
    else
        pline_hw "$(_emu '🧩')" "$(t hw_ram)" "${DIM}$(t hw_ram_none)${RESET}"
    fi
}

print_storage() {
    local rows
    rows=$(lsblk -nd -o NAME,MODEL,SIZE 2>/dev/null | grep -vE '^(loop|zram|sr)' || true)
    if [[ -n "$rows" ]]; then
        local n=0 dev model size
        while IFS= read -r row; do
            dev=$(awk '{print $1}' <<< "$row")
            size=$(awk '{print $NF}' <<< "$row")
            model=$(awk '{$1=""; $NF=""; gsub(/^ +| +$/, ""); print}' <<< "$row")
            [[ -z "$model" ]] && model="$(t hw_unknown)"
            if (( n == 0 )); then
                pline_hw "$(_emu '💿')" "$(t hw_storage)" "${dev}: ${model} ${DIM}(${size})${RESET}"
            else
                pline_sub "${dev}: ${model} ${DIM}(${size})${RESET}"
            fi
            n=$((n + 1))
        done <<< "$rows"
    else
        pline_hw "$(_emu '💿')" "$(t hw_storage)" "${DIM}$(t hw_unknown)${RESET}"
    fi
}

print_network() {
    local found=0
    while IFS= read -r l; do
        [[ -n "$l" ]] || continue
        if (( found == 0 )); then
            pline_hw "$(_emu '🌐')" "$(t hw_network)" "$l"
        else
            pline_sub "$l"
        fi
        found=$((found + 1))
    done < <(ls /sys/class/net/ 2>/dev/null | grep -vE '^(lo|virbr|docker|br-|veth)' | \
        while IFS= read -r dev; do
            local op
            op=$(cat "/sys/class/net/$dev/operstate" 2>/dev/null || echo "down")
            local addr
            addr=$(cat "/sys/class/net/$dev/address" 2>/dev/null || echo "")
            printf '%s %s %s\n' "$dev" "$op" "${addr}"
        done)
    if (( found == 0 )); then
        pline_hw "$(_emu '🌐')" "$(t hw_network)" "${DIM}$(t hw_unknown)${RESET}"
    fi
}

print_battery() {
    local cap stat
    local bat
    for bat in /sys/class/power_supply/BAT* /sys/class/power_supply/bat*; do
        [[ -d "$bat" ]] || continue
        cap=$(cat "$bat/capacity" 2>/dev/null || true)
        stat=$(cat "$bat/status" 2>/dev/null || true)
        if [[ -n "$cap" ]]; then
            pline_hw "$(_emu '🔋')" "$(t hw_battery)" "${W}${cap}%%${RESET} ${DIM}(${stat})${RESET}"
            return
        fi
    done
}

print_cooling() {
    local found=0
    for f in /sys/devices/platform/*/fan*_input /sys/class/hwmon/hwmon*/fan*_input; do
        [[ -r "$f" ]] || continue
        local rpm
        rpm=$(cat "$f" 2>/dev/null || echo 0)
        (( rpm > 0 )) || continue
        local chip idx label
        chip=$(basename "$(dirname "$f")")
        idx=$(basename "$f" | sed 's/fan\([0-9]*\)_input/\1/')
        [[ "$idx" =~ ^[0-9]+$ ]] || continue
        # label sits next to the fanN_input file we already found (no hwmon0 hardcode)
        label=$(cat "$(dirname "$f")/fan${idx}_label" 2>/dev/null || echo "$(t hw_cooling) ${idx}")
        if (( found == 0 )); then
            pline_hw "$(_emu '🌀')" "$(t hw_cooling)" "${label} ${W}${rpm}${RESET} ${DIM}RPM (${chip})${RESET}"
        else
            pline_sub "${label} ${W}${rpm}${RESET} ${DIM}RPM (${chip})${RESET}"
        fi
        found=$((found + 1))
    done
    if (( found == 0 )); then
        pline_hw "$(_emu '🌀')" "$(t hw_cooling)" "${DIM}$(t hw_unknown)${RESET}"
    fi
}

# ─── JSON output ────────────────────────────────────────────────
json_out() {
    local model cores threads
    model=$(awk -F': *' '/^model name/{print $2; exit}' /proc/cpuinfo)
    cores=$(awk '/^cpu cores/{print $4; exit}' /proc/cpuinfo)
    threads=$(awk '/^processor/{c++} END{print c+0}' /proc/cpuinfo)

    local gpu=""
    gpu=$(lspci 2>/dev/null | grep -iE 'vga compatible|3d controller' | sed -E 's/^[0-9a-f:.]+ [^:]+: //' | head -1) || gpu=""

    local b_vendor="" b_name="" b_version="" bv="" bver="" bdate=""
    b_vendor=$(cat /sys/class/dmi/id/board_vendor 2>/dev/null || true)
    b_name=$(cat /sys/class/dmi/id/board_name 2>/dev/null || true)
    b_version=$(cat /sys/class/dmi/id/board_version 2>/dev/null || true)
    bv=$(cat /sys/class/dmi/id/bios_vendor 2>/dev/null || true)
    bver=$(cat /sys/class/dmi/id/bios_version 2>/dev/null || true)
    bdate=$(cat /sys/class/dmi/id/bios_date 2>/dev/null || true)

    local mout="" modules=0 msize_mb=0 mtype="" mspeed="" mmanuf="" mpn="" mform=""
    mout=$(root_run dmidecode -t memory 2>/dev/null) || mout=""
    if [[ -n "$mout" ]]; then
        modules=$(awk '/^[[:space:]]*Size: [0-9]+ /{c++} END{print c+0}' <<< "$mout")
        msize_mb=$(awk '/^[[:space:]]*Size: [0-9]+ (MiB|GiB)/{if($3=="GiB") s+=$2*1024; else s+=$2} END{print s+0}' <<< "$mout")
        mtype=$(awk '/^[[:space:]]*Type: (DDR|LPDDR)/{print $2; exit}' <<< "$mout")
        mspeed=$(awk '/^[[:space:]]*Speed: [0-9]+ MT\/s/{print $2; exit}' <<< "$mout")
        mmanuf=$(awk '/^[[:space:]]*Manufacturer:/{sub(/^[[:space:]]*Manufacturer:[[:space:]]*/,""); gsub(/\r/,""); sub(/[[:space:]]+$/,""); print; exit}' <<< "$mout")
        mpn=$(awk '/^[[:space:]]*Part Number:/{sub(/^[[:space:]]*Part Number:[[:space:]]*/,""); gsub(/\r/,""); sub(/[[:space:]]+$/,""); print; exit}' <<< "$mout")
        mform=$(awk '/^[[:space:]]*Form Factor:/{sub(/^[[:space:]]*Form Factor:[[:space:]]*/,""); gsub(/\r/,""); sub(/[[:space:]]+$/,""); print; exit}' <<< "$mout")
    fi
    if [[ -z "$mout" ]] && command -v decode-dimms &>/dev/null; then
        local dout
        dout=$(root_run decode-dimms 2>/dev/null) || dout=""
        if [[ -n "$dout" ]]; then
            modules=$(awk '/^Decoding EEPROM/{c++} END{print c+0}' <<< "$dout")
            msize_mb=$(awk '/^Size/{sub(/^Size[ \t]+/, ""); sub(/ MB.*/,""); s+=$1} END{print s+0}' <<< "$dout")
            mtype=$(awk '/^Memory Type/{sub(/^Memory Type[ \t]+/, ""); gsub(/[ \t]+.*/,""); print; exit}' <<< "$dout")
            mspeed=$(awk '/^Speed/{sub(/^Speed[ \t]+/, ""); print $1; exit}' <<< "$dout")
            mmanuf=$(awk '/^Module Manufacturer/{sub(/^Module Manufacturer[ \t]+/, ""); print; exit}' <<< "$dout")
            mpn=$(awk '/^Part Number/{sub(/^Part Number[ \t]+/, ""); print; exit}' <<< "$dout")
            mform=$(awk '/^Module Type/{sub(/^Module Type[ \t]+/, ""); print; exit}' <<< "$dout")
        fi
    fi
    if [[ "$mmanuf" =~ ^[0-9A-Fa-f]{4}$ ]]; then
        local mdec
        mdec=$(wu_jedec_decode "$mmanuf") || mdec=""
        [[ -n "$mdec" ]] && mmanuf="$mdec"
    fi

    wu_json_head "$_WU_TOOLNAME" "$_WU_VERSION"
    printf ',\n  "cpu": { "model": "%s", "cores": "%s", "threads": "%s" },\n' \
        "$(json_esc "$model")" "$(json_esc "$cores")" "$(json_esc "$threads")"
    printf '  "gpu": { "name": "%s" },\n' "$(json_esc "$gpu")"
    printf '  "board": {\n'
    printf '    "vendor": "%s",\n' "$(json_esc "$b_vendor")"
    printf '    "name": "%s",\n' "$(json_esc "$b_name")"
    printf '    "version": "%s",\n' "$(json_esc "$b_version")"
    printf '    "bios": { "vendor": "%s", "version": "%s", "date": "%s" }\n' \
        "$(json_esc "$bv")" "$(json_esc "$bver")" "$(json_esc "$bdate")"
    printf '  },\n'
    printf '  "memory": {\n'
    printf '    "modules": %d,\n' "$modules"
    printf '    "size_mb": %d,\n' "$msize_mb"
    printf '    "type": "%s",\n' "$(json_esc "$mtype")"
    printf '    "speed_mts": "%s",\n' "$(json_esc "$mspeed")"
    printf '    "manufacturer": "%s",\n' "$(json_esc "$mmanuf")"
    printf '    "part_number": "%s",\n' "$(json_esc "$mpn")"
    printf '    "form_factor": "%s"\n' "$(json_esc "$mform")"
    printf '  },\n'

    printf '  "storage": [\n'
    local first=1 row dev smodel size
    while IFS= read -r row; do
        dev=$(awk '{print $1}' <<< "$row")
        size=$(awk '{print $NF}' <<< "$row")
        smodel=$(awk '{$1=""; $NF=""; gsub(/^ +| +$/, ""); print}' <<< "$row")
        (( first )) && first=0 || printf ',\n'
        printf '    { "name": "%s", "model": "%s", "size": "%s" }' \
            "$(json_esc "$dev")" "$(json_esc "$smodel")" "$(json_esc "$size")"
    done < <(lsblk -nd -o NAME,MODEL,SIZE 2>/dev/null | grep -vE '^(loop|zram|sr)' || true)
    printf '\n  ],\n'

    printf '  "network": [\n'
    first=1
    while IFS= read -r dev; do
        local op mac
        op=$(cat "/sys/class/net/$dev/operstate" 2>/dev/null || echo "down")
        mac=$(cat "/sys/class/net/$dev/address" 2>/dev/null || echo "")
        (( first )) && first=0 || printf ',\n'
        printf '    { "name": "%s", "operstate": "%s", "mac": "%s" }' \
            "$(json_esc "$dev")" "$(json_esc "$op")" "$(json_esc "$mac")"
    done < <(ls /sys/class/net/ 2>/dev/null | grep -vE '^(lo|virbr|docker|br-|veth)')
    printf '\n  ],\n'

    local cap="" stat=""
    for bat in /sys/class/power_supply/BAT* /sys/class/power_supply/bat*; do
        [[ -d "$bat" ]] || continue
        cap=$(cat "$bat/capacity" 2>/dev/null || true)
        stat=$(cat "$bat/status" 2>/dev/null || true)
        [[ -n "$cap" ]] && break
    done
    printf '  "battery": { "capacity": "%s", "status": "%s" },\n' "$(json_esc "$cap")" "$(json_esc "$stat")"

    printf '  "cooling": [\n'
    first=1
    local f rpm idx chip label
    for f in /sys/devices/platform/*/fan*_input /sys/class/hwmon/hwmon*/fan*_input; do
        [[ -r "$f" ]] || continue
        rpm=$(cat "$f" 2>/dev/null || echo 0)
        (( rpm > 0 )) || continue
        chip=$(basename "$(dirname "$f")")
        idx=$(basename "$f" | sed 's/fan\([0-9]*\)_input/\1/')
        [[ "$idx" =~ ^[0-9]+$ ]] || continue
        label=$(cat "$(dirname "$f")/fan${idx}_label" 2>/dev/null || echo "fan ${idx}")
        (( first )) && first=0 || printf ',\n'
        printf '    { "chip": "%s", "label": "%s", "rpm": %d }' \
            "$(json_esc "$chip")" "$(json_esc "$label")" "$rpm"
    done
    printf '\n  ],\n'

    local n_storage n_net
    n_storage=$(lsblk -nd -o NAME 2>/dev/null | grep -cvE '^(loop|zram|sr)' || echo 0)
    n_net=$(ls /sys/class/net/ 2>/dev/null | grep -cvE '^(lo|virbr|docker|br-|veth)' || echo 0)
    printf '  "summary": { "cpu": "%s", "gpu": "%s", "ram_modules": %d, "ram_size_mb": %d, "storage_devices": %d, "network_interfaces": %d }\n' \
        "$(json_esc "$model")" "$(json_esc "$gpu")" "$modules" "$msize_mb" "$n_storage" "$n_net"
    wu_json_end
}

# ─── Main ────────────────────────────────────────────────────────
main() {
    if [[ "$_WU_JSON" == "1" ]]; then json_out; return 0; fi

    box_header "$(_emu '🖥')" "wellhw" "$(t hw_title)"

    box "$(_emu '🧠')" "$(t hw_cpu)" print_cpu
    box "$(_emu '🎮')" "$(t hw_gpu)" print_gpu
    box "$(_emu '🖥️')" "$(t hw_board)" print_board
    box "$(_emu '🧩')" "$(t hw_ram)" print_ram
    box "$(_emu '💿')" "$(t hw_storage)" print_storage
    box "$(_emu '🌐')" "$(t hw_network)" print_network
    box "$(_emu '🌀')" "$(t hw_cooling)" print_cooling

    print_battery

    printf '\n  %sWellHW v1.3 | %s%s\n\n' "$DIM" "$(date '+%Y-%m-%d %H:%M:%S')" "$RESET"
}

wu_run main "$@"