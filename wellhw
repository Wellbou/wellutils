#!/usr/bin/env bash
# wellhw -- Beautiful hardware report (chat-ready)
# Part of wellutils by wellbou_
set -euo pipefail

# ─── Shared libs ────────────────────────────────────────────────
_WU_TOOLNAME="wellhw" _WU_NAME="WellHW" _WU_VERSION="1.3"
_WU_TAGLINE="Beautiful hardware report (chat-ready)"
_WU_BOOT_DIR="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="$(dirname -- "$_WU_BOOT_DIR")/share/wellutils"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="/usr/local/share/wellutils"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="/usr/share/wellutils"
source "$_WU_BOOT_DIR/bootstrap.sh" lang box cli

# ─── Snapshot / diff ─────────────────────────────────────────────
_HW_SNAPSHOT=0 _HW_DIFF=0 _HW_SNAP_FILE=""
_HW_DEFAULT_SNAP="${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}/wellutils/hardware-snapshot.json"

hw_extra_parse() {
    case "$1" in
        --snapshot)
            _HW_SNAPSHOT=1
            if [[ $# -ge 2 && "$2" != -* ]]; then _HW_SNAP_FILE="$2"; _WU_EXTRA_CONSUMED=2
            else _HW_SNAP_FILE="$_HW_DEFAULT_SNAP"; _WU_EXTRA_CONSUMED=1; fi
            return 0 ;;
        --diff)
            _HW_DIFF=1
            if [[ $# -ge 2 && "$2" != -* ]]; then _HW_SNAP_FILE="$2"; _WU_EXTRA_CONSUMED=2
            else _HW_SNAP_FILE="$_HW_DEFAULT_SNAP"; _WU_EXTRA_CONSUMED=1; fi
            return 0 ;;
    esac
    return 1
}
_WU_EXTRA_PARSE=hw_extra_parse
_WU_EXTRA_HELP="      --snapshot [FILE]       save stable hardware identity to FILE
      --diff [FILE]           compare current hardware against a snapshot
                                (FILE defaults to $_HW_DEFAULT_SNAP)"

# Stable-identity projection of --json (volatile fields dropped).
_hw_filter_py() {
PYTHONIOENCODING=utf-8 python3 -c '
import json,sys
d=json.load(sys.stdin)
out={}
if "cpu" in d: out["cpu"]={k:d["cpu"].get(k) for k in ("model","cores","threads")}
if "gpu" in d and isinstance(d["gpu"],dict): out["gpu"]={"name":d["gpu"].get("name")}
b=d.get("board",{})
nb={}
for k in ("vendor","name","version"):
    if isinstance(b,dict) and b.get(k): nb[k]=b[k]
bi=b.get("bios") if isinstance(b,dict) else None
if isinstance(bi,dict):
    nb["bios"]={k:bi.get(k) for k in ("vendor","version","date")}
if nb: out["board"]=nb
m=d.get("memory",{})
if isinstance(m,dict):
    out["memory"]={"modules":m.get("modules"),"size_mb":m.get("size_mb"),
        "slots":[{"locator":s.get("locator"),"size":s.get("size"),"type":s.get("type"),
                  "speed_mts":s.get("speed_mts")} for s in m.get("slots",[])]}
st=d.get("storage",[])
out["storage"]=sorted([{"name":x.get("name"),"model":x.get("model"),"size":x.get("size")} for x in st],
                      key=lambda x:str(x.get("name")))
nt=d.get("network",[])
out["network"]=sorted([{"name":x.get("name"),"mac":x.get("mac")} for x in nt],
                      key=lambda x:str(x.get("name")))
print(json.dumps(out,ensure_ascii=False,sort_keys=True))
'
}

_hw_diff_py() {
    WELLUTILS_LANG="${WELLUTILS_LANG:-EN}" PYTHONIOENCODING=utf-8 python3 -c '
import json,sys,os
ru=os.environ.get("WELLUTILS_LANG")=="RU"
def L(ru_s,en_s): return ru_s if ru else en_s
lines=[l for l in sys.stdin.read().splitlines() if l.strip()]
if len(lines)<2: sys.exit(3)
old,new=json.loads(lines[0]),json.loads(lines[1])
def flat(o,p=""):
    r={}
    if isinstance(o,dict):
        for k,v in o.items(): r.update(flat(v,f"{p}.{k}" if p else k))
    elif isinstance(o,list):
        for i,v in enumerate(o): r.update(flat(v,f"{p}[{i}]"))
    else: r[p]=o
    return r
fo,fn_=flat(old),flat(new)
changes=[]
for k in sorted(set(fo)|set(fn_)):
    a,b=fo.get(k,"\u2205"),fn_.get(k,"\u2205")
    if a!=b:
        changes.append(L("~ ","~ ")+f"{k}: {a} -> {b}")
if not changes:
    print(L("Нет изменений железа.","No hardware changes."))
else:
    print(L(f"Изменений: {len(changes)}",f"Changes: {len(changes)}"))
    for c in changes: print(" "+c)
    sys.exit(2)
'
}

do_snapshot() {
    local f="$_HW_SNAP_FILE"
    local dir; dir=$(dirname "$f")
    mkdir -p "$dir" 2>/dev/null || true
    json_out | _hw_filter_py > "$f" || { printf 'wellhw: snapshot failed\n' >&2; return 3; }
    printf '%s %s\n' "$(t hw_snap_saved):" "$f"
}

do_diff() {
    local f="$_HW_SNAP_FILE" tmp_old tmp_new rc=0 changed=1
    [[ -r "$f" ]] || { printf 'wellhw: %s %s\n' "$(t hw_snap_missing):" "$f" >&2; return 3; }
    tmp_old=$(mktemp) tmp_new=$(mktemp)
    cp "$f" "$tmp_old"
    if ! json_out | _hw_filter_py > "$tmp_new"; then
        rm -f "$tmp_old" "$tmp_new"; return 3
    fi
    # The semantic differ decides: exit 2 = changes found, 0 = identical.
    local drc=0
    { cat "$tmp_old"; echo; cat "$tmp_new"; } | _hw_diff_py || drc=$?
    if (( drc == 2 )); then changed=1
    elif (( drc == 0 )); then changed=0
    else rc=3; fi
    rm -f "$tmp_old" "$tmp_new"
    (( rc )) && return "$rc"
    return "$changed"
}

# ─── Rare-hardware guards (Termux/PS5/ARM/laptops may lack tools) ──
command -v awk    >/dev/null 2>&1 || awk()    { :; }
command -v free   >/dev/null 2>&1 || free()   { printf 'Mem: 0 0 0 0 0 0\n'; }
command -v df     >/dev/null 2>&1 || df()     { :; }
command -v uptime >/dev/null 2>&1 || uptime() { :; }
command -v nproc  >/dev/null 2>&1 || nproc()  { getconf _NPROCESSORS_ONLN 2>/dev/null || printf '1'; }
command -v date   >/dev/null 2>&1 || date()   { printf '%s' '1970-01-01 00:00:00'; }
# JEDEC JEP106 RAM vendor codes (loaded after guards since it's optional)
_WU_JEDEC="$_WU_BOOT_DIR/jedec.sh"
[[ -f "$_WU_JEDEC" ]] || _WU_JEDEC="/usr/share/wellutils/jedec.sh"
[[ -f "$_WU_JEDEC" ]] && source "$_WU_JEDEC"


# ─── Helpers ────────────────────────────────────────────────────
root_run() {
    if (( EUID == 0 )); then "$@"
    elif sudo -n true 2>/dev/null; then sudo -n "$@"
    else "$@"; fi
}

# ─── Sections ───────────────────────────────────────────────────
print_cpu() {
    local model cores threads
    model=$(awk -F': *' '/^model name/{print $2; exit}' /proc/cpuinfo)
    [[ -z "$model" ]] && model=$(awk -F': *' '/^Processor/{print $2; exit}' /proc/cpuinfo)
    [[ -z "$model" ]] && model=$(awk '/^Hardware/{sub(/^[^:]*:[[:space:]]*/,""); sub(/[[:space:]]*$/,""); print; exit}' /proc/cpuinfo)
    cores=$(awk '/^cpu cores/{print $4; exit}' /proc/cpuinfo)
    threads=$(awk '/^processor/{c++} END{print c+0}' /proc/cpuinfo)
    pline_hw "$(_emu '🧠')" "$(t hw_cpu)" "${model}  ${DIM}($(t hw_cores): ${cores}, $(t hw_threads): ${threads})${RESET}"
}

hw_gpu_name() {
    local line bus vendor device aib
    line=$(lspci -mmnn 2>/dev/null | grep -iE '"VGA compatible controller|"3D controller' | head -1)
    [[ -n "$line" ]] || return 0
    set -- $line
    bus=$1
    vendor=$(printf '%s' "$line" | awk -F'"' '{print $4}')
    device=$(printf '%s' "$line" | awk -F'"' '{print $6}')
    [[ -z "$device" ]] && device="$vendor" && vendor=""
    aib=$(gpu_aib_vendor "$bus")
    printf '%s%s%s' "${aib:+$aib }" "$device" "${vendor:+|$vendor}"
}

print_gpu() {
    local gpu vendor
    gpu=$(hw_gpu_name)
    vendor="${gpu##*|}"
    [[ "$vendor" == "$gpu" ]] && vendor=""
    gpu="${gpu%|*}"
    if [[ -n "$gpu" ]]; then
        pline_hw "$(_emu '🎮')" "$(t hw_gpu)" "${gpu}${vendor:+  ${DIM}(${vendor})${RESET}}"
    else
        pline_hw "$(_emu '🎮')" "$(t hw_gpu)" "${DIM}$(t hw_unknown)${RESET}"
    fi
}

print_board() {
    local vendor name version bios
    vendor=$(cat /sys/class/dmi/id/board_vendor 2>/dev/null || true)
    name=$(cat /sys/class/dmi/id/board_name 2>/dev/null || true)
    version=$(cat /sys/class/dmi/id/board_version 2>/dev/null || true)
    bios=$(cat /sys/class/dmi/id/bios_vendor 2>/dev/null || true)
    local bver bdate
    bver=$(cat /sys/class/dmi/id/bios_version 2>/dev/null || true)
    bdate=$(cat /sys/class/dmi/id/bios_date 2>/dev/null || true)
    bios="$bios $bver"
    [[ -n "$bdate" ]] && bios="$bios ($bdate)"
    bios="${bios//  / }"
    [[ -z "${bios// /}" ]] && bios=""

    local board="$vendor $name"
    [[ -n "$version" ]] && board="$board (v$version)"
    board="${board//  / }"

    pline_hw "$(_emu '🖥')" "$(t hw_board)" "${board:-$(t hw_unknown)}"
    pline_hw "$(_emu '💾')" "$(t hw_bios)" "${bios:-$(t hw_unknown)}"
}

print_ram() {
    local mout="$_WU_DMIDECODE"
    local _HT=$'\t'

    local -a slot_size=() slot_type=() slot_speed=() slot_manuf=() slot_pn=() slot_form=() slot_locator=()
    local in_slot=0 s_size="" s_type="" s_speed="" s_manuf="" s_pn="" s_form="" s_loc="" s_empty=0

    flush_slot() {
        [[ $in_slot -eq 1 ]] || return 0
        if [[ "$s_empty" -eq 0 && "$s_size" != *No* ]]; then
            slot_size+=("$s_size"); slot_type+=("$s_type"); slot_speed+=("$s_speed")
            slot_manuf+=("$s_manuf"); slot_pn+=("$s_pn"); slot_form+=("$s_form")
            slot_locator+=("$s_loc")
        fi
        in_slot=0; s_size=""; s_type=""; s_speed=""; s_manuf=""; s_pn=""; s_form=""; s_loc=""; s_empty=0
    }

    if [[ -n "$mout" ]]; then
        while IFS= read -r line; do
            case "$line" in
                *[Mm]emory\ [Dd]evice*) flush_slot; in_slot=1 ;;
                *Size:\ *)              s_size="${line#*: }"; s_size="${s_size%%$_HT*}"
                    s_size="$(printf '%s' "$s_size" | awk '{$1=$1}1')"
                    [[ "$s_size" == *No* ]] && s_empty=1 ;;
                *Type:\ *)              s_type="${line#*: }"; s_type="${s_type%%$_HT*}"
                    s_type="$(printf '%s' "$s_type" | awk '{$1=$1}1')" ;;
                *Speed:\ *MT/*)         s_speed="$(printf '%s' "$line" | awk '{for(i=1;i<=NF;i++) if($i+0==$i && $(i+1)~/MT/) {print $i; exit}}')" ;;
                *Manufacturer:\ *)     s_manuf="${line#*: }"; s_manuf="${s_manuf%%$_HT*}"
                    s_manuf="$(printf '%s' "$s_manuf" | awk '{$1=$1}1' | tr -d '\r')" ;;
                *Part\ Number:\ *)     s_pn="${line#*: }"; s_pn="${s_pn%%$_HT*}"
                    s_pn="$(printf '%s' "$s_pn" | awk '{$1=$1}1' | tr -d '\r')" ;;
                *Form\ Factor:\ *)     s_form="${line#*: }"; s_form="${s_form%%$_HT*}"
                    s_form="$(printf '%s' "$s_form" | awk '{$1=$1}1' | tr -d '\r')" ;;
                *Bank\ Locator:\ *)    : ;;  # skip — handled separately if needed
                *Locator:\ *)          s_loc="${line#*: }"; s_loc="${s_loc%%$_HT*}"
                    s_loc="$(printf '%s' "$s_loc" | awk '{$1=$1}1' | tr -d '\r')" ;;
            esac
        done <<< "$mout"
        flush_slot
    fi

    local modules=${#slot_size[@]}

    if (( modules == 0 )) && command -v decode-dimms &>/dev/null; then
        local dout dcount
        dout=$(root_run decode-dimms 2>/dev/null) || dout=""
        dcount=$(awk '/^Decoding EEPROM/{c++} END{print c+0}' <<< "$dout")
        if (( dcount > 0 )); then
            local -a dd_size=() dd_manu=() dd_pn=() dd_form=() dd_type=() dd_speed=()
            local _s="" _m="" _p="" _f="" _t="" _sp=""
            while IFS= read -r line; do
                case "$line" in
                    Decoding\ EEPROM*)
                        [[ -n "$_s" ]] && { dd_size+=("$_s"); dd_manu+=("$_m"); dd_pn+=("$_p"); dd_form+=("$_f"); dd_type+=("$_t"); dd_speed+=("$_sp"); }
                        _s=""; _m=""; _p=""; _f=""; _t=""; _sp="" ;;
                    Size*)                   _s="${line##*Size}"; _s="$(printf '%s' "$_s" | awk '{for(i=1;i<=NF;i++) if($i+0==$i){print $i; exit}}')" ;;
                    Module\ Manufacturer*)  _m="${line##*Module Manufacturer}"; _m="$(printf '%s' "$_m" | awk '{$1=$1}1' | tr -d '\r')" ;;
                    Part\ Number*)           _p="${line##*Part Number}"; _p="$(printf '%s' "$_p" | awk '{$1=$1}1' | tr -d '\r')" ;;
                    Module\ Type*)           _f="${line##*Module Type}"; _f="$(printf '%s' "$_f" | awk '{$1=$1}1' | tr -d '\r')" ;;
                    Memory\ Type*)           _t="${line##*Memory Type}"; _t="$(printf '%s' "$_t" | awk '{$1=$1}1' | tr -d '\r')" ;;
                    Speed*)                   _sp="${line##*Speed}"; _sp="$(printf '%s' "$_sp" | awk '{for(i=1;i<=NF;i++) if($i+0==$i) {print $i; exit}}')" ;;
                esac
            done <<< "$dout"
            [[ -n "$_s" ]] && { dd_size+=("$_s"); dd_manu+=("$_m"); dd_pn+=("$_p"); dd_form+=("$_f"); dd_type+=("$_t"); dd_speed+=("$_sp"); }
            modules=${#dd_size[@]}
            local i
            for (( i=0; i<modules; i++ )); do
                local mb="${dd_size[$i]:-0}"
                [[ "$mb" =~ ^[0-9]+$ ]] || mb=0
                if (( mb >= 1024 )); then
                    slot_size+=("$(( mb / 1024 )) GiB")
                else
                    slot_size+=("${mb} MiB")
                fi; slot_type+=("${dd_type[$i]:-DDR}"); slot_speed+=("${dd_speed[$i]:-}")
                slot_manuf+=("${dd_manu[$i]:-}"); slot_pn+=("${dd_pn[$i]:-}"); slot_form+=("${dd_form[$i]:-UDIMM}")
                slot_locator+=("DIMM $(( i + 1 ))")
            done
            modules=${#slot_size[@]}
        fi
    fi

    if (( modules == 0 )); then
        pline_hw "$(_emu '🧩')" "$(t hw_ram)" "${DIM}$(t hw_ram_none)${RESET}"
        return
    fi

    local i
    for (( i=0; i<modules; i++ )); do
        if [[ "${slot_manuf[$i]}" =~ ^[0-9A-Fa-f]{4}$ ]] && declare -F wu_jedec_decode &>/dev/null; then
            local dec
            dec=$(wu_jedec_decode "${slot_manuf[$i]}") || dec=""
            [[ -n "$dec" ]] && slot_manuf[$i]="$dec"
        fi
    done

    local uniform=1 first_t="${slot_type[0]}" first_s="${slot_speed[0]}" first_sz="${slot_size[0]}"
    for (( i=1; i<modules; i++ )); do
        [[ "${slot_type[$i]}" == "$first_t" && "${slot_speed[$i]}" == "$first_s" && "${slot_size[$i]}" == "$first_sz" ]] || { uniform=0; break; }
    done

    local ram_line ram_sub=""
    if (( uniform )); then
        local type_label="DDR"
        case "$first_t" in
            DDR2|DDR3|DDR4|DDR5) type_label="$first_t" ;;
        esac
        local speed_txt=""
        [[ -n "$first_s" ]] && speed_txt="-$first_s"
        ram_line="${modules}× ${first_sz} ${type_label}${speed_txt}"
        local sub_parts=()
        [[ -n "${slot_manuf[0]}" ]] && sub_parts+=("${slot_manuf[0]}")
        [[ -n "${slot_pn[0]}" ]]   && sub_parts+=("$(t hw_pn): ${slot_pn[0]}")
            if ((${#sub_parts[@]})); then
            ram_sub=""
            local _sp_i
            for (( _sp_i=0; _sp_i<${#sub_parts[@]}; _sp_i++ )); do
                ram_sub+="${sub_parts[$_sp_i]}"
                (( _sp_i < ${#sub_parts[@]} - 1 )) && ram_sub+=" | "
            done
        fi
    else
        ram_line="${modules} slots"
        pline_hw "$(_emu '🧩')" "$(t hw_ram)" "$ram_line"
        for (( i=0; i<modules; i++ )); do
            local t2="DDR"
            case "${slot_type[$i]}" in
                DDR2|DDR3|DDR4|DDR5) t2="${slot_type[$i]}" ;;
            esac
            local sp2=""
            [[ -n "${slot_speed[$i]}" ]] && sp2="-${slot_speed[$i]}"
            local detail="  ${slot_locator[$i]:-DIMM $(( i + 1 ))}: ${slot_size[$i]} ${t2}${sp2}"
            local extra=""
            [[ -n "${slot_manuf[$i]}" ]] && extra+="${slot_manuf[$i]} "
            [[ -n "${slot_pn[$i]}" ]]   && extra+="${slot_pn[$i]}"
            [[ -n "$extra" ]] && detail+=" ${DIM}(${extra})${RESET}"
            pline_sub "$detail"
        done
        return
    fi

    pline_hw "$(_emu '🧩')" "$(t hw_ram)" "$ram_line"
    [[ -n "$ram_sub" ]] && pline_sub "$ram_sub" || true
}

print_storage() {
    local rows
    rows=$(lsblk -nd -o NAME,MODEL,SIZE 2>/dev/null | grep -vE '^(loop|zram|sr)' || true)
    if [[ -n "$rows" ]]; then
        local n=0 dev model size
        while IFS= read -r row; do
            dev=$(awk '{print $1}' <<< "$row")
            size=$(awk '{print $NF}' <<< "$row")
            model=$(awk '{$1=""; $NF=""; gsub(/^ +| +$/, ""); print}' <<< "$row")
            [[ -z "$model" ]] && model="$(t hw_unknown)"
            if (( n == 0 )); then
                pline_hw "$(_emu '💿')" "$(t hw_storage)" "${dev}: ${model} ${DIM}(${size})${RESET}"
            else
                pline_sub "${dev}: ${model} ${DIM}(${size})${RESET}"
            fi
            n=$((n + 1))
        done <<< "$rows"
    else
        pline_hw "$(_emu '💿')" "$(t hw_storage)" "${DIM}$(t hw_unknown)${RESET}"
    fi
}

print_network() {
    local found=0
    while IFS= read -r l; do
        [[ -n "$l" ]] || continue
        if (( found == 0 )); then
            pline_hw "$(_emu '🌐')" "$(t hw_network)" "$l"
        else
            pline_sub "$l"
        fi
        found=$((found + 1))
    done < <(ls /sys/class/net/ 2>/dev/null | grep -vE '^(lo|virbr|docker|br-|veth)' | \
        while IFS= read -r dev; do
            local op
            op=$(cat "/sys/class/net/$dev/operstate" 2>/dev/null || echo "down")
            local addr
            addr=$(cat "/sys/class/net/$dev/address" 2>/dev/null || echo "")
            printf '%s %s %s\n' "$dev" "$op" "${addr}"
        done)
    if (( found == 0 )); then
        pline_hw "$(_emu '🌐')" "$(t hw_network)" "${DIM}$(t hw_unknown)${RESET}"
    fi
}

print_battery() {
    local cap stat
    local bat
    for bat in /sys/class/power_supply/BAT* /sys/class/power_supply/bat*; do
        [[ -d "$bat" ]] || continue
        cap=$(cat "$bat/capacity" 2>/dev/null || true)
        stat=$(cat "$bat/status" 2>/dev/null || true)
        if [[ -n "$cap" ]]; then
            pline_hw "$(_emu '🔋')" "$(t hw_battery)" "${W}${cap}%${RESET} ${DIM}(${stat})${RESET}"
        fi
    done
}

print_cooling() {
    local found=0
    for f in /sys/devices/platform/*/fan*_input /sys/class/hwmon/hwmon*/fan*_input; do
        [[ -r "$f" ]] || continue
        local rpm
        rpm=$(cat "$f" 2>/dev/null || echo 0)
        (( rpm > 0 )) || continue
        local chip idx label
        chip=$(basename "$(dirname "$f")")
        idx=$(basename "$f" | sed 's/fan\([0-9]*\)_input/\1/')
        [[ "$idx" =~ ^[0-9]+$ ]] || continue
        # label sits next to the fanN_input file we already found (no hwmon0 hardcode)
        label=$(cat "$(dirname "$f")/fan${idx}_label" 2>/dev/null || echo "$(t hw_cooling) ${idx}")
        if (( found == 0 )); then
            pline_hw "$(_emu '🌀')" "$(t hw_cooling)" "${label} ${W}${rpm}${RESET} ${DIM}RPM (${chip})${RESET}"
        else
            pline_sub "${label} ${W}${rpm}${RESET} ${DIM}RPM (${chip})${RESET}"
        fi
        found=$((found + 1))
    done
    if (( found == 0 )); then
        pline_hw "$(_emu '🌀')" "$(t hw_cooling)" "${DIM}$(t hw_unknown)${RESET}"
    fi
}

# ─── PCI Expansion Cards ───────────────────────────────────────
print_pci() {
    pci_slot_devices
    if (( ${#_PCI_BUS[@]} == 0 )); then
        pline "${DIM}$(t hw_pci_none)${RESET}"
        return
    fi
    local i
    for (( i=0; i<${#_PCI_BUS[@]}; i++ )); do
        pline_hw "$(_emu '🔌')" "${_PCI_BUS[$i]}" "${_PCI_DESC[$i]}"
    done
}

# ─── JSON output ────────────────────────────────────────────────
json_out() {
    local model cores threads
    model=$(awk -F': *' '/^model name/{print $2; exit}' /proc/cpuinfo)
    cores=$(awk '/^cpu cores/{print $4; exit}' /proc/cpuinfo)
    threads=$(awk '/^processor/{c++} END{print c+0}' /proc/cpuinfo)

    local gpu=""
    gpu=$(hw_gpu_name)
    [[ "$gpu" == *"|"* ]] && gpu="${gpu%|*}"

    local b_vendor="" b_name="" b_version="" bv="" bver="" bdate=""
    b_vendor=$(cat /sys/class/dmi/id/board_vendor 2>/dev/null || true)
    b_name=$(cat /sys/class/dmi/id/board_name 2>/dev/null || true)
    b_version=$(cat /sys/class/dmi/id/board_version 2>/dev/null || true)
    bv=$(cat /sys/class/dmi/id/bios_vendor 2>/dev/null || true)
    bver=$(cat /sys/class/dmi/id/bios_version 2>/dev/null || true)
    bdate=$(cat /sys/class/dmi/id/bios_date 2>/dev/null || true)

    # ── Per-slot memory collection (shared with print_ram) ──
    local mout="$_WU_DMIDECODE" msize_mb=0
    local _HT=$'\t'
    local -a j_size=() j_type=() j_speed=() j_manuf=() j_pn=() j_form=() j_locator=()
    local in_slot=0 j_s="" j_t="" j_sp="" j_m="" j_p="" j_f="" j_l="" j_empty=0

    j_flush() {
        [[ $in_slot -eq 1 ]] || return 0
        if [[ "$j_empty" -eq 0 && "$j_s" != *No* ]]; then
            j_size+=("$j_s"); j_type+=("$j_t"); j_speed+=("$j_sp")
            j_manuf+=("$j_m"); j_pn+=("$j_p"); j_form+=("$j_f"); j_locator+=("$j_l")
        fi
        in_slot=0; j_s=""; j_t=""; j_sp=""; j_m=""; j_p=""; j_f=""; j_l=""; j_empty=0
    }

    if [[ -n "$mout" ]]; then
        while IFS= read -r line; do
            case "$line" in
                *[Mm]emory\ [Dd]evice*) j_flush; in_slot=1 ;;
                *Size:\ *)              j_s="${line#*: }"; j_s="${j_s%%$_HT*}"
                    j_s="$(printf '%s' "$j_s" | awk '{$1=$1}1')"
                    [[ "$j_s" == *No* ]] && j_empty=1 ;;
                *Type:\ *)              j_t="${line#*: }"; j_t="${j_t%%$_HT*}"
                    j_t="$(printf '%s' "$j_t" | awk '{$1=$1}1')" ;;
                *Speed:\ *MT/*)         j_sp="$(printf '%s' "$line" | awk '{for(i=1;i<=NF;i++) if($i+0==$i && $(i+1)~/MT/) {print $i; exit}}')" ;;
                *Manufacturer:\ *)     j_m="${line#*: }"; j_m="${j_m%%$_HT*}"
                    j_m="$(printf '%s' "$j_m" | awk '{$1=$1}1' | tr -d '\r')" ;;
                *Part\ Number:\ *)     j_p="${line#*: }"; j_p="${j_p%%$_HT*}"
                    j_p="$(printf '%s' "$j_p" | awk '{$1=$1}1' | tr -d '\r')" ;;
                *Form\ Factor:\ *)     j_f="${line#*: }"; j_f="${j_f%%$_HT*}"
                    j_f="$(printf '%s' "$j_f" | awk '{$1=$1}1' | tr -d '\r')" ;;
                *Bank\ Locator:\ *)    : ;;  # skip
                *Locator:\ *)          j_l="${line#*: }"; j_l="${j_l%%$_HT*}"
                    j_l="$(printf '%s' "$j_l" | awk '{$1=$1}1' | tr -d '\r')" ;;
            esac
        done <<< "$mout"
        j_flush
    fi

    local modules=${#j_size[@]}

    # Normalize raw dmidecode size strings to GiB/MiB
    if (( modules > 0 )); then
        local i
        for (( i=0; i<modules; i++ )); do
            local mb="${j_size[$i]:-0}"
            if [[ "$mb" == *GiB || "$mb" == *MiB ]]; then
                continue  # already normalized (decode-dimms path)
            fi
            mb=$(printf '%s' "$mb" | awk '{n=0; for(i=1;i<=NF;i++) if($i+0==$i){n=$i; u=$(i+1); break} if(u~/[Gg][Bb]/) n*=1024; print n}')
            [[ "$mb" =~ ^[0-9]+$ ]] || mb=0
            if (( mb >= 1024 )); then
                j_size[$i]="$(( mb / 1024 )) GiB"
            else
                j_size[$i]="${mb} MiB"
            fi
        done
    fi

    if (( modules == 0 )); then
        local dout dcount
        dout=$(root_run decode-dimms 2>/dev/null) || dout=""
        dcount=$(awk '/^Decoding EEPROM/{c++} END{print c+0}' <<< "$dout")
        if (( dcount > 0 )); then
            local _s="" _m="" _p="" _f="" _t="" _sp=""
            while IFS= read -r line; do
                case "$line" in
                    Decoding\ EEPROM*)
                        [[ -n "$_s" ]] && { j_size+=("$_s"); j_manuf+=("$_m"); j_pn+=("$_p"); j_form+=("$_f"); j_type+=("$_t"); j_speed+=("$_sp"); }
                        _s=""; _m=""; _p=""; _f=""; _t=""; _sp="" ;;
                    Size*)                   _s="${line##*Size}"; _s="$(printf '%s' "$_s" | awk '{for(i=1;i<=NF;i++) if($i+0==$i){print $i; exit}}')" ;;
                    Module\ Manufacturer*)  _m="${line##*Module Manufacturer}"; _m="$(printf '%s' "$_m" | awk '{$1=$1}1' | tr -d '\r')" ;;
                    Part\ Number*)           _p="${line##*Part Number}"; _p="$(printf '%s' "$_p" | awk '{$1=$1}1' | tr -d '\r')" ;;
                    Module\ Type*)           _f="${line##*Module Type}"; _f="$(printf '%s' "$_f" | awk '{$1=$1}1' | tr -d '\r')" ;;
                    Memory\ Type*)           _t="${line##*Memory Type}"; _t="$(printf '%s' "$_t" | awk '{$1=$1}1' | tr -d '\r')" ;;
                    Speed*)                   _sp="${line##*Speed}"; _sp="$(printf '%s' "$_sp" | awk '{for(i=1;i<=NF;i++) if($i+0==$i) {print $i; exit}}')" ;;
                esac
            done <<< "$dout"
            [[ -n "$_s" ]] && { j_size+=("$_s"); j_manuf+=("$_m"); j_pn+=("$_p"); j_form+=("$_f"); j_type+=("$_t"); j_speed+=("$_sp"); }
            modules=${#j_size[@]}
            local i
            for (( i=0; i<modules; i++ )); do
                local mb="${j_size[$i]:-0}"
                mb=$(printf '%s' "$mb" | awk '{n=0; for(i=1;i<=NF;i++) if($i+0==$i){n=$i; u=$(i+1); break} if(u~/[Gg][Bb]/) n*=1024; print n}')
                [[ "$mb" =~ ^[0-9]+$ ]] || mb=0
                if (( mb >= 1024 )); then
                    j_size[$i]="$(( mb / 1024 )) GiB"
                else
                    j_size[$i]="${mb} MiB"
                fi
                [[ -z "${j_locator[$i]:-}" ]] && j_locator[$i]="DIMM $(( i + 1 ))"
            done
        fi
    fi
    msize_mb=0
    for (( i=0; i<modules; i++ )); do
        local v="${j_size[$i]:-0}"
        if [[ "$v" == *GiB ]]; then v="${v% GiB}"; v=$(( v * 1024 )); elif [[ "$v" == *MiB ]]; then v="${v% MiB}"; elif [[ "$v" =~ ^[0-9]+$ ]]; then v=$(( v / 1024 )); else v=0; fi
        msize_mb=$(( msize_mb + v ))
    done

    # Resolve JEDEC codes
    for (( i=0; i<modules; i++ )); do
        if [[ "${j_manuf[$i]:-}" =~ ^[0-9A-Fa-f]{4}$ ]] && declare -F wu_jedec_decode &>/dev/null; then
            local mdec
            mdec=$(wu_jedec_decode "${j_manuf[$i]:-}") || mdec=""
            [[ -n "$mdec" ]] && j_manuf[$i]="$mdec"
        fi
    done

    wu_json_head "$_WU_TOOLNAME" "$_WU_VERSION"
    printf ',\n  "cpu": { "model": "%s", "cores": "%s", "threads": "%s" },\n' \
        "$(json_esc "$model")" "$(json_esc "$cores")" "$(json_esc "$threads")"
    printf '  "gpu": { "name": "%s" },\n' "$(json_esc "$gpu")"
    printf '  "board": {\n'
    printf '    "vendor": "%s",\n' "$(json_esc "$b_vendor")"
    printf '    "name": "%s",\n' "$(json_esc "$b_name")"
    printf '    "version": "%s",\n' "$(json_esc "$b_version")"
    printf '    "bios": { "vendor": "%s", "version": "%s", "date": "%s" }\n' \
        "$(json_esc "$bv")" "$(json_esc "$bver")" "$(json_esc "$bdate")"
    printf '  },\n'
    printf '  "memory": {\n'
    printf '    "modules": %d,\n' "$modules"
    printf '    "size_mb": %d,\n' "$msize_mb"
    printf '    "slots": [\n'
    local jfirst=1
    for (( i=0; i<modules; i++ )); do
        (( jfirst )) && jfirst=0 || printf ',\n'
        printf '      { "locator": "%s", "size": "%s", "type": "%s", "speed_mts": "%s", "manufacturer": "%s", "part_number": "%s", "form_factor": "%s" }' \
            "$(json_esc "${j_locator[$i]}")" "$(json_esc "${j_size[$i]}")" "$(json_esc "${j_type[$i]}")" \
            "$(json_esc "${j_speed[$i]}")" "$(json_esc "${j_manuf[$i]}")" "$(json_esc "${j_pn[$i]}")" "$(json_esc "${j_form[$i]}")"
    done
    printf '\n    ]\n  },\n'

    printf '  "storage": [\n'
    local first=1 row dev smodel size
    while IFS= read -r row; do
        dev=$(awk '{print $1}' <<< "$row")
        size=$(awk '{print $NF}' <<< "$row")
        smodel=$(awk '{$1=""; $NF=""; gsub(/^ +| +$/, ""); print}' <<< "$row")
        (( first )) && first=0 || printf ',\n'
        printf '    { "name": "%s", "model": "%s", "size": "%s" }' \
            "$(json_esc "$dev")" "$(json_esc "$smodel")" "$(json_esc "$size")"
    done < <(lsblk -nd -o NAME,MODEL,SIZE 2>/dev/null | grep -vE '^(loop|zram|sr)' || true)
    printf '\n  ],\n'

    printf '  "network": [\n'
    first=1
    while IFS= read -r dev; do
        local op mac
        op=$(cat "/sys/class/net/$dev/operstate" 2>/dev/null || echo "down")
        mac=$(cat "/sys/class/net/$dev/address" 2>/dev/null || echo "")
        (( first )) && first=0 || printf ',\n'
        printf '    { "name": "%s", "operstate": "%s", "mac": "%s" }' \
            "$(json_esc "$dev")" "$(json_esc "$op")" "$(json_esc "$mac")"
    done < <(ls /sys/class/net/ 2>/dev/null | grep -vE '^(lo|virbr|docker|br-|veth)')
    printf '\n  ],\n'

    local cap="" stat=""
    for bat in /sys/class/power_supply/BAT* /sys/class/power_supply/bat*; do
        [[ -d "$bat" ]] || continue
        cap=$(cat "$bat/capacity" 2>/dev/null || true)
        stat=$(cat "$bat/status" 2>/dev/null || true)
        [[ -n "$cap" ]] && break
    done
    printf '  "battery": { "capacity": "%s", "status": "%s" },\n' "$(json_esc "$cap")" "$(json_esc "$stat")"

    printf '  "cooling": [\n'
    first=1
    local f rpm idx chip label
    for f in /sys/devices/platform/*/fan*_input /sys/class/hwmon/hwmon*/fan*_input; do
        [[ -r "$f" ]] || continue
        rpm=$(cat "$f" 2>/dev/null || echo 0)
        (( rpm > 0 )) || continue
        chip=$(basename "$(dirname "$f")")
        idx=$(basename "$f" | sed 's/fan\([0-9]*\)_input/\1/')
        [[ "$idx" =~ ^[0-9]+$ ]] || continue
        label=$(cat "$(dirname "$f")/fan${idx}_label" 2>/dev/null || echo "$(t hw_cooling) ${idx}")
        (( first )) && first=0 || printf ',\n'
        printf '    { "chip": "%s", "label": "%s", "rpm": %d }' \
            "$(json_esc "$chip")" "$(json_esc "$label")" "$rpm"
    done
    printf '\n  ],\n'

    printf '  "pci_expansion": [\n'
    first=1
    pci_slot_devices
    for (( i=0; i<${#_PCI_BUS[@]}; i++ )); do
        (( first )) && first=0 || printf ',\n'
        printf '    { "bus": "%s", "class": "%s", "description": "%s" }' \
            "$(json_esc "${_PCI_BUS[$i]}")" "$(json_esc "${_PCI_CLASS[$i]}")" "$(json_esc "${_PCI_DESC[$i]}")"
    done
    printf '\n  ],\n'

    local n_storage n_net
    n_storage=$(lsblk -nd -o NAME 2>/dev/null | grep -cvE '^(loop|zram|sr)' || true)
    n_net=$(ls /sys/class/net/ 2>/dev/null | grep -cvE '^(lo|virbr|docker|br-|veth)' || true)
    printf '  "summary": { "cpu": "%s", "gpu": "%s", "ram_modules": %d, "ram_size_mb": %d, "storage_devices": %d, "network_interfaces": %d }\n' \
        "$(json_esc "$model")" "$(json_esc "$gpu")" "$modules" "$msize_mb" "$n_storage" "$n_net"
    wu_json_end
}

# ─── Main ────────────────────────────────────────────────────────
_WU_DMIDECODE=""
main() {
    if (( _HW_SNAPSHOT )); then do_snapshot; return $?; fi
    if (( _HW_DIFF )); then do_diff; return $?; fi

    # Cache dmidecode once (used by both print_ram and json_out)
    _WU_DMIDECODE=$(root_run dmidecode -t memory 2>/dev/null) || _WU_DMIDECODE=""
    if [[ "$_WU_JSON" == "1" ]]; then json_out; return 0; fi

    box_header "$(_emu '🖥')" "wellhw" "$(t hw_title)"

    box "$(_emu '🧠')" "$(t hw_cpu)" print_cpu
    box "$(_emu '🎮')" "$(t hw_gpu)" print_gpu
    box "$(_emu '🖥')" "$(t hw_board)" print_board
    box "$(_emu '🧩')" "$(t hw_ram)" print_ram
    box "$(_emu '💿')" "$(t hw_storage)" print_storage
    box "$(_emu '🌐')" "$(t hw_network)" print_network
    box "$(_emu '🌀')" "$(t hw_cooling)" print_cooling
    box "$(_emu '🔌')" "$(t hw_pci)" print_pci

    # Battery: only render box if a battery exists
    if ls /sys/class/power_supply/BAT* /sys/class/power_supply/bat* 1>/dev/null 2>&1; then
        box "$(_emu '🔋')" "$(t hw_battery)" print_battery
    fi

    printf '\n  %sWellHW v1.3 | %s%s\n\n' "$DIM" "$(date '+%Y-%m-%d %H:%M:%S')" "$RESET"
}

wu_run main "$@"