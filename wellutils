#!/usr/bin/env bash
# wellutils -- launcher for wellutils system utility kit
# Usage: wellutils [-l LANG] <command> [args]
#        wellutils --lang RU|ENG   -- set language persistently
#        wellutils --help          -- show help
set -euo pipefail

_WU_DIR="$(dirname "$(readlink -f "$0")")"
_WU_LANG_FILE="${XDG_CONFIG_HOME:-${HOME:-/tmp}/.config}/wellutils/lang.conf"

# ─── Shared libs ────────────────────────────────────────────────
_WU_LIB="$_WU_DIR/lang.sh"
[[ -f "$_WU_LIB" ]] || _WU_LIB="$_WU_DIR/../share/wellutils/lang.sh"
[[ -f "$_WU_LIB" ]] || _WU_LIB="/usr/local/share/wellutils/lang.sh"
[[ -f "$_WU_LIB" ]] || _WU_LIB="/usr/share/wellutils/lang.sh"
[[ -f "$_WU_LIB" ]] || _WU_LIB="/etc/wellutils/lang.sh"
source "$_WU_LIB"
_WU_BOX="$_WU_DIR/box.sh"
[[ -f "$_WU_BOX" ]] || _WU_BOX="$_WU_DIR/../share/wellutils/box.sh"
[[ -f "$_WU_BOX" ]] || _WU_BOX="/usr/local/share/wellutils/box.sh"
[[ -f "$_WU_BOX" ]] || _WU_BOX="/usr/share/wellutils/box.sh"
[[ -f "$_WU_BOX" ]] || _WU_BOX="/etc/wellutils/box.sh"
[[ -f "$_WU_BOX" ]] && source "$_WU_BOX"

_WU_VERSION="1.4.0"

show_help() {
    local ttl pad
    ttl="🛠  wellutils -- $(t launcher_title)"
    pad=$(( 54 - $(vislen "$ttl") - 1 ))      # box inner is 54 cells
    (( pad < 1 )) && pad=1
    printf '\n'
    printf '  %s╔══════════════════════════════════════════════════════╗%s\n' "$C" "$RESET"
    printf '  %s║%s%s  %s%*s%s%s║%s\n' "$C" "$RESET" "${BOLD}${W}" "$ttl" "$pad" '' "$RESET" "$C" "$RESET"
    printf '  %s╚══════════════════════════════════════════════════════╝%s\n' "$C" "$RESET"
    printf '\n'
    printf '  %s%s:%s\n' "$BOLD" "$(t launcher_usage)" "$RESET"
    printf '    wellutils <command>              %s\n' "$(t launcher_run)"
    printf '    wellutils --lang RU|EN          %s\n' "$(t launcher_set_lang)"
    printf '    wellutils --help                %s\n' "$(t launcher_help)"
    printf '    wellutils --version             %s\n' "$(t launcher_version)"
    printf '\n'
    printf '  %s%s:%s\n' "$BOLD" "$(t launcher_commands)" "$RESET"
    printf '    %susb%s       -- %s\n' "$G" "$RESET" "$(t cmd_usb)"
    printf '    %spci%s       -- %s\n' "$G" "$RESET" "$(t cmd_pci)"
    printf '    %sblock%s     -- %s\n' "$G" "$RESET" "$(t cmd_block)"
    printf '    %smem%s       -- %s\n' "$G" "$RESET" "$(t cmd_mem)"
    printf '    %smod%s       -- %s\n' "$G" "$RESET" "$(t cmd_mod)"
    printf '    %swellsensors%s -- %s\n' "$G" "$RESET" "$(t cmd_sensors)"
    printf '    %shw%s         -- %s\n' "$G" "$RESET" "$(t cmd_hw)"
    printf '    %sper%s        -- %s\n' "$G" "$RESET" "$(t cmd_per)"
    printf '    %sgpu%s        -- %s\n' "$G" "$RESET" "$(t cmd_gpu)"
    printf '    %scpu%s        -- %s\n' "$G" "$RESET" "$(t cmd_cpu)"
    printf '    %sfetch%s      -- %s\n' "$G" "$RESET" "$(t cmd_fetch)"
    printf '    %sup%s         -- %s\n' "$G" "$RESET" "$(t cmd_up)"
    printf '    %snet%s        -- %s\n' "$G" "$RESET" "$(t cmd_net)"
    printf '    %spower%s      -- %s\n' "$G" "$RESET" "$(t cmd_power)"
    printf '    %sdoctor%s     -- %s\n' "$G" "$RESET" "$(t cmd_doctor)"
    printf '    %sself-update%s  -- %s\n' "$G" "$RESET" "$(t cmd_selfupdate)"
    printf '\n'
    printf '  %s%s:%s\n' "$BOLD" "$(t launcher_options)" "$RESET"
    printf '    %s--plain%s / %s--color auto|always|never%s  %s\n' "$G" "$RESET" "$G" "$RESET" "$(t opt_plain_color)"
    printf '    %s--short%s  %s\n' "$G" "$RESET" "$(t opt_short)"
    printf '    %s--html%s   %s\n' "$G" "$RESET" "$(t opt_html)"
    printf '    %s--json%s   %s\n' "$G" "$RESET" "$(t opt_json)"
    printf '    %s--all%s / %s--full%s / %s--no-logo%s        %s\n' "$G" "$RESET" "$G" "$RESET" "$G" "$RESET" "$(t opt_more)"
    printf '    %s--help%s                   %s\n' "$G" "$RESET" "$(t launcher_help)"
    printf '\n'
    printf '  %s%s:%s  usb=wellusb  wusb=wellusb  pci=wellpci  wpci=wellpci\n' "$DIM" "$(t launcher_aliases)" "$RESET"
    printf '                block=wellblock  wblock=wellblock  mem=wmem=wellmem\n'
    printf '                ram=wram=wellram=wellmem  mod=wellmod\n'
    printf '                wsensors=wellsensors  wtemp=wellsensors  hw=wellhw\n'
    printf '                whw=wellhw  per=wellper  wper=wellper  gpu=wellgpu\n'
    printf '                wgpu=wellgpu  cpu=wellcpu  wcpu=wellcpu  fetch=wellfetch\n'
    printf '                up=wellup  wup=wellup  net=wellnet  wnet=wellnet\n'
    printf '                power=wellpower  wpower=wellpower  wbatt=wellpower\n'
    printf '                doctor=welldoctor  wdoc=welldoctor  wdoctor=welldoctor\n'
    printf '                html=whtml  report=whtml  whtml=whtml\n'
    printf '\n'
    printf '  %s%s:%s %s%s%s\n\n' "$DIM" "$(t launcher_current_lang)" "$RESET" "$BOLD" "$WELLUTILS_LANG" "$RESET"
}

set_lang() {
    local lang
    lang=$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')
    case "$lang" in
        RU|EN|ENG)
            [[ "$lang" == "ENG" ]] && lang="EN"
            mkdir -p "$(dirname "$_WU_LANG_FILE")"
            echo "$lang" > "$_WU_LANG_FILE"
            printf '  %s%s:%s %s%s%s\n\n' "$G" "$(t launcher_set_lang_done)" "$RESET" "$BOLD" "$lang" "$RESET"
            ;;
        *)
            printf '  %s%s:%s %s\n\n' "$R" "$(t launcher_error)" "$RESET" "$(t launcher_error_lang "$lang")"
            exit 1
            ;;
    esac
}

# Parse args
CMD=""

while [[ $# -gt 0 ]]; do
    [[ -n "$CMD" ]] && break    # rest of args belong to the tool
    case "$1" in
        --lang|-l)
            [[ $# -lt 2 || "$2" == -* ]] && { printf '  %s%s:%s --lang %s\n' "$R" "$(t launcher_error)" "$RESET" "$(t launcher_set_lang)"; exit 1; }
            shift
            set_lang "$1"
            exit 0
            ;;
        --help|-h)
            show_help
            exit 0
            ;;
        --version|-V)
            printf '%s %s\n' "wellutils" "$_WU_VERSION"
            exit 0
            ;;
        usb|wellusb|wusb)          CMD="wellusb";     shift ;;
        pci|wellpci|wpci)          CMD="wellpci";     shift ;;
        block|wellblock|wblock)    CMD="wellblock";   shift ;;
        mem|wellmem|wmem|ram|wellram|wram) CMD="wellmem"; shift ;;
        mod|wellmod|wmod)          CMD="wellmod";     shift ;;
        sensors|wellsensors|wsensors|wtemp) CMD="wellsensors"; shift ;;
        hw|wellhw|whw)             CMD="wellhw";      shift ;;
        per|wellper|wper)          CMD="wellper";     shift ;;
        gpu|wellgpu|wgpu)          CMD="wellgpu";     shift ;;
        cpu|wellcpu|wcpu)          CMD="wellcpu";     shift ;;
        fetch|wellfetch|wfetch)    CMD="wellfetch";   shift ;;
        up|wellup|wup)             CMD="wellup";      shift ;;
        net|wellnet|wnet)          CMD="wellnet";     shift ;;
        power|wellpower|wpower|wbatt) CMD="wellpower"; shift ;;
        doctor|welldoctor|wdoc|wdoctor) CMD="welldoctor"; shift ;;
        html|report|whtml)            CMD="whtml";      shift ;;
        self-update|selfupdate)    CMD="wellup";      set -- --self-update "${@:2}" ;;
        *)
            printf '  %s%s: %s "%s"\n\n' "$R" "$(t launcher_error)" "$(t launcher_error_cmd)" "$1"
            show_help
            exit 1
            ;;
    esac
done

if [[ -z "$CMD" ]]; then
    show_help
    exit 0
fi

# Prefer PATH; fall back to the repo checkout next to this launcher.
if command -v "$CMD" >/dev/null 2>&1; then
    exec "$CMD" "$@"
elif [[ -x "$_WU_DIR/$CMD" ]]; then
    exec "$_WU_DIR/$CMD" "$@"
else
    printf '  %s%s: %s "%s"\n\n' "$R" "$(t launcher_error)" "$(t launcher_error_cmd)" "$CMD"
    exit 127
fi
