#compdef wellfetch
# zsh completion for wellfetch
# Part of wellutils by wellbou_

_wellfetch() {
    _arguments -S \
        --help[show help] \
        --version[show version] \
        --lang=[output language]: :(ru en auto) \
        --color=[colorize output]: :(always auto never) \
        --logo[] \
        --no-logo[] \
        --png[] \
        --logo-width[] \
        --key[] \
        --custom[] \
        --all[] \
        --full[] \
        --json[] \
        --short[] \
        --html[] \
        --plain[] \
        --box[] \
        --no-emoji[] \
        --emoji[] \
        --debug[shell tracing] \
        --
}

_wellfetch "$@"
