pkgbase = wellutils
	pkgdesc = Suite of colourful system and peripheral reporting tools (wellper, wellusb, wellpci, wellhw, wellmem, wellsensors, wellblock, wellcpu, wellgpu, wellmod, wellfetch, wellup, whtml)
	pkgver = 1.4.0
	pkgrel = 53
	url = https://github.com/Wellbou/wellutils
	arch = any
	license = MIT
	depends = bash
	depends = python
	depends = coreutils
	depends = procps-ng
	depends = hwdata
	optdepends = pciutils: PCI descriptions and listing (wellpci, wellhw, wellgpu)
	optdepends = hwdata: USB device identification database (wellusb, wellper)
	optdepends = smartmontools: disk temperature monitoring (wellsensors) and S.M.A.R.T. health (wellblock)
	optdepends = nvme-cli: NVMe temperature monitoring (wellsensors)
	optdepends = dmidecode: detailed memory info (wellhw)
	optdepends = i2c-tools: decode-dimms SPD fallback for RAM detail (wellhw)
	optdepends = util-linux: lscpu topology info (wellcpu)
	optdepends = iproute2: interfaces, routes and listening ports (wellnet)
	optdepends = iw: Wi-Fi SSID and signal info (wellnet)

pkgname = wellutils
