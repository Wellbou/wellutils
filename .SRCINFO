pkgbase = wellutils
	pkgdesc = Colourful system and peripheral reporting tools (wellper, wellhw, wellmem, wellusb, wellpci, wellblock, wellcpu, wellgpu, wellmod, wellsensors, wellfetch, wellup, wellnet, wellpower, welldoctor, whtml)
	pkgver = 1.4.0.54
	pkgrel = 1
	url = https://github.com/Wellbou/wellutils
	arch = any
	license = MIT
	license = GPL-2.0-only
	depends = bash
	depends = coreutils
	depends = procps-ng
	depends = util-linux
	optdepends = python: whtml HTML report and the PNG logo of wellfetch
	optdepends = hwdata: PCI/USB ID database (wellusb, wellpci, wellper)
	optdepends = pciutils: PCI descriptions and listing (wellpci, wellhw, wellgpu)
	optdepends = lm_sensors: extra sensor readings (wellsensors)
	optdepends = smartmontools: disk temperature (wellsensors) and S.M.A.R.T. health (wellblock, welldoctor)
	optdepends = nvme-cli: NVMe temperature monitoring (wellsensors)
	optdepends = dmidecode: detailed memory and board info (wellhw)
	optdepends = i2c-tools: decode-dimms SPD fallback for RAM detail (wellhw)
	optdepends = iproute2: interfaces, routes and listening ports (wellnet)
	optdepends = iw: Wi-Fi SSID and signal info (wellnet)
	options = !debug
	options = !strip
	source = wellutils-1.4.0-54.tar.gz::https://github.com/Wellbou/wellutils/archive/refs/tags/v1.4.0-54.tar.gz
	sha256sums = SKIP

pkgname = wellutils
