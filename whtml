  var p=curPane();var n=panes[p].querySelectorAll('.subit').length;
  switch(ev.key){
    case 'ArrowRight':ev.preventDefault();show((p+1)%panes.length);break;
    case 'ArrowLeft':ev.preventDefault();show((p-1+panes.length)%panes.length);break;
    case 'ArrowDown':ev.preventDefault();if(n)showSub(p,(curSub(p)+1)%n);break;
    case 'ArrowUp':ev.preventDefault();if(n)showSub(p,(curSub(p)-1+n)%n);break;
    case 'Home':ev.preventDefault();show(0);break;
    case 'End':ev.preventDefault();show(panes.length-1);break;
  }
});
show(0);
})();
</script>
