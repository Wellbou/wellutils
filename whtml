def render_ami(panels, L, R, user, host, ts, wu_ver, FONT_B64, cpu=None, mem_t=None, disks=None):
    font_decl = ''
    if FONT_B64:
        font_decl = "@font-face{font-family:'BIOS';src:url(data:font/woff;base64," + FONT_B64 + ") format('woff')}"
    head_css = CSS_AMI.replace('__FONT__', font_decl)

    out = ["<!DOCTYPE html>", "<html lang=\"en\">", "<head>",
           "<meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">",
           "<title>AMIBIOS SETUP UTILITY - %s@%s</title>" % (esc(user), esc(host.get('host',''))),
           "<style>", head_css, "</style>", "</head>",
           "<body class=\"ami\">"]
    # header banner
    out.append('<div class="banner"><span>AMIBIOS SETUP UTILITY</span><span class="bversion">%s</span></div>' % esc(wu_ver))
    # main tabs (one per panel) - horizontal nav like real BIOS
    tabs = ['<div class="tabs">']
    for i, p in enumerate(panels):
        tabs.append('<button class="tab%s" data-p="%d">%s</button>' % (' active' if i==0 else '', i, esc(p[0])))
    tabs.append('</div>')
    out.append(''.join(tabs))
    # body
    out.append('<div class="ami-body">')
    for i, (maintitle, subs) in enumerate(panels):
        out.append('<div class="pane%s" id="pane%d">' % (' active' if i==0 else '', i))
        # left submenu (only if multiple subs)
        if len(subs) > 1:
            out.append('<div class="subcol">')
            for si, s in enumerate(subs):
                out.append('<button class="subit%s" data-p="%d" data-s="%d" type="button"><span class="caret">&gt;</span>%s</button>'
                           % (' active' if si==0 else '', i, si, esc(s[0])))
            out.append('</div>')
        else:
            out.append('<div class="subcol empty"></div>')
        # content columns
        for si, s in enumerate(subs):
            out.append('<div class="content%s" id="c%d-%d">' % (' active' if si==0 else '', i, si))
            out.append('<table class="tbl"><tbody>%s</tbody></table>' % s[1])
            if s[2]:
                out.append('<div class="miniwrap">%s</div>' % s[2])
            out.append('</div>')
        # item specific help
        out.append('<div class="helpcol"><div class="helptitle">Item Specific Help</div>'
                   '<div class="helpbody">' + esc(maintitle) + '</div></div>')
        out.append('</div>')
    out.append('</div>')  # ami-body
    out.append(LEGEND_AMI)
    # overlays: help, F9, F10, boot
    out.append('<div class="overlay" id="bootOverlay"><div class="boot-screen" id="bootText"></div></div>')
    out.append('<div class="popup" id="f9Popup"><div class="popup-box" id="f9PopupInner">'
      '<div class="msg">Load optimized defaults?<br>All current settings will be lost.</div>'
      '<div class="opts"><button class="active" id="f9Yes">[ Yes ]</button>'
      '<button id="f9No">[ No ]</button></div></div></div>')
    out.append('<div class="popup" id="f10Popup"><div class="popup-box" id="f10PopupInner">'
      '<div class="msg">Save configuration and exit?</div>'
      '<div class="opts"><button class="active" id="f10Yes">[ Yes ]</button>'
      '<button id="f10No">[ No ]</button></div></div></div>')
    out.append('<div class="help-overlay" id="helpOverlay"><div class="help-box">'
      '<h3>BIOS SETUP UTILITY - HELP</h3>'
      '<div class="row"><span class="key">F1</span><span>Open this help screen</span></div>'
      '<div class="row"><span class="key">&larr; &rarr;</span><span>Navigate between tabs</span></div>'
      '<div class="row"><span class="key">&uarr; &darr;</span><span>Select item in submenu</span></div>'
      '<div class="row"><span class="key">Enter</span><span>Select sub-menu item</span></div>'
      '<div class="row"><span class="key">+/-</span><span>Change option value</span></div>'
      '<div class="row"><span class="key">F9</span><span>Load optimal defaults</span></div>'
      '<div class="row"><span class="key">F10</span><span>Save and exit</span></div>'
      '<div class="row"><span class="key">Esc</span><span>Exit / close popup</span></div>'
      '<div style="margin-top:14px;text-align:center;color:#0ff">Press any key to close</div>'
      '</div></div>')
    boot_cpu = esc(str(gv(cpu,'model') or 'N/A') if cpu else 'N/A')
    boot_mem = esc(str(mem_t)+' GB' if mem_t else 'N/A')
    boot_disks = [esc(str(d.get('model','') or d.get('name','') or 'None')) for d in (disks[:4] if disks else [])]
    while len(boot_disks) < 4: boot_disks.append('None')
    import json as _json
    boot_disks_js = _json.dumps(boot_disks)
    js_boot = JS_AMI.replace('__BOOT_CPU__', boot_cpu).replace('__BOOT_MEM__', boot_mem).replace('__BOOT_DISKS__', boot_disks_js)
    out.append(js_boot)
    out.append('</body></html>')
    return ''.join(out)


