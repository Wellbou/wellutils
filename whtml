body.ami *{box-sizing:border-box;user-select:none;-webkit-user-select:none}
body.ami button{font-family:inherit;background:none;border:none;color:inherit;font-size:inherit;font-weight:inherit;cursor:default}
.banner{display:flex;justify-content:space-between;align-items:center;color:#fff;
 background:linear-gradient(180deg,#0099cc,#0089bb 40%,#007aaa);font-weight:700;
 padding:6px 18px;letter-spacing:.4px}
.banner .bversion{font-size:0.7em;color:#e0f2ff}
.tabs{display:flex;background:var(--blueDark);color:var(--grey)}
.tabs .tab{flex:1;color:var(--grey);padding:7px 4px;text-align:center;border-right:1px solid #1f2f9f;
 text-transform:capitalize;cursor:default}
.tabs .tab:last-child{border-right:none}
.tabs .tab.active{background:var(--grey);color:var(--blueDark)}
.tabs .tab:hover{color:#fff}
.ami-body{flex:1;display:flex;overflow:hidden}
.pane{display:none;flex:1;min-width:0}
.pane.active{display:flex}
.subcol{width:220px;flex-shrink:0;border-right:1px solid #8a8784;padding:6px 0;overflow-y:auto}
.subcol.empty{width:220px}
.subit{display:flex;align-items:center;gap:6px;width:100%;text-align:left;color:var(--blueDark);
 padding:6px 12px;white-space:nowrap;text-transform:capitalize;cursor:default}
.subit .caret{color:#3f3c39;visibility:hidden;width:16px;flex-shrink:0}
.subit.active .caret{visibility:visible}
.subit.active{background:var(--blueDark);color:#fff}
.subit:hover{background:var(--blueDark);color:#fff}
.content{display:none;flex:1;min-width:0;overflow:auto;padding:22px 26px;color:var(--blueDark);
 border:2px solid #000;border-left:none}
.content.active{display:block}
.content .tbl{border-collapse:collapse;width:100%;color:var(--blueDark)}
.content .tbl td{padding:7px 8px;border:none;font-size:inherit;vertical-align:top}
.content .tbl td.lbl{color:#33303d;width:200px;white-space:nowrap}
.content .tbl td.lbl::after{content:":";color:#4a47a0}
.miniwrap{margin-top:12px}
.miniwrap table{border-collapse:collapse;width:100%;color:var(--blueDark)}
.miniwrap table td{font-size:0.8em;padding:4px 8px;border:none;text-align:left}
.miniwrap table td:first-child{color:#33303d}
.helpcol{width:300px;flex-shrink:0;border-left:2px solid #8a8784;display:flex;flex-direction:column}
.helptitle{padding:6px 12px;text-align:center;color:var(--blueLight);font-weight:700;
 border-bottom:1px solid #8a8784}
.helpbody{flex:1;padding:18px 14px;color:#7a3a08;font-size:0.78em;line-height:1.4;overflow:auto}
.legend{background:var(--blueLight);color:#fff;font-size:0.72em;padding:5px 14px;display:flex;
 justify-content:center;flex-wrap:wrap;gap:2px 24px;flex-shrink:0}
.legend .row{display:flex;flex-wrap:wrap;justify-content:center;gap:2px 24px}
.legend b{color:#fff}
.badge.ok{color:#0a7a0a}.badge.warn{color:#8a6a00}.badge.crit{color:#a50f0f}.badge.info{color:var(--blueDark)}
.overlay{display:none;position:fixed;inset:0;z-index:100;background:#000;flex-direction:column;align-items:center;justify-content:center}
.overlay.show{display:flex}
.boot-screen{color:#aaa;font:21px/1.6 "BIOS","Perfect DOS VGA 437","Courier New",monospace;white-space:pre;text-align:left}
.boot-screen .hi{color:#fff}
.boot-screen .ok{color:#0a0}
.boot-screen .warn{color:#aa0}
.boot-screen .fail{color:#a00}
.boot-screen .blink{animation:blinker 1s steps(1) infinite}
@keyframes blinker{50%{opacity:0}}
.popup{display:none;position:fixed;inset:0;z-index:90;background:rgba(0,0,0,.55);
 align-items:center;justify-content:center}
.popup.show{display:flex}
.popup-box{background:#0000b0;border:2px solid #fff;color:#fff;padding:18px 28px;
 font:21px/1.5 "BIOS","Perfect DOS VGA 437","Courier New",monospace;min-width:360px;text-align:center}
.popup-box .msg{margin-bottom:16px}
.popup-box .opts{display:flex;gap:18px;justify-content:center}
.popup-box .opts button{color:#fff;font:inherit;padding:4px 14px;border:1px solid transparent;
 background:none;cursor:default}
.popup-box .opts button.active{border-color:#fff;color:#fff}
.popup-box .opts button:hover{color:#0ff}
.help-overlay{display:none;position:fixed;inset:0;z-index:80;background:rgba(0,0,0,.7);
 align-items:center;justify-content:center}
.help-overlay.show{display:flex}
.help-box{background:#000080;border:2px solid #fff;color:#fff;padding:22px 32px;
 font:18px/1.6 "BIOS","Perfect DOS VGA 437","Courier New",monospace;max-width:600px}
.help-box h3{margin:0 0 10px;color:#0ff;font-size:20px}
.help-box .row{display:flex;justify-content:space-between;border-bottom:1px solid #336;padding:3px 0}
.help-box .key{color:#ff0;min-width:80px}
@media (max-width:960px){.subcol{width:150px}.helpcol{display:none}}
