  var contents=panes[p].querySelectorAll('.content');
  if(subs.length){
    var cur=0;
    subs.forEach(function(s,k){if(s.classList.contains('active'))cur=k});
    subs.forEach(function(s,k){s.classList.toggle('active',k===cur)});
    contents.forEach(function(c,k){c.classList.toggle('active',k===cur)});
  }else{
    contents.forEach(function(c,k){c.classList.toggle('active',k===0)});
  }
}
function curPane(){return panes.findIndex(function(x){return x.classList.contains('active')})}
function curSub(p){var a=panes[p].querySelector('.subit.active');return a?+a.dataset.s:0}
function showSub(p,s){
  var subs=panes[p].querySelectorAll('.subit');
  var contents=panes[p].querySelectorAll('.content');
  if(!subs.length)return;
  s=(s%subs.length+subs.length)%subs.length;
  subs.forEach(function(b,k){b.classList.toggle('active',k===s)});
  contents.forEach(function(c,k){c.classList.toggle('active',k===s)});
}
function openPopup(el){el.classList.add('show')}
function closeAll(){helpOv.classList.remove('show');f9Popup.classList.remove('show');f10Popup.classList.remove('show');bootOv.classList.remove('show')}
function anyOpen(){return helpOv.classList.contains('show')||f9Popup.classList.contains('show')||f10Popup.classList.contains('show')||bootOv.classList.contains('show')}

tabs.forEach(function(t){t.onclick=function(){show(+t.dataset.p)}});
document.querySelectorAll('.subit').forEach(function(b){b.onclick=function(){showSub(+b.dataset.p,+b.dataset.s)}});

function runBoot(){
