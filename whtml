# ── Tab 6: Network ──
t6 = []
ifs = net.get('interfaces') or []
for i in ifs:
    t6.append(row(i.get('name',''), f'{i.get("kind","")} · {i.get("state","")} · {i.get("mac","")}' + (f' · {i.get("speed_mbps")} Мбит/с' if i.get('speed_mbps') else '')))
t6.append(airow('net_desc'))
if not ifs:
    t6.append(row('', '—'))

# ── Tab 7: Thermal & Fans ──
t7 = []
cores = gv(sensors,'cpu_cores') or []
if cores:
    t7.append(f'<tr><td class="lbl">{R("Процессор","CPU")}</td><td><table class="mini">')
