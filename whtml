def render_cli(panels, L, R, user, host, ts, wu_ver, FONT_B64):
    css = CSS_CLI.replace('__FONT__', '')

    out = ["<!DOCTYPE html>", "<html lang=\"%s\">" % lang.lower(), "<head>",
           "<meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">",
           "<title>WellHTML - %s@%s</title>" % (esc(user), esc(host.get('host',''))),
           "<style>", css, "</style>", "</head>",
           "<body data-theme=\"dark\">"]
    # header
    out.append(HEADER_CLI.replace('__USER__', esc(user)).replace('__HOST__', esc(host.get('host','')))
               .replace('__HELP__', R('хелп','help')).replace('__SEARCH__', R('поиск','search'))
               .replace('__THEME__', R('тема','theme')).replace('__DL__', R('Скачать HTML','Download HTML')))
    # nav main
    nav = ['<nav id="nav" aria-label="tabs">']
    for i, p in enumerate(panels):
        idx = (i+1) % 10
        nav.append('<button data-i="%d" class="%s"><span class="idx">[%d]</span>%s</button>' % (i, 'active' if i==0 else '', idx, esc(p[0])))
    nav.append('</nav>')
    out.append(''.join(nav))
    out.append('<div id="search"><span class="p">&gt; </span><input type="text" id="searchin" placeholder="%s" autocomplete="off"><span class="count" id="searchcount"></span></div>' % R('фильтр строк…','filter rows…'))
    out.append('<main>')
    for i, (maintitle, subs) in enumerate(panels):
        out.append('<div class="panel%s" id="p%d">' % (' active' if i==0 else '', i))
        if len(subs) > 1:
            sub = ['<div class="subnav" id="subnav-%d">' % i]
            for si, s in enumerate(subs):
                sub.append('<button data-s="%d" class="%s">%s</button>' % (si, 'active' if si==0 else '', esc(s[0])))
            sub.append('</div>')
            out.append(''.join(sub))
        for si, s in enumerate(subs):
            out.append('<div class="subpanel%s" id="s%d-%d">' % (' active' if si==0 else '', i, si))
            out.append('<table><tbody>%s</tbody></table>' % s[1])
            if s[2]:
                out.append(s[2])
            out.append('</div>')
        out.append('</div>')
    out.append('</main>')
    out.append(FOOTER_CLI.replace('__VER__', esc(wu_ver)).replace('__TS__', esc(ts))
               .replace('__HINT__', R('<- -> или цифры для навигации','<- -> or digits to navigate')))
    out.append(HELP_CLI.replace('__H1__', R('Клавиатура','Keyboard'))
               .replace('__H1K__', R('<- -> / ^ v','<- -> / ^ v')).replace('__H1V__', R('переключить вкладку','switch tab'))
               .replace('__H2K__', 'Tab / Enter').replace('__H2V__', R('внутренняя вкладка','inner tab'))
               .replace('__H3K__', '1…9 / 0').replace('__H3V__', R('перейти к вкладке','jump to tab'))
               .replace('__H4K__', 'Home / End').replace('__H4V__', R('первая / последняя','first / last'))
               .replace('__H5K__', '/').replace('__H5V__', R('фильтр строк','filter rows'))
               .replace('__H6K__', 't').replace('__H6V__', R('тёмная / светлая тема','dark / light theme'))
               .replace('__H7K__', '?').replace('__H7V__', R('эта справка','this help'))
               .replace('__H8K__', 'Esc').replace('__H8V__', R('закрыть','close'))
               .replace('__VER2__', esc(wu_ver)))
    out.append(JS_CLI)
    out.append('</body></html>')
    return ''.join(out)

