function popupNav(id,dir){
  var btns=popupBtns[id]||[];if(!btns.length)return;
  var cur=btns.findIndex(function(b){return b.classList.contains('active')});
  cur=(cur<0?0:cur)+dir;cur=(cur%btns.length+btns.length)%btns.length;
  btns.forEach(function(b,k){b.classList.toggle('active',k===cur)});
