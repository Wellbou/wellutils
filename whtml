document.addEventListener('keydown',function(ev){
  if(ev.key==='F1'){ev.preventDefault();openHelp();return}
  if(ev.key==='F9'){ev.preventDefault();openF9();return}
  if(ev.key==='F10'){ev.preventDefault();openF10();return}
  if(ev.key==='Escape'){
    ev.preventDefault();
    if(bootOv.classList.contains('show')){bootOv.classList.remove('show');return}
    if(helpOv.classList.contains('show')){helpOv.classList.remove('show');return}
    if(f9Popup.classList.contains('show')){f9Popup.classList.remove('show');return}
    if(f10Popup.classList.contains('show')){f10Popup.classList.remove('show');return}
    return;
  }
  if(anyOpen()){
    if(f9Popup.classList.contains('show')&&(ev.key==='ArrowLeft'||ev.key==='ArrowRight')){
      ev.preventDefault();popupNav('f9Popup',ev.key==='ArrowRight'?1:-1);
    }
    if(f9Popup.classList.contains('show')&&ev.key==='Enter'){ev.preventDefault();popupEnter('f9Popup')}
    if(f10Popup.classList.contains('show')&&(ev.key==='ArrowLeft'||ev.key==='ArrowRight')){
      ev.preventDefault();popupNav('f10Popup',ev.key==='ArrowRight'?1:-1);
    }
    if(f10Popup.classList.contains('show')&&ev.key==='Enter'){ev.preventDefault();popupEnter('f10Popup')}
