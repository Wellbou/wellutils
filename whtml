document.getElementById('f9Yes').onclick=function(){f9Popup.classList.remove('show')};
document.getElementById('f9No').onclick=function(){f9Popup.classList.remove('show')};
document.getElementById('f10Yes').onclick=function(){runBoot()};
document.getElementById('f10No').onclick=function(){f10Popup.classList.remove('show')};
