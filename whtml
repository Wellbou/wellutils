# ─── Main ────────────────────────────────────────────────────────
main() {
    _WHTML_TMP="$(mktemp -d /tmp/tmp.XXXXXXXXXX)"
    local keep=0
    [[ "${WHTML_KEEP_TMP:-0}" == 1 ]] && keep=1
    trap '[[ "${keep:-0}" -eq 0 ]] && rm -rf "$_WHTML_TMP"' EXIT

    _whtml_log "collecting data..."
    if ! command -v python3 >/dev/null 2>&1; then
        echo "whtml: error: python3 is required to build the report (not found on PATH)" >&2
        echo "       install python3, or choose another tool (wellhw/wellcpu --json)" >&2
        exit 3
    fi
    printf '%s' "$(_whtml_host)" > "$_WHTML_TMP/host.json"

    _whtml_collect_json "$_WHTML_TMP/hw.json" wellhw
    if _whtml_tool wellcpu >/dev/null 2>&1; then
        _whtml_collect_json "$_WHTML_TMP/cpuinfo.json" wellcpu
    fi
    python3 - "$_WHTML_TMP" << 'PYEOF'
import json, os
t=os.sys.argv[1]
def split(src, dst):
    try:
        d=json.load(open(os.path.join(t, src)))
    except Exception:
        d={}
    for key, out in dst.items():
        v=d.get(key)
        if v is None: v={}
        json.dump(v, open(os.path.join(t, out),'w'), ensure_ascii=False)
split('hw.json', {'cpu':'cpu.json','gpu':'gpu.json','board':'board.json','storage':'storage.json'})
mem={}
try:
    mem=json.load(open(os.path.join(t,'hw.json'))).get('memory') or {}
except Exception:
    pass
if not mem:
    try:
        mem=json.load(open(os.path.join(t,'memraw.json'))).get('memory') or {}
    except Exception:
        pass
json.dump(mem, open(os.path.join(t,'mem.json'),'w'), ensure_ascii=False)
try:
    ci=json.load(open(os.path.join(t,'cpuinfo.json'))).get('info') or {}
    cpu=json.load(open(os.path.join(t,'cpu.json')))
    for k in ('sockets','max_freq_khz','base_freq_khz'):
        if k in ci: cpu[k]=ci[k]
    json.dump(cpu, open(os.path.join(t,'cpu.json'),'w'), ensure_ascii=False)
except Exception:
    pass
PYEOF

    _whtml_collect_json "$_WHTML_TMP/memraw.json" wellmem
    _whtml_collect_json "$_WHTML_TMP/net.json"     wellnet
    _whtml_collect_json "$_WHTML_TMP/per.json"     wellper
    _whtml_collect_json "$_WHTML_TMP/sensors.json" wellsensors
    _whtml_collect_json "$_WHTML_TMP/doctor.json"  welldoctor
    _whtml_collect_json "$_WHTML_TMP/block.json"   wellblock

    if [[ "$_WHTML_AI" == 1 ]]; then
        _whtml_ai_enrich
    fi

    _whtml_log "building HTML..."
    local html
    if ! html="$( _whtml_generate )"; then
        echo "whtml: generation failed (see above)" >&2
        exit 1
    fi
    if [[ -z "$html" ]]; then
        echo "whtml: generation produced empty output" >&2
        exit 1
    fi
    printf '%s' "$html" > "$_WHTML_OUTPUT"

    printf '  %s%s%s %s\n' "$G" "$(t done)" "$RESET" "$_WHTML_OUTPUT"
    if [[ "$_WHTML_OPEN" == 1 && -t 1 ]]; then
        if command -v xdg-open >/dev/null 2>&1; then
            nohup xdg-open "$_WHTML_OUTPUT" >/dev/null 2>&1 &
        fi
    fi
}

# ─── Argument parsing (strict CLI contract) ────────────────────
_WU_REST=()
while [[ $# -gt 0 ]]; do
    consumed=0
    if whtml_extra_parse "$@"; then
        shift "$_WU_EXTRA_CONSUMED"
        consumed=1
    fi
    if [[ "$consumed" -eq 0 ]]; then
        case "$1" in
            --) shift; while [[ $# -gt 0 ]]; do _WU_REST+=("$1"); shift; done; break ;;
            --help|-h)  _whtml_show_help; exit 0 ;;
            --version|-V) echo "whtml $_WU_VERSION"; exit 0 ;;
            --json)     echo "whtml: --json is not supported (this tool emits HTML)" >&2; exit 2 ;;
            --*)        echo "whtml: unknown option: $1" >&2; exit 2 ;;
            *)          _WU_REST+=("$1"); shift ;;
        esac
    fi
done
set -- "${_WU_REST[@]}"

main "$@"
