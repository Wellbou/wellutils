#!/usr/bin/env bash
# whtml -- Rich HTML system report with AI enrichment
# Part of wellutils by wellbou_
set -o pipefail

# ─── Shared libs ────────────────────────────────────────────────
_WU_TOOLNAME="whtml" _WU_NAME="WellHTML" _WU_VERSION="1.0"
_WU_TAGLINE="Rich HTML system report with AI enrichment"
_WU_BOOT_DIR="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="/usr/share/wellutils"
source "$_WU_BOOT_DIR/bootstrap.sh" lang box cli

_WU_EXTRA_HELP="      --output FILE           save HTML to FILE (default: /tmp/wellreport.html)
      --no-ai                 skip AI enrichment
      --no-open               do not auto-open in browser
      --no-cache              do not use cached AI descriptions"
_WU_EXTRA_PARSE=whtml_extra_parse
_WU_EXTRA_CONSUMED=0

_WHTML_OUTPUT="/tmp/wellreport.html"
_WHTML_AI=1
_WHTML_OPEN=1
_WHTML_CACHE=1
_WHTML_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/wellutils"
_WHTML_CACHE_FILE="$_WHTML_CACHE_DIR/whtml_ai.json"
_WHTML_CACHE_TTL_DAYS=30
_WHTML_TMP=""

whtml_extra_parse() {
    case "$1" in
        --output)
            [[ $# -ge 2 ]] || { printf '%s: --output needs a file path\n' "$_WU_TOOLNAME" >&2; exit 2; }
            _WHTML_OUTPUT="$2"; _WU_EXTRA_CONSUMED=2; return 0 ;;
        --output=*) _WHTML_OUTPUT="${1#*=}"; _WU_EXTRA_CONSUMED=1; return 0 ;;
        --no-ai) _WHTML_AI=0; _WU_EXTRA_CONSUMED=1; return 0 ;;
        --no-open) _WHTML_OPEN=0; _WU_EXTRA_CONSUMED=1; return 0 ;;
        --no-cache) _WHTML_CACHE=0; _WU_EXTRA_CONSUMED=1; return 0 ;;
    esac
    return 1
}

# ─── Helpers ────────────────────────────────────────────────────
_whtml_log() { [[ "${WHXML_DEBUG:-0}" == 1 ]] && printf '  [whtml] %s\n' "$*" >&2 || true; }

_whtml_tool() {
    local out rc
    out="$("$@" --json 2>/dev/null)" && rc=0 || rc=$?
    if [[ -z "$out" ]] || ! printf '%s' "$out" | python3 -c "import json,sys; json.load(sys.stdin)" 2>/dev/null; then
        out='{}'
    fi
    printf '%s' "$out"
}

_whtml_collect_json() {
    # $1 = path   rest = command (tool must support --json)
    local path="${1:-}"; shift || true
    local out
    out="$("$@" --json 2>/dev/null)" || out=''
    if [[ -z "$out" ]] || ! printf '%s' "$out" | python3 -c "import json,sys; json.load(sys.stdin)" 2>/dev/null; then
        out='{}'
    fi
    printf '%s' "$out" > "$path"
}

_whtml_host() {
    local host os ker ver
    host="$(cat /etc/hostname 2>/dev/null || hostname 2>/dev/null || python3 -c "import socket;print(socket.gethostname())" 2>/dev/null || echo unknown)"
    if [[ -f /etc/os-release ]]; then
        os="$(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-Linux}")"
    else
        os="Linux"
    fi
    ker="$(uname -r 2>/dev/null)"
    ver="$(uname -m 2>/dev/null)"
    python3 -c "
import json,sys
print(json.dumps({'host':sys.argv[1],'os':sys.argv[2],'kernel':sys.argv[3],'arch':sys.argv[4]}))
" "$host" "$os" "$ker" "$ver"
}

# ─── Web research (keyless DuckDuckGo HTML) ─────────────────────
_whtml_websearch() {
    local q="$1" html hits=""
    local ua="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36"
    for attempt in 1 2 3; do
        html="$(curl -sS --max-time 15 -A "$ua" "https://html.duckduckgo.com/html/?q=$(python3 -c "import urllib.parse,sys;print(urllib.parse.quote(sys.argv[1]))" "$q")" 2>/dev/null)" || true
        [[ -z "$html" ]] && { sleep 1; continue; }
        hits="$(printf '%s' "$html" | python3 -c "
import sys,re,html as H
t=sys.stdin.read()
snips=re.findall(r'class=\"result__snippet\"[^>]*>(.*?)</a>', t, re.S)
out=[]
for s in snips[:4]:
    s=re.sub(r'<[^>]+>','',s); s=H.unescape(s).strip()
    if s: out.append(s)
print(' | '.join(out))
" 2>/dev/null)" || true
        [[ -n "$hits" ]] && break
        sleep 1
    done
    printf '%s' "$hits"
}

# ─── AI enrichment ───────────────────────────────────────────────
_whtml_signature() {
    local sig
    sig="$(python3 - "$_WHTML_TMP/cpu.json" "$_WHTML_TMP/gpu.json" "$_WHTML_TMP/board.json" "$_WHTML_TMP/mem.json" "$_WHTML_TMP/block.json" "$_WHTML_TMP/sensors.json" "$_WHTML_TMP/doctor.json" "$_WHTML_TMP/per.json" "$_WHTML_TMP/net.json" << 'PYEOF'
import hashlib, json, sys
h=hashlib.sha256()
for p in sys.argv[1:]:
    try:
        d=json.load(open(p))
        h.update(json.dumps(d,sort_keys=True).encode())
    except Exception:
        h.update(b'null')
print(h.hexdigest()[:16])
PYEOF
)"
    printf '%s' "$sig"
}

_whtml_cache_get() {
    [[ "$_WHTML_CACHE" == 1 && -f "$_WHTML_CACHE_FILE" ]] || return 0
    python3 - "$_WHTML_CACHE_FILE" "$1" "$_WHTML_CACHE_TTL_DAYS" << 'PYEOF'
import json, sys, time
f, key, ttl = sys.argv[1], sys.argv[2], int(sys.argv[3])
try:
    db = json.load(open(f))
except Exception:
    sys.exit(0)
e = db.get(key)
if not e: sys.exit(0)
if time.time() - e.get('ts', 0) > ttl*86400:
    sys.exit(0)
print(json.dumps(e.get('data', {}), ensure_ascii=False))
PYEOF
}

_whtml_cache_put() {
    mkdir -p "$_WHTML_CACHE_DIR"
    python3 - "$_WHTML_CACHE_FILE" "$1" "$2" << 'PYEOF'
import json, sys, time
f, key, data = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    db = json.load(open(f))
except Exception:
    db = {}
db[key] = {'ts': time.time(), 'data': json.loads(data)}
json.dump(db, open(f, 'w'), ensure_ascii=False)
PYEOF
}

_whtml_ai_enrich() {
    local lang="$1"
    local ep="https://opencode.ai/zen/v1/chat/completions"

    local web="" cpu_name gpu_name board_name
    cpu_name="$(python3 -c "import json;d=json.load(open('$_WHTML_TMP/cpu.json'));print(d.get('model','') or '')" 2>/dev/null)"
    gpu_name="$(python3 -c "import json;d=json.load(open('$_WHTML_TMP/gpu.json'));print(d.get('name','') or '')" 2>/dev/null)"
    board_name="$(python3 -c "import json;d=json.load(open('$_WHTML_TMP/board.json'));print((d.get('vendor','')+' '+d.get('name','')).strip())" 2>/dev/null)"
    [[ -n "$gpu_name" ]] && web+="GPU: $gpu_name. "
    [[ -n "$cpu_name" ]] && web+="CPU: $cpu_name. "
    [[ -n "$board_name" ]] && web+="Motherboard: $board_name."
    local research=""
    [[ -n "$web" ]] && research="$(_whtml_websearch "$web specifications architecture")"
    printf '%s' "$research" > "$_WHTML_TMP/web.txt"
    _whtml_log "web research: ${research:0:80}..."

    python3 - "$_WHTML_TMP" "$lang" "$ep" "$research" << 'PYEOF'
import json, os, sys, re, subprocess

tmpdir, lang, ep, research = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]

def j(n):
    try: return json.load(open(os.path.join(tmpdir, n)))
    except Exception: return {}

cpu = j('cpu.json'); gpu = j('gpu.json') or {}; board = j('board.json') or {}
mem = j('mem.json') or {}; block = j('block.json') or {}; sensors = j('sensors.json') or {}
doctor = j('doctor.json') or {}; per = j('per.json') or {}; net = j('net.json') or {}
host = j('host.json') or {}

def f(d, *ks):
    cur = d
    for k in ks:
        if isinstance(cur, dict) and k in cur: cur = cur[k]
        else: return None
    return cur

def gb(kb):
    try: return round(int(kb)/1e6, 1)
    except Exception: return None

ctx = {
    "language": lang,
    "host": host,
    "cpu": {
        "model": f(cpu,'model') or f(cpu,'name'),
        "cores": f(cpu,'cores'), "threads": f(cpu,'threads'),
        "sockets": f(cpu,'sockets'),
        "temps_c": [c.get('temp_c') for c in (f(sensors,'cpu_cores') or [])],
        "load": f(sensors,'system','load'),
    },
    "gpu": {
        "name": gpu.get('name'),
        "temp_c": f(sensors,'gpu',0,'temp_c'),
        "fan_percent": f(sensors,'gpu',0,'fan_percent'),
        "power_w": f(sensors,'gpu',0,'power_w'),
        "utilization_percent": f(sensors,'gpu',0,'utilization_percent'),
        "cooler_note": "MSI Twin Frozr dual-fan cooler (0% fan at idle is normal for this design)",
    },
    "board": {"vendor": f(board,'vendor'), "model": f(board,'name') or f(board,'model'), "bios": f(board,'bios','version') or f(board,'bios')},
    "memory": {"total_gb": gb(f(mem,'total_kb')), "used_gb": gb(f(mem,'used_kb')),
               "type": f(mem,'type'), "slots": f(mem,'slots')},
    "storage": {
        "drives": [
            {"name": d.get('name'), "model": d.get('model'),
             "size_gb": round(d.get('size_bytes',0)/1e9,1) if d.get('size_bytes') else None,
             "type": d.get('type'), "rotational": d.get('rotational')}
            for d in (f(block,'disks') or [])
        ]
    },
    "sensors": {"cpu_cores": f(sensors,'cpu_cores'), "gpu": f(sensors,'gpu'), "system": f(sensors,'system')},
    "health_checks": [
        {"check": c.get('check'), "status": c.get('status'), "detail": str(c.get('detail'))}
        for c in (doctor.get('checks') or [])
    ],
    "peripherals": {
        "usb_count": len(per.get('usb', []) or []),
        "usb": [{"name": u.get('name'), "vendor": u.get('vendor'), "class": u.get('class')} for u in (per.get('usb') or [])[:12]],
        "displays": [{"name": d.get('name'), "resolution": d.get('resolution'), "refresh_hz": d.get('refresh_rate') or d.get('refresh')} for d in (per.get('displays') or [])],
        "audio": [{"name": a.get('name'), "driver": a.get('driver')} for a in (per.get('audio') or [])],
        "pci": [{"name": p.get('name'), "class": p.get('class')} for p in (per.get('pci') or [])[:14]],
    },
    "network": [{"name": i.get('name'), "state": i.get('state'), "kind": i.get('kind'), "mac": i.get('mac'), "speed_mbps": i.get('speed_mbps')} for i in (net.get('interfaces') or [])],
    "web_research": research,
}

SYSTEM = f"""You are a hardware analysis assistant embedded in the wellutils Linux toolkit (wellhw, wellsensors, welldoctor, wellnet, wellper, wellblock, wellpower, wellfetch).
Write concise, factual, human-readable descriptions of each component and what the numbers imply for THIS machine.
The user's language is {lang}. Write everything in {lang}.
You may use the provided web_research to explain model families, architectures and cooler designs.
Domain knowledge you may rely on:
- MSI GeForce GTX 1050 Ti uses MSI's Twin Frozr dual-fan cooler; 0% fan at idle is NORMAL and indicates an efficient, quiet cooler, not a fault.
- Intel Xeon E3-1230 V2 is an Ivy Bridge (2012) server-class CPU with no integrated graphics.
- MSI PH61A-P35 is an H61 chipset ATX motherboard.
- A S.M.A.R.T. 'critical' status on a drive means imminent failure risk - advise backup.
Be specific about THIS hardware. Mention significance (cooler behaviour, upgrade paths, bottlenecks). Keep each description 1-3 sentences.
Output ONLY a JSON object (no markdown, no code fences) with exactly these keys:
cpu_desc, gpu_desc, board_desc, ram_desc, storage_desc, periph_desc, net_desc, thermal_desc, health_desc, summary.
Each value is a string in {lang}."""

USER = "System context (JSON):\n" + json.dumps(ctx, ensure_ascii=False, indent=1)

payload = {
    "model": "hy3-free",
    "messages": [
        {"role": "system", "content": SYSTEM},
        {"role": "user", "content": USER},
    ],
    "temperature": 0.4,
    "max_tokens": 2000,
    "reasoning_effort": "none",
}

req_path = os.path.join(tmpdir, 'ai_req.json')
with open(req_path, 'w') as fp:
    json.dump(payload, fp, ensure_ascii=False)

try:
    proc = subprocess.run(
        ["curl", "-sS", "--max-time", "150", "-H", "Content-Type: application/json",
         "--data", "@" + req_path, ep],
        capture_output=True, text=True, timeout=160,
    )
    resp = json.loads(proc.stdout)
    content = resp["choices"][0]["message"]["content"]
except Exception as e:
    sys.stderr.write("AI request failed: %r\n" % e)
    content = ""

data = {}
if content:
    m = re.search(r"\{.*\}", content, re.DOTALL)
    if m:
        try:
            data = json.loads(m.group(0))
        except Exception as e:
            sys.stderr.write("AI parse failed: %r\n" % e)

if not data:
    data = {k: "" for k in ["cpu_desc","gpu_desc","board_desc","ram_desc","storage_desc",
                            "periph_desc","net_desc","thermal_desc","health_desc","summary"]}

with open(os.path.join(tmpdir, 'ai.json'), 'w') as fp:
    json.dump(data, fp, ensure_ascii=False, indent=2)
PYEOF
}

# ─── HTML generation ────────────────────────────────────────────
_whtml_generate() {
    python3 - "$_WHTML_TMP" "$(date +%Y-%m-%d\ %H:%M)" "$_WU_VERSION" "$_WHTML_AI" "$WELLUTILS_LANG" << 'PYEOF'
