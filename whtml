main{flex:1;padding:18px;max-width:980px;width:100%;margin:0 auto}
.panel{display:none;background:var(--panel);border:1px solid var(--bd);border-radius:8px;padding:6px 14px;overflow-x:auto}
.panel.active{display:block}
table{border-collapse:collapse;width:100%}
td{padding:7px 10px;border-bottom:1px solid var(--panel2);vertical-align:top}
td.lbl{color:var(--muted);width:210px;font-weight:600;white-space:nowrap}
td.lbl::before{content:"$ ";color:var(--dim)}
td.val b{color:var(--grn)}
td.ai{background:var(--hlbg);color:var(--fg);font-style:normal}
td.ai::before{content:"ai ";color:var(--cyn);font-weight:700}
.mini{margin:2px 0;font-size:12.5px}
.mini td{border-bottom:1px solid var(--panel2);padding:3px 8px}
.mini td::before{content:none}
.muted{color:var(--muted)}
.badge{border-radius:4px;padding:1px 7px;font-size:10.5px;font-weight:700}
.badge.ok{color:#1e2b1a;background:var(--grn)}
.badge.warn{color:#1e2b1a;background:var(--ylw)}
.badge.crit{color:#fff;background:var(--red)}
.badge.info{color:var(--fg);background:var(--dim)}
.tag{color:var(--pur)}
footer{padding:14px 20px;text-align:center;color:var(--muted);font-size:11px;border-top:1px solid var(--bd)}
footer .hint{color:var(--dim)}
#help{display:none;position:fixed;inset:0;z-index:40;background:rgba(0,0,0,.6);align-items:center;justify-content:center}
#help.open{display:flex}
#help .box{background:var(--panel);border:1px solid var(--grn);border-radius:8px;max-width:560px;width:90%;
 padding:20px 24px;color:var(--fg);box-shadow:0 10px 40px rgba(0,0,0,.5)}
#help h2{color:var(--grn);font-size:14px;margin:0 0 12px;letter-spacing:.5px;text-transform:uppercase}
#help .row{display:flex;justify-content:space-between;gap:20px;padding:5px 0;border-bottom:1px solid var(--panel2);font-size:13px}
#help .row .k{color:var(--cyn);font-weight:700}
#help .close{margin-top:14px;text-align:right;color:var(--muted);font-size:11px}
.hl{background:var(--ylw);color:#1e2b1a;border-radius:2px}
@media (max-width:760px){td.lbl{width:130px}}
