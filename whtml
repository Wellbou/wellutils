tmpdir, ts, wu_ver, ai_enabled_s, lang = sys.argv[1:6]
ai_enabled = ai_enabled_s == '1'

def load(name):
    try: return json.load(open(os.path.join(tmpdir, name)))
    except Exception: return {}

host = load('host.json') or {}
cpu = load('cpu.json') or {}; gpu = load('gpu.json') or {}; board = load('board.json') or {}
mem = load('mem.json') or {}; net = load('net.json') or {}; per = load('per.json') or {}
sensors = load('sensors.json') or {}; doctor = load('doctor.json') or {}; block = load('block.json') or {}

ai = {}
if ai_enabled:
    try:
        af = os.path.join(tmpdir, 'ai.json')
        if os.path.exists(af):
            ai = load('ai.json')
    except Exception:
        pass

def e(s):
    return h.escape(str(s)) if s not in (None, '') else ''

def row(lbl, val, cls=''):
    c = f' class="{cls}"' if cls else ''
    return f'<tr><td class="lbl">{e(lbl)}</td><td{c}>{e(val)}</td></tr>'

def airow(key, default=''):
    v = e(ai.get(key, '')) or e(default)
    if not v: return ''
    return f'<tr><td class="lbl"><span class="ai-badge">AI</span></td><td class="desc">{v}</td></tr>'

def badge(status):
    s = (status or '').lower()
    cls = 'ok' if s == 'ok' else ('warn' if s == 'warning' else ('crit' if s in ('critical','fail','failed') else 'info'))
    label = {'ok':'OK','warning':'WARN','critical':'CRIT','fail':'FAIL','failed':'FAIL','info':'INFO'}.get(s.upper(), (status or '').upper())
    return f'<span class="badge {cls}">{e(label)}</span>'

TR = {
 'RU': ['Обзор','Процессор','Видеокарта','Память','Диски и S.M.A.R.T.','Периферия','Сеть','Температуры','Здоровье','ИИ-анализ'],
 'EN': ['Overview','CPU','GPU','Memory','Disks & S.M.A.R.T.','Peripherals','Network','Thermal','Health','AI Analysis'],
}
L = TR.get(lang, TR['EN'])
R = lambda ru, en: (ru if lang == 'RU' else en)

