#!/usr/bin/env bash
# whtml -- Rich, self-contained HTML system report (offline, read-only)
# Part of wellutils by wellbou_
#
# INVARIANT: this tool makes NO network requests by default. The only way it
# ever contacts a server is the OPTIONAL, OFF-BY-DEFAULT AI enrichment, which
# requires the user to supply their own endpoint (WHTML_AI_ENDPOINT) and pass
# --ai. No endpoint is hardcoded. See the wellutils README ("AI enrichment").
set -o pipefail

# ─── Shared libs ────────────────────────────────────────────────
_WU_TOOLNAME="whtml" _WU_NAME="whtml" _WU_VERSION="1.2"
_WU_TAGLINE="Rich, self-contained HTML system report (offline)"
_WU_BOOT_DIR="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="/usr/share/wellutils"
source "$_WU_BOOT_DIR/bootstrap.sh" lang box cli

_WU_EXTRA_HELP="      --output FILE           save HTML to FILE (default: ~/wellreport.html)
      --no-open               do not auto-open in browser
      --open                  force open in browser
      --ai                    optional AI analysis (needs WHTML_AI_ENDPOINT; OFF by default)"
_WU_EXTRA_PARSE=whtml_extra_parse
_WU_EXTRA_CONSUMED=0

_WHTML_OUTPUT="${HOME:-/tmp}/wellreport.html"
_WHTML_OPEN=1
_WWHTML_AI=0

whtml_extra_parse() {
    case "$1" in
        --output)
            [[ $# -ge 2 ]] || { printf '%s: --output needs a file path\n' "$_WU_TOOLNAME" >&2; exit 2; }
            _WHTML_OUTPUT="$2"; _WU_EXTRA_CONSUMED=2; return 0 ;;
        --output=*) _WHTML_OUTPUT="${1#*=}"; _WU_EXTRA_CONSUMED=1; return 0 ;;
        --no-open) _WHTML_OPEN=0; _WU_EXTRA_CONSUMED=1; return 0 ;;
        --open) _WHTML_OPEN=1; _WU_EXTRA_CONSUMED=1; return 0 ;;
        --ai) _WHTML_AI=1; _WU_EXTRA_CONSUMED=1; return 0 ;;
        --no-ai) _WHTML_AI=0; _WU_EXTRA_CONSUMED=1; return 0 ;;
    esac
    return 1
}

# ─── Help ───────────────────────────────────────────────────────
_whtml_show_help() {
    cat <<EOF
$_WU_NAME $_WU_VERSION - $_WU_TAGLINE

Usage: $_WU_TOOLNAME [options]

  --output FILE   save HTML to FILE (default: ~/wellreport.html)
  --no-open       do not auto-open the report in a browser
  --open          force open in browser
  --ai            OPTIONAL AI analysis. Requires WHTML_AI_ENDPOINT to be set
                  (bring-your-own endpoint, OpenAI-compatible). OFF by default;
                  without it this tool makes zero network requests.
  --help, -h      this help
  --version, -V   print version

Collects data from the wellutils suite via their --json output and renders a
single self-contained HTML file (no external resources, no network access).
EOF
}

# ─── Helpers ────────────────────────────────────────────────────
_whtml_log() { [[ "${WHTML_DEBUG:-0}" == 1 ]] && printf '  [whtml] %s\n' "$*" >&2 || true; }

_whtml_collect_json() {
    local path="${1:-}"; shift || true
    local out
    out="$("$@" --json 2>/dev/null)" || out=''
    if [[ -z "$out" ]] || ! printf '%s' "$out" | python3 -c "import json,sys; json.load(sys.stdin)" 2>/dev/null; then
        out='{}'
    fi
    printf '%s' "$out" > "$path"
}

_whtml_host() {
    local host os ker ver
    host="$(cat /etc/hostname 2>/dev/null || hostname 2>/dev/null || python3 -c "import socket;print(socket.gethostname())" 2>/dev/null || echo unknown)"
    if [[ -f /etc/os-release ]]; then
        os="$(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-Linux}")"
    else
        os="Linux"
    fi
    ker="$(uname -r 2>/dev/null)"; ver="$(uname -m 2>/dev/null)"
    python3 -c "import json,sys;print(json.dumps({'host':sys.argv[1],'os':sys.argv[2],'kernel':sys.argv[3],'arch':sys.argv[4]}))" "$host" "$os" "$ker" "$ver"
}

# ─── Optional, OFF-BY-DEFAULT AI enrichment ─────────────────────
# Endpoint is BYO (no default). Context is sanitized (MAC/hostname/serial out).
# Failure never breaks the report. Uses python urllib (no curl/wget).
_whtml_ai_enrich() {
    local endpoint="${WHTML_AI_ENDPOINT:-}"
    local model="${WHTML_AI_MODEL:-}"
    if [[ -z "$endpoint" ]]; then
        echo "whtml: --ai: WHTML_AI_ENDPOINT is not set; skipping AI (staying offline)." >&2
        return 0
    fi
    _whtml_log "AI enrichment -> $endpoint"
    python3 - "$_WHTML_TMP" "$endpoint" "$model" "$WELLUTILS_LANG" << 'PYEOF'
import json, os, sys, urllib.request, urllib.error

tmp, endpoint, model, lang = sys.argv[1:5]

# Recursively strip identifying fields from the context.
import re as _re
_BAD = ("mac", "serial", "serial_number", "hostname", "host", "uuid", "uuid_",
        "addr", "address", "ip", "ipv4", "ipv6", "inet", "local", "gateway", "dns")
_IPRE = _re.compile(r"\b(?:\d{1,3}\.){3}\d{1,3}\b")
def strip(o):
    if isinstance(o, dict):
        return {k: strip(v) for k, v in o.items() if k.lower() not in _BAD}
    if isinstance(o, list):
        return [strip(x) for x in o]
    if isinstance(o, str):
        return _IPRE.sub("<ip>", o)
    return o

def load(name):
    try:
        d = json.load(open(os.path.join(tmp, name)))
        return d if isinstance(d, dict) else {}
    except Exception:
        return {}

data = {
    "host": strip(load("host.json")),
    "cpu": strip(load("cpu.json")),
    "gpu": strip(load("gpu.json")),
    "board": strip(load("board.json")),
    "memory": strip(load("mem.json")),
    "network": strip(load("net.json")),
    "peripherals": strip(load("per.json")),
    "sensors": strip(load("sensors.json")),
    "health": strip(load("doctor.json")),
    "block": strip(load("block.json")),
}

system = ("You are a concise senior sysadmin writing short hardware report notes. "
          "Return ONLY a JSON object with these keys, each a 1-2 sentence note in "
          + ("Russian" if lang == "RU" else "English")
          + ": overview, cpu, gpu, memory, disks, peripherals, network, thermal, "
            "health, full. Do not invent numbers; comment only on what the data shows. "
            "Note that 0% fan at idle is normal on zero-RPM coolers.")

user = "Analyze this sanitized hardware summary:\n" + json.dumps(data, ensure_ascii=False)[:6000]

payload = {
    "model": model or "local-model",
    "messages": [
        {"role": "system", "content": system},
        {"role": "user", "content": user},
    ],
    "max_tokens": 900,
    "temperature": 0.3,
}
req = urllib.request.Request(
    endpoint,
    data=json.dumps(payload).encode(),
    headers={"Content-Type": "application/json"},
)
try:
    with urllib.request.urlopen(req, timeout=40) as r:
        resp = json.loads(r.read().decode())
    content = resp["choices"][0]["message"]["content"]
    ai = json.loads(content)
    json.dump(ai, open(os.path.join(tmp, "ai.json"), "w"), ensure_ascii=False)
except Exception as ex:
    sys.stderr.write("whtml: AI enrichment failed (%s); continuing without it.\n" % ex)
PYEOF
}

# ─── HTML generation ────────────────────────────────────────────
_whtml_generate() {
    python3 - "$_WHTML_TMP" "$(date +%Y-%m-%d\ %H:%M)" "$_WU_VERSION" "$WELLUTILS_LANG" << 'PYEOF'
import json, os, html as h, sys

tmpdir, ts, wu_ver, lang = sys.argv[1:5]

def load(name):
    try:
        d = json.load(open(os.path.join(tmpdir, name)))
        return d if isinstance(d, dict) else {}
    except Exception:
        return {}

def run():
    host = load('host.json'); cpu = load('cpu.json'); gpu = load('gpu.json')
    board = load('board.json'); mem = load('mem.json'); net = load('net.json')
    per = load('per.json'); sensors = load('sensors.json')
    doctor = load('doctor.json'); block = load('block.json')
    try:
        ai = json.load(open(os.path.join(tmpdir, 'ai.json')))
    except Exception:
        ai = {}

    def e(s):
        return h.escape(str(s)) if s not in (None, '') else ''

    def row(lbl, val, cls=''):
        c = f' class="{cls}"' if cls else ''
        return f'<tr><td class="lbl">{e(lbl)}</td><td{c}>{e(val)}</td></tr>'

    def airow(key):
        t = ai.get(key) if isinstance(ai, dict) else None
        if not t:
            return ''
        return f'<tr><td class="lbl ai">AI</td><td class="ai">{e(t)}</td></tr>'

    def badge(status):
        s = (status or '').lower()
        cls = 'ok' if s == 'ok' else ('warn' if s == 'warning' else ('crit' if s in ('critical','fail','failed') else 'info'))
        label = {'ok':'OK','warning':'WARN','critical':'CRIT','fail':'FAIL','failed':'FAIL','info':'INFO'}.get(s.upper(), (status or '').upper())
        return f'<span class="badge {cls}">{e(label)}</span>'

    TR = {
     'RU': ['Обзор','Процессор','Видеокарта','Память','Диски и S.M.A.R.T.','Периферия','Сеть','Температуры','Здоровье'],
     'EN': ['Overview','CPU','GPU','Memory','Disks & S.M.A.R.T.','Peripherals','Network','Thermal','Health'],
    }
    L = TR.get(lang, TR['EN'])
    R = lambda ru, en: (ru if lang == 'RU' else en)

    def gv(d, *ks):
        cur = d
        for k in ks:
            if isinstance(cur, dict) and k in cur: cur = cur[k]
            else: return None
        return cur

    # ── Tab 0: Overview ──
    t0 = [airow('overview')]
    t0.append(row(R('Имя хоста','Hostname'), host.get('host','')))
    t0.append(row(R('ОС','OS'), f"{host.get('os','')} {host.get('arch','')}".strip()))
    t0.append(row(R('Ядро','Kernel'), host.get('kernel','')))
    t0.append(row(R('Время работы','Uptime'), gv(sensors,'system','uptime') or gv(cpu,'uptime') or ''))
    t0.append(row(R('Процессор','CPU'), gv(cpu,'model') or gv(cpu,'name') or ''))
    t0.append(row(R('Видеокарта','GPU'), gpu.get('name','') or gv(sensors,'gpu',0,'name') or ''))
    tk = gv(mem,'total_kb'); mem_gb = (round(tk/1e6,1) if tk else (gv(mem,'total_gb') or '')) if isinstance(mem, dict) else ''
    t0.append(row(R('Память','Memory'), (f"{mem_gb} ГБ" if mem_gb else '')))

    # ── Tab 1: CPU ──
    t1 = [airow('cpu')]
    t1.append(row(R('Модель','Model'), gv(cpu,'model') or gv(cpu,'name') or ''))
    t1.append(row(R('Сокет','Socket'), gv(cpu,'sockets') or ''))
    t1.append(row(R('Ядра / потоки','Cores / threads'), f"{gv(cpu,'cores') or '?'} / {gv(cpu,'threads') or '?'}" if (gv(cpu,'cores') or gv(cpu,'threads')) else ''))
    t1.append(row(R('Макс. частота','Max freq'), gv(cpu,'max_freq_ghz') or gv(cpu,'max_freq_mhz') or ''))
    t1.append(row(R('Загрузка','Load avg'), gv(sensors,'system','load') or ''))
    cores = gv(sensors,'cpu_cores') or []
    if cores:
        t1.append(f'<tr><td class="lbl">{R("Температуры ядер","Core temps")}</td><td><table class="mini">')
        for c in cores:
            t1.append(f'<tr><td>{e(c.get("label",""))}</td><td>{e(c.get("temp_c"))}°C</td></tr>')
        t1.append('</table></td></tr>')

    # ── Tab 2: GPU ──
    gp = gv(sensors,'gpu')
    if isinstance(gp, list): gp = gp[0] if gp else {}
    if not isinstance(gp, dict): gp = {}
    t2 = [airow('gpu')]
    t2.append(row(R('Модель','Model'), gpu.get('name','') or gp.get('name','')))
    t2.append(row(R('Драйвер','Driver'), gpu.get('driver','') or gp.get('driver','')))
    vram = gpu.get('vram_total_mib') or gp.get('vram_total_mib')
    t2.append(row(R('Память','VRAM'), f"{vram} МБ" if vram else ''))
    t2.append(row(R('Температура','Temp'), f"{gp.get('temp_c')}°C" if gp.get('temp_c') is not None else ''))
    t2.append(row(R('Вентилятор','Fan'), f"{gp.get('fan_percent')}%" if gp.get('fan_percent') is not None else ''))
    t2.append(row(R('Энергопотребление','Power'), f"{gp.get('power_w')} Вт" if gp.get('power_w') is not None else ''))
    t2.append(row(R('Загрузка','Utilization'), f"{gp.get('utilization_percent')}%" if gp.get('utilization_percent') is not None else ''))
    t2.append(row(R('Частоты','Clocks'), f"GPU {gp.get('clock_gpu_mhz') or '?'} МГц / MEM {gp.get('clock_mem_mhz') or '?'} МГц"))

    # ── Tab 3: Memory ──
    t3 = [airow('memory')]
    if isinstance(mem, dict):
        tk = gv(mem,'total_kb'); uk = gv(mem,'used_kb')
        tg = round(tk/1e6,1) if tk else (gv(mem,'total_gb') or '')
        ug = round(uk/1e6,1) if uk else ''
        t3.append(row(R('Всего','Total'), (f"{tg} ГБ" if tg else '')))
        t3.append(row(R('Тип','Type'), gv(mem,'type') or ''))
        t3.append(row(R('Использовано','Used'), (f"{ug} / {tg} ГБ" if (ug and tg) else '')))
        slots = gv(mem,'slots') or []
        if isinstance(slots, list) and slots:
            t3.append(f'<tr><td class="lbl">{R("Слоты","Slots")}</td><td><table class="mini">')
            for s in slots:
                if isinstance(s, dict):
                    t3.append(f'<tr><td>{e(s.get("bank","") or s.get("locator",""))}</td><td>{e(s.get("size_gb") or s.get("size_mb") or "")}</td><td>{e(s.get("type",""))}</td></tr>')
            t3.append('</table></td></tr>')
    else:
        t3.append(row('', R('Нет данных','No data')))

    # ── Tab 4: Disks & S.M.A.R.T. ──
    t4 = [airow('disks')]
    disks = gv(block,'disks') or []
    smart = {}
    for c in (doctor.get('checks') or []):
        ck = c.get('check','')
        if ck.startswith('smart_'):
            smart[ck.replace('smart_','')] = c.get('status')
    for d in disks:
        nm = d.get('name','')
        size = d.get('size_bytes')
        size_s = f"{size/1e9:.0f} ГБ" if size else ''
        t4.append(row(nm, f"{d.get('model','')} - {size_s} ({d.get('type','')})"))
        st = smart.get(nm)
        if st:
            t4.append(f'<tr><td class="lbl">S.M.A.R.T.</td><td>{badge(st)} {e(str(d.get("detail","")).strip())}</td></tr>')
        parts = d.get('partitions') or []
        if parts:
            t4.append('<tr><td class="lbl">Разделы</td><td><table class="mini">')
            for p in parts:
                t4.append(f'<tr><td>{e(p.get("name",""))}</td><td>{e(p.get("fs_type",""))}</td><td>{e(p.get("mountpoint",""))}</td></tr>')
            t4.append('</table></td></tr>')
    if not disks:
        t4.append(row('', '-'))

    # ── Tab 5: Peripherals ──
    t5 = [airow('peripherals')]
    usb = per.get('usb') or []
    if usb:
        t5.append(f'<tr><td class="lbl">USB ({len(usb)})</td><td><table class="mini">')
        for u in usb[:16]:
            t5.append(f'<tr><td>{e(u.get("name",""))}</td><td>{e(u.get("vendor",""))}</td><td class="muted">{e(u.get("class",""))}</td></tr>')
        t5.append('</table></td></tr>')
    disp = per.get('displays') or []
    if disp:
        t5.append(f'<tr><td class="lbl">{R("Дисплеи","Displays")}</td><td><table class="mini">')
        for dd in disp:
            t5.append(f'<tr><td>{e(dd.get("name",""))}</td><td>{e(dd.get("resolution",""))}</td><td>{e(dd.get("refresh_rate") or dd.get("refresh") or "")} Гц</td></tr>')
        t5.append('</table></td></tr>')
    aud = per.get('audio') or []
    if aud:
        t5.append(f'<tr><td class="lbl">{R("Аудио","Audio")}</td><td><table class="mini">')
        for a in aud:
            t5.append(f'<tr><td>{e(a.get("name",""))}</td><td class="muted">{e(a.get("driver",""))}</td></tr>')
        t5.append('</table></td></tr>')
    pci = per.get('pci') or []
    if pci:
        t5.append(f'<tr><td class="lbl">PCI ({len(pci)})</td><td><table class="mini">')
        for p in pci[:16]:
            t5.append(f'<tr><td>{e(p.get("name",""))}</td><td class="muted">{e(p.get("class",""))}</td></tr>')
        t5.append('</table></td></tr>')
    if not any([usb,disp,aud,pci]):
        t5.append(row('', '-'))

    # ── Tab 6: Network ──
    t6 = [airow('network')]
    ifs = net.get('interfaces') or []
    for i in ifs:
        t6.append(row(i.get('name',''), f'{i.get("kind","")} - {i.get("state","")}' + (f' - {i.get("speed_mbps")} Мбит/с' if i.get('speed_mbps') else '')))
    if not ifs:
        t6.append(row('', '-'))

    # ── Tab 7: Thermal & Fans ──
    t7 = [airow('thermal')]
    cores = gv(sensors,'cpu_cores') or []
    if cores:
        t7.append(f'<tr><td class="lbl">{R("Процессор","CPU")}</td><td><table class="mini">')
        for c in cores:
            t7.append(f'<tr><td>{e(c.get("label",""))}</td><td>{e(c.get("temp_c"))}°C</td></tr>')
        t7.append('</table></td></tr>')
    if gp:
        t7.append(row('GPU', (f"{gp.get('temp_c')}°C - {gp.get('fan_percent')}% - {gp.get('power_w')} Вт" if gp.get('power_w') is not None else f"{gp.get('temp_c')}°C - {gp.get('fan_percent')}%")))
    if gv(sensors,'system','memory_percent'):
        t7.append(row(R('Память','Memory'), f"{gv(sensors,'system','memory_percent')}%"))

    # ── Tab 8: Health ──
    t8 = [airow('health')]
    crit = gv(doctor,'summary','critical') or 0
    warn = gv(doctor,'summary','warnings') or 0
    try:
        score = max(0, 100 - int(crit)*15 - int(warn)*5)
    except Exception:
        score = 100
    t8.append(row(R('Оценка здоровья','Health score'), f"{score}/100"))
    for c in (doctor.get('checks') or []):
        t8.append(f'<tr><td class="lbl">{badge(c.get("status"))}</td><td>{e(c.get("check",""))} - {e(c.get("detail",""))}</td></tr>')
    if not (doctor.get('checks') or []):
        t8.append(row('', '-'))

    panels = ['\n'.join(t) for t in [t0,t1,t2,t3,t4,t5,t6,t7,t8]]

    if ai:
        ta = ['<tr><td class="lbl ai">AI</td><td class="ai">' + e(ai.get('full')) + '</td></tr>']
        panels.append('\n'.join(ta))
        L = L + [R('ИИ-анализ','AI Analysis')]

    css = """
:root{
 --bg:#0d0f14; --panel:#14171e; --panel2:#1c2029; --bd:#262c38;
 --fg:#c8d2dc; --muted:#5f6b7a; --dim:#3a4350;
 --grn:#8ec07c; --grn2:#6bbf63; --cyn:#79b8c9; --pur:#b08fd6; --blu:#7aa2f7;
 --ylw:#e5c07b; --red:#e06666; --hl:#8ec07c; --hlbg:#8ec07c22;
}
[data-theme="light"]{
 --bg:#f5f6f8; --panel:#ffffff; --panel2:#eef1f5; --bd:#d8dde4;
 --fg:#1c232b; --muted:#5a6673; --dim:#b0b8c2;
 --grn:#4f8c3a; --grn2:#3f8f34; --cyn:#2a7a96; --pur:#7d5bb0; --blu:#2f5fd0;
 --ylw:#9a6b00; --red:#c0392b; --hl:#4f8c3a; --hlbg:#4f8c3a1a;
}
