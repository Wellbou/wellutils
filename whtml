#!/usr/bin/env bash
# whtml -- Rich, self-contained HTML system report (offline, read-only)
# Part of wellutils by wellbou_
#
# INVARIANT: this tool makes NO network requests by default. The only way it
# ever contacts a server is the OPTIONAL, OFF-BY-DEFAULT AI enrichment, which
# requires the user to supply their own endpoint (WHTML_AI_ENDPOINT) and pass
# --ai. No endpoint is hardcoded. See the wellutils README ("AI enrichment").
set -o pipefail

# ─── Shared libs ────────────────────────────────────────────────
_WU_TOOLNAME="whtml" _WU_NAME="whtml" _WU_VERSION="1.2"
_WU_TAGLINE="Rich, self-contained HTML system report (offline)"
_WU_BOOT_DIR="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="$(dirname -- "$_WU_BOOT_DIR")/share/wellutils"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="/usr/local/share/wellutils"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="/usr/share/wellutils"
source "$_WU_BOOT_DIR/bootstrap.sh" lang box cli

_WU_EXTRA_HELP="      --output FILE           save HTML to FILE (default: ~/wellreport.html)
      --no-open               do not auto-open in browser
      --open                  force open in browser
      --ami                   render the classic AMI BIOS 2000s setup look (English only,
                              xb-16 palette & embedded VGA font)
      --ai                    optional AI analysis (needs WHTML_AI_ENDPOINT; OFF by default)"
_WU_EXTRA_PARSE=whtml_extra_parse
_WU_EXTRA_CONSUMED=0

_WHTML_OUTPUT="${HOME:-/tmp}/wellreport.html"
_WHTML_OPEN=1
_WHTML_AI=0
_WHTML_AMI=0
_WHTML_FONT_B64=""

whtml_extra_parse() {
    case "$1" in
        --output)
            [[ $# -ge 2 ]] || { printf '%s: --output needs a file path\n' "$_WU_TOOLNAME" >&2; exit 2; }
            _WHTML_OUTPUT="$2"; _WU_EXTRA_CONSUMED=2; return 0 ;;
        --output=*) _WHTML_OUTPUT="${1#*=}"; _WU_EXTRA_CONSUMED=1; return 0 ;;
        --no-open) _WHTML_OPEN=0; _WU_EXTRA_CONSUMED=1; return 0 ;;
        --open) _WHTML_OPEN=1; _WU_EXTRA_CONSUMED=1; return 0 ;;
        --ami) _WHTML_AMI=1; _WU_EXTRA_CONSUMED=1; return 0 ;;
        --ai) _WHTML_AI=1; _WU_EXTRA_CONSUMED=1; return 0 ;;
        --no-ai) _WHTML_AI=0; _WU_EXTRA_CONSUMED=1; return 0 ;;
    esac
    return 1
}

# ─── Help ───────────────────────────────────────────────────────
_whtml_show_help() {
    cat <<EOF
$_WU_NAME $_WU_VERSION - $_WU_TAGLINE

Usage: $_WU_TOOLNAME [options]

  --output FILE   save HTML to FILE (default: ~/wellreport.html)
  --no-open       do not auto-open the report in a browser
  --open          force open in browser
  --ami           render the classic AMI BIOS 2000s setup look (English only,
                  xb-16 palette & embedded VGA font)
  --ai            OPTIONAL AI analysis. Requires WHTML_AI_ENDPOINT to be set
                  (bring-your-own endpoint, OpenAI-compatible). OFF by default;
                  without it this tool makes zero network requests.
  --help, -h      this help
  --version, -V   print version

Collects data from the wellutils suite via their --json output and renders a
single self-contained HTML file (no external resources, no network access).
EOF
}

# ─── Helpers ────────────────────────────────────────────────────
_whtml_log() { [[ "${WHTML_DEBUG:-0}" == 1 ]] && printf '  [whtml] %s\n' "$*" >&2 || true; }

# Resolve a sibling tool to a runnable path. Consumers may be running from
# a checkout (tools adjacent to whtml), from an installation (tools in
# ../bin relative to the LIBDIR), or purely via PATH.
_whtml_tool() {
    local name="$1" cand
    for cand in "$_WU_BOOT_DIR/$name" "$(dirname "$_WU_BOOT_DIR")/bin/$name" "$(dirname "$_WU_BOOT_DIR")/$name"; do
        [[ -x "$cand" ]] && { printf '%s' "$cand"; return 0; }
    done
    if command -v "$name" >/dev/null 2>&1; then
        printf '%s' "$(command -v "$name")"
        return 0
    fi
    return 1
}

_whtml_collect_json() {
    local path="$1" name="$2" tool out
    tool=$(_whtml_tool "$name") || return 0
    out="$("$tool" --json 2>/dev/null || true)"
    if [[ -z "$out" ]] || ! printf '%s' "$out" | python3 -c "import json,sys; json.load(sys.stdin)" 2>/dev/null; then
        out='{}'
    fi
    printf '%s' "$out" > "$path"
}

_whtml_host() {
    local host os ker ver
    host="$(cat /etc/hostname 2>/dev/null || hostname 2>/dev/null || python3 -c "import socket;print(socket.gethostname())" 2>/dev/null || echo unknown)"
    if [[ -f /etc/os-release ]]; then
        os="$(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-Linux}")"
    else
        os="Linux"
    fi
    ker="$(uname -r 2>/dev/null)"; ver="$(uname -m 2>/dev/null)"
    python3 -c "import json,sys;print(json.dumps({'host':sys.argv[1],'os':sys.argv[2],'kernel':sys.argv[3],'arch':sys.argv[4]}))" "$host" "$os" "$ker" "$ver"
}

# ─── Optional, OFF-BY-DEFAULT AI enrichment ─────────────────────
# Endpoint is BYO (no default). Context is sanitized (MAC/hostname/serial out).
# Failure never breaks the report. Uses python urllib (no curl/wget).
_whtml_ai_enrich() {
    local endpoint="${WHTML_AI_ENDPOINT:-}"
    local model="${WHTML_AI_MODEL:-}"
    if [[ -z "$endpoint" ]]; then
        echo "whtml: --ai: WHTML_AI_ENDPOINT is not set; skipping AI (staying offline)." >&2
        return 0
    fi
    _whtml_log "AI enrichment -> $endpoint"
    python3 - "$_WHTML_TMP" "$endpoint" "$model" "$WELLUTILS_LANG" << 'PYEOF'
import json, os, sys, urllib.request, urllib.error

tmp, endpoint, model, lang = sys.argv[1:5]

# Recursively strip identifying fields from the context.
import re as _re
_BAD = ("mac", "serial", "serial_number", "hostname", "host", "uuid", "uuid_",
        "addr", "address", "ip", "ipv4", "ipv6", "inet", "local", "gateway", "dns")
_IPRE = _re.compile(r"\b(?:\d{1,3}\.){3}\d{1,3}\b")
def strip(o):
    if isinstance(o, dict):
        return {k: strip(v) for k, v in o.items() if k.lower() not in _BAD}
    if isinstance(o, list):
        return [strip(x) for x in o]
    if isinstance(o, str):
        return _IPRE.sub("<ip>", o)
    return o

def load(name):
    try:
        d = json.load(open(os.path.join(tmp, name)))
        return d if isinstance(d, dict) else {}
    except Exception:
        return {}

data = {
    "host": strip(load("host.json")),
    "cpu": strip(load("cpu.json")),
    "gpu": strip(load("gpu.json")),
    "board": strip(load("board.json")),
    "memory": strip(load("mem.json")),
    "network": strip(load("net.json")),
    "peripherals": strip(load("per.json")),
    "sensors": strip(load("sensors.json")),
    "health": strip(load("doctor.json")),
    "block": strip(load("block.json")),
}

system = ("You are a concise senior sysadmin writing short hardware report notes. "
          "Return ONLY a JSON object with these keys, each a 1-2 sentence note in "
          + ("Russian" if lang == "RU" else "English")
          + ": overview, cpu, gpu, memory, disks, peripherals, network, thermal, "
            "health, full. Do not invent numbers; comment only on what the data shows. "
            "Note that 0% fan at idle is normal on zero-RPM coolers.")

user = "Analyze this sanitized hardware summary:\n" + json.dumps(data, ensure_ascii=False)[:6000]

payload = {
    "model": model or "local-model",
    "messages": [
        {"role": "system", "content": system},
        {"role": "user", "content": user},
    ],
    "max_tokens": 900,
    "temperature": 0.3,
}
req = urllib.request.Request(
    endpoint,
    data=json.dumps(payload).encode(),
    headers={"Content-Type": "application/json"},
)
try:
    with urllib.request.urlopen(req, timeout=40) as r:
        resp = json.loads(r.read().decode())
    content = resp["choices"][0]["message"]["content"]
    ai = json.loads(content)
    json.dump(ai, open(os.path.join(tmp, "ai.json"), "w"), ensure_ascii=False)
except Exception as ex:
    sys.stderr.write("whtml: AI enrichment failed (%s); continuing without it.\n" % ex)
PYEOF
}

# ─── HTML generation ────────────────────────────────────────────
_whtml_generate() {
    WHTML_FONT_B64="$_WHTML_FONT_B64" python3 - "$_WHTML_TMP" "$(date +%Y-%m-%d\ %H:%M)" "$_WU_VERSION" "$WELLUTILS_LANG" "$_WHTML_AMI" << 'PYEOF'
# whtml generator (self-contained)
import json, os, html as h, sys, re

tmpdir, ts, wu_ver, lang, ami = sys.argv[1:6]
ami = str(ami) == '1'
FONT_B64 = os.environ.get('WHTML_FONT_B64','')

def load(name):
    try:
        d = json.load(open(os.path.join(tmpdir, name)))
        return d if isinstance(d, dict) else {}
    except Exception:
        return {}

def esc(s):
    return h.escape(str(s)) if s not in (None, '') else ''

def gv(d, *ks):
    cur = d
    for k in ks:
        if isinstance(cur, dict) and k in cur: cur = cur[k]
        else: return None
    return cur

def run():
    host = load('host.json'); cpu = load('cpu.json'); gpu = load('gpu.json')
    board = load('board.json'); mem = load('mem.json'); net = load('net.json')
    per = load('per.json'); sensors = load('sensors.json')
    doctor = load('doctor.json'); block = load('block.json')
    memraw = load('memraw.json').get('memory') or {}
    try:
        ai = json.load(open(os.path.join(tmpdir, 'ai.json')))
    except Exception:
        ai = {}

    TR = {
     'RU': ['Обзор','Процессор','Видеокарта','Память','Диски и S.M.A.R.T.','Периферия','Сеть','Температуры','Здоровье'],
     'EN': ['Overview','CPU','GPU','Memory','Disks & S.M.A.R.T.','Peripherals','Network','Thermal','Health'],
    }
    L = TR['EN'] if (lang != 'RU' or ami) else TR.get(lang, TR['EN'])
    def R(ru, en):
        return en if (lang != 'RU' or ami) else ru
    if lang == 'RU' and not ami:
        U_GB=' ГБ'; U_GHZ=' ГГц'; U_MB=' МБ'; U_W=' Вт'; U_MBIT=' Мбит/с'; U_MHZ=' МГц'
    else:
        U_GB=' GB'; U_GHZ=' GHz'; U_MB=' MB'; U_W=' W'; U_MBIT=' Mbps'; U_MHZ=' MHz'

    def badge(status):
        s = (status or '').lower()
        cls = 'ok' if s == 'ok' else ('warn' if s == 'warning' else ('crit' if s in ('critical','fail','failed') else 'info'))
        label = {'ok':'OK','warning':'WARN','critical':'CRIT','fail':'FAIL','failed':'FAIL','info':'INFO'}.get(s.upper(), (status or '').upper())
        return '<span class="badge ' + cls + '">' + esc(label) + '</span>'

    def trr(lbl, val, cls=''):
        c = ' class="' + cls + '"' if cls else ''
        return '<tr><td class="lbl">' + esc(lbl) + '</td><td' + c + '>' + (val if not isinstance(val, str) else val) + '</td></tr>'

    def trow(lbl, val):
        return '<tr><td class="lbl">' + esc(lbl) + '</td><td>' + esc(val) + '</td></tr>'

    # ---- data ----
    cpu_max = gv(cpu,'max_freq_ghz') or gv(cpu,'max_freq_mhz')
    if gv(cpu,'max_freq_khz') and not cpu_max:
        cpu_max = '%.1f' % (int(gv(cpu,'max_freq_khz'))/1e6) + U_GHZ
    cpu_base = gv(cpu,'base_freq_ghz') or gv(cpu,'base_freq_mhz')
    if gv(cpu,'base_freq_khz') and not cpu_base:
        cpu_base = '%.1f' % (int(gv(cpu,'base_freq_khz'))/1e6) + U_GHZ

    mem_type = gv(mem,'type') or ''
    slots = gv(mem,'slots') or []
    if not isinstance(slots, list): slots=[]
    if not mem_type and slots: mem_type = slots[0].get('type','')
    mem_size_mb = gv(mem,'size_mb')

    def mem_total_gb():
        tk = gv(mem,'total_kb')
        if tk: return round(tk/1e6,1)
        tg = gv(mem,'total_gb')
        if tg: return tg
        if mem_size_mb: return round(mem_size_mb/1024.0,1)
        return None
    def mem_used_gb():
        uk = gv(mem,'used_kb') or gv(memraw,'used_kb')
        if uk: return round(uk/1e6,1)
        ug = gv(mem,'used_gb') or gv(memraw,'used_gb')
        if ug: return ug
        return None
    mem_t = mem_total_gb(); mem_u = mem_used_gb()

    def slot_size_gb(s):
        sz = s.get('size') or s.get('size_gb') or s.get('size_mb') or ''
        m = re.match(r'^\s*([\d.]+)\s*(GiB|GB|MiB|MB)?', str(sz))
        if not m: return str(sz).strip()
        v = float(m.group(1)); u = (m.group(2) or '')
        if u in ('MiB','MB'): v = v/1024.0
        return ('%g' % v) + U_GB

    disks = gv(block,'disks') or []
    if not isinstance(disks, list): disks=[]
    smart = {}
    for c in (doctor.get('checks') or []):
        if c.get('check','').startswith('smart_'):
            smart[c['check'].replace('smart_','')] = c
    usb = per.get('usb') or []; disp = per.get('displays') or []
    aud = per.get('audio') or []; pci = per.get('pci') or []
    for x in (usb,disp,aud,pci):
        if not isinstance(x, list): x[:] = []

    cores = gv(sensors,'cpu_cores') or []
    if not isinstance(cores, list): cores=[]
    gp = gv(sensors,'gpu')
    if isinstance(gp, list): gp = gp[0] if gp else {}
    if not isinstance(gp, dict): gp = {}
    ifs = net.get('interfaces') or []
    if not isinstance(ifs, list): ifs=[]

    def airow(key):
        t = ai.get(key) if isinstance(ai, dict) else None
        if not t: return ''
        return '<tr><td class="lbl ai">AI</td><td class="ai">' + esc(t) + '</td></tr>'

    # ================= panels =================
    # panel: (main_title, [ subtab ])
    # subtab: ('label', rows_html, optional_subtables_html)
    panels = []

    # Overview
    bt = gv(board,'bios')
    board_line = (str(board.get('vendor','')) + ' ' + str(board.get('name',''))).strip()
    bios_line = ''
    if isinstance(bt, dict):
        bios_line = (str(bt.get('vendor','')) + ' ' + str(bt.get('version',''))).strip()
    memov = (('%s' % mem_t) + U_GB) if mem_t else ''
    ov_rows = airow('overview')
    ov_rows += trow(R('Имя хоста','Hostname'), host.get('host',''))
    ov_rows += trow(R('Материнская плата','Motherboard'), board_line)
    ov_rows += trow(R('BIOS','BIOS'), bios_line)
    ov_rows += trow(R('ОС','OS'), (str(host.get('os','')) + ' ' + str(host.get('arch',''))).strip())
    ov_rows += trow(R('Ядро','Kernel'), host.get('kernel',''))
    ov_rows += trow(R('Время работы','Uptime'), gv(sensors,'system','uptime') or gv(cpu,'uptime') or '')
    ov_rows += trow(R('Процессор','CPU'), gv(cpu,'model') or gv(cpu,'name') or '')
    ov_rows += trow(R('Видеокарта','GPU'), gpu.get('name','') or gv(sensors,'gpu',0,'name') or '')
    ov_rows += trow(R('Память','Memory'), memov)
    panels.append((L[0], [('Overview', ov_rows, '')]))

    # CPU
    cpu_rows = airow('cpu')
    cpu_rows += trow(R('Модель','Model'), gv(cpu,'model') or gv(cpu,'name') or '')
    cpu_rows += trow(R('Сокет','Socket'), gv(cpu,'sockets') or '')
    cpu_rows += trow(R('Макс. частота','Max freq'), cpu_max or '')
    cpu_rows += trow(R('Баз. частота','Base freq'), cpu_base or '')
    cpu_rows += trow(R('Ядра / потоки','Cores / threads'), ('%s / %s' % (gv(cpu,'cores') or '?', gv(cpu,'threads') or '?')) if (gv(cpu,'cores') or gv(cpu,'threads')) else '')
    cpu_rows += trow(R('Загрузка','Load avg'), gv(sensors,'system','load') or '')
    coretab = ''
    if cores:
        coretab = '<table class="mini"><tbody>' + ''.join('<tr><td>%s</td><td>%s°C</td></tr>' % (esc(c.get("label","")), esc(c.get("temp_c"))) for c in cores) + '</tbody></table>'
    panels.append((L[1], [('CPU', cpu_rows, coretab)]))

    # GPU
    gpu_rows = airow('gpu')
    vram = gpu.get('vram_total_mib') or gp.get('vram_total_mib')
    gpu_rows += trow(R('Модель','Model'), gpu.get('name','') or gp.get('name',''))
    gpu_rows += trow(R('Драйвер','Driver'), gpu.get('driver','') or gp.get('driver',''))
    gpu_rows += trow(R('Память','VRAM'), (('%s' % vram) + U_MB) if vram else '')
    gpu_rows += trow(R('Температура','Temp'), ('%s°C' % gp.get('temp_c')) if gp.get('temp_c') is not None else '')
    gpu_rows += trow(R('Вентилятор','Fan'), ('%s%%' % gp.get('fan_percent')) if gp.get('fan_percent') is not None else '')
    gpu_rows += trow(R('Энергопотребление','Power'), (('%s' % gp.get('power_w')) + U_W) if gp.get('power_w') is not None else '')
    gpu_rows += trow(R('Загрузка','Utilization'), ('%s%%' % gp.get('utilization_percent')) if gp.get('utilization_percent') is not None else '')
    panels.append((L[2], [('GPU', gpu_rows, '')]))

    # Memory
    mem_subs = []
    mem_main = 'Нет данных' if not (mem_t or slots or mem_type or mem_size_mb) else ''
    ram_rows = airow('memory')
    ram_rows += trow(R('Всего','Total'), (('%s' % mem_t) + U_GB) if mem_t else '')
    ram_rows += trow(R('Тип','Type'), mem_type)
    ram_rows += trow(R('Использовано','Used'), ((('%s' % mem_u) + ' / ' + ('%s' % mem_t)) + U_GB) if (mem_u and mem_t) else '')
    if mem_size_mb:
        ram_rows += trow(R('В системе','Installed'), (('%s' % round(mem_size_mb/1024.0,1)) + U_GB))
    mem_subs.append(('RAM', ram_rows, ''))
    if slots:
        slottab = '<table class="mini"><tbody>' + ''.join(
            '<tr><td>%s</td><td>%s</td><td>%s</td><td>%s</td></tr>' % (
                esc(s.get('locator','') or s.get('bank','')), esc(slot_size_gb(s)),
                esc(s.get('type','')), esc((str(s.get('speed_mts')) + U_MHZ) if s.get('speed_mts') else ''))
            for s in slots) + '</tbody></table>'
        mem_subs.append(('Slots', '', slottab))
    panels.append((L[3], mem_subs))

    # Disks & SMART
    disk_subs = []
    for d in disks:
        nm = d.get('name','')
        size = d.get('size_bytes')
        size_s = (('%d' % (size/1e9)) + U_GB) if size else ''
        rows = '<tr><td class="lbl">%s</td><td>%s</td></tr>' % (esc(nm), esc('%s - %s (%s)' % (d.get('model',''), size_s, d.get('type',''))))
        st = smart.get(nm)
        if st:
            rows += '<tr><td class="lbl">S.M.A.R.T.</td><td>%s %s</td></tr>' % (badge(st.get('status')), esc(str(st.get('detail','')).strip()))
        parts = d.get('partitions') or []
        subt = ''
        if isinstance(parts, list) and parts:
            subt = '<table class="mini"><tbody>' + ''.join('<tr><td>%s</td><td>%s</td><td>%s</td></tr>' % (esc(p.get("name","")), esc(p.get("fs_type","")), esc(p.get("mountpoint",""))) for p in parts) + '</tbody></table>'
        disk_subs.append((nm.upper(), rows, subt))
    if not disk_subs:
        disk_subs.append((R('Диски','Disks'), trow('', '-'), ''))
    panels.append((L[4], disk_subs))

    # Peripherals
    per_subs = []
    if usb:
        subt = '<table class="mini"><tbody>' + ''.join('<tr><td>%s</td><td>%s</td><td>%s</td></tr>' % (esc(u.get("name","")), esc(u.get("vendor","")), esc(u.get("class",""))) for u in usb) + '</tbody></table>'
        per_subs.append(('USB (%d)' % len(usb), '', subt))
    if disp:
        dtrs = ''
        for dd in disp:
            refresh = dd.get('refresh_hz') or dd.get('refresh_rate') or dd.get('refresh')
            cells = [esc(dd.get('name','') or dd.get('model','')), esc(dd.get('mode') or dd.get('resolution') or '')]
            if refresh: cells.append(esc(refresh) + ' Гц')
            dtrs += '<tr><td>%s</td><td>%s</td>%s</tr>' % (cells[0], cells[1], ('<td>'+cells[2]+'</td>') if len(cells)>2 else '')
        per_subs.append((R('Дисплеи','Displays'), '', '<table class="mini"><tbody>' + dtrs + '</tbody></table>'))
    if aud:
        atr = ''.join('<tr><td>%s</td><td>%s</td></tr>' % (esc(str(a.get('id','')).strip()), esc(a.get('description',''))) for a in aud)
        per_subs.append((R('Аудио','Audio'), '', '<table class="mini"><tbody>' + atr + '</tbody></table>'))
    if pci:
        ptr = ''.join('<tr><td>%s</td><td>%s</td></tr>' % (esc(p.get('bus','')), esc(p.get('description',''))) for p in pci)
        per_subs.append(('PCI (%d)' % len(pci), '', '<table class="mini"><tbody>' + ptr + '</tbody></table>'))
    if not (usb or disp or aud or pci):
        per_subs.append((R('Периферия','Peripherals'), trow('', '-'), ''))
    panels.append((L[5], per_subs))

    # Network
    net_rows = airow('network')
    if ifs:
        for i in ifs:
            sp = ((' - %s' % i.get('speed_mbps')) + U_MBIT) if i.get('speed_mbps') else ''
            net_rows += trow(i.get('name',''), '%s - %s%s' % (i.get('kind',''), i.get('state',''), sp))
    else:
        net_rows += trow('', '-')
    panels.append((L[6], [('Network', net_rows, '')]))

    # Thermal
    th_subs = []
    if cores:
        th_subs.append((R('Процессор','CPU'), '', '<table class="mini"><tbody>' + ''.join('<tr><td>%s</td><td>%s°C</td></tr>' % (esc(c.get("label","")), esc(c.get("temp_c"))) for c in cores) + '</tbody></table>'))
    if gp:
        gline = '%s°C - %s%%' % (gp.get('temp_c'), gp.get('fan_percent'))
        if gp.get('power_w') is not None: gline += ((' - %s' % gp.get('power_w')) + U_W)
        th_subs.append(('GPU', trow('GPU', gline), ''))
    if gv(sensors,'system','memory_percent'):
        th_subs.append((R('Память','Memory'), trow(R('Память','Memory'), '%s%%' % gv(sensors,'system','memory_percent')), ''))
    if not th_subs:
        th_subs.append((R('Температуры','Thermal'), trow('', '-'), ''))
    panels.append((L[7], th_subs))

    # Health
    crit = gv(doctor,'summary','critical') or 0
    warn = gv(doctor,'summary','warnings') or 0
    try: score = max(0, 100 - int(crit)*15 - int(warn)*5)
    except Exception: score = 100
    checks = doctor.get('checks') or []
    h_rows = airow('health')
    h_rows += trow(R('Оценка здоровья','Health score'), '%s/100' % score)
    h_rows += trow(R('Критично','Critical'), str(crit))
    h_rows += trow(R('Предупреждений','Warnings'), str(warn))
    for c in checks:
        h_rows += '<tr><td class="lbl">%s</td><td>%s - %s</td></tr>' % (badge(c.get('status')), esc(c.get('check','')), esc(c.get('detail','')))
    if not checks:
        h_rows += trow('', '-')
    panels.append((L[8], [('Health', h_rows, '')]))

    if ai:
        panels.append((R('ИИ-анализ','AI Analysis'), [('AI', '<tr><td class="lbl ai">AI</td><td class="ai">%s</td></tr>' % esc(ai.get('full')), '')]))

    user = os.environ.get('USER') or os.environ.get('LOGNAME') or 'user'
    if ami:
        out = render_ami(panels, L, R, user, host, ts, wu_ver, FONT_B64, cpu=cpu, mem_t=mem_t, disks=disks)
    else:
        out = render_cli(panels, L, R, user, host, ts, wu_ver, FONT_B64)
    sys.stdout.write(out)


