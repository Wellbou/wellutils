#!/usr/bin/env bash
# wellfetch -- detailed system info display with ANSI logo (wellutils suite)
# Style: bash, 2-space indent.
set -uo pipefail

# shellcheck disable=SC2034,SC2059,SC2154

_WU_NAME="wellfetch"
_WU_VERSION="1.4.0"
_WU_TAGLINE="detailed system information with logo"

_WU_MANUAL=0
_WU_EXTRA_PARSE="wf_extra_parse"
# ─── Rare-hardware guards (Termux/PS5/ARM/laptops may lack tools) ──
command -v awk    >/dev/null 2>&1 || awk()    { :; }
command -v free   >/dev/null 2>&1 || free()   { printf 'Mem: 0 0 0 0 0 0\n'; }
command -v df     >/dev/null 2>&1 || df()     { :; }
command -v uptime >/dev/null 2>&1 || uptime() { :; }
command -v nproc  >/dev/null 2>&1 || nproc()  { getconf _NPROCESSORS_ONLN 2>/dev/null || printf '1'; }

_WU_BOOT_DIR="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="$(dirname -- "$_WU_BOOT_DIR")/share/wellutils"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="/usr/local/share/wellutils"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="/usr/share/wellutils"
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    # wellfetch runs without `set -e` (unlike the other tools), so bootstrap's
    # bash-3.2 guard must be paired with an explicit exit here or the script
    # would continue and die with rc=127 ("wu_run: command not found").
    source "$_WU_BOOT_DIR/bootstrap.sh" lang box cli || exit 1
else
    source "$_WU_BOOT_DIR/bootstrap.sh" lang box cli || return 1 2>/dev/null || exit 1
    return 0 2>/dev/null || exit 0
fi

_WF_LOGO=1
_WF_PNG=0
_WF_LWIDTH=0
_WF_ALL=0

wf_extra_parse() {
    _WU_EXTRA_CONSUMED=0
    case "$1" in
        --no-logo|--text) _WF_LOGO=0; _WU_EXTRA_CONSUMED=1; return 0 ;;
        --logo)           _WF_LOGO=1; _WU_EXTRA_CONSUMED=1; return 0 ;;
        --png)            _WF_PNG=1; _WU_EXTRA_CONSUMED=1; return 0 ;;
        --all)            _WF_ALL=1; WF_SECTIONS="$WF_ALL_SECTIONS"; _WU_EXTRA_CONSUMED=1; return 0 ;;
        --full)           _WF_ALL=1; WF_SECTIONS="$WF_ALL_SECTIONS"; _WU_EXTRA_CONSUMED=1; return 0 ;;
        --logo-width)
            if [[ -n "${2:-}" ]] && [[ "$2" =~ ^[0-9]+$ ]]; then
                _WF_LWIDTH=$2; _WU_EXTRA_CONSUMED=2; return 0
            fi
            return 1 ;;
        --logo-width=*)
            _WF_LWIDTH="${1#*=}"
            [[ "$_WF_LWIDTH" =~ ^[0-9]+$ ]] || { printf 'wellfetch: --logo-width must be a number\n' >&2; return 1; }
            _WU_EXTRA_CONSUMED=1; return 0 ;;
    esac
    return 1
}

_WU_EXTRA_HELP="      --no-logo, --text     text only, no logo
      --logo                show logo (default on tty)
      --png                 force the PNG-rendered logo instead of distro art
      --all, --full         show all sections (audio, resolution, peripherals…)
      --logo-width N        logo width in cells"

# --- i18n ---------------------------------------------------------------------

# The default sections (os kernel cpu gpu mem resolution) use compact
# single-width geometric glyphs: they align perfectly and match the
# wellutils box style. The rest (--all/--full) keep emoji.
wf_emoji() {
    case "$1" in
        user) _ic '◉' ;; os) _ic '◆' ;; kernel) _ic '◈' ;; uptime) _ic '◔' ;;
        shell) _ic '🐚' ;; desktop) _ic '🪟' ;; wm) _ic '🎨' ;; terminal) _ic '⌨' ;;
        theme) _ic '🎭' ;; icons) _ic '🖌' ;; font) _ic '🔠' ;; cpu) _ic '▚' ;;
        gpu) _ic '▞' ;; mem) _ic '▤' ;; swap) _ic '🔁' ;; disk) _ic '💽' ;;
        disks) _ic '💿' ;; monitors) _ic '📺' ;; resolution) _ic '▣' ;;
        audio) _ic '🎚' ;; peripherals) _ic '🔌' ;; packages) _ic '📦' ;;
        locale) _ic '🌍' ;; date) _ic '📅' ;;
    esac
}

# --- row collection -----------------------------------------------------------

WF_SECS=() WF_LABELS=() WF_VALUES=()

wf_push() {
    WF_SECS+=("$1") WF_LABELS+=("$2") WF_VALUES+=("$3")
}

wf_clean() {
    printf '%s' "$1" | tr -cd '[:print:]\n' | sed -e 's/  */ /g' -e 's/^ //' -e 's/ $//'
}

# --- value providers (each pushes one or more rows) ----------------------------

wfv_user() {
    local u h
    u=$(id -un 2>/dev/null); [[ -n "$u" ]] || u="${USER:-?}"
    h=$(hostname 2>/dev/null || true); [[ -n "$h" ]] || h="${HOSTNAME:-?}"
    wf_push user "$(t wf_user)" "$u@$h"
}

wfv_os() {
    local p="${WF_OSFILE:-/etc/os-release}" pretty="" arch=""
    if [[ -r "$p" ]]; then
        pretty=$(awk -F= '/^PRETTY_NAME=/{print $2}' "$p" 2>/dev/null | tr -d '"')
    fi
    arch=$(uname -m 2>/dev/null)
    if [[ -n "$pretty" ]]; then
        wf_push os "$(t wf_os)" "$pretty${arch:+ ($arch)}"
    else
        wf_push os "$(t wf_os)" "-"
    fi
}

wfv_kernel() { wf_push kernel "$(t wf_kernel)" "$(uname -r 2>/dev/null || printf '-')"; }

wfv_uptime() {
    local s d h m up boot
    read -r s _ < /proc/uptime 2>/dev/null
    s=${s%.*}; s=${s:-0}
    d=$(( s / 86400 )); h=$(( (s % 86400) / 3600 )); m=$(( (s % 3600) / 60 ))
    if (( d > 0 )); then up="${d}d ${h}h ${m}m"
    elif (( h > 0 )); then up="${h}h ${m}m"
    else up="${m}m"; fi
    if command -v date >/dev/null 2>&1; then
        boot=$(( $(date +%s) - s ))
        up+=" · $(t wf_boot) $(date -d "@$boot" '+%F %H:%M' 2>/dev/null)"
    fi
    wf_push uptime "$(t wf_uptime)" "$up"
}

wfv_shell() {
    local base ver
    base="${SHELL##*/}"
    [[ -n "$base" ]] || base="${_WU_SHELL:-?}"
    case "$base" in
        bash) ver="${BASH_VERSION%%(*}" ;;
        zsh)  ver="${ZSH_VERSION:-}" ;;
        fish) ver="${FISH_VERSION:-}" ;;
    esac
    if [[ -n "$ver" ]]; then wf_push shell "$(t wf_shell)" "$base $ver"
    else wf_push shell "$(t wf_shell)" "$base"; fi
}

wfv_desktop() {
    local v="${XDG_CURRENT_DESKTOP:-${DESKTOP_SESSION:-}}"
    v=$(wf_clean "$v")
    wf_push desktop "$(t wf_desktop)" "${v:--}"
}

wfv_wm() {
    local v="${GDMSESSION:-${DESKTOP_SESSION:-${WM:-}}}"
    v=$(wf_clean "$v")
    wf_push wm "$(t wf_wm)" "${v:--}"
}

wfv_terminal() {
    local v="${TERM_PROGRAM:-}"
    [[ -n "$v" ]] || v="${TERM##*-}"
    wf_push terminal "$(t wf_terminal)" "${v:--}"
}

wfv_theme() {
    local v="${GTK_THEME:-}"
    if [[ -z "$v" ]] && command -v gsettings >/dev/null 2>&1; then
        v=$(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null | tr -d "'")
    fi
    v=$(wf_clean "$v")
    wf_push theme "$(t wf_theme)" "${v:--}"
}

wfv_icons() {
    local v=""
    if command -v gsettings >/dev/null 2>&1; then
        v=$(gsettings get org.gnome.desktop.interface icon-theme 2>/dev/null | tr -d "'")
    fi
    v=$(wf_clean "$v")
    wf_push icons "$(t wf_icons)" "${v:--}"
}

wfv_font() {
    local v=""
    if command -v gsettings >/dev/null 2>&1; then
        v=$(gsettings get org.gnome.desktop.interface font-name 2>/dev/null | tr -d "'")
    fi
    v=$(wf_clean "$v")
    wf_push font "$(t wf_font)" "${v:--}"
}

wfv_cpu() {
    local m cores threads freq load
    m=$(awk -F': ' '/^model name/{print $2; exit}' /proc/cpuinfo 2>/dev/null | sed 's/  */ /g')
    cores=$(awk -F': ' '/^cpu cores/{print $2; exit}' /proc/cpuinfo 2>/dev/null)
    threads=$(nproc 2>/dev/null)
    freq=$(awk -F': ' '/^cpu MHz/{print $2; exit}' /proc/cpuinfo 2>/dev/null)
    load=$(awk '{print $1}' /proc/loadavg 2>/dev/null)
    wf_push cpu "$(t wf_cpu)" "${m:--}"
    local detail=""
    if [[ -n "$cores" && -n "$threads" ]]; then
        detail="${cores} $(t_plural "$cores" core) / ${threads} $(t_plural "$threads" thread)"
        if [[ -n "$freq" ]]; then
            freq=$(awk -v f="$freq" -v u="$(t wf_freq)" 'BEGIN{printf "%d %s", f+0.5, u}')
            detail+=" @ $freq"
        fi
        if [[ -n "$load" ]]; then detail+=" · $(t wf_load) $load"; fi
        wf_push cpu "" "$detail"
    elif [[ -n "$load" ]]; then
        wf_push cpu "" "$(t wf_load) $load"
    fi
}

wfv_gpu() {
    command -v lspci >/dev/null 2>&1 || { wf_push gpu "$(t wf_gpu)" "-"; return; }
    local first=1 line name vram
    while IFS= read -r line; do
        name=$(sed -E 's/.*(VGA compatible controller|3D controller|Display controller): //' <<< "$line")
        name=$(awk '{sub(/^\[[^]]*\] */,""); sub(/ *$/,""); print}' <<< "$name")
        [[ -n "$name" ]] || continue
        vram=""
        if [[ "$name" == *NVIDIA* ]] && command -v nvidia-smi >/dev/null 2>&1; then
            local mib
            mib=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d ' ')
            [[ "$mib" =~ ^[0-9]+$ ]] && vram="$(( mib / 1024 )) GiB"
        fi
        name=$(sed -E 's/^(NVIDIA Corporation|Advanced Micro Devices|AMD|Intel Corporation|Intel) //; s/ *\(rev[^)]*\)$//' <<< "$name")
        if (( first )); then
            wf_push gpu "$(t wf_gpu)" "$name${vram:+ · $vram}"
            first=0
        else
            wf_push gpu "" "$name${vram:+ · $vram}"
        fi
    done < <(lspci 2>/dev/null | grep -iE 'VGA compatible|3D controller|Display controller')
    (( first )) && wf_push gpu "$(t wf_gpu)" "-"
}

# Format kibibytes as GiB: one decimal below 10, integer above
fmt_gib() {
    [[ "$1" =~ ^[0-9]+$ ]] || { printf '0 GiB'; return; }
    awk -v k="$1" 'BEGIN{g=k/1048576; if(g<10) printf "%.1f GiB", g; else printf "%d GiB", g+0.5}'
}

wfv_mem() {
    local total avail pct
    total=$(awk '/^MemTotal:/{print $2}' /proc/meminfo 2>/dev/null)
    avail=$(awk '/^MemAvailable:/{print $2}' /proc/meminfo 2>/dev/null)
    [[ -n "$total" && -n "$avail" ]] || { wf_push mem "$(t wf_mem)" "-"; return; }
    pct=$(( (total - avail) * 100 / total ))
    wf_push mem "$(t wf_mem)" "$(fmt_gib "$(( total - avail ))") / $(fmt_gib "$total") ($pct%)"
}

wfv_swap() {
    local total free used pct
    total=$(awk '/^SwapTotal:/{print $2}' /proc/meminfo 2>/dev/null)
    [[ -n "$total" && "$total" -gt 0 ]] || return 0
    free=$(awk '/^SwapFree:/{print $2}' /proc/meminfo 2>/dev/null)
    pct=$(( (total - free) * 100 / total ))
    wf_push swap "$(t wf_swap)" "$(fmt_gib "$(( total - free ))") / $(fmt_gib "$total") ($pct%)"
}

wfv_disk() {
    local line
    line=$(df -h / 2>/dev/null | awk 'NR==2{printf "%s %s / %s (%s)", $6, $3, $2, $5}')
    wf_push disk "$(t wf_disk)" "${line:--}"
}

wfv_disks() {
    command -v lsblk >/dev/null 2>&1 || return 0
    local first=1 name type size model
    while read -r name type size model; do
        [[ "$type" == "disk" ]] || continue
        model=$(wf_clean "$model")
        [[ -n "$model" ]] || model="-"
        if (( first )); then
            wf_push disks "$(t wf_disks)" "$name $model · $size"
            first=0
        else
            wf_push disks "" "$name $model · $size"
        fi
    done < <(lsblk -dno NAME,TYPE,SIZE,MODEL 2>/dev/null)
}

wfv_monitors() {
    local -a outs modes
    local d conn mode
    for d in /sys/class/drm/card*-*-*/; do
        [[ -f "$d/status" ]] || continue
        [[ "$(cat "$d/status" 2>/dev/null)" == "connected" ]] || continue
        conn=$(basename "$d")
        mode=$(head -1 "$d/modes" 2>/dev/null)
        outs+=("$conn"); modes+=("${mode:-?}")
    done
    if (( ${#outs[@]} == 0 )); then
        local line out geo
        if command -v xrandr >/dev/null 2>&1 && [[ -n "${DISPLAY:-}" ]]; then
            while IFS= read -r line; do
                [[ "$line" == *" connected"* ]] || continue
                out=$(awk '{print $1}' <<< "$line")
                geo=$(awk '{for (i=1;i<=NF;i++) if ($i ~ /^[0-9]+x[0-9]+/) print $i}' <<< "$line" | head -1)
                geo=${geo%%+*}
                outs+=("$out"); modes+=("${geo:-?}")
            done < <(xrandr --query 2>/dev/null || true)
        fi
    fi
    local n=${#outs[@]}
    if (( n == 0 )); then
        wf_push monitors "$(t wf_monitors)" "-"; return
    fi
    wf_push monitors "$(t wf_monitors)" "$n"
    local i
    for (( i=0; i<n; i++ )); do
        wf_push monitors "" "${outs[i]} · ${modes[i]}"
    done
}

wfv_resolution() {
    local r
    for d in /sys/class/drm/card*-primary-*; do
        [[ -f "$d/modes" ]] || continue
        r=$(head -1 "$d/modes" 2>/dev/null)
        if [[ -n "$r" ]]; then wf_push resolution "$(t wf_resolution)" "$r"; return; fi
    done
    for d in /sys/class/drm/card*-HDMI-* /sys/class/drm/card*-DVI-* /sys/class/drm/card*-DP-*; do
        [[ -f "$d/status" ]] || continue
        [[ "$(cat "$d/status" 2>/dev/null)" == "connected" ]] || continue
        r=$(head -1 "$d/modes" 2>/dev/null)
        if [[ -n "$r" ]]; then wf_push resolution "$(t wf_resolution)" "$r"; return; fi
    done
    if command -v wlr-randr >/dev/null 2>&1; then
        r=$(wlr-randr 2>/dev/null | awk '/current/{print $1; exit}')
        if [[ -n "$r" ]]; then wf_push resolution "$(t wf_resolution)" "$r"; return; fi
    fi
    wf_push resolution "$(t wf_resolution)" "-"
}

wfv_audio() {
    local n=0 names="" line nm
    while IFS= read -r line; do
        [[ "$line" =~ ^[[:space:]]*[0-9]+[[:space:]]*\[ ]] || continue
        nm=$(sed -E 's/.*\[([^]]*)\].*/\1/' <<< "$line")
        nm=$(wf_clean "$nm")
        [[ -n "$nm" ]] || continue
        n=$(( n + 1 ))
        names+="${names:+, }$nm"
    done < /proc/asound/cards
    if (( n > 0 )); then wf_push audio "$(t wf_audio)" "$n: $names"
    else wf_push audio "$(t wf_audio)" "-"; fi
}

wf_classify() {
    local bclass="$1" prod="$2" mfg="$3"
    local hay
    hay=$(printf '%s %s' "$prod" "$mfg" | tr '[:upper:]' '[:lower:]')
    case "$hay" in
        *xp-pen*|*wacom*|*huion*|*gaomon*|*drawing*|*graphics*|*pen*tablet*|*graphire*|*bamboo*|*intuos*|*cintiq*|*stylus*)
            printf '%s' tablet; return ;;
    esac
    case "$hay" in
        *touch*|*touchscreen*|*touchpad*)
            printf '%s' touchscreen; return ;;
    esac
    case "$hay" in
        *keyboard*|*k63*|*k55*|*k70*|*typewriter*) printf '%s' keyboard; return ;;
        *mouse*|*trackball*|*deathadder*|*razer*|*logitech*g*|*gaming*mouse*) printf '%s' mouse; return ;;
        *gamepad*|*controller*|*xbox*|*dualshock*|*joystick*|*fightstick*|*nintendo*|*pro*controller*)
            printf '%s' gamepad; return ;;
    esac
    case "$hay" in
        *webcam*|*camera*|*cam*) printf '%s' webcam; return ;;
        *headset*|*headphone*|*headphones*|*earphone*|*microphone*|*audio*|*mic*) printf '%s' audio; return ;;
    esac
    case "$hay" in
        *wlan*|*wireless*lan*|*wifi*|*wi-fi*|*802.11*|*ralink*|*mediatek*|*bluetooth*) printf '%s' network; return ;;
        *storage*|*flash*|*disk*|*ssd*|*sata*|*hdd*) printf '%s' storage; return ;;
        *printer*|*scanner*|*mfp*) printf '%s' printer; return ;;
        *phone*|*huawei*|*honor*|*xiaomi*|*redmi*|*pixel*|*galaxy*|*samsung*|*nokia*|*oppo*|*vivo*|*oneplus*|*realme*|*android*|*mao-lx*)
            printf '%s' phone; return ;;
    esac
    case "$bclass" in
        0e) printf '%s' webcam ;; 01|04) printf '%s' audio ;;
        08) printf '%s' storage ;; 07) printf '%s' printer ;;
        02) printf '%s' network ;; 03) printf '%s' hid ;;
        09) printf '%s' hub ;; ff) printf '%s' vendor ;;
        *)  printf '%s' device ;;
    esac
}

wf_ptype() {
    case "$1" in
        keyboard) t p_kbd ;; mouse) t p_mouse ;; touchscreen) t p_touch ;;
        stylus) t p_stylus ;; tablet) t p_tablet ;;
        gamepad)  t p_pad ;; audio) t p_audio ;; webcam) t p_cam ;;
        printer)  t p_print ;; storage) t p_store ;; network) t p_net ;;
        phone)    t p_phone ;; hub) t p_hub ;; hid) t p_hid ;;
        vendor)   t p_vend ;; *) t p_dev ;;
    esac
}

wf_picon() {
    case "$1" in
        keyboard) printf '⌨' ;; mouse) printf '🖱' ;; touchscreen) printf '👆' ;;
        stylus) printf '✏' ;; tablet) printf '🎨' ;;
        gamepad) printf '🎮' ;; audio) printf '🎧' ;; webcam) printf '📷' ;;
        printer) printf '🖨' ;; storage) printf '💾' ;; network) printf '📶' ;;
        phone) printf '📱' ;; hub) printf '🔌' ;; hid) printf '⚙' ;;
        *) printf '🔌' ;;
    esac
}

wfv_peripherals() {
    local devdir base bclass prod mfg type name
    local -a order=(keyboard mouse touchscreen stylus tablet gamepad audio webcam printer storage network phone hid vendor device)

    # bash 3.2 has no associative arrays: index P by position in $order.
    wfv_pindex() {
        local t="$1" i
        for (( i=0; i<${#order[@]}; i++ )); do
            [[ "${order[$i]}" == "$t" ]] && { printf '%s' "$i"; return 0; }
        done
        printf '%s' "$((${#order[@]} - 1))"
    }

    local -a P=()

    # ── USB devices (primary source) ──────────────────────────
    for devdir in /sys/bus/usb/devices/*; do
        [[ -d "$devdir" ]] || continue
        base=$(basename "$devdir")
        [[ "$base" == usb[0-9]* ]] && continue
        [[ -r "$devdir/idVendor" ]] || continue
        bclass=$(cat "$devdir/bDeviceClass" 2>/dev/null)
        [[ "$bclass" == "09" ]] && continue
        prod=$(wf_clean "$(cat "$devdir/product" 2>/dev/null)")
        mfg=$(wf_clean "$(cat "$devdir/manufacturer" 2>/dev/null)")
        type=$(wf_classify "$bclass" "$prod" "$mfg")
        name="$prod"
        [[ -n "$name" ]] || name="$mfg"
        [[ -n "$name" ]] || continue
        local pi
        pi=$(wfv_pindex "$type")
        case ",${P[$pi]:-}," in *",$name,"*) continue ;; esac
        P[$pi]+=",$name"
    done

    # ── PS/2 keyboards and mice ───────────────────────────────
    for devdir in /sys/bus/serio/devices/*; do
        [[ -d "$devdir" ]] || continue
        [[ -r "$devdir/description" ]] || continue
        local sdesc
        sdesc=$(cat "$devdir/description" 2>/dev/null)
        case "$sdesc" in
            *keyboard*|*kbd*) type="keyboard" ;;
            *mouse*|*pointing*) type="mouse" ;;
            *) continue ;;
        esac
        name=$(wf_clean "$sdesc")
        [[ -n "$name" ]] || name="PS/2 ${type}"
        local pi
        pi=$(wfv_pindex "$type")
        case ",${P[$pi]:-}," in *",$name,"*) continue ;; esac
        P[$pi]+=",$name"
    done

    # ── evdev input devices (touchscreens, styluses, tablets) ─
    if [[ -r /proc/bus/input/devices ]]; then
        local evname="" evphys="" evskip=""
        while IFS= read -r evline; do
            case "$evline" in
                N:\ *)
                    evname=$(printf '%s' "${evline#*Name=}" | tr -d '"' | sed 's/^ //' | tr -cd '[:print:]')
                    evname=$(wf_clean "$evname")
                    evskip="" ;;
                P:\ *)
                    evphys=$(printf '%s' "${evline#*Phys=}" | sed 's/^ //' | tr -cd '[:print:]')
                    # skip USB devices -- already detected via /sys/bus/usb
                    [[ "$evphys" == usb-* ]] && evskip=1 ;;
                H:\ *Handlers=*)
                    # skip if no name or already marked as USB
                    [[ "$evskip" == "1" ]] && { evname=""; evphys=""; continue; }
                    [[ -z "$evname" ]] && { evname=""; evphys=""; continue; }
                    local hay
                    hay=$(printf '%s' "$evname" | tr '[:upper:]' '[:lower:]')
                    type=""
                    case "$hay" in
                        *touch*|*touchscreen*) type="touchscreen" ;;
                        *stylus*|*pen*|*wacom*|*huion*|*xp-pen*|*gaomon*|*digitizer*)
                            type="stylus" ;;
                        *tablet*|*graphics*|*intuos*|*cintiq*|*bamboo*)
                            type="tablet" ;;
                        *joystick*|*gamepad*|*controller*|*xbox*|*ps3*|*ps4*|*ps5*|*nintendo*)
                            type="gamepad" ;;
                        *keyboard*|*kbd*) type="keyboard" ;;
                        *mouse*|*trackball*) type="mouse" ;;
                        *sensor*|*accel*|*gyro*) type="" ;;  # skip internal sensors
                    esac
                    [[ -n "$type" ]] || { evname=""; evphys=""; continue; }
                    local pi
                    pi=$(wfv_pindex "$type")
                    case ",${P[$pi]:-}," in *",$evname,"*) evname=""; evphys=""; continue ;; esac
                    P[$pi]+=",$evname"
                    evname=""; evphys=""
                    ;;
            esac
        done < /proc/bus/input/devices
    fi

    # ── Bluetooth input devices ────────────────────────────────
    for devdir in /sys/bus/bluetooth/devices/*; do
        [[ -d "$devdir" ]] || continue
        [[ -r "$devdir/name" ]] || continue
        local btname
        btname=$(wf_clean "$(cat "$devdir/name" 2>/dev/null)")
        [[ -n "$btname" ]] || continue
        # Classify by name heuristic
        type="device"
        local hay
        hay=$(printf '%s' "$btname" | tr '[:upper:]' '[:lower:]')
        case "$hay" in
            *keyboard*|*kbd*) type="keyboard" ;;
            *mouse*|*trackball*) type="mouse" ;;
            *controller*|*gamepad*|*xbox*|*dualshock*) type="gamepad" ;;
            *headphone*|*headset*|*buds*|*earphone*|*speaker*|*audio*) type="audio" ;;
            *pen*|*stylus*|*tablet*) type="tablet" ;;
            *printer*) type="printer" ;;
        esac
        local pi
        pi=$(wfv_pindex "$type")
        case ",${P[$pi]:-}," in *",$btname,"*) continue ;; esac
        P[$pi]+=",$btname"
    done
    local -a rows=()
    local t count=0
    for t in "${order[@]}"; do
        local pi
        pi=$(wfv_pindex "$t")
        [[ -n "${P[$pi]:-}" ]] || continue
        rows+=("$t")
        [[ -n "${P[$pi]:-}" ]] && count=$(( count + ${#P[$pi]//,/} + 1 ))
    done
    if (( ${#rows[@]} == 0 )); then
        wf_push peripherals "$(t wf_peripherals)" "-"
        return
    fi
    wf_push peripherals "$(t wf_peripherals)" "$count"
    local first=1
    for t in "${rows[@]}"; do
        local names ic label pi
        pi=$(wfv_pindex "$t")
        names=$(printf '%s' "${P[$pi]}" | tr ',' '\n' | sed '/^$/d' | paste -sd ', ' -)
        ic=$(wf_picon "$t")
        label=$(wf_ptype "$t")
        if (( first )); then
            wf_push peripherals "" "$(_ic "$ic")$label: $names"
            first=0
        else
            wf_push peripherals "" "$(_ic "$ic")$label: $names"
        fi
    done
}

wfv_packages() {
    local n=0 pac=0 flat=0
    if command -v pacman >/dev/null 2>&1; then
        n=$(pacman -Q 2>/dev/null | wc -l); n=${n:-0}; pac=1
    fi
    if command -v flatpak >/dev/null 2>&1; then
        flat=$(flatpak list 2>/dev/null | wc -l); flat=${flat:-0}
    fi
    local parts=() joined p
    (( pac )) && parts+=("$n pacman")
    (( flat )) && parts+=("$flat flatpak")
    if (( ${#parts[@]} )); then
        joined=""
        for p in "${parts[@]}"; do
            [[ -n "$joined" ]] && joined+=", "
            joined+="$p"
        done
        wf_push packages "$(t wf_packages)" "$joined"
    else
        wf_push packages "$(t wf_packages)" "-"
    fi
}

wfv_locale() { wf_push locale "$(t wf_locale)" "${LANG:--}"; }

wfv_date() {
    if command -v date >/dev/null 2>&1; then
        local _lc_save="${LC_TIME:-}"
        [[ "$WELLUTILS_LANG" == "EN" ]] && export LC_TIME="en_US.UTF-8" 2>/dev/null || true
        wf_push date "$(t wf_date)" "$(date '+%A %d %B %Y %H:%M' 2>/dev/null)"
        [[ -n "$_lc_save" ]] && export LC_TIME="$_lc_save" || unset LC_TIME
    else
        wf_push date "$(t wf_date)" "-"
    fi
}

wfv_battery() {
    local bat_dir cap="" status=""
    for bat_dir in /sys/class/power_supply/BAT* /sys/class/power_supply/bat*; do
        [[ -d "$bat_dir" ]] || continue
        cap=$(cat "$bat_dir/capacity" 2>/dev/null || true)
        status=$(cat "$bat_dir/status" 2>/dev/null || true)
        [[ -n "$cap" ]] || continue
        local icon
        case "$status" in
            Charging) icon="$(_emu '🔌')" ;;
            Full)     icon="$(_emu '🔋')" ;;
            *)        icon="$(_emu '🪫')" ;;
        esac
        wf_push battery "$(t wf_battery)" "${icon} ${cap}% (${status})"
        return
    done
}

wf_custom() { :; }

# --- collection ---------------------------------------------------------------

# Default set: essentials only -- user@host, system, kernel, uptime, cpu,
# gpu, memory, screen. Everything else stays available via --all/--full.
WF_SECTIONS="user os kernel uptime cpu gpu mem resolution"
WF_ALL_SECTIONS="user os kernel uptime shell desktop wm terminal theme icons font cpu gpu mem swap disk disks monitors packages locale audio resolution peripherals battery date"

wf_collect() {
    WF_SECS=() WF_LABELS=() WF_VALUES=()
    local sec vname
    for sec in $WF_SECTIONS; do
        vname="WF_VALUE_${sec}"
        if [[ -n "${!vname:-}" ]]; then
            wf_push "$sec" "$(t "wf_$sec")" "${!vname}"
        else
            wfv_${sec}
        fi
    done
    local line
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        wf_push custom "${line%%|*}" "${line#*|}"
    done < <(wf_custom 2>/dev/null)
}

# --- logo ---------------------------------------------------------------------

wf_logo_lines() {
    local art="$1" lw="$2"
    WF_LOGO_LINES=""
    WF_LOGO_ROWS=0
    # Distro ASCII art first (unless --png forced).
    if [[ "$_WF_PNG" != "1" && -f "$_WU_BOOT_DIR/distro_art.sh" ]]; then
        local dart=""
        dart=$(source "$_WU_BOOT_DIR/distro_art.sh"; wf_distro_art) || dart=""
        if [[ -n "$dart" ]]; then
            WF_LOGO_LINES="$dart"
            WF_LOGO_ROWS=$(printf '%s\n' "$dart" | wc -l)
            return 0
        fi
    fi
    if [[ -f "$art" ]] && command -v python3 >/dev/null 2>&1 && [[ -f "$WF_LOGO" ]]; then
        local cache_dir="${WF_CACHE_DIR:-${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}/wellutils}"
        local key="$(md5sum "$WF_LOGO" "$art" 2>/dev/null | md5sum | cut -d' ' -f1)"
        local cached="$cache_dir/logo-${lw}-${WF_KEY:-40}-${key}"
        if [[ -f "$cached" ]]; then
            WF_LOGO_LINES="$(cat "$cached")"
        else
            local cmd=(python3 "$art" "$WF_LOGO" --width "$lw" --key "${WF_KEY:-40}")
            if [[ -n "${WF_BG:-}" ]]; then
                cmd+=(--bg "$WF_BG")
            fi
            WF_LOGO_LINES="$("${cmd[@]}" 2>/dev/null)"
            if [[ -n "$WF_LOGO_LINES" ]]; then
                mkdir -p "$cache_dir" 2>/dev/null
                printf '%s\n' "$WF_LOGO_LINES" > "$cached" 2>/dev/null
                # cache rows count alongside to stay consistent
            fi
        fi
        if [[ -n "$WF_LOGO_LINES" ]]; then
            WF_LOGO_ROWS="$(printf '%s\n' "$WF_LOGO_LINES" | wc -l)"
        fi
        _wf_trim_logo
    fi
}

# Trim transparent margins around ASCII logo (keep horizontal offset for alignment).
_wf_trim_logo() {
    local -a arr=()
    local line i start=-1 end=-1 kept="" o
    while IFS= read -r line; do arr+=("$line"); done <<< "$WF_LOGO_LINES"
    for (( i=0; i<${#arr[@]}; i++ )); do
        o=$(printf '%s' "${arr[i]}" | sed $'s/\x1b\\[[0-9;]*m//g' | tr -d '[:space:]')
        [[ -n "$o" ]] && { (( start < 0 )) && start=$i; end=$i; }
    done
    if (( start < 0 )); then
        WF_LOGO_LINES=""; WF_LOGO_ROWS=0
        return 0
    fi
    kept=""
    for (( i=start; i<=end; i++ )); do
        kept+="${arr[i]}"$'\n'
    done
    WF_LOGO_LINES="${kept%$'\n'}"
    WF_LOGO_ROWS=$(( end - start + 1 ))
}

wf_info_line() {
    local label="$1" value="$2"
    printf '%s%s:%s %s' "${C}${label}" "${RESET}" "${RESET}" "$value"
}

# --- compact row layout ------------------------------------------------------
# Every section becomes a single row: "label: value" followed by
# indented continuation lines for multi-line sections (CPU, GPUs, disks…).
# The logo is drawn on the left, info column height matches the logo.

WF_RTYPE=() WF_RTEXT=() WF_RSUBS=() WF_RITEM=()

wf_build_rows() {
    WF_RTYPE=() WF_RTEXT=() WF_RSUBS=() WF_RITEM=()
    local i n=${#WF_LABELS[@]} j header subs
    for (( i=0; i<n; i++ )); do
        [[ -n "${WF_LABELS[i]}" ]] || continue
        header="$(wf_emoji "${WF_SECS[i]}")$(wf_info_line "${WF_LABELS[i]}" "${WF_VALUES[i]}")"
        subs=""
        for (( j=i+1; j<n; j++ )); do
            [[ -z "${WF_LABELS[j]}" ]] || break
            subs+="${WF_VALUES[j]}"$'\n'
        done
        i=$(( j - 1 ))
        WF_RTYPE+=(block)
        WF_RTEXT+=("$header")
        WF_RSUBS+=("${subs%$'\n'}")
        WF_RITEM+=(1)
    done
}

wf_print_plain() {
    local i n=${#WF_RTYPE[@]} sub
    for (( i=0; i<n; i++ )); do
        printf '%s\n' "${WF_RTEXT[i]}"
        if [[ "${WF_RTYPE[i]}" == "block" && -n "${WF_RSUBS[i]}" ]]; then
            while IFS= read -r sub; do
                [[ -n "$sub" ]] && printf '%s\n' "      $sub"
            done <<< "${WF_RSUBS[i]}"
        fi
    done
}

wf_collect_info_lines() {
    WF_INFO_LINES=()
    local i sub
    for (( i=0; i<${#WF_RTYPE[@]}; i++ )); do
        WF_INFO_LINES+=("${WF_RTEXT[i]}")
        if [[ "${WF_RTYPE[i]}" == "block" ]]; then
            while IFS= read -r sub; do
                [[ -n "$sub" ]] && WF_INFO_LINES+=("      $sub")
            done <<< "${WF_RSUBS[i]}"
        fi
    done
}

wf_strip_ansi() {
    printf '%s' "$1" | sed $'s/\x1b\\[[0-9;]*m//g'
}

# --- JSON output -----------------------------------------------------------
# Reuse wf_collect: sections become { section, label, value, subs[] } blocks
# with the same grouping as wf_build_rows (subs = following unlabelled rows).
wf_json_out() {
    wu_json_head "$_WU_TOOLNAME" "$_WU_VERSION"
    printf ',\n  "sections": [\n'
    local first=1 i n=${#WF_LABELS[@]} j s sfirst
    for (( i=0; i<n; i++ )); do
        [[ -n "${WF_LABELS[i]}" ]] || continue
        local _sec="${WF_SECS[i]}" _lbl="${WF_LABELS[i]}" _val="${WF_VALUES[i]}"
        local subs=""
        for (( j=i+1; j<n; j++ )); do
            [[ -z "${WF_LABELS[j]}" ]] || break
            subs+="${WF_VALUES[j]}"$'\n'
        done
        i=$(( j - 1 ))
        (( first )) && first=0 || printf ',\n'
        printf '    { "section": "%s", "label": "%s", "value": "%s", "subs": [' \
            "$(json_esc "$_sec")" "$(json_esc "$_lbl")" "$(json_esc "$_val")"
        sfirst=1
        while IFS= read -r s; do
            [[ -n "$s" ]] || continue
            (( sfirst )) && sfirst=0 || printf ','
            printf ' "%s"' "$(json_esc "$s")"
        done <<< "$subs"
        printf ' ] }'
    done
    printf '\n  ]\n'
    wu_json_end
}

main() {
    wf_collect
    if [[ "$_WU_JSON" == "1" ]]; then wf_json_out; return 0; fi

    wf_build_rows
    local n=${#WF_RTYPE[@]}
    (( n < 1 )) && return 0

    if [[ "$_WF_LOGO" -eq 0 || "$_WU_COLOR_ON" != 1 ]]; then
        wf_print_plain
        return 0
    fi

    # resolve logo + art paths
    local art=""
    WF_LOGO="${WF_LOGO:-}"
    if [[ -n "${_WU_LIBDIR:-}" ]]; then
        WF_LOGO="${WF_LOGO:--$_WU_LIBDIR/logo.png}"
        [[ "$WF_LOGO" == "-"* ]] && WF_LOGO="${WF_LOGO#-}"
        [[ -f "$_WU_LIBDIR/wfetch_art.py" ]] && art="$_WU_LIBDIR/wfetch_art.py"
    fi
    [[ -n "$WF_LOGO" ]] || WF_LOGO="/usr/local/share/wellutils/logo.png"
    [[ -f "$WF_LOGO" ]] || WF_LOGO="/usr/share/wellutils/logo.png"
    [[ -n "$art" ]] || art="/usr/local/share/wellutils/wfetch_art.py"
    [[ -f "$art" ]] || art="/usr/share/wellutils/wfetch_art.py"

    # side-by-side: logo (left) | info column (right, height = logo height)
    local cols gap=4 avail lw rows maxr info_w=0 i v len sl
    cols="${COLUMNS:-$(tput cols 2>/dev/null || printf '80')}"
    for (( i=0; i<n; i++ )); do
        len=$(vislen "${WF_RTEXT[i]}")
        sl="$(printf '%s\n' "${WF_RSUBS[i]}" | wc -L)"
        (( sl > len )) && len=$sl
        (( len > info_w )) && info_w=$len
    done

    # native image support (kitty/iTerm2) beats ASCII half-blocks
    local gfx=""
    if [[ -z "${WF_GFX:-}" || "${WF_GFX:-}" == "auto" ]] && command -v python3 >/dev/null 2>&1; then
        case "${TERM:-}" in xterm-kitty) gfx="kitty" ;; esac
        case "${TERM_PROGRAM:-}" in
            WezTerm|foot|ghostty|konsole) gfx="kitty" ;;
            iTerm.app|mintty)             gfx="iterm" ;;
        esac
        [[ -n "${ITERM_PROFILE:-}" ]] && gfx="iterm"
    fi
    case "${WF_GFX:-}" in
        off|none)    gfx="" ;;
        auto|"")     : ;;
        *)           gfx="$WF_GFX" ;;
    esac

    wf_collect_info_lines
    local total=${#WF_INFO_LINES[@]}
    # wcwidth-aware info width (vislen handles double-width emoji in --all)
    info_w=0
    for (( i=0; i<total; i++ )); do
        v=$(vislen "${WF_INFO_LINES[i]}")
        (( v > info_w )) && info_w=$v
    done
    avail=$(( cols - info_w - gap ))
    if (( _WF_LWIDTH > 0 )); then
        lw=$_WF_LWIDTH
    else
        # Scale with the terminal: the logo takes about half the space that
        # remains after the info column, and never exceeds half the width.
        # On a fullscreen wide terminal it grows instead of staying tiny.
        lw=$(( avail / 2 ))
        (( lw > cols / 2 )) && lw=$(( cols / 2 ))
        (( lw < 8 )) && lw=8
    fi
    (( lw + info_w + gap > cols )) && lw=$(( cols - info_w - gap ))
    if (( lw < 8 )); then
        wf_print_plain
        return 0
    fi

    # native image support (kitty/iTerm2) beats ASCII half-blocks; the logo
    # is sized the same way as the ASCII render (lw computed above).
    if [[ -n "$gfx" && -n "$art" && -f "$WF_LOGO" ]]; then
        python3 "$art" "$WF_LOGO" --width "$lw" --key "${WF_KEY:-40}" --gfx "$gfx" 2>/dev/null
        wf_print_plain
        return 0
    fi

    wf_logo_lines "$art" "$lw"
    rows=$WF_LOGO_ROWS
    (( rows < 1 )) && rows=0

    # The art renderer centers the drawing in its canvas; if the canvas is
    # much wider than the drawing, re-render at the visible width so the
    # frame hugs the logo instead of leaving huge transparent margins.
    local wv=0 line_ plain lead trail
    while IFS= read -r line_; do
        plain=$(wf_strip_ansi "$line_")
        lead=$(printf '%s' "$plain" | sed 's/[^ ].*//' | wc -c); lead=$(( lead - 1 ))
        trail=$(printf '%s' "$plain" | sed 's/.*[^ ]//' | wc -c); trail=$(( trail - 1 ))
        v=$(( $(vislen "$line_") - lead - trail ))
        (( v > wv )) && wv=$v
    done <<< "$WF_LOGO_LINES"
    (( wv < 1 )) && wv=$lw
    if (( _WF_LWIDTH == 0 && wv + 2 < lw )); then
        lw=$(( wv + 2 ))
        wf_logo_lines "$art" "$lw"
        rows=$WF_LOGO_ROWS
        (( rows < 1 )) && rows=0
    fi

    maxr=$(( rows > total ? rows : total ))
    local artw=0
    while IFS= read -r line_; do
        v=$(vislen "$line_")
        (( v > artw )) && artw=$v
    done <<< "$WF_LOGO_LINES"
    (( artw < 1 )) && artw=$lw

    if (( rows > 0 )); then
        # wellutils frame: logo and info share one box, aligned to the same
        # left column on every row (the art renderer pads each line to lw).
        local inner left right padl
        inner=$(( artw + gap + info_w + 2 ))
        box_top '◆' "wellfetch v${_WU_VERSION}" "$inner"
        local -a logo_arr=() info_arr=()
        while IFS= read -r line; do logo_arr+=("$line"); done <<< "$WF_LOGO_LINES"
        info_arr=("${WF_INFO_LINES[@]}")
        for (( i=0; i<maxr; i++ )); do
            if (( i < rows )); then
                left="${logo_arr[i]}"
                padl=$(( artw - $(vislen "$left") ))
                (( padl > 0 )) && left+="$(printf '%*s' "$padl" '')"
            else
                left="$(printf '%*s' "$artw" '')"
            fi
            if (( i < total )); then
                right="${info_arr[i]}"
                padl=$(( info_w - $(vislen "$right") ))
                (( padl > 0 )) && right+="$(printf '%*s' "$padl" '')"
            else
                right="$(printf '%*s' "$info_w" '')"
            fi
            box_row "${left}$(printf '%*s' "$gap" '')${right}" "$inner"
        done
        box_bottom "$inner"
        printf '\n  %sWellFetch v%s | %s%s\n\n' "$DIM" "$_WU_VERSION" "$(date '+%Y-%m-%d %H:%M:%S')" "$RESET"
    else
        wf_print_plain
    fi
    return 0
}

# config override (function redefinitions or WF_VALUE_<sec>= overrides)
if [[ -n "${WELLFETCH_CONFIG:-}" ]]; then
    [[ -f "$WELLFETCH_CONFIG" ]] && . "$WELLFETCH_CONFIG"
elif [[ -f "${XDG_CONFIG_HOME:-${HOME:-/tmp}/.config}/wellutils/wellfetch.conf" ]]; then
    . "${XDG_CONFIG_HOME:-${HOME:-/tmp}/.config}/wellutils/wellfetch.conf"
fi

wu_run main "$@"
exit $?
