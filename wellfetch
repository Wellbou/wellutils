            case "$1" in
                user) printf 'Пользователь' ;; os) printf 'ОС' ;;
                kernel) printf 'Ядро' ;; uptime) printf 'Аптайм' ;;
                shell) printf 'Оболочка' ;; desktop) printf 'Окружение' ;;
                wm) printf 'Окна' ;; terminal) printf 'Терминал' ;;
                theme) printf 'Тема' ;; icons) printf 'Иконки' ;;
                font) printf 'Шрифт' ;; cpu) printf 'CPU' ;;
                gpu) printf 'GPU' ;; mem) printf 'Память' ;;
                swap) printf 'Своп' ;; disk) printf 'Диск' ;;
                disks) printf 'Диски' ;; monitors) printf 'Мониторы' ;;
                resolution) printf 'Разрешение' ;; audio) printf 'Аудио' ;;
