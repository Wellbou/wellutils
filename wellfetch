                p_vend) printf 'Прочее' ;; p_dev) printf 'Устройство' ;;
            esac ;;
        *)
            case "$1" in
                user) printf 'User' ;; os) printf 'OS' ;;
                kernel) printf 'Kernel' ;; uptime) printf 'Uptime' ;;
                shell) printf 'Shell' ;; desktop) printf 'Desktop' ;;
                wm) printf 'WM' ;; terminal) printf 'Terminal' ;;
