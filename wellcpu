#!/usr/bin/env bash
# wellcpu -- Beautiful CPU overview (topology, load, frequencies)
# Part of wellutils by wellbou_
set -euo pipefail

declare -A _CPU_PCT=() _CPU_SOCKET=() _CPU_CORE=() _SOCKETS=()
declare -i _CPU_COUNT=0

# ─── Shared libs ────────────────────────────────────────────────
_WU_TOOLNAME="wellcpu" _WU_NAME="WellCPU" _WU_VERSION="1.0"
_WU_SHORT_OK=1
_WU_TAGLINE="Beautiful CPU overview (topology, load, frequencies)"
_WU_BOOT_DIR="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="$(dirname -- "$_WU_BOOT_DIR")/share/wellutils"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="/usr/local/share/wellutils"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="/usr/share/wellutils"
source "$_WU_BOOT_DIR/bootstrap.sh" lang box cli
# ─── Rare-hardware guards ─────────────────────────────────────────
command -v awk    >/dev/null 2>&1 || awk()    { :; }
command -v date   >/dev/null 2>&1 || date()   { printf '%s' '1970-01-01 00:00:00'; }
command -v nproc  >/dev/null 2>&1 || nproc()  { getconf _NPROCESSORS_ONLN 2>/dev/null || printf '1'; }
command -v lscpu  >/dev/null 2>&1 || lscpu()  { :; }
command -v sleep  >/dev/null 2>&1 || sleep()  { :; }


ORANGE=$'\033[1;38;5;208m'

# ─── Helpers ─────────────────────────────────────────────────────
load_color() {
    local pct=$1
    if   (( pct < 50 )); then printf '%s' "$G"
    elif (( pct < 80 )); then printf '%s' "$Y"
    elif (( pct < 95 )); then printf '%s' "$ORANGE"
    else                      printf '%s' "$R"
    fi
}

load_bar() {
    local pct=$1 width=${2:-14}
    local filled=$(( pct * width / 100 ))
    local empty=$(( width - filled ))
    printf '%s' "$(load_color "$pct")"
    wu_bar "$filled" "$empty"
    printf '%s' "$RESET"
}

# kHz -> human ("3.50 GHz" / "3500 MHz")
fmt_mhz() {
    local khz=$1
    [[ "$khz" =~ ^[0-9]+$ ]] || khz=0
    local mhz=$(( khz / 1000 ))
    if (( mhz >= 1000 )); then
        printf '%s GHz' "$(awk "BEGIN {printf \"%.2f\", $mhz/1000}")"
    else
        printf '%s MHz' "$mhz"
    fi
}

# Per-core busy% via /proc/stat delta (single read, then sleep).
core_loads() {
    local -a t0=()
    local i c idle total
    while IFS= read -r line; do
        case "$line" in
            cpu[0-9]*)
                set -- $line
                c=$1; shift
                while (( $# < 8 )); do set -- "$@" 0; done
                idle=$(( $4 + $5 ))
                total=$(( $1 + $2 + $3 + $4 + $5 + $6 + $7 + $8 ))
                t0[$((10#${c#cpu}))]="$idle $total" ;;
        esac
    done < /proc/stat
    sleep 0.2
    local n=0
    while IFS= read -r line; do
        case "$line" in
            cpu[0-9]*)
                set -- $line
                c=$1; shift
                while (( $# < 8 )); do set -- "$@" 0; done
                idle=$(( $4 + $5 ))
                total=$(( $1 + $2 + $3 + $4 + $5 + $6 + $7 + $8 ))
                local idx=$((10#${c#cpu}))
                local d_idle=0 d_total=0
                if [[ -n "${t0[$idx]:-}" ]]; then
                    d_idle=$(( idle - ${t0[$idx]%% *} ))
                    d_total=$(( total - ${t0[$idx]##* } ))
                fi
                local pct=0
                (( d_total > 0 )) && pct=$(( (d_total - d_idle) * 100 / d_total ))
                (( pct < 0 )) && pct=0
                (( pct > 100 )) && pct=100
                _CPU_PCT[$idx]=$pct
                n=$((n + 1)) ;;
        esac
    done < /proc/stat
    _CPU_COUNT=$n
}

# Build processor -> (socket, core) topology from /proc/cpuinfo so multi-socket
# (and multi-CCX / hybrid) machines can group the per-core load by NUMA socket.
# Populates global assoc arrays: _CPU_SOCKET[], _CPU_CORE[] and _SOCKETS[].
cpu_topology() {
    local proc="" phys="" coreid=""
    while IFS= read -r line; do
        case "$line" in
            processor*) proc=$(awk -F': *' '{print $2}' <<< "$line") ;;
            "physical id"*) phys=$(awk -F': *' '{print $2}' <<< "$line") ;;
            "core id"*) coreid=$(awk -F': *' '{print $2}' <<< "$line") ;;
        esac
        if [[ -n "$proc" && -n "$phys" && -n "$coreid" ]]; then
            [[ "$phys" =~ ^[0-9]+$ ]] || phys=0
            [[ "$coreid" =~ ^[0-9]+$ ]] || coreid=$proc
            _CPU_SOCKET[$proc]=$phys
            _CPU_CORE[$proc]=$coreid
            _SOCKETS[$phys]=1
            proc=""; phys=""; coreid=""
        fi
    done < /proc/cpuinfo
    if (( ${#_CPU_SOCKET[@]} == 0 )); then
        local _i
        for (( _i = 0; _i < _CPU_COUNT; _i++ )); do
            _CPU_SOCKET[$_i]=0
            _CPU_CORE[$_i]=$_i
        done
        _SOCKETS[0]=1
    fi
}

# ─── Sections ───────────────────────────────────────────────────
print_cpu_info() {
    local model arch sockets cores threads freq_base freq_max gov virt hv
    model=$(awk -F': *' '/^model name/{print $2; exit}' /proc/cpuinfo)

    local lscpu_out
    lscpu_out=$(lscpu 2>/dev/null) || lscpu_out=""

    arch=$(awk -F': *' '/^Architecture/{print $2}' <<< "$lscpu_out" | head -1)
    local _sockets _threads _cores
    _sockets=$(awk -F': *' '/^Socket\(s\)/{print $2}' <<< "$lscpu_out" | head -1)
    _threads=$(awk -F': *' '/^Thread\(s\) per core/{print $2}' <<< "$lscpu_out" | head -1)
    _cores=$(awk -F': *' '/^Core\(s\) per socket/{print $2}' <<< "$lscpu_out" | head -1)
    [[ -z "$_sockets" ]] && _sockets=$(awk '/^physical id/{if(!seen[$4]++) n++} END{print n+0}' /proc/cpuinfo)
    [[ -z "$_cores" ]] && _cores=$(awk '/^cpu cores/{print $4; exit}' /proc/cpuinfo)
    [[ -z "$_threads" ]] && _threads=$(awk '/^siblings/{print $3; exit}' /proc/cpuinfo)
    [[ -z "$arch" ]] && arch=$(uname -m)
    # lscpu prints "Socket(s): -" on ARM64 / SBCs / VMs without topology.
    # Treat any non-numeric value (including "-") as unknown -> 1.
    [[ "$_sockets" =~ ^[0-9]+$ ]] || _sockets=1
    [[ "$_cores" =~ ^[0-9]+$ ]]  || _cores=1
    [[ "$_threads" =~ ^[0-9]+$ ]] || _threads=1
    [[ "$_sockets" -lt 1 ]] && _sockets=1
    [[ "$_cores" -lt 1 ]] && _cores=1
    [[ "$_threads" -lt 1 ]] && _threads=1
    sockets="$_sockets"; cores=$(( _cores * _sockets )); threads=$(( _threads * _cores * _sockets ))

    local turbo_hint base_hint
    turbo_hint=$(cat /sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq 2>/dev/null || cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq 2>/dev/null || true)
    base_hint=$(awk -F'@' '/^model name/{print $2; exit}' /proc/cpuinfo | tr -d ' ' | sed 's/^\([0-9.]*\)GHz/\1 GHz/')
    gov=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || true)

    local flags vtx virt_label hv_label
    flags=$(grep -m1 '^flags' /proc/cpuinfo 2>/dev/null || true)
    vtx=""
    if [[ "$flags" == *vmx* ]]; then vtx="Intel VT-x"
    elif [[ "$flags" == *svm* ]]; then vtx="AMD-V"; fi
    [[ -n "$vtx" ]] || vtx="$(t blk_smart_unknown)"
    hv_label="$(t blk_smart_unknown)"
    if [[ "$flags" == *hypervisor* ]]; then
        local hv_vendor
        hv_vendor=$(awk -F': *' '/^Hypervisor vendor/{print $2}' <<< "$lscpu_out" | head -1)
        [[ -n "$hv_vendor" ]] && hv_label="$hv_vendor" || hv_label="yes"
    fi
    virt=$(awk -F': *' '/^Virtualization:/{print $2}' <<< "$lscpu_out" | head -1)
    [[ -n "$virt" ]] && virt="$virt ($vtx)" || virt="$vtx"

    pline_hw "$(_emu '🧠')" "$(t cpu_model)" "$model"
    pline_hw "$(_emu '🏛')" "$(t cpu_arch)" "$arch"
    pline_hw "$(_emu '🧩')" "$(t cpu_sockets)" "$sockets"
    pline_hw "$(_emu '⚙')" "$(t cpu_cores)" "$cores"
    pline_hw "$(_emu '🔗')" "$(t cpu_threads)" "$threads"

    local freq_txt=""
    if [[ -n "$turbo_hint" && "$turbo_hint" != "0" ]]; then
        freq_txt="$(fmt_mhz "$turbo_hint") ($(t cpu_turbo))"
        if [[ -n "$base_hint" && "$base_hint" =~ ^[0-9.]+(\ )?GHz?$ ]]; then
            freq_txt="$base_hint ($(t cpu_base)) / $(fmt_mhz "$turbo_hint") ($(t cpu_turbo))"
        fi
    fi
    [[ -n "$freq_txt" ]] && pline_hw "$(_emu '⚡')" "$(t cpu_freq)" "$freq_txt"

    local caches=""
    local c_l1d c_l1i c_l2 c_l3
    cache_fmt() {
        local size="${1%%(*}" n
        if [[ "$1" != *'('* ]]; then printf '%s' "$1"; return; fi
        n=$(printf '%s' "${1#*(}" | awk '{for(i=1;i<=NF;i++) if($i+0==$i){print $i; exit}}')
        if [[ -n "$n" ]]; then
            printf '%s (%d %s)' "${size% }" "$n" "$(t_plural "$n" instance)"
        else
            printf '%s' "${size% }"
        fi
    }
    c_l1d=$(awk -F': *' '/^L1d cache/{print $2}' <<< "$lscpu_out" | head -1)
    c_l1i=$(awk -F': *' '/^L1i cache/{print $2}' <<< "$lscpu_out" | head -1)
    c_l2=$(awk -F': *' '/^L2 cache/{print $2}' <<< "$lscpu_out" | head -1)
    c_l3=$(awk -F': *' '/^L3 cache/{print $2}' <<< "$lscpu_out" | head -1)
    [[ -n "$c_l1d" ]] && c_l1d=$(cache_fmt "$c_l1d")
    [[ -n "$c_l1i" ]] && c_l1i=$(cache_fmt "$c_l1i")
    [[ -n "$c_l2" ]] && c_l2=$(cache_fmt "$c_l2")
    [[ -n "$c_l3" ]] && c_l3=$(cache_fmt "$c_l3")
    if [[ -n "$c_l1d" || -n "$c_l1i" || -n "$c_l2" || -n "$c_l3" ]]; then
        caches="L1d: ${c_l1d:-?}"
        [[ -n "$c_l1i" ]] && caches="$caches  L1i: ${c_l1i}"
        [[ -n "$c_l2" ]] && caches="$caches  L2: ${c_l2}"
        [[ -n "$c_l3" ]] && caches="$caches  L3: ${c_l3}"
        # The value area starts at column 19; box content is capped at COLUMNS-4.
        # Split the caches line when it would otherwise be cut off.
        if (( $(vislen "$caches") > ${COLUMNS:-100} - 23 )); then
            local c1="${caches%  L2:*}" c2="L2: ${caches#*  L2: }" pad
            printf -v pad '%*s' 18 ''
            pline_hw "$(_emu '📦')" "$(t cpu_caches)" "$c1"
            _LINES+=( " ${pad}${c2}${RESET}" )
        else
            pline_hw "$(_emu '📦')" "$(t cpu_caches)" "$caches"
        fi
    fi

    local feats=() feat_txt=""
    for f in avx512f avx2 avx avx_vnni avx512_vnni sse4_2 sse4_1 aes ssse3 bmi2 bmi1; do
        [[ "$flags" == *"$f"* ]] && feats+=("$f")
    done
    if ((${#feats[@]})); then
        printf -v feat_txt "%s " "${feats[@]}"
        pline_hw "$(_emu '💡')" "$(t cpu_features)" "${feat_txt% }"
    fi

    [[ -n "$virt" ]] && pline_hw "$(_emu '🛡')" "$(t cpu_virt)" "$virt"
    [[ "$flags" == *hypervisor* ]] && pline_hw "$(_emu '☁')" "$(t cpu_hv)" "$hv_label"
    [[ -n "$gov" ]] && pline_hw "$(_emu '🎚')" "$(t cpu_governor)" "$gov" || true
}

print_cpu_load() {
    core_loads
    cpu_topology

    if (( _CPU_COUNT == 0 )); then
        pline "${DIM}$(t blk_smart_unknown)${RESET}"
        return
    fi

    local i freq gov pct cur_sock=""
    for (( i = 0; i < _CPU_COUNT; i++ )); do
        # Group per-core lines under their socket so multi-socket machines
        # (dual-socket Xeons, etc.) read topologically instead of by Linux
        # enumeration order.
        local sock=${_CPU_SOCKET[$i]:-0}
        if [[ "$sock" != "$cur_sock" ]]; then
            cur_sock="$sock"
            if (( ${#_SOCKETS[@]} > 1 )); then
                _LINES+=( "" )
                _LINES+=( "  ${BOLD}${W}$(t cpu_socket) ${sock}${RESET}" )
            fi
        fi

        pct=${_CPU_PCT[$i]:-0}
        freq=$(cat "/sys/devices/system/cpu/cpu${i}/cpufreq/scaling_cur_freq" 2>/dev/null || true)
        gov=$(cat "/sys/devices/system/cpu/cpu${i}/cpufreq/scaling_governor" 2>/dev/null || true)

        local label="CPU${i}"
        local val="$(printf '%3d%%' "$pct")"
        local bar
        bar=$(load_bar "$pct")
        local freq_txt=""
        [[ -n "$freq" ]] && freq_txt="  ${DIM}@ $(fmt_mhz "$freq")${RESET}"
        local gov_txt=""
        [[ -n "$gov" ]] && gov_txt="  ${DIM}($gov)${RESET}"

        _LINES+=( "  ${BOLD}${W}${label}${RESET}  ${bar}  ${val}${freq_txt}${gov_txt}" )
    done
}

# ─── JSON output ────────────────────────────────────────────────
json_out() {
    local model arch sockets cores threads freq_base gov
    model=$(awk -F': *' '/^model name/{print $2; exit}' /proc/cpuinfo)

    local lscpu_out
    lscpu_out=$(lscpu 2>/dev/null) || lscpu_out=""

    arch=$(awk -F': *' '/^Architecture/{print $2}' <<< "$lscpu_out" | head -1)
    local _sockets _threads _cores
    _sockets=$(awk -F': *' '/^Socket\(s\)/{print $2}' <<< "$lscpu_out" | head -1)
    _threads=$(awk -F': *' '/^Thread\(s\) per core/{print $2}' <<< "$lscpu_out" | head -1)
    _cores=$(awk -F': *' '/^Core\(s\) per socket/{print $2}' <<< "$lscpu_out" | head -1)
    [[ -z "$_sockets" ]] && _sockets=$(awk '/^physical id/{if(!seen[$4]++) n++} END{print n+0}' /proc/cpuinfo)
    [[ -z "$_cores" ]] && _cores=$(awk '/^cpu cores/{print $4; exit}' /proc/cpuinfo)
    [[ -z "$_threads" ]] && _threads=$(awk '/^siblings/{print $3; exit}' /proc/cpuinfo)
    [[ -z "$arch" ]] && arch=$(uname -m)
    # lscpu prints "Socket(s): -" on ARM64 / SBCs / VMs without topology.
    # Treat any non-numeric value (including "-") as unknown -> 1.
    [[ "$_sockets" =~ ^[0-9]+$ ]] || _sockets=1
    [[ "$_cores" =~ ^[0-9]+$ ]]  || _cores=1
    [[ "$_threads" =~ ^[0-9]+$ ]] || _threads=1
    [[ "$_sockets" -lt 1 ]] && _sockets=1
    [[ "$_cores" -lt 1 ]] && _cores=1
    [[ "$_threads" -lt 1 ]] && _threads=1
    sockets="$_sockets"; cores=$(( _cores * _sockets )); threads=$(( _threads * _cores * _sockets ))

    local turbo_hint
    turbo_hint=$(cat /sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq 2>/dev/null || cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq 2>/dev/null || true)
    gov=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || true)

    local base_hint base_freq_khz
    base_hint=$(awk -F'@' '/^model name/{print $2; exit}' /proc/cpuinfo | tr -d ' ' | sed 's/^\([0-9.]*\)GHz/\1 GHz/')
    base_freq_khz=""
    if [[ -n "$base_hint" && "$base_hint" =~ [0-9] ]]; then
        base_freq_khz=$(awk -v b="$base_hint" 'BEGIN{ g=b+0; if (g>0) printf "%.0f", g*1000000 }')
    fi

    local c_l1d="" c_l1i="" c_l2="" c_l3=""
    c_l1d=$(awk -F': *' '/^L1d cache/{print $2}' <<< "$lscpu_out" | head -1)
    c_l1i=$(awk -F': *' '/^L1i cache/{print $2}' <<< "$lscpu_out" | head -1)
    c_l2=$(awk -F': *' '/^L2 cache/{print $2}' <<< "$lscpu_out" | head -1)
    c_l3=$(awk -F': *' '/^L3 cache/{print $2}' <<< "$lscpu_out" | head -1)

    local flags
    flags=$(grep -m1 '^flags' /proc/cpuinfo 2>/dev/null || true)

    local -a feats=()
    local f
    for f in avx512f avx2 avx avx_vnni avx512_vnni sse4_2 sse4_1 aes ssse3 bmi2 bmi1; do
        [[ "$flags" == *"$f"* ]] && feats+=("$f")
    done

    local vtx="" hv_label=""
    if [[ "$flags" == *vmx* ]]; then vtx="Intel VT-x"
    elif [[ "$flags" == *svm* ]]; then vtx="AMD-V"; fi
    local virt
    virt=$(awk -F': *' '/^Virtualization:/{print $2}' <<< "$lscpu_out" | head -1)
    if [[ "$flags" == *hypervisor* ]]; then
        hv_label=$(awk -F': *' '/^Hypervisor vendor/{print $2}' <<< "$lscpu_out" | head -1)
    fi

    core_loads
    cpu_topology

    wu_json_head "$_WU_TOOLNAME" "$_WU_VERSION"
    printf ',\n  "info": {\n'
    printf '    "model": "%s",\n' "$(json_esc "$model")"
    printf '    "arch": "%s",\n' "$(json_esc "$arch")"
    printf '    "sockets": %s,\n' "$(wu_json_num "$sockets")"
    printf '    "cores": %s,\n' "$(wu_json_num "$cores")"
    printf '    "threads": %s,\n' "$(wu_json_num "$threads")"
    printf '    "max_freq_khz": %s,\n' "$(wu_json_num "$turbo_hint")"
    printf '    "base_freq_khz": %s,\n' "$(wu_json_num "$base_freq_khz")"
    printf '    "governor": "%s",\n' "$(json_esc "$gov")"
    printf '    "caches": { "l1d": "%s", "l1i": "%s", "l2": "%s", "l3": "%s" },\n' \
        "$(json_esc "$c_l1d")" "$(json_esc "$c_l1i")" "$(json_esc "$c_l2")" "$(json_esc "$c_l3")"
    printf '    "features": ['
    local first=1
    for f in ${feats[@]+"${feats[@]}"}; do
        (( first )) && first=0 || printf ','
        printf ' "%s"' "$(json_esc "$f")"
    done
    printf ' ],\n'
    printf '    "virtualization": "%s",\n' "$(json_esc "$virt")"
    printf '    "hypervisor": "%s"\n' "$(json_esc "$hv_label")"
    printf '  },\n'
    printf '  "load": [\n'
    first=1
    local i
    for (( i=0; i<_CPU_COUNT; i++ )); do
        local pct=${_CPU_PCT[$i]:-0}
        local freq gov_c
        freq=$(cat "/sys/devices/system/cpu/cpu${i}/cpufreq/scaling_cur_freq" 2>/dev/null || true)
        gov_c=$(cat "/sys/devices/system/cpu/cpu${i}/cpufreq/scaling_governor" 2>/dev/null || true)
        (( first )) && first=0 || printf ',\n'
        # socket/core come from /proc/cpuinfo topology; omit when unknown (0/0
        # is still emitted so consumers can group even on single-socket boxes).
        printf '    { "cpu": %d, "socket": %d, "core": %d, "usage_percent": %d, "freq_khz": %s, "governor": "%s" }' \
            "$i" "${_CPU_SOCKET[$i]:-0}" "${_CPU_CORE[$i]:-0}" "$pct" "$(wu_json_num "$freq")" "$(json_esc "$gov_c")"
    done
    printf '\n  ]\n'
    wu_json_end
}

# ─── Main ────────────────────────────────────────────────────────
short_out() {
    local a b
    a=$(awk '/^cpu /{print $2+$3+$4+$5+$6+$7+$8, $2+$3+$4+$6+$7}' /proc/stat 2>/dev/null) || a=""
    [[ -n "$a" ]] || { printf -- '-\n'; return 0; }
    sleep 0.3
    b=$(awk '/^cpu /{print $2+$3+$4+$5+$6+$7+$8, $2+$3+$4+$6+$7}' /proc/stat 2>/dev/null) || b=""
    [[ -n "$b" ]] || { printf -- '-\n'; return 0; }
    local d_all=$(( ${b%% *} - ${a%% *} )) d_busy=$(( ${b#* } - ${a#* } ))
    (( d_all > 0 )) || { printf '0%%\n'; return 0; }
    local pct=$(( d_busy * 100 / d_all ))
    (( pct < 0 )) && pct=0
    (( pct > 100 )) && pct=100
    printf '%d%%\n' "$pct"
}

main() {
    if [[ "$_WU_JSON" == "1" ]]; then json_out; return 0; fi
    if [[ "$_WU_SHORT" == "1" ]]; then short_out; return 0; fi

    box_header "$(_emu '🧠')" "wellcpu" "$(t cpu_title)"

    box "$(_emu '⚙')" "$(t cpu_summary)" print_cpu_info
    box "$(_emu '📈')" "$(t cpu_load)" print_cpu_load

    printf '\n  %sWellCPU v1.0 | %s%s\n\n' "$DIM" "$(date '+%Y-%m-%d %H:%M:%S')" "$RESET"
}

wu_run main "$@"
