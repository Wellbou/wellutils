#!/usr/bin/env bash
# wellpower v1 -- Battery health and power management overview.
# Part of wellutils by wellbou_
set -euo pipefail

_WU_TOOLNAME="wellpower" _WU_NAME="WellPower" _WU_VERSION="1.0"
_WU_SHORT_OK=1
_WU_SHORT_OK=1
_WU_TAGLINE="battery health and power profiles"
_WU_BOOT_DIR="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="$(dirname -- "$_WU_BOOT_DIR")/share/wellutils"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="/usr/local/share/wellutils"
[[ -f "$_WU_BOOT_DIR/bootstrap.sh" ]] || _WU_BOOT_DIR="/usr/share/wellutils"
source "$_WU_BOOT_DIR/bootstrap.sh" lang cli box

PS_DIR=/sys/class/power_supply

# ─── Helpers ────────────────────────────────────────────────────
wp_read() { cat "$1" 2>/dev/null | head -1 | tr -d '\r' || true; }
wp_pct() {
    local v="$1"
    [[ "$v" =~ ^[0-9]+(\.[0-9]+)?$ ]] || return 1
    printf '%d' "${v%%.*}"
}

print_batteries() {
    local found=0 d name status cap energy_full energy_full_design capacity wear cycles tech
    for d in "$PS_DIR"/BAT* "$PS_DIR"/bat*; do
        [[ -d "$d" ]] || continue
        found=1
        name=$(basename "$d")
        status=$(wp_read "$d/status")
        cap=$(wp_pct "$(wp_read "$d/capacity")" || echo "?")
        energy_full=$(wp_read "$d/energy_full")
        energy_full_design=$(wp_read "$d/energy_full_design")
        # Some drivers expose charge_* (uAh) instead of energy_* (uWh).
        if [[ ! "$energy_full" =~ ^[0-9]+$ ]]; then
            energy_full=$(wp_read "$d/charge_full")
            energy_full_design=$(wp_read "$d/charge_full_design")
        fi
        local wear=""
        if [[ "$energy_full" =~ ^[0-9]+$ && "$energy_full_design" =~ ^[0-9]+$ && "$energy_full_design" -gt 0 && "$energy_full" -gt 0 ]]; then
            wear=$(( 100 - (energy_full * 100 / energy_full_design) ))
            (( wear < 0 )) && wear=0
        fi
        cycles=$(wp_read "$d/cycle_count")
        tech=$(wp_read "$d/technology")

        local ccolor="$G"
        [[ "$cap" != "?" ]] && (( cap <= 20 )) && ccolor="$R"
        [[ "$cap" != "?" ]] && (( cap > 20 && cap <= 45 )) && ccolor="$Y"

        local line_out="$(_emu '🔋') ${BOLD}${name}${RESET}: ${ccolor}${cap}%${RESET} (${status})"
        [[ -n "$tech" ]] && line_out+="${DIM} · ${tech}${RESET}"
        pline "$line_out"
        if [[ -n "$wear" ]]; then
            local wcolor="$G"; (( wear >= 25 )) && wcolor="$Y"; (( wear >= 40 )) && wcolor="$R"
            local wtxt="$(t pwr_wear): ${wcolor}${wear}%${RESET}"
            [[ "$cycles" =~ ^[0-9]+$ && "$cycles" -gt 0 ]] && wtxt+=" · $(t pwr_cycles): $cycles"
            pline_sub "$wtxt"
        elif [[ "$cycles" =~ ^[0-9]+$ && "$cycles" -gt 0 ]]; then
            pline_sub "$(t pwr_cycles): $cycles"
        fi
    done
    (( found )) || pline "${DIM}$(t pwr_no_battery)${RESET}"
}

print_ac() {
    local found=0 d name online
    for d in "$PS_DIR"A* "$PS_DIR"/AC* "$PS_DIR"/ac*; do
        [[ -d "$d" ]] || continue
        name=$(basename "$d")
        online=$(wp_read "$d/online")
        case "$online" in
            1) pline "$(_emu '⚡') ${BOLD}${name}${RESET}: $(t pwr_online)" ;;
            0) pline "$(_emu '🔌') ${BOLD}${name}${RESET}: $(t pwr_offline)" ;;
            *) : ;;
        esac
        found=1
    done
    (( found )) || pline "${DIM}$(t pwr_no_ac)${RESET}"
}

print_thresholds() {
    local d name start stop found=0
    for d in "$PS_DIR"/BAT*; do
        [[ -d "$d" ]] || continue
        name=$(basename "$d")
        start=$(wp_read "$d/charge_control_start_threshold")
        stop=$(wp_read "$d/charge_control_end_threshold")
        if [[ -n "$start$stop" ]]; then
            found=1
            local ttxt=""
            [[ -n "$start" ]] && ttxt="$(t pwr_thr_start): ${start}%"
            [[ -n "$stop" ]] && { [[ -n "$ttxt" ]] && ttxt+=" · "; ttxt+="$(t pwr_thr_stop): ${stop}%"; }
            [[ -n "$ttxt" ]] && pline_sub "$(_emu '🎚') ${BOLD}${name}${RESET}: $ttxt"
        fi
    done
    (( found )) || pline "${DIM}$(t pwr_no_thresholds)${RESET}"
}

print_governor() {
    local prof="" src=""
    if command -v powerprofilesctl &>/dev/null; then
        prof=$(powerprofilesctl get 2>/dev/null || true)
        [[ -n "$prof" ]] && src="power-profiles-daemon"
    fi
    if [[ -z "$prof" ]]; then
        prof=$(wp_read /sys/firmware/acpi/platform_profile)
        [[ -n "$prof" ]] && src="platform_profile"
    fi
    if [[ -z "$prof" ]] && command -v tlp &>/dev/null; then
        prof="TLP"; src="tlp"
    fi
    if [[ -n "$prof" ]]; then
        pline "$(_emu '⚙') $(t pwr_profile): ${BOLD}${prof}${RESET} ${DIM}(${src})${RESET}"
    else
        pline "$(_emu '⚙') ${DIM}$(t pwr_no_profile)${RESET}"
    fi
}

print_drain() {
    # Current discharge rate in watts when available (positive = discharging).
    local d name now rate found=0
    for d in "$PS_DIR"/BAT*; do
        [[ -d "$d" ]] || continue
        name=$(basename "$d")
        now=$(wp_read "$d/power_now")
        if [[ ! "$now" =~ ^[0-9]+$ ]]; then
            now=$(wp_read "$d/current_now")
            local volt
            volt=$(wp_read "$d/voltage_now")
            if [[ "$now" =~ ^[0-9]+$ && "$volt" =~ ^[0-9]+$ && "$volt" -gt 0 ]]; then
                # uA * uV -> uW
                now=$(( now * volt / 1000000 ))
            fi
        fi
        [[ "$now" =~ ^[0-9]+$ ]] || continue
        found=1
        pline_sub "$(_emu '📉') ${BOLD}${name}${RESET}: $(awk -v u="$now" 'BEGIN{printf "%.1f W", u/1000000}')"
    done
    (( found )) || pline "${DIM}$(t pwr_no_rate)${RESET}"
}

json_out() {
    wu_json_head "$_WU_TOOLNAME" "$_WU_VERSION"
    printf ',\n  "batteries": [\n'
    local first=1 d name status cap efull edes wear cycles
    for d in "$PS_DIR"/BAT* "$PS_DIR"/bat*; do
        [[ -d "$d" ]] || continue
        name=$(basename "$d"); status=$(wp_read "$d/status")
        cap=$(wp_read "$d/capacity"); cycles=$(wp_read "$d/cycle_count")
        efull=$(wp_read "$d/energy_full"); edes=$(wp_read "$d/energy_full_design")
        [[ "$efull" =~ ^[0-9]+$ ]] || { efull=$(wp_read "$d/charge_full"); edes=$(wp_read "$d/charge_full_design"); }
        local wear_j=null
        if [[ "$efull" =~ ^[0-9]+$ && "$edes" =~ ^[0-9]+$ && "$edes" -gt 0 && "$efull" -gt 0 ]]; then
            wear=$(( 100 - efull * 100 / edes )); (( wear < 0 )) && wear=0
            wear_j="$wear"
        fi
        [[ "$cap" =~ ^[0-9]+$ ]] || cap=null
        [[ "$cycles" =~ ^[0-9]+$ ]] || cycles=null
        (( first )) && first=0 || printf ',\n'
        printf '    { "name": "%s", "status": "%s", "capacity_percent": %s, "wear_percent": %s, "cycle_count": %s }' \
            "$(json_esc "$name")" "$(json_esc "$status")" "$cap" "$wear_j" "$cycles"
    done
    printf '\n  ],\n'
    local ac="null"
    for d in "$PS_DIR"A* "$PS_DIR"/AC*; do
        [[ -d "$d" ]] || continue
        ac=$(wp_read "$d/online")
        [[ "$ac" == "1" || "$ac" == "0" ]] && break || ac="null"
    done
    printf '  "ac_online": %s,\n' "$ac"
    printf '  "thresholds": [\n'
    first=1
    for d in "$PS_DIR"/BAT*; do
        [[ -d "$d" ]] || continue
        local st sp
        st=$(wp_read "$d/charge_control_start_threshold")
        sp=$(wp_read "$d/charge_control_end_threshold")
        [[ -n "$st$sp" ]] || continue
        (( first )) && first=0 || printf ',\n'
        printf '    { "name": "%s", "start": "%s", "end": "%s" }' \
            "$(json_esc "$(basename "$d")")" "${st:-}" "${sp:-}"
    done
    printf '\n  ]\n'
    wu_json_end
}

short_out() {
    local d cap status wear efull edes
    for d in "$PS_DIR"/BAT*; do
        [[ -d "$d" ]] || continue
        cap=$(wp_pct "$(wp_read "$d/capacity")" || echo "")
        [[ -n "$cap" ]] || continue
        status=$(wp_read "$d/status")
        local out="${cap}%"
        [[ "$status" == "Discharging" ]] || out+="+"
        efull=$(wp_read "$d/energy_full"); edes=$(wp_read "$d/energy_full_design")
        [[ "$efull" =~ ^[0-9]+$ ]] || { efull=$(wp_read "$d/charge_full"); edes=$(wp_read "$d/charge_full_design"); }
        if [[ "$efull" =~ ^[0-9]+$ && "$edes" =~ ^[0-9]+$ && "$edes" -gt 0 && "$efull" -gt 0 ]]; then
            wear=$(( 100 - efull * 100 / edes )); (( wear < 0 )) && wear=0
            out+=" ($(t pwr_wear) ${wear}%)"
        fi
        printf '%s\n' "$out"
        return 0
    done
    printf -- '-\n'
}

main() {
    if [[ "$_WU_JSON" == "1" ]]; then json_out; return 0; fi
    if [[ "$_WU_SHORT" == "1" ]]; then short_out; return 0; fi

    box_header "$(_emu '🔋')" "wellpower" "$(t pwr_title)"

    box "$(_emu '🔋')" "$(t pwr_battery)" print_batteries
    box "$(_emu '⚡')" "$(t pwr_ac)" print_ac
    box "$(_emu '📉')" "$(t pwr_drain)" print_drain
    box "$(_emu '🎚')" "$(t pwr_thresholds)" print_thresholds
    box "$(_emu '⚙')" "$(t pwr_mgmt)" print_governor

    printf '\n  %sWellPower v%s | %s%s\n\n' "$DIM" "$_WU_VERSION" "$(date '+%Y-%m-%d %H:%M:%S')" "$RESET"
}

wu_run main "$@"
